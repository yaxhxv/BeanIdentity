{% comment %}
  SECTION: CLEAN HERO BANNER
  - Full width autoplay hero using the same image blocks.
  - Editorial Bean Identity treatment with restrained motion.
{% endcomment %}

{% liquid
  assign loading_priority = 'eager'

  # Calculate Desktop Aspect Ratio
  assign desktop_ratio = section.settings.desktop_ratio
  if desktop_ratio == 'adapt'
    assign first_image = section.blocks.first.settings.image_d
    if first_image
      assign desktop_ratio = 1 | divided_by: first_image.aspect_ratio | times: 100 | append: '%'
    else
      assign desktop_ratio = '56.25%'
    endif
  endif

  # Calculate Mobile Aspect Ratio
  assign mobile_ratio = section.settings.mobile_ratio
  if mobile_ratio == 'adapt'
    assign first_block = section.blocks.first
    assign mobile_image = first_block.settings.image_m | default: first_block.settings.image_d
    if mobile_image
      assign mobile_ratio = 1 | divided_by: mobile_image.aspect_ratio | times: 100 | append: '%'
    else
      assign mobile_ratio = '125%'
    endif
  endif
%}

{%- style -%}
  .clean-hero-section {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: block;
    background: #0b0b0b;
    isolation: isolate;
  }

  /* Container Widths */
  .clean-hero-section.page-width {
    max-width: 1200px;
    margin: 20px auto;
    width: calc(100% - 30px);
  }

  .clean-hero-section.full-width {
    width: 100%;
    max-width: 100%;
    margin: 0;
    border-radius: 0;
  }

  /* TRACK & SLIDES */
  .clean-hero-track {
    display: flex;
    width: 100%;
    transition: transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .clean-hero-slide {
    min-width: 100%;
    position: relative;
    flex-shrink: 0;
  }

  /* IMAGE HANDLING */
  .clean-image-wrapper {
    width: 100%;
    position: relative;
    overflow: hidden;
    background: #0b0b0b;
  }

  .clean-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    position: absolute;
    top: 0; left: 0;
    transform: scale(1.02);
    filter: saturate(0.85) contrast(1.08);
    transition: transform 6s ease, filter 0.6s ease;
  }

  .clean-hero-slide.is-active .clean-img {
    transform: scale(1.08);
    filter: saturate(0.92) contrast(1.12);
  }

  /* CONTENT OVERLAY */
  .hero-content-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    padding: clamp(3.2rem, 6vw, 7rem);
    z-index: 5;
    text-align: left;
    color: {{ section.settings.text_color }};
  }

  .hero-copy-stack {
    width: min(78rem, 100%);
    transform: translateY(1rem);
    opacity: 0;
    animation: heroCopyIn 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.15s forwards;
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 1.4rem;
    font-family: 'Poppins', sans-serif;
    font-size: clamp(1rem, 1.1vw, 1.2rem);
    font-weight: 700;
    letter-spacing: 0.22em;
    line-height: 1;
    text-transform: uppercase;
    color: #c6a969;
  }

  .hero-kicker::before {
    content: "";
    width: 4.8rem;
    height: 1px;
    background: currentColor;
    opacity: 0.85;
  }

  .hero-overlay-mask {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    {% assign base_opacity = section.settings.overlay_opacity | divided_by: 100.0 %}
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.82) 0%, rgba(0, 0, 0, 0.5) 34%, rgba(0, 0, 0, 0.16) 72%),
      linear-gradient(180deg, rgba(0, 0, 0, 0.18) 0%, rgba(0, 0, 0, 0.05) 42%, rgba(0, 0, 0, 0.82) 100%);
    z-index: 2;
  }

  /* Cinematic Vignette */
  .clean-image-wrapper::after {
    content: "";
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background:
      radial-gradient(circle at 72% 32%, transparent 0, rgba(0,0,0,0.08) 34%, rgba(0,0,0,0.72) 100%),
      linear-gradient(0deg, rgba(0,0,0,0.18), rgba(0,0,0,0.18));
    pointer-events: none;
    z-index: 3;
  }

  .clean-image-wrapper::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
    opacity: 0.18;
    background-image:
      linear-gradient(rgba(255,255,255,0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px);
    background-size: 76px 76px;
    mask-image: linear-gradient(90deg, #000, transparent 72%);
  }

  /* Bottom Edge Blend */
  .hero-bottom-blend {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 32%;
    background: linear-gradient(to bottom, transparent, rgba(11, 11, 11, 0.9) 70%, #0b0b0b 100%);
    z-index: 4;
    pointer-events: none;
  }

  .hero-headline {
    font-family: var(--font-heading-family);
    font-size: clamp(5.2rem, 11vw, 13.2rem);
    font-weight: 900;
    margin: 0;
    max-width: 11ch;
    line-height: 0.78;
    text-transform: uppercase;
    letter-spacing: 0;
    color: #f5f5f5;
    text-wrap: balance;
    text-shadow: 0 2rem 6rem rgba(0,0,0,0.55);
  }

  .hero-subline {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(1.45rem, 1.6vw, 1.85rem);
    font-weight: 500;
    margin: 2rem 0 0;
    max-width: 52rem;
    color: rgba(245, 245, 245, 0.86);
    line-height: 1.45;
    text-shadow: 0 1rem 3rem rgba(0,0,0,0.45);
  }

  .hero-buttons {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
    margin-top: 3rem;
    align-items: center;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 5.4rem;
    padding: 0 3rem;
    font-family: 'Poppins', sans-serif;
    font-size: 1.25rem;
    font-weight: 800;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    transition: color 0.28s ease, background 0.28s ease, border-color 0.28s ease, transform 0.28s ease;
    min-width: 18.8rem;
    text-align: center;
    border-radius: 0;
  }

  .hero-btn-primary {
    background: #f5f5f5;
    color: #0b0b0b;
    border: 1px solid #f5f5f5;
    box-shadow: 0 2rem 5rem rgba(0,0,0,0.28);
  }

  .hero-btn-primary:hover {
    background: #c6a969;
    border-color: #c6a969;
    color: #0b0b0b;
    transform: translateY(-0.2rem);
  }

  .hero-btn-secondary {
    background: rgba(11, 11, 11, 0.26);
    color: #f5f5f5;
    border: 1px solid rgba(245, 245, 245, 0.55);
    backdrop-filter: blur(14px);
  }

  .hero-btn-secondary:hover {
    background: rgba(245, 245, 245, 0.12);
    border-color: #c6a969;
    color: #c6a969;
    transform: translateY(-0.2rem);
  }

  .hero-brand-note {
    position: absolute;
    right: clamp(2rem, 4vw, 5.2rem);
    bottom: clamp(2rem, 4vw, 4.8rem);
    z-index: 5;
    display: grid;
    gap: 0.5rem;
    max-width: 20rem;
    font-family: 'Poppins', sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0.14em;
    text-align: right;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.72);
  }

  .hero-brand-note strong {
    color: #c6a969;
    font-weight: 800;
  }

  @keyframes heroCopyIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* RESPONSIVE VISIBILITY & RATIOS */
  .mobile-only { display: none; }
  .desktop-only { display: block; }

  /* Desktop Ratio */
  @media (min-width: 768px) {
    .clean-image-wrapper {
      padding-bottom: {{ desktop_ratio }};
      min-height: 62rem;
    }
  }

  /* Mobile Ratio */
  @media (max-width: 767px) {
    .desktop-only { display: none; }
    .mobile-only { display: block; }

    .clean-image-wrapper {
      padding-bottom: {{ mobile_ratio }};
      min-height: 67rem;
    }

    .hero-buttons {
      flex-direction: column;
      width: 100%;
      align-items: stretch;
    }

    .hero-btn {
      width: 100%;
      min-width: unset;
    }

    .hero-content-overlay {
      justify-content: flex-end;
      padding: 3.2rem 2rem 7.2rem;
    }

    .hero-headline {
      font-size: clamp(4.4rem, 16vw, 6.8rem);
      max-width: 10ch;
    }

    .hero-subline {
      max-width: 34rem;
    }

    .hero-overlay-mask {
      background:
        linear-gradient(180deg, rgba(0,0,0,0.12) 0%, rgba(0,0,0,0.35) 42%, rgba(0,0,0,0.9) 100%),
        linear-gradient(90deg, rgba(0,0,0,0.55), rgba(0,0,0,0.05));
    }

    .clean-image-wrapper::before {
      background-size: 54px 54px;
      opacity: 0.12;
    }

    .hero-kicker::before {
      width: 3.2rem;
    }

    .hero-brand-note {
      display: none;
    }
  }

  /* NAVIGATION DOTS */
  .clean-hero-dots {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 1rem;
    z-index: 6;
    pointer-events: none;
  }

  .clean-dot {
    width: 3rem;
    height: 0.3rem;
    border-radius: 0;
    background: rgba(245, 245, 245, 0.28);
    cursor: pointer;
    pointer-events: auto;
    padding: 0;
    border: none;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .clean-dot.active {
    width: 5.2rem;
    background: #c6a969;
    box-shadow: 0 0 2rem rgba(198,169,105,0.35);
  }
{%- endstyle -%}

<div
  class="clean-hero-section {{ section.settings.section_width }}"
  id="CleanSlider-{{ section.id }}"
  data-autoplay="true"
  data-speed="{{ section.settings.speed }}"
>
  <div class="clean-hero-track">
    {% for block in section.blocks %}
      <div class="clean-hero-slide {% if forloop.first %}is-active{% endif %}" {{ block.shopify_attributes }}>
        <div class="clean-image-wrapper">
          {% liquid
            assign loading_strategy = 'lazy'
            assign fetch_priority = 'auto'

            if forloop.first
              assign loading_strategy = 'eager'
              assign fetch_priority = 'high'
            endif
          %}

          <div class="desktop-only">
            {% if block.settings.image_d != blank %}
              {{
                block.settings.image_d
                | image_url: width: 2000
                | image_tag:
                  loading: loading_strategy,
                  fetchpriority: fetch_priority,
                  class: 'clean-img',
                  widths: '1000, 1400, 2000, 3000'
              }}
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'clean-img' }}
            {% endif %}
          </div>

          <div class="mobile-only">
            {% if block.settings.image_m != blank %}
              {{
                block.settings.image_m
                | image_url: width: 800
                | image_tag:
                  loading: loading_strategy,
                  fetchpriority: fetch_priority,
                  class: 'clean-img',
                  widths: '400, 600, 800, 1000'
              }}
            {% elsif block.settings.image_d != blank %}
              {{
                block.settings.image_d
                | image_url: width: 800
                | image_tag:
                  loading: loading_strategy,
                  fetchpriority: fetch_priority,
                  class: 'clean-img',
                  widths: '400, 600, 800'
              }}
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'clean-img' }}
            {% endif %}
          </div>

          <div class="hero-overlay-mask"></div>
          <div class="hero-bottom-blend"></div>

          <div class="hero-content-overlay">
            <div class="hero-copy-stack">
              <p class="hero-kicker">Bean Identity</p>
              {% if block.settings.headline != blank %}
                <h2 class="hero-headline">{{ block.settings.headline }}</h2>
              {% endif %}

              {% if block.settings.subline != blank %}
                <p class="hero-subline">{{ block.settings.subline }}</p>
              {% endif %}

              <div class="hero-buttons">
                {% if block.settings.button_1_label != blank %}
                  <a href="{{ block.settings.button_1_link | default: '#' }}" class="hero-btn hero-btn-primary">
                    {{ block.settings.button_1_label }}
                  </a>
                {% endif %}

                {% if block.settings.button_2_label != blank %}
                  <a href="{{ block.settings.button_2_link | default: '#' }}" class="hero-btn hero-btn-secondary">
                    {{ block.settings.button_2_label }}
                  </a>
                {% endif %}
              </div>
            </div>
          </div>

          <div class="hero-brand-note" aria-hidden="true">
            <span><strong>One system.</strong></span>
            <span>Five personalities.</span>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>

  {% if section.settings.show_dots and section.blocks.size > 1 %}
    <div class="clean-hero-dots">
      {% for block in section.blocks %}
        <button
          class="clean-dot {% if forloop.first %}active{% endif %}"
          data-index="{{ forloop.index0 }}"
          aria-label="Go to slide {{ forloop.index }}"
        ></button>
      {% endfor %}
    </div>
  {% endif %}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const container = document.getElementById('CleanSlider-{{ section.id }}');
    if (!container) return;

    const track = container.querySelector('.clean-hero-track');
    const slides = container.querySelectorAll('.clean-hero-slide');
    const dots = container.querySelectorAll('.clean-dot');

    if (slides.length <= 1) return;

    let currentIndex = 0;
    let interval;
    const speed = parseInt(container.dataset.speed) * 1000;

    function goToSlide(index) {
      currentIndex = index;
      track.style.transform = `translateX(-${currentIndex * 100}%)`;

      slides.forEach((slide) => slide.classList.remove('is-active'));
      if (slides[currentIndex]) slides[currentIndex].classList.add('is-active');

      dots.forEach((d) => d.classList.remove('active'));
      if (dots[currentIndex]) dots[currentIndex].classList.add('active');
    }

    function nextSlide() {
      let next = currentIndex + 1;
      if (next >= slides.length) next = 0;
      goToSlide(next);
    }

    function startPlay() {
      if (!interval) {
        interval = setInterval(nextSlide, speed);
      }
    }

    function stopPlay() {
      if (interval) {
        clearInterval(interval);
        interval = null;
      }
    }

    // Dot Clicks
    dots.forEach((dot) => {
      dot.addEventListener('click', function () {
        stopPlay();
        goToSlide(parseInt(this.dataset.index));
        startPlay();
      });
    });

    // Pause on hover
    container.addEventListener('mouseenter', stopPlay);
    container.addEventListener('mouseleave', startPlay);

    // Init
    startPlay();
  });
</script>

{% schema %}
{
  "name": "Clean Hero (Structural)",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        { "value": "full-width", "label": "Full Width" },
        { "value": "page-width", "label": "Page Width" }
      ],
      "default": "full-width"
    },
    {
      "type": "select",
      "id": "desktop_ratio",
      "label": "Desktop Aspect Ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to first image" },
        { "value": "56.25%", "label": "16:9 (Wide)" },
        { "value": "41.6%", "label": "21:9 (Ultrawide)" },
        { "value": "75%", "label": "4:3 (Standard)" },
        { "value": "100%", "label": "1:1 (Square)" }
      ],
      "default": "56.25%"
    },
    {
      "type": "select",
      "id": "mobile_ratio",
      "label": "Mobile Aspect Ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to first image" },
        { "value": "125%", "label": "4:5 (Portrait)" },
        { "value": "177.7%", "label": "9:16 (Full Screen)" },
        { "value": "100%", "label": "1:1 (Square)" },
        { "value": "75%", "label": "4:3 (Rectangular)" }
      ],
      "default": "125%"
    },
    {
      "type": "header",
      "content": "Aesthetic Settings"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#F5F5F5"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 30
    },
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "sec",
      "label": "Auto-play Speed",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show Navigation Dots",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F5F5F5"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_d",
          "label": "Desktop Image"
        },
        {
          "type": "image_picker",
          "id": "image_m",
          "label": "Mobile Image (Optional)"
        },
        {
          "type": "text",
          "id": "headline",
          "label": "Headline",
          "default": "Wear who you are"
        },
        {
          "type": "text",
          "id": "subline",
          "label": "Subline",
          "default": "Insert supporting sub-line copy here."
        },
        {
          "type": "header",
          "content": "Primary Button"
        },
        {
          "type": "text",
          "id": "button_1_label",
          "label": "Button Label",
          "default": "Find your Bean"
        },
        {
          "type": "url",
          "id": "button_1_link",
          "label": "Button Link"
        },
        {
          "type": "header",
          "content": "Secondary Button"
        },
        {
          "type": "text",
          "id": "button_2_label",
          "label": "Button Label",
          "default": "Meet the Beans"
        },
        {
          "type": "url",
          "id": "button_2_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Clean Hero (Structural)",
      "blocks": [{ "type": "slide" }]
    }
  ]
}
{% endschema %}
