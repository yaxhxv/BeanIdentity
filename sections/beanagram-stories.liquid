{% comment %}
  SECTION: BEANAGRAM STORIES
  - Community stories in a social-card style.
  - Color-coded based on Bean identity.
{% endcomment %}

{%- style -%}
  #Beanagram-{{ section.id }} {
    background:
      radial-gradient(circle at 12% 0%, rgba(198,169,105,0.16), transparent 24%),
      #121212;
    padding: clamp(8rem, 10vw, 13rem) 0;
    overflow: hidden;
    color: #f5f5f5;
    position: relative;
    border-radius: 4.6rem 4.6rem 5.8rem 5rem / 3rem 3rem 4rem 3.8rem;
    box-shadow: 0 2.8rem 6rem rgba(0, 0, 0, 0.18);
    margin: 0 1.6rem;
  }



  .beanagram-header {
    text-align: center;
    margin-bottom: 6rem;
    padding: 0 2rem;
    position: relative;
    z-index: 1;
  }


  .beanagram-title {
    font-family: var(--font-heading-family);
    font-size: clamp(4rem, 7vw, 8.8rem);
    font-weight: 900;
    line-height: 0.9;
    margin: 0 0 1rem 0;
    color: #f5f5f5;
  }

  .beanagram-subtitle {
    font-family: 'Poppins', sans-serif;
    font-size: 1.8rem;
    color: rgba(245,245,245,0.68);
    margin: 0;
  }

  .beanagram-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 2.5rem;
    padding: 2rem 4rem 4rem;
    scrollbar-width: none;
    -ms-overflow-style: none;
    position: relative;
    z-index: 1;
    width: max-content;
    max-width: 100%;
    margin: 0 auto;
  }

  .beanagram-track::-webkit-scrollbar {
    display: none;
  }

  .beanagram-card {
    flex: 0 0 36rem;
    background: rgba(245,245,245,0.05);
    border: 1px solid rgba(245,245,245,0.12);
    border-radius: 2.4rem 2rem 2.8rem 2.2rem;
    padding: 2.8rem;
    scroll-snap-align: center;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    display: flex;
    flex-direction: column;
    min-height: 40rem;
    transition: transform 0.35s ease, border-color 0.35s ease, background 0.35s ease;
    /* Dynamic Border Accent */
    border-top: 4px solid var(--bean-accent);
    position: relative;
    text-align: left;
  }

  .beanagram-card:hover {
    transform: translateY(-0.8rem);
    border-color: var(--bean-accent);
    background: rgba(245,245,245,0.08);
  }


  .beanagram-card__header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .beanagram-card__avatar {
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    background: rgba(245,245,245,0.08);
    overflow: hidden;
    flex-shrink: 0;
    border: 2px solid var(--bean-accent);
  }

  .beanagram-card__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .beanagram-card__user-info {
    display: flex;
    flex-direction: column;
  }

  .beanagram-card__handle {
    font-weight: 800;
    font-size: 1.6rem;
    color: #f5f5f5;
  }

  .beanagram-card__bean-badge {
    font-size: 1.2rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--bean-accent);
    letter-spacing: 0.05em;
  }

  .beanagram-card__story {
    font-size: 1.6rem;
    line-height: 1.6;
    color: rgba(245,245,245,0.84);
    margin: 0;
    flex-grow: 1;
    font-style: italic;
  }

  .beanagram-card__footer {
    padding-top: 2rem;
    border-top: 1px solid rgba(245,245,245,0.16);
    margin-top: 2rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 1.3rem;
    font-weight: 600;
    color: rgba(245,245,245,0.48);
  }

  .beanagram-card__icon {
    width: 2rem;
    height: 2rem;
    fill: var(--bean-accent);
  }

  .beanagram-cta-wrapper {
    text-align: center;
    margin-top: 4rem;
  }

  .beanagram-cta {
    display: inline-block;
    padding: 1.5rem 4rem;
    border: 1px solid #C6A969;
    background: transparent;
    text-decoration: none;
    font-weight: 700;
    color: #f5f5f5;
    text-transform: uppercase;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
    cursor: pointer;
    font-family: inherit;
  }

  .beanagram-cta:hover {
    background: #C6A969;
    transform: translateY(-0.2rem);
    color: #000000 !important;
  }

  .beanagram-cta::after {
    content: "";
    position: absolute;
    left: 2rem;
    right: 2rem;
    bottom: 1rem;
    height: 2px;
    background: currentColor;
    transform: scaleX(0.16);
    transform-origin: left center;
    opacity: 0.28;
    transition: transform 0.28s ease, opacity 0.28s ease;
    color: #000000 !important;

  }

  .beanagram-cta:hover::after {
    transform: scaleX(1);
    opacity: 0.75;
    color: #000000 !important;
  }


  @media screen and (max-width: 749px) {
    #Beanagram-{{ section.id }} {
      margin: 0 1rem;
      border-radius: 2.8rem 2.8rem 3.8rem 3.2rem / 2rem 2rem 2.8rem 2.4rem;
    }
    .beanagram-track {
      gap: 1.5rem;
      padding: 2rem 1.5rem;
      justify-content: flex-start;
    }
    .beanagram-card {
      flex: 0 0 28rem;
    }
  }

  .beanagram__bean-gif {
    position: absolute;
    top: -3rem;
    right: -5rem;
    width: clamp(240px, 28vw, 360px);
    height: auto;
    border-radius: 48% 52% 44% 56% / 52% 44% 56% 48%;
    mix-blend-mode: screen;
    opacity: 0.45;
    pointer-events: none;
    z-index: 0;
  }

  @media screen and (max-width: 749px) {
    .beanagram__bean-gif {
      width: clamp(140px, 40vw, 200px);
      top: -1.5rem;
      right: -2.5rem;
    }
  }

  /* --- STORY SUBMISSION MODAL CSS --- */
  :root {
    --active-accent: #A67C52;
    --active-accent-rgb: 166, 124, 82;
  }

  .story-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s cubic-bezier(0.25, 1, 0.5, 1);
    padding: 2rem;
  }

  .story-modal-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  .story-modal-container {
    background: #141414;
    border: 1px solid rgba(245, 245, 245, 0.08);
    border-top: 4px solid var(--active-accent);
    border-radius: 2.8rem;
    width: 100%;
    max-width: 680px;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
    box-shadow: 0 4rem 10rem rgba(0, 0, 0, 0.6);
    transform: scale(0.92) translateY(2rem);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    padding: 4rem;
    color: #f5f5f5;
  }

  .story-modal-overlay.open .story-modal-container {
    transform: scale(1) translateY(0);
  }

  .story-modal-close {
    position: absolute;
    top: 2.5rem;
    right: 2.5rem;
    background: none;
    border: none;
    font-size: 3.5rem;
    color: rgba(245, 245, 245, 0.4);
    cursor: pointer;
    line-height: 1;
    transition: color 0.2s ease, transform 0.2s ease;
    z-index: 5;
  }

  .story-modal-close:hover {
    color: #f5f5f5;
    transform: rotate(90deg);
  }

  .story-modal-title {
    font-family: var(--font-heading-family);
    font-size: clamp(2.4rem, 4vw, 3.4rem);
    font-weight: 900;
    letter-spacing: -0.01em;
    margin: 0 0 1rem 0;
    text-transform: uppercase;
    background: linear-gradient(135deg, #ffffff 0%, rgba(255,255,255,0.7) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .story-modal-subtitle {
    font-family: 'Poppins', sans-serif;
    font-size: 1.4rem;
    color: rgba(245,245,245,0.6);
    margin: 0 0 3.5rem 0;
    line-height: 1.6;
  }

  .story-form-scroll {
    display: flex;
    flex-direction: column;
  }

  .form-row {
    display: flex;
    gap: 2.5rem;
    margin-bottom: 2rem;
  }

  .form-group {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    min-width: 0;
  }

  .form-group label {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: rgba(245, 245, 245, 0.8);
    text-transform: uppercase;
  }

  .label-optional {
    font-size: 0.9rem;
    opacity: 0.5;
  }

  .form-group input[type="text"],
  .form-group input[type="email"],
  .form-group textarea {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1.2rem;
    padding: 1.4rem 1.8rem;
    color: #f5f5f5;
    font-family: 'Poppins', sans-serif;
    font-size: 1.4rem;
    transition: border-color 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--active-accent);
    box-shadow: 0 0 0 3px rgba(var(--active-accent-rgb), 0.18);
    background: rgba(255, 255, 255, 0.06);
  }

  .bean-pills-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .bean-pill-label {
    position: relative;
    cursor: pointer;
  }

  .bean-pill-label input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .bean-pill-label span {
    display: inline-block;
    padding: 0.8rem 1.6rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 2rem;
    font-size: 1.2rem;
    font-weight: 600;
    transition: all 0.25s cubic-bezier(0.25, 1, 0.5, 1);
    color: rgba(245, 245, 245, 0.7);
  }

  .bean-pill-label.coffee:hover span, .bean-pill-label.coffee input:checked + span {
    background: rgba(166, 124, 82, 0.16);
    border-color: #A67C52;
    color: #FFF;
  }

  .bean-pill-label.chilli:hover span, .bean-pill-label.chilli input:checked + span {
    background: rgba(211, 47, 47, 0.16);
    border-color: #D32F2F;
    color: #FFF;
  }

  .bean-pill-label.vanilla:hover span, .bean-pill-label.vanilla input:checked + span {
    background: rgba(255, 249, 196, 0.12);
    border-color: #FFF9C4;
    color: #FFF;
  }

  .bean-pill-label.jelly:hover span, .bean-pill-label.jelly input:checked + span {
    background: rgba(240, 98, 146, 0.16);
    border-color: #F06292;
    color: #FFF;
  }

  .bean-pill-label.green:hover span, .bean-pill-label.green input:checked + span {
    background: rgba(56, 142, 60, 0.16);
    border-color: #388E3C;
    color: #FFF;
  }

  .label-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .word-counter {
    font-size: 1.1rem;
    font-weight: 600;
    color: rgba(245, 245, 245, 0.4);
    transition: color 0.2s ease;
  }

  .word-counter.limit-exceeded {
    color: #D32F2F;
    font-weight: 700;
  }

  .media-upload-row {
    margin-top: 1rem;
  }

  .media-dropzone {
    border: 2px dashed rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.01);
    border-radius: 1.4rem;
    padding: 2.2rem 1.8rem;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.25s cubic-bezier(0.25, 1, 0.5, 1), background 0.25s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .media-dropzone:hover {
    border-color: var(--active-accent);
    background: rgba(255, 255, 255, 0.03);
  }

  .dropzone-prompt {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    color: rgba(245, 245, 245, 0.5);
    font-size: 1.2rem;
    font-weight: 600;
  }

  .dropzone-prompt svg {
    width: 2.4rem;
    height: 2.4rem;
    fill: currentColor;
  }

  .media-previews-container {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.2rem;
  }

  .preview-item {
    position: relative;
    width: 6.8rem;
    height: 6.8rem;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: #000;
  }

  .preview-item img,
  .preview-item video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .preview-remove-btn {
    position: absolute;
    top: 0.3rem;
    right: 0.3rem;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.85);
    color: #fff;
    border: none;
    font-size: 1.1rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    line-height: 1;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .preview-remove-btn:hover {
    background: #D32F2F;
    transform: scale(1.1);
  }

  .story-submit-btn {
    width: 100%;
    margin-top: 2.5rem;
    padding: 1.6rem;
    border: 1px solid var(--active-accent);
    background: transparent;
    color: #f5f5f5;
    font-weight: 700;
    font-size: 1.4rem;
    letter-spacing: 0.05em;
    border-radius: 1.4rem;
    cursor: pointer;
    text-transform: uppercase;
    transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .story-submit-btn:hover:not(:disabled) {
    background: var(--active-accent);
    color: #000000;
    transform: translateY(-2px);
    box-shadow: 0 1rem 3rem rgba(var(--active-accent-rgb), 0.2);
  }

  .story-submit-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .upload-progress-container {
    margin-top: 2.5rem;
    text-align: center;
  }

  .progress-bar-wrapper {
    background: rgba(255, 255, 255, 0.08);
    height: 8px;
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 1.2rem;
  }

  .progress-bar-fill {
    height: 100%;
    width: 0%;
    background: var(--active-accent);
    transition: width 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    border-radius: 4px;
  }

  .progress-text {
    font-size: 1.2rem;
    font-weight: 600;
    color: rgba(245, 245, 245, 0.7);
  }

  .story-success-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #141414;
    border-radius: 2.8rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem;
    text-align: center;
    z-index: 10;
  }

  .success-icon-wrapper {
    width: 6.8rem;
    height: 6.8rem;
    border-radius: 50%;
    background: rgba(56, 142, 60, 0.12);
    border: 2px solid #388E3C;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 2.5rem;
    color: #388E3C;
    animation: scaleUp 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  .success-icon-wrapper svg {
    width: 3.4rem;
    height: 3.4rem;
    fill: currentColor;
  }

  .story-success-overlay h4 {
    font-family: var(--font-heading-family);
    font-size: 2.6rem;
    font-weight: 900;
    margin: 0 0 1rem 0;
    color: #f5f5f5;
  }

  .story-success-overlay p {
    font-family: 'Poppins', sans-serif;
    font-size: 1.4rem;
    color: rgba(245, 245, 245, 0.6);
    max-width: 400px;
    margin: 0 0 3rem 0;
    line-height: 1.6;
  }

  .story-success-close-btn {
    padding: 1.4rem 3.5rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: transparent;
    color: #f5f5f5;
    font-weight: 700;
    font-size: 1.3rem;
    border-radius: 1.2rem;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .story-success-close-btn:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  /* --- CUSTOM DYNAMIC CAROUSEL DOCK CARDS --- */
  .story-card-images {
    display: flex;
    gap: 0.8rem;
    margin-top: 1.8rem;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    border-radius: 0.8rem;
  }
  .story-card-images::-webkit-scrollbar {
    display: none;
  }
  .story-card-images img {
    width: 6.8rem;
    height: 6.8rem;
    object-fit: cover;
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    flex-shrink: 0;
  }

  .story-card-video {
    margin-top: 1.8rem;
    border-radius: 1.4rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    position: relative;
    aspect-ratio: 16 / 9;
    width: 100%;
    background: #000;
  }

  .story-card-video video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @keyframes scaleUp {
    0% { transform: scale(0.5); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }

  @media screen and (max-width: 749px) {
    .story-modal-container {
      padding: 3rem 2.2rem;
      border-radius: 2.2rem;
    }
    .form-row {
      flex-direction: column;
      gap: 1.8rem;
      margin-bottom: 1.8rem;
    }
    .media-upload-row {
      gap: 1.8rem;
    }
  }

  /* --- BEAN STORY COPY DESIGN --- */
  .bean-story-modal-content {
    text-align: center;
    padding-top: 1.5rem;
  }

  .bean-story-headline {
    font-family: var(--font-heading-family);
    font-size: clamp(3rem, 5vw, 4.8rem);
    font-weight: 900;
    line-height: 1.1;
    margin: 0 0 2.5rem 0;
    text-transform: uppercase;
    background: linear-gradient(135deg, #ffffff 0%, #C6A969 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -0.02em;
  }

  .bean-story-body {
    font-family: 'Poppins', sans-serif;
    font-size: 1.8rem;
    line-height: 1.7;
    color: rgba(245, 245, 245, 0.85);
    margin-bottom: 3.5rem;
    max-width: 540px;
    margin-left: auto;
    margin-right: auto;
  }

  .bean-story-body p {
    margin: 0 0 2rem 0;
  }

  .bean-story-body p:last-child {
    margin-bottom: 0;
  }

  .bean-story-email-card {
    background: rgba(198, 169, 105, 0.06);
    border: 1px solid rgba(198, 169, 105, 0.2);
    border-radius: 2rem;
    padding: 3rem;
    margin: 4rem auto;
    max-width: 480px;
    position: relative;
    overflow: hidden;
    transition: all 0.35s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .bean-story-email-card:hover {
    background: rgba(198, 169, 105, 0.1);
    border-color: rgba(198, 169, 105, 0.4);
    transform: translateY(-0.3rem);
    box-shadow: 0 1.5rem 3.5rem rgba(0, 0, 0, 0.3);
  }

  .bean-story-email-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, #C6A969, transparent);
  }

  .bean-story-email-label {
    display: block;
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #C6A969;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .bean-story-email-link {
    font-family: var(--font-heading-family);
    font-size: clamp(1.4rem, 4.8vw, 2.8rem);
    font-weight: 700;
    color: #ffffff;
    text-decoration: none;
    transition: color 0.3s ease;
    display: inline-block;
    word-break: break-all;
    max-width: 100%;
    text-align: center;
    line-height: 1.2;
  }

  .bean-story-email-link:hover {
    color: #C6A969;
  }

  .bean-story-brief {
    font-family: var(--font-heading-family);
    font-size: 2.2rem;
    font-weight: 800;
    color: #ffffff;
    margin: 3.5rem 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .bean-story-brief span {
    color: #C6A969;
  }

  .bean-story-fineprint {
    font-family: 'Poppins', sans-serif;
    font-size: 1.2rem;
    line-height: 1.6;
    color: rgba(245, 245, 245, 0.45);
    border-top: 1px solid rgba(245, 245, 245, 0.08);
    padding-top: 2.5rem;
    margin-top: 4rem;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  .bean-story-copy-btn {
    background: transparent;
    border: 1px solid rgba(245, 245, 245, 0.2);
    color: rgba(245, 245, 245, 0.7);
    padding: 0.6rem 1.2rem;
    border-radius: 0.8rem;
    font-size: 1.1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    margin-top: 1.2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .bean-story-copy-btn:hover {
    border-color: #C6A969;
    color: #ffffff;
    background: rgba(198, 169, 105, 0.1);
  }

  /* Mobile optimization for stories contact modal */
  @media screen and (max-width: 749px) {
    .bean-story-email-card {
      padding: 2rem 1.5rem;
      margin: 2.5rem auto;
      border-radius: 1.6rem;
    }
    .bean-story-headline {
      margin-bottom: 2rem;
    }
    .bean-story-body {
      font-size: 1.5rem;
      line-height: 1.6;
      margin-bottom: 2.5rem;
    }
    .bean-story-brief {
      font-size: 1.8rem;
      margin: 2.5rem 0;
    }
    .bean-story-fineprint {
      margin-top: 2.5rem;
      padding-top: 2rem;
    }
  }

  /* Premium Single Story Displayer Styling */
  .beanagram-displayer-wrapper {
    max-width: 960px;
    margin: 4rem auto;
    position: relative;
    padding: 0 1rem;
    z-index: 10;
  }

  /* Autoplay progress bar at top of card */
  .beanagram-progress-indicator {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 2.4rem;
    padding: 0 1rem;
  }

  .beanagram-progress-segment {
    flex: 1;
    height: 4px;
    background: rgba(245, 245, 245, 0.12);
    border-radius: 2px;
    overflow: hidden;
    position: relative;
  }

  .beanagram-progress-fill {
    height: 100%;
    width: 0%;
    background: var(--active-accent, #C6A969);
    transition: width 0.05s linear;
  }

  .beanagram-progress-segment.completed .beanagram-progress-fill {
    width: 100%;
  }

  .beanagram-displayer-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3rem;
  }

  /* Nav Buttons */
  .beanagram-nav-btn {
    width: 5.6rem;
    height: 5.6rem;
    border-radius: 50%;
    background: rgba(245, 245, 245, 0.05);
    border: 1px solid rgba(245, 245, 245, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    color: #f5f5f5;
    flex-shrink: 0;
  }

  .beanagram-nav-btn:hover {
    background: var(--active-accent, #C6A969);
    border-color: var(--active-accent, #C6A969);
    color: #000;
    transform: scale(1.1);
    box-shadow: 0 0.8rem 2.4rem rgba(var(--active-accent-rgb, 198, 169, 105), 0.25);
  }

  /* Active Story Card Display Frame */
  .beanagram-active-card-frame {
    flex-grow: 1;
    min-height: 48rem;
    background: rgba(245, 245, 245, 0.02);
    border: 1px solid rgba(245, 245, 245, 0.08);
    border-radius: 3.2rem;
    box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.3);
    overflow: hidden;
    position: relative;
    /* Soft glowing backdrop that transitions color */
    background:
      linear-gradient(135deg, rgba(var(--active-accent-rgb, 198, 169, 105), 0.06), transparent 45%),
      rgba(255, 255, 255, 0.02);
    transition: background 0.5s ease;
  }

  /* Single card details layout */
  .beanagram-single-card {
    display: flex;
    min-height: 48rem;
    width: 100%;
    animation: storyEnter 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes storyEnter {
    0% { opacity: 0; transform: translateY(1.5rem); }
    100% { opacity: 1; transform: translateY(0); }
  }

  .beanagram-single-card__text {
    flex: 1 1 50%;
    padding: 4.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-align: left;
    border-right: 1px solid rgba(245, 245, 245, 0.06);
    position: relative;
  }

  .testimonial-quote-icon {
    font-size: 10rem;
    font-family: Georgia, serif;
    position: absolute;
    top: 2rem;
    right: 3rem;
    color: rgba(var(--active-accent-rgb, 198, 169, 105), 0.08);
    user-select: none;
    line-height: 1;
  }

  .beanagram-single-card__media {
    flex: 1 1 50%;
    position: relative;
    background: rgba(18, 18, 18, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3.5rem;
    overflow: hidden;
  }

  /* Image Slide style */
  .beanagram-media-slider {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .beanagram-media-slider img {
    position: absolute;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 2rem;
    border: 2px solid rgba(var(--active-accent-rgb, 198, 169, 105), 0.35);
    box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.45);
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .beanagram-media-slider img.active {
    opacity: 1;
  }

  .beanagram-media-video {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .beanagram-media-video video {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 2rem;
    border: 2px solid rgba(var(--active-accent-rgb, 198, 169, 105), 0.35);
    box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.45);
    background: #000;
  }

  /* Custom navigation dots for multiple images inside a slide */
  .slider-dots {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.8rem;
    z-index: 5;
  }

  .slider-dot {
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .slider-dot.active {
    background: #fff;
    transform: scale(1.25);
  }

  /* Gallery layout when both images and video are present */
  .beanagram-media-gallery {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
    width: 100%;
    height: 100%;
    justify-content: space-between;
  }

  .beanagram-media-gallery .beanagram-media-video {
    height: 62%;
    width: 100%;
  }

  .beanagram-media-gallery .beanagram-media-video video {
    border-radius: 1.4rem;
  }

  .beanagram-media-gallery .beanagram-media-slider {
    height: 34%;
    width: 100%;
  }

  .beanagram-media-gallery .beanagram-media-slider img {
    border-radius: 1.4rem;
  }

  .beanagram-media-gallery .slider-dots {
    bottom: 0.8rem;
  }

  /* Mobile Responsive Stacking */
  @media screen and (max-width: 768px) {
    .beanagram-displayer-content {
      flex-direction: column;
      gap: 2rem;
    }
    
    .beanagram-nav-btn {
      display: none; /* Hide desktop nav buttons on mobile */
    }
    
    .beanagram-single-card {
      flex-direction: column;
      min-height: auto;
    }

    .beanagram-single-card__media {
      flex: none;
      width: 100%;
      aspect-ratio: 16 / 10;
      border-bottom: 1px solid rgba(245, 245, 245, 0.06);
    }

    .beanagram-single-card__media.has-gallery {
      aspect-ratio: auto;
      height: 38rem;
    }
    
    .beanagram-single-card__text {
      flex: none;
      padding: 3rem;
      border-right: none;
    }

    /* Floating navigation overlays for mobile tap control */
    .mobile-tap-overlay {
      position: absolute;
      top: 0;
      bottom: 0;
      width: 50%;
      z-index: 8;
      cursor: pointer;
    }
    .mobile-tap-overlay.left {
      left: 0;
    }
    .mobile-tap-overlay.right {
      right: 0;
    }
  }
{%- endstyle -%}

<div id="Beanagram-{{ section.id }}" class="beanagram-stories">
  <div class="beanagram-header">
    <h2 class="beanagram-title">{{ section.settings.title }}</h2>
    <p class="beanagram-subtitle">{{ section.settings.subtitle }}</p>
  </div>

  <!-- Single Story Displayer (JS-enabled slideshow) -->
  <div class="beanagram-displayer-wrapper" style="display: none;">
    <div class="beanagram-progress-indicator" id="beanagram-progress-indicator"></div>
    <div class="beanagram-displayer-content">
      <button type="button" class="beanagram-nav-btn prev" id="beanagram-prev-btn" aria-label="Previous Story">
        <svg viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
      </button>
      <div class="beanagram-active-card-frame" id="beanagram-active-card-frame"></div>
      <button type="button" class="beanagram-nav-btn next" id="beanagram-next-btn" aria-label="Next Story">
        <svg viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
      </button>
    </div>
  </div>

  <!-- Fallback static track (shown on load, hidden by JS) -->
  <div class="beanagram-track" id="beanagram-static-track">
    {%- for block in section.blocks -%}
      {%- liquid
        assign bean_color = '#121212'
        case block.settings.bean_type
          when 'coffee'
            assign bean_color = '#A67C52'
          when 'chilli'
            assign bean_color = '#D32F2F'
          when 'vanilla'
            assign bean_color = '#FFF9C4'
          when 'jelly'
            assign bean_color = '#F06292'
          when 'green'
            assign bean_color = '#388E3C'
        endcase
      -%}
      <div class="beanagram-card" style="--bean-accent: {{ bean_color }};" {{ block.shopify_attributes }}>
        <div class="beanagram-card__header">
          <div class="beanagram-card__avatar">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 100 | image_tag: loading: 'lazy' }}
            {%- else -%}
              <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; background:#eee;">
                <svg class="beanagram-card__icon" viewBox="0 0 24 24">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/>
                </svg>
              </div>
            {%- endif -%}
          </div>
          <div class="beanagram-card__user-info">
            <span class="beanagram-card__handle">@{{ block.settings.handle }}</span>
            <span class="beanagram-card__bean-badge">{{ block.settings.bean_type }} Bean</span>
          </div>
        </div>
        <p class="beanagram-card__story">"{{ block.settings.story }}"</p>
        <div class="beanagram-card__footer">
          <svg class="beanagram-card__icon" viewBox="0 0 24 24">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
          Authenticated Identity
        </div>
      </div>
    {%- endfor -%}
  </div>

  <div class="beanagram-cta-wrapper">
    <button type="button" class="beanagram-cta" id="open-story-modal">{{ section.settings.cta_label }}</button>
  </div>
</div>

<!-- Stories Submission Modal Overlay -->
<div id="story-modal" class="story-modal-overlay">
  <div class="story-modal-container">
    <button type="button" class="story-modal-close" id="close-story-modal">&times;</button>

    <!-- NEW GORGEOUS BEAN STORY CONTENT - COMMENTED OUT AS FORM IS ACTIVE -->
    {% comment %}
    <div class="bean-story-modal-content">
      <h3 class="bean-story-headline">What's your bean story?</h3>

      <div class="bean-story-body">
        <p>Every bean has a story. And we want to hear yours.</p>
        <p>Tell us which bean you are? And what made you so sure.</p>
        <p>And the best ones will make it to our wall.</p>
      </div>

      <div class="bean-story-email-card">
        <span class="bean-story-email-label">Write to us at</span>
        <a href="mailto:Support@beanidentity.com" class="bean-story-email-link">Support@beanidentity.com</a>
        <br>
        <button type="button" class="bean-story-copy-btn" id="copy-email-btn">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span>Copy Email</span>
        </button>
      </div>

      <div class="bean-story-brief">Keep it real. Keep it you. <span>That's the only brief.</span></div>

      <p class="bean-story-fineprint">
        Selected stories will be featured on the Bean Identity website and <br>
        social media.<br>
        By writing to us you give us permission to share your story.<br>
        We'll always credit you :)
      </p>
    </div>
    {% endcomment %}

    <!-- ORIGINAL BACKEND INTEGRATION FORM - RESTORED -->
    <div class="story-modal-form-wrapper">
      <h3 class="story-modal-title">SHARE YOUR BEAN STORY</h3>
      <p class="story-modal-subtitle">
        Meet the real people wearing their true identities. Show the world who you are.
      </p>

      <form id="story-submission-form" class="story-form-scroll" enctype="multipart/form-data">
        <div class="form-row">
          <div class="form-group">
            <label for="story-name">FULL NAME *</label>
            <input type="text" id="story-name" name="name" required placeholder="Enter your full name">
          </div>
          <div class="form-group">
            <label for="story-email">EMAIL ADDRESS *</label>
            <input type="email" id="story-email" name="email" required placeholder="Enter your email">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="story-handle">INSTAGRAM HANDLE <span class="label-optional">(OPTIONAL)</span></label>
            <input type="text" id="story-handle" name="handle" placeholder="e.g. alex_driven">
          </div>
          <div class="form-group">
            <label>WHICH BEAN ARE YOU? *</label>
            <div class="bean-pills-container">
              <label class="bean-pill-label coffee">
                <input type="radio" name="beanType" value="coffee" checked>
                <span>Coffee</span>
              </label>
              <label class="bean-pill-label chilli">
                <input type="radio" name="beanType" value="chilli">
                <span>Chilli</span>
              </label>
              <label class="bean-pill-label vanilla">
                <input type="radio" name="beanType" value="vanilla">
                <span>Vanilla</span>
              </label>
              <label class="bean-pill-label jelly">
                <input type="radio" name="beanType" value="jelly">
                <span>Jelly</span>
              </label>
              <label class="bean-pill-label green">
                <input type="radio" name="beanType" value="green">
                <span>Green</span>
              </label>
            </div>
          </div>
        </div>

        <div class="form-group">
          <div class="label-wrapper">
            <label for="story-text">YOUR STORY *</label>
            <span id="word-counter" class="word-counter">0 / 150 words</span>
          </div>
          <textarea
            id="story-text"
            name="story"
            required
            placeholder="Describe how your bean identity changed how you express yourself every day..."
            rows="4"
          ></textarea>
        </div>

        <!-- Media Upload Zone -->
        <div class="form-row media-upload-row">
          <div class="form-group">
            <label>UPLOAD PHOTOS <span class="label-optional">(UP TO 3, OPTIONAL)</span></label>
