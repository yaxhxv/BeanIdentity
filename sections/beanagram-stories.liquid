              <input type="file" id="story-images-input" accept="image/*" multiple style="display:none;">
              <div class="dropzone-prompt">
                <svg viewBox="0 0 24 24">
                  <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                </svg>
                <span>Add Photos</span>
              </div>
            </div>
            <div class="media-previews-container" id="images-previews"></div>
          </div>

          <div class="form-group">
            <label>UPLOAD VIDEO <span class="label-optional">(1 VIDEO, OPTIONAL)</span></label>
            <div class="media-dropzone" id="video-dropzone">
              <input type="file" id="story-video-input" accept="video/*" style="display:none;">
              <div class="dropzone-prompt" id="video-dropzone-prompt">
                <svg viewBox="0 0 24 24">
                  <path d="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4zM14 16H5V8h9v8z"/>
                </svg>
                <span>Add Video</span>
              </div>
            </div>
            <div class="media-previews-container" id="video-preview"></div>
          </div>
        </div>

        <button type="submit" class="story-submit-btn" id="story-submit-button">SUBMIT STORY</button>
      </form>

      <!-- Upload Progress Bar -->
      <div id="story-upload-progress" class="upload-progress-container" style="display:none;">
        <div class="progress-bar-wrapper">
          <div class="progress-bar-fill" id="progress-bar-fill"></div>
        </div>
        <p class="progress-text" id="progress-text">Uploading your story & media...</p>
      </div>

      <!-- Success Overlay -->
      <div id="story-success-message" class="story-success-overlay" style="display:none;">
        <div class="success-icon-wrapper">
          <svg viewBox="0 0 24 24">
            <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
          </svg>
        </div>
        <h4>STORY RECEIVED!</h4>
        <p>
          Thank you for sharing your true identity. Once our team approves your story, it will appear dynamically on our
          homepage queue!
        </p>
        <button type="button" class="story-success-close-btn" id="close-success-modal">CLOSE</button>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const BACKEND_URL = window.beanBackendUrl || 'https://beanidentitybackend.onrender.com';

    // Elements
    const openModalBtn = document.getElementById('open-story-modal');
    const closeModalBtn = document.getElementById('close-story-modal');
    const modalOverlay = document.getElementById('story-modal');
    const storyForm = document.getElementById('story-submission-form');
    const textarea = document.getElementById('story-text');
    const wordCounter = document.getElementById('word-counter');
    const submitBtn = document.getElementById('story-submit-button');
    const progressContainer = document.getElementById('story-upload-progress');
    const progressFill = document.getElementById('progress-bar-fill');
    const successOverlay = document.getElementById('story-success-message');
    const successCloseBtn = document.getElementById('close-success-modal');

    // Media Elements
    const imagesDropzone = document.getElementById('images-dropzone');
    const imagesInput = document.getElementById('story-images-input');
    const imagesPreviews = document.getElementById('images-previews');

    const videoDropzone = document.getElementById('video-dropzone');
    const videoInput = document.getElementById('story-video-input');
    const videoPreview = document.getElementById('video-preview');
    const videoPrompt = document.getElementById('video-dropzone-prompt');

    // State (Commented out backend form state variables to prevent unused vars warning, but preserved)
    let selectedImages = [];
    let selectedVideo = null;

    // 1. OPEN / CLOSE MODAL
    if (openModalBtn) {
      openModalBtn.addEventListener('click', (e) => {
        e.preventDefault();
        modalOverlay.classList.add('open');
        document.body.style.overflow = 'hidden';
      });
    }

    const closeModal = () => {
      modalOverlay.classList.remove('open');
      document.body.style.overflow = '';
      resetForm(); // Commented out to avoid errors since form is disabled
    };

    if (closeModalBtn) closeModalBtn.addEventListener('click', closeModal);

    modalOverlay.addEventListener('click', (e) => {
      if (e.target === modalOverlay) closeModal();
    });

    if (successCloseBtn) successCloseBtn.addEventListener('click', closeModal);

    // Interactive copy email to clipboard logic
    const copyBtn = document.getElementById('copy-email-btn');
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        navigator.clipboard
          .writeText('Support@beanidentity.com')
          .then(() => {
            const btnText = copyBtn.querySelector('span');
            if (btnText) {
              const originalText = btnText.textContent;
              btnText.textContent = 'Copied!';
              copyBtn.style.borderColor = '#388E3C';
              copyBtn.style.color = '#388E3C';
              setTimeout(() => {
                btnText.textContent = originalText;
                copyBtn.style.borderColor = '';
                copyBtn.style.color = '';
              }, 2000);
            }
          })
          .catch((err) => {
            console.error('Failed to copy text: ', err);
          });
      });
    }

    // 2. DYNAMIC THEME ACCENTS BASED ON RADIO SELECTION
    const accentColors = {
      coffee: { hex: '#A67C52', rgb: '166, 124, 82' },
      chilli: { hex: '#D32F2F', rgb: '211, 47, 47' },
      vanilla: { hex: '#FFF9C4', rgb: '255, 249, 196' },
      jelly: { hex: '#F06292', rgb: '240, 98, 146' },
      green: { hex: '#388E3C', rgb: '56, 142, 60' },
    };

    const updateThemeAccent = (beanType) => {
      const accent = accentColors[beanType] || accentColors.coffee;
      document.documentElement.style.setProperty('--active-accent', accent.hex);
      document.documentElement.style.setProperty('--active-accent-rgb', accent.rgb);
    };

    document.querySelectorAll('input[name="beanType"]').forEach((radio) => {
      radio.addEventListener('change', (e) => {
        updateThemeAccent(e.target.value);
      });
    });

    // 3. WORD COUNT VALIDATION
    const maxWords = 150;
    textarea.addEventListener('input', () => {
      const text = textarea.value.trim();
      const words = text === '' ? 0 : text.split(/\s+/).length;
      wordCounter.textContent = `${words} / ${maxWords} words`;

      if (words > maxWords) {
        wordCounter.classList.add('limit-exceeded');
        submitBtn.disabled = true;
      } else {
        wordCounter.classList.remove('limit-exceeded');
        submitBtn.disabled = false;
      }
    });

    // 4. IMAGE UPLOAD INTERACTION & PREVIEWS
    imagesDropzone.addEventListener('click', () => imagesInput.click());

    imagesInput.addEventListener('change', (e) => {
      const files = Array.from(e.target.files);

      // Max 3 images validation
      files.forEach((file) => {
        if (selectedImages.length < 3 && !selectedImages.some((f) => f.name === file.name)) {
          selectedImages.push(file);
        }
      });

      renderImagePreviews();
      imagesInput.value = ''; // Reset files input
    });

    const renderImagePreviews = () => {
      imagesPreviews.innerHTML = '';
      selectedImages.forEach((file, index) => {
        const reader = new FileReader();
        reader.onload = (e) => {
          const item = document.createElement('div');
          item.className = 'preview-item';
          item.innerHTML = `
          <img src="${e.target.result}" alt="Apparel Wearer preview">
          <button type="button" class="preview-remove-btn" data-index="${index}">&times;</button>
        `;
          imagesPreviews.appendChild(item);

          // Remove button handler
          item.querySelector('.preview-remove-btn').addEventListener('click', (e) => {
            const idx = parseInt(e.target.getAttribute('data-index'));
            selectedImages.splice(idx, 1);
            renderImagePreviews();
          });
        };
        reader.readAsDataURL(file);
      });

      if (selectedImages.length >= 3) {
        imagesDropzone.style.opacity = '0.5';
        imagesDropzone.style.pointerEvents = 'none';
      } else {
        imagesDropzone.style.opacity = '1';
        imagesDropzone.style.pointerEvents = 'auto';
      }
    };

    // 5. VIDEO UPLOAD INTERACTION & PREVIEWS
    videoDropzone.addEventListener('click', () => videoInput.click());

    videoInput.addEventListener('change', (e) => {
      if (e.target.files.length > 0) {
        selectedVideo = e.target.files[0];
        renderVideoPreview();
      }
      videoInput.value = '';
    });

    const renderVideoPreview = () => {
      videoPreview.innerHTML = '';
      if (selectedVideo) {
        const reader = new FileReader();
        reader.onload = (e) => {
          const item = document.createElement('div');
          item.className = 'preview-item';
          item.style.width = '100%';
          item.style.height = '120px';
          item.innerHTML = `
          <video src="${e.target.result}" muted playsinline></video>
          <button type="button" class="preview-remove-btn">&times;</button>
        `;
          videoPreview.appendChild(item);

          videoPrompt.style.display = 'none';
          videoDropzone.style.pointerEvents = 'none';

          item.querySelector('.preview-remove-btn').addEventListener('click', () => {
            selectedVideo = null;
            videoPreview.innerHTML = '';
            videoPrompt.style.display = 'flex';
            videoDropzone.style.pointerEvents = 'auto';
          });
        };
        reader.readAsDataURL(selectedVideo);
      }
    };

    // 6. FORM SUBMISSION VIA FETCH & PROGRESS ANIMATION
    storyForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      submitBtn.disabled = true;
      storyForm.style.display = 'none';
      progressContainer.style.display = 'block';

      // Simulate uploading progress
      let progress = 0;
      const progressInterval = setInterval(() => {
        progress += (100 - progress) * 0.15; // Asymptotic approach to 98%
        if (progress > 95) progress = 95;
        progressFill.style.width = `${progress}%`;
      }, 200);

      // Build FormData
      const formData = new FormData(storyForm);

      // Clear and append actual verified media items
      formData.delete('images');
      selectedImages.forEach((file) => {
        formData.append('images', file);
      });

      formData.delete('video');
      if (selectedVideo) {
        formData.append('video', selectedVideo);
      }

      try {
        const response = await fetch(`${BACKEND_URL}/api/stories/submit`, {
          method: 'POST',
          body: formData,
        });

        const result = await response.json();
        clearInterval(progressInterval);

        if (response.ok) {
          progressFill.style.width = '100%';
          setTimeout(() => {
            progressContainer.style.display = 'none';
            successOverlay.style.display = 'flex';
          }, 300);
        } else {
          alert(result.error || 'Failed to submit story. Please try again.');
          clearInterval(progressInterval);
          submitBtn.disabled = false;
          progressContainer.style.display = 'none';
          storyForm.style.display = 'flex';
        }
      } catch (err) {
        console.error(err);
        clearInterval(progressInterval);
        alert('Unable to connect to the stories service. Please ensure the backend is running.');
        submitBtn.disabled = false;
        progressContainer.style.display = 'none';
        storyForm.style.display = 'flex';
      }
    });

    const resetForm = () => {
      storyForm.reset();
      storyForm.style.display = 'flex';
      progressContainer.style.display = 'none';
      successOverlay.style.display = 'none';
      progressFill.style.width = '0%';

      selectedImages = [];
      selectedVideo = null;
      imagesPreviews.innerHTML = '';
      videoPreview.innerHTML = '';
      videoPrompt.style.display = 'flex';

      imagesDropzone.style.opacity = '1';
      imagesDropzone.style.pointerEvents = 'auto';
      videoDropzone.style.pointerEvents = 'auto';

      wordCounter.textContent = '0 / 150 words';
      wordCounter.classList.remove('limit-exceeded');
      submitBtn.disabled = false;

      updateThemeAccent('coffee');
    };

    // 7. DYNAMIC STORIES QUEUE LOADER (SINGLE CARD AUTOPLAY SYSTEM)
    const getBeanBadgeColor = (type) => {
      const colors = {
        coffee: '#A67C52',
        chilli: '#D32F2F',
        vanilla: '#FFF9C4',
        jelly: '#F06292',
        green: '#388E3C',
      };
      return colors[type] || '#A67C52';
    };

    const getBeanBadgeColorRGB = (type) => {
      const colors = {
        coffee: '166, 124, 82',
        chilli: '211, 47, 47',
        vanilla: '255, 249, 196',
        jelly: '240, 98, 146',
        green: '56, 142, 60',
      };
      return colors[type] || '166, 124, 82';
    };

    const getFullMediaUrl = (url) => {
      if (!url) return '';
      if (url.startsWith('http') || url.startsWith('//')) {
        return url;
      }
      return `${BACKEND_URL}${url}`;
    };

    // State Variables
    let currentStories = [];
    let currentStoryIndex = 0;
    let progressInterval = null;
    let currentProgress = 0;
    const progressDuration = 8000; // 8 seconds for static slides
    const tickRate = 50; // Update progress every 50ms
    let isStoryHovered = false;

    // Elements
    const staticTrack = document.getElementById('beanagram-static-track');
    const displayerWrapper = document.querySelector('.beanagram-displayer-wrapper');
    const displayerFrame = document.getElementById('beanagram-active-card-frame');
    const prevBtn = document.getElementById('beanagram-prev-btn');
    const nextBtn = document.getElementById('beanagram-next-btn');
    const progressIndicator = document.getElementById('beanagram-progress-indicator');

    const loadApprovedStories = async () => {
      try {
        const response = await fetch(`${BACKEND_URL}/api/stories/approved`);
        if (response.ok) {
          const apiStories = await response.json();
          if (apiStories && apiStories.length > 0) {
            currentStories = apiStories;
          }
        }
      } catch (err) {
        console.warn('Could not load stories from backend, using DOM fallback...', err);
      }

      // Fallback: If currentStories is empty, parse from static Liquid cards
      if (currentStories.length === 0 && staticTrack) {
        const cards = staticTrack.querySelectorAll('.beanagram-card');
        cards.forEach(card => {
          const handleEl = card.querySelector('.beanagram-card__handle');
          const badgeEl = card.querySelector('.beanagram-card__bean-badge');
          const storyEl = card.querySelector('.beanagram-card__story');
          const avatarImg = card.querySelector('.beanagram-card__avatar img');

          // Extract beanType from badge text
          let beanType = 'coffee';
          if (badgeEl) {
            const txt = badgeEl.textContent.toLowerCase();
            if (txt.includes('chilli')) beanType = 'chilli';
            else if (txt.includes('vanilla')) beanType = 'vanilla';
            else if (txt.includes('jelly')) beanType = 'jelly';
            else if (txt.includes('green')) beanType = 'green';
          }

          // Extract images
          const images = [];
          if (avatarImg) images.push(avatarImg.getAttribute('src'));

          // Check if there are other images
          const blockImgs = card.querySelectorAll('.story-card-images img');
          blockImgs.forEach(img => images.push(img.getAttribute('src')));

          // Check if video exists
          const videoEl = card.querySelector('.story-card-video video');
          const videoUrl = videoEl ? videoEl.getAttribute('src') : '';

          currentStories.push({
            name: handleEl ? handleEl.textContent.replace('@', '') : 'Member',
            handle: handleEl ? handleEl.textContent.replace('@', '') : 'username',
            beanType: beanType,
            story: storyEl ? storyEl.textContent.replace(/^"|"$/g, '') : '',
            media: {
              images: images,
              video: videoUrl
            }
          });
        });
      }

      if (currentStories.length > 0) {
        // Initialize single-story view
        if (staticTrack) staticTrack.style.display = 'none';
        if (displayerWrapper) displayerWrapper.style.display = 'block';

        initProgressIndicator();
        renderActiveStory();
        initStoryListeners();
      }
    };

    const initProgressIndicator = () => {
      if (!progressIndicator) return;
      progressIndicator.innerHTML = '';
      currentStories.forEach((_, idx) => {
        const segment = document.createElement('div');
        segment.className = 'beanagram-progress-segment';
        segment.innerHTML = `<div class="beanagram-progress-fill" id="progress-fill-${idx}"></div>`;
        progressIndicator.appendChild(segment);
      });
    };

    const updateProgressBars = () => {
      if (!progressIndicator) return;
      currentStories.forEach((_, idx) => {
        const fill = document.getElementById(`progress-fill-${idx}`);
        const segment = fill.parentElement;
        if (!fill) return;

        if (idx < currentStoryIndex) {
          fill.style.width = '100%';
          segment.classList.add('completed');
        } else if (idx > currentStoryIndex) {
          fill.style.width = '0%';
          segment.classList.remove('completed');
        } else {
          fill.style.width = `${currentProgress}%`;
          segment.classList.remove('completed');
        }
      });
    };

    const renderActiveStory = () => {
      if (currentStories.length === 0 || !displayerFrame) return;

      const story = currentStories[currentStoryIndex];
      const beanColor = getBeanBadgeColor(story.beanType);
      const beanColorRGB = getBeanBadgeColorRGB(story.beanType);

      // Set active accent variables
      document.documentElement.style.setProperty('--active-accent', beanColor);
      document.documentElement.style.setProperty('--active-accent-rgb', beanColorRGB);

      // Reset timers
      clearInterval(progressInterval);
      currentProgress = 0;

      // Handle media rendering
      let mediaHtml = '';
      let isVideo = false;

      const hasVideo = !!story.media.video;
      const hasImages = story.media.images && story.media.images.length > 0;

      if (hasVideo && hasImages) {
        isVideo = true;
        mediaHtml = `
          <div class="beanagram-media-gallery">
            <div class="beanagram-media-video">
              <video id="story-video-player" src="${getFullMediaUrl(story.media.video)}" autoplay muted playsinline></video>
            </div>
            <div class="beanagram-media-slider" id="story-image-slider">
              ${story.media.images.map((img, i) => `
                <img src="${getFullMediaUrl(img)}" class="${i === 0 ? 'active' : ''}" data-idx="${i}" alt="Story media ${i + 1}">
              `).join('')}
              ${story.media.images.length > 1 ? `
                <div class="slider-dots">
                  ${story.media.images.map((_, i) => `
                    <span class="slider-dot ${i === 0 ? 'active' : ''}" data-idx="${i}"></span>
                  `).join('')}
                </div>
              ` : ''}
            </div>
          </div>
        `;
      } else if (hasVideo) {
        isVideo = true;
        mediaHtml = `
          <div class="beanagram-media-video">
            <video id="story-video-player" src="${getFullMediaUrl(story.media.video)}" autoplay muted playsinline></video>
          </div>
        `;
      } else if (hasImages) {
        mediaHtml = `
          <div class="beanagram-media-slider" id="story-image-slider">
            ${story.media.images.map((img, i) => `
              <img src="${getFullMediaUrl(img)}" class="${i === 0 ? 'active' : ''}" data-idx="${i}" alt="Story media ${i + 1}">
            `).join('')}
            ${story.media.images.length > 1 ? `
              <div class="slider-dots">
                ${story.media.images.map((_, i) => `
                  <span class="slider-dot ${i === 0 ? 'active' : ''}" data-idx="${i}"></span>
                `).join('')}
              </div>
            ` : ''}
          </div>
        `;
      } else {
        // Fallback placeholder image
        mediaHtml = `
          <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #111;">
            <svg class="beanagram-card__icon" viewBox="0 0 24 24" style="width: 6rem; height: 6rem; fill: ${beanColor};">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/>
            </svg>
          </div>
        `;
      }

      const handleLabel = story.handle ? `@${story.handle}` : story.name;

      displayerFrame.innerHTML = `
        <div class="beanagram-single-card" style="--bean-accent: ${beanColor};">
          <!-- Mobile Tap Overlays -->
          <div class="mobile-tap-overlay left" id="mobile-tap-left"></div>
          <div class="mobile-tap-overlay right" id="mobile-tap-right"></div>

          <div class="beanagram-single-card__text">
            <div class="testimonial-quote-icon">“</div>
            <div>
              <div class="beanagram-card__header">
                <div class="beanagram-card__avatar" style="border-color: ${beanColor};">
                  ${
                    story.media.images && story.media.images.length > 0
                      ? `<img src="${getFullMediaUrl(story.media.images[0])}" alt="${story.name}">`
                      : `<svg class="beanagram-card__icon" viewBox="0 0 24 24" style="fill: ${beanColor};"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/></svg>`
                  }
                </div>
                <div class="beanagram-card__user-info">
                  <span class="beanagram-card__handle">${handleLabel}</span>
                  <span class="beanagram-card__bean-badge" style="color: ${beanColor};">${story.beanType} Bean</span>
                </div>
              </div>
              <p class="beanagram-card__story">"${story.story}"</p>
            </div>

            <div class="beanagram-card__footer">
              <svg class="beanagram-card__icon" viewBox="0 0 24 24" style="fill: ${beanColor};">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
              </svg>
              Authenticated Identity
            </div>
          </div>

          <div class="beanagram-single-card__media ${hasVideo && hasImages ? 'has-gallery' : ''}">
            ${mediaHtml}
          </div>
        </div>
      `;

      // Set up mobile tap controls
      const tapLeft = document.getElementById('mobile-tap-left');
      const tapRight = document.getElementById('mobile-tap-right');
      if (tapLeft) tapLeft.addEventListener('click', prevStory);
      if (tapRight) tapRight.addEventListener('click', nextStory);

      // Multiple Images Slideshow logic inside the slide
      if (story.media.images && story.media.images.length > 1) {
        initImageSlider();
      }

      // Autoplay / Video management
      if (isVideo) {
        const video = document.getElementById('story-video-player');
        if (video) {
          video.addEventListener('loadedmetadata', () => {
            // Video drives the progress
            startVideoProgressTracker(video);
          });
          video.addEventListener('ended', () => {
            nextStory();
          });
          // Handle play failures (browser restrictions)
          video.play().catch(e => {
            console.warn('Autoplay prevented, fallback to standard timer', e);
            startStaticProgressTracker();
          });
        }
      } else {
        startStaticProgressTracker();
      }
    };

    const startStaticProgressTracker = () => {
      clearInterval(progressInterval);
      const totalSteps = progressDuration / tickRate;
      let steps = 0;

      progressInterval = setInterval(() => {
        if (isStoryHovered) return; // Pause on hover

        steps++;
        currentProgress = (steps / totalSteps) * 100;
        updateProgressBars();

        if (steps >= totalSteps) {
          clearInterval(progressInterval);
          nextStory();
        }
      }, tickRate);
    };

    const startVideoProgressTracker = (video) => {
      clearInterval(progressInterval);
      progressInterval = setInterval(() => {
        if (isStoryHovered) {
          if (!video.paused) video.pause();
          return; // Pause on hover
        } else {
          if (video.paused) video.play().catch(() => {});
        }

        if (video.duration) {
          currentProgress = (video.currentTime / video.duration) * 100;
          updateProgressBars();
        }
      }, tickRate);
    };

    const initImageSlider = () => {
      const slider = document.getElementById('story-image-slider');
      const imgs = slider.querySelectorAll('img');
      const dots = slider.querySelectorAll('.slider-dot');
      let imgIdx = 0;
      let imgInterval = null;

      const rotateImages = () => {
        if (isStoryHovered) return; // Pause on hover
        imgs[imgIdx].classList.remove('active');
        dots[imgIdx].classList.remove('active');
        imgIdx = (imgIdx + 1) % imgs.length;
        imgs[imgIdx].classList.add('active');
        dots[imgIdx].classList.add('active');
      };

      // Cycle images inside the slide
      const cycleDuration = progressDuration / imgs.length;
      imgInterval = setInterval(rotateImages, cycleDuration);

      // Store interval on the slider element
      slider.dataset.intervalId = imgInterval;

      dots.forEach(dot => {
        dot.addEventListener('click', (e) => {
          e.stopPropagation();
          clearInterval(imgInterval);
          const targetIdx = parseInt(dot.getAttribute('data-idx'));
          imgs[imgIdx].classList.remove('active');
          dots[imgIdx].classList.remove('active');
          imgIdx = targetIdx;
          imgs[imgIdx].classList.add('active');
          dots[imgIdx].classList.add('active');
        });
      });
    };

    const nextStory = () => {
      cleanupActiveMedia();
      currentStoryIndex = (currentStoryIndex + 1) % currentStories.length;
      renderActiveStory();
    };

    const prevStory = () => {
      cleanupActiveMedia();
      currentStoryIndex = (currentStoryIndex - 1 + currentStories.length) % currentStories.length;
      renderActiveStory();
    };

    const cleanupActiveMedia = () => {
      clearInterval(progressInterval);
      const slider = document.getElementById('story-image-slider');
      if (slider && slider.dataset.intervalId) {
        clearInterval(parseInt(slider.dataset.intervalId));
      }
      const video = document.getElementById('story-video-player');
      if (video) {
        video.pause();
      }
    };

    const initStoryListeners = () => {
      if (prevBtn) prevBtn.addEventListener('click', prevStory);
      if (nextBtn) nextBtn.addEventListener('click', nextStory);

      if (displayerFrame) {
        // Pause on mouseenter
        displayerFrame.addEventListener('mouseenter', () => {
          isStoryHovered = true;
          const video = document.getElementById('story-video-player');
          if (video) video.pause();
        });

        // Resume on mouseleave
        displayerFrame.addEventListener('mouseleave', () => {
          isStoryHovered = false;
          const video = document.getElementById('story-video-player');
          if (video) video.play().catch(() => {});
        });
      }
    };

    loadApprovedStories();

  });
</script>

