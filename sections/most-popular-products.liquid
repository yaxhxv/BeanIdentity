{% comment %}
  ------------------------------------------------------------------------------
  SECTION: MOST POPULAR PRODUCTS (OPTIMIZED)
  ------------------------------------------------------------------------------
{% endcomment %}

<style>
  .bean-popular {
    position: relative;
    width: 100%;
    background: {{ section.settings.bg_color | default: '#ffffff' }};
    color: {{ section.settings.text_color | default: '#1a1a1a' }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  
  .bean-container {
    width: 100%;
    max-width: 1200px; 
    margin: 0 auto;    
    padding: 0 20px;   
    box-sizing: border-box;
  }

  .bean-popular-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .bean-popular-title {
    font-size: {{ section.settings.heading_size }}px;
    margin-bottom: 0.6rem;
    color: inherit;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .bean-popular-desc {
    max-width: 600px;
    margin: 0 auto;
    opacity: 0.8;
    line-height: 1.5;
  }

  /* --- SLIDER STYLES --- */
  .bean-popular-slider {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; 
    padding-bottom: 2rem;
    padding-left: 5px; 
    padding-right: 5px;
  }

  /* Grid Layout Modifier */
  .bean-popular-slider.bean-layout-grid {
    flex-wrap: wrap;
    justify-content: center;
    overflow-x: visible;
    scroll-snap-type: none;
    padding-left: 0;
    padding-right: 0;
  }

  .bean-popular-slider::-webkit-scrollbar {
    display: none; 
  }

  /* --- CARD STYLES --- */
  .bean-product-card {
    flex: 0 0 280px; 
    background: #f7f5f2;
    border-radius: 8px; /* Slightly softer radius */
    overflow: hidden;
    scroll-snap-align: start;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .bean-image-wrap {
    position: relative;
    display: block;
    width: 100%;
    /* Aspect Ratio optimization */
    aspect-ratio: 2 / 3; 
    overflow: hidden;
    background: #e5e5e5;
  }

  .bean-img {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  
  .bean-placeholder-svg {
    width: 100%;
    height: 100%;
    background: #eee;
    fill: #ccc;
    object-fit: cover;
  }

  .bean-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    background: {{ section.settings.badge_bg | default: '#5a3e2b' }};
    color: {{ section.settings.badge_text | default: '#ffffff' }};
    padding: 4px 10px;
    font-size: 0.75rem;
    border-radius: 999px;
    z-index: 2;
    font-weight: 600;
  }

  .bean-product-info {
    padding: 1.2rem;
    text-align: center;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .bean-product-title {
    font-size: 1rem;
    margin: 0 0 0.5rem 0;
    color: inherit;
    font-weight: 500;
    line-height: 1.3;
  }

  .bean-price {
    margin-bottom: 1rem;
    font-size: 1rem;
    color: inherit;
  }

  .bean-old {
    text-decoration: line-through;
    opacity: 0.6;
    margin-right: 8px;
    font-size: 0.9em;
  }

  /* Accessible Link Overlay (Optimization) */
  .bean-card-link-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    z-index: 1;
  }

  .bean-btn {
    display: inline-block;
    width: 100%;
    padding: 10px;
    border-radius: 4px;
    border: 1px solid currentColor;
    background: transparent;
    color: inherit;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
    z-index: 2;
  }

  .bean-btn:hover {
    background: {{ section.settings.text_color | default: '#000000' }};
    color: {{ section.settings.bg_color | default: '#F5F5F5' }};
    border-color: {{ section.settings.text_color | default: '#000000' }};
  }

  @media (hover: hover) {
    .bean-product-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 20px rgba(0,0,0,0.08);
    }
    .bean-product-card:hover .bean-img {
      transform: scale(1.05);
    }
  }

  @media (max-width: 768px) {
    .bean-product-card {
      flex: 0 0 240px; /* Mobile Optimization for Carousel */
    }
    .bean-popular-title {
      font-size: 1.8rem;
    }
    
    /* Mobile Grid Overrides */
    .bean-layout-grid.bean-mobile-cols-1 .bean-product-card {
      width: 100%;
      flex: none;
    }
    
    .bean-layout-grid.bean-mobile-cols-2 .bean-product-card {
      width: calc(50% - 0.75rem); /* gap is 1.5rem */
      flex: none;
    }
  }
</style>

<section class="bean-popular{% if section.settings.bg_color == '#EDE7E3' or section.settings.bg_color == '#ede7e3' %} texture-grain{% endif %}" data-section-id="{{ section.id }}">
  <div class="bean-container">
    
    <header class="bean-popular-header">
      {% if section.settings.title != blank %}
        <h2 class="bean-popular-title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="bean-popular-desc">{{ section.settings.description }}</p>
      {% endif %}
    </header>

    <div class="bean-popular-slider bean-layout-{{ section.settings.layout_mode }} bean-mobile-cols-{{ section.settings.mobile_cols }}">
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        
        {% if product != blank %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          {% assign price = product.price %}
          {% assign compare = product.compare_at_price %}
          
          {% assign discount = 0 %}
          {% if compare > price %}
            {% assign discount = compare | minus: price | times: 100 | divided_by: compare %}
          {% endif %}

          <div class="bean-product-card" {{ block.shopify_attributes }}>
            <a href="{{ product.url }}" class="bean-image-wrap">
              {% if compare > price %}
                <span class="bean-badge">-{{ discount | round }}%</span>
              {% endif %}

              {% if product.featured_image %}
                {{ product.featured_image 
                  | image_url: width: 600 
                  | image_tag: 
                    loading: 'lazy', 
                    class: 'bean-img',
                    widths: '300, 600',
                    sizes: '(max-width: 768px) 300px, 280px',
                    alt: product.title
                }}
              {% else %}
                 {{ 'product-1' | placeholder_svg_tag: 'bean-placeholder-svg' }}
              {% endif %}
            </a>

            <div class="bean-product-info">
              <h3 class="bean-product-title">{{ product.title }}</h3>

              <div class="bean-price">
                {% if compare > price %}
                  <span class="bean-old">{{ compare | money }}</span>
                {% endif %}
                <span class="bean-current">{{ price | money }}</span>
              </div>

              <!-- Button link -->
              <a href="{{ product.url }}" class="bean-btn">
                {% if product.available %}View Product{% else %}Sold Out{% endif %}
              </a>
            </div>
            
            <!-- Accessible Overlay Link covering the whole card (for white space clicks) -->
            <a href="{{ product.url }}" class="bean-card-link-overlay" aria-label="View {{ product.title }}"></a>
          </div>

        {% else %}
          
          <!-- Placeholder Card -->
          <div class="bean-product-card" {{ block.shopify_attributes }}>
            <div class="bean-image-wrap">
               {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'bean-placeholder-svg' }}
            </div>
            <div class="bean-product-info">
              <h3 class="bean-product-title">Example Product Title</h3>
              <div class="bean-price">
                <span class="bean-current">{{ 1999 | money }}</span>
              </div>
              <span class="bean-btn">View Product</span>
            </div>
          </div>

        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Most Popular Products",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    { "type": "text", "id": "title", "label": "Heading", "default": "Community Has Spoken" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Shop What’s Selling" },
    { "type": "range", "id": "heading_size", "label": "Heading Size", "min": 20, "max": 60, "step": 2, "default": 32 },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Layout",
      "options": [
        { "value": "carousel", "label": "Carousel / Slider" },
        { "value": "grid", "label": "Grid" }
      ],
      "default": "carousel"
    },
    {
      "type": "select", 
      "id": "mobile_cols", 
      "label": "Mobile Grid Columns",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "2",
      "info": "Only applies when Layout is set to Grid"
    },
    
    {
      "type": "header",
      "content": "Colors"
    },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F5F5F5" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" },
    { "type": "color", "id": "badge_bg", "label": "Badge Background", "default": "#C6A969" },
    { "type": "color", "id": "badge_text", "label": "Badge Text", "default": "#000000" },
    
    {
      "type": "header",
      "content": "Spacing"
    },
    { "type": "range", "id": "padding_top", "label": "Padding Top", "min": 0, "max": 100, "step": 4, "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Padding Bottom", "min": 0, "max": 100, "step": 4, "default": 60 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Select product" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Most Popular Products",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
