{% comment %}
  ------------------------------------------------------------------------------
  SECTION: MOST POPULAR PRODUCTS (OPTIMIZED)
  ------------------------------------------------------------------------------
{% endcomment %}

<style>
  .bean-popular {
    position: relative;
    width: 100%;
    background: linear-gradient(180deg, #f5f5f5 0%, #ede7e3 100%);
    color: #0b0b0b;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    overflow: hidden;
    border-radius: 4.4rem 4.4rem 5.2rem 5.6rem / 3rem 3rem 4rem 4.2rem;
    box-shadow: 0 2.8rem 6rem rgba(43, 43, 43, 0.08);
    margin: 0 1.6rem;
  }

  .bean-popular::before,
  .bean-popular::after {
    content: "";
    position: absolute;
    pointer-events: none;
    z-index: 0;
  }

  .bean-popular::before {
    top: 3rem;
    right: 4rem;
    width: clamp(10rem, 18vw, 18rem);
    height: clamp(10rem, 18vw, 18rem);
    border-radius: 44% 56% 58% 42% / 48% 44% 56% 52%;
    background: radial-gradient(circle, rgba(198,169,105,0.16), transparent 72%);
  }

  .bean-popular::after {
    left: -2rem;
    bottom: -3rem;
    width: clamp(14rem, 22vw, 24rem);
    height: clamp(14rem, 22vw, 24rem);
    border-radius: 58% 42% 46% 54% / 54% 48% 52% 46%;
    background: radial-gradient(circle, rgba(255,255,255,0.88), rgba(255,255,255,0) 72%);
    opacity: 0.75;
  }

  .bean-container {
    width: 100%;
    max-width: 1480px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
    position: relative;
    z-index: 1;
  }

  .bean-popular-header {
    text-align: center;
    margin-bottom: 3rem;
    position: relative;
  }


  .bean-popular-title {
    font-family: var(--font-heading-family);
    font-size: clamp(3.2rem, 6vw, 8rem);
    margin-bottom: 0.6rem;
    color: inherit;
    line-height: 0.86;
    text-transform: uppercase;
    letter-spacing: 0;
    font-weight: 900;
  }

  .bean-popular-desc {
    max-width: 600px;
    margin: 0 auto;
    font-family: 'Poppins', sans-serif;
    opacity: 0.72;
    line-height: 1.5;
  }

  /* --- SLIDER STYLES --- */
  .bean-popular-slider {
    display: flex;
    gap: 1.8rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 2rem;
    padding-left: 5px;
    padding-right: 5px;
  }

  /* Grid Layout Modifier */
  .bean-popular-slider.bean-layout-grid {
    flex-wrap: wrap;
    justify-content: center;
    overflow-x: visible;
    scroll-snap-type: none;
    padding-left: 0;
    padding-right: 0;
  }

  .bean-popular-slider::-webkit-scrollbar {
    display: none;
  }

  /* --- CARD STYLES --- */
  .bean-product-card {
    flex: 0 0 33rem;
    background: #f5f5f5;
    border-radius: 16px;
    overflow: hidden;
    scroll-snap-align: start;
    transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
    display: flex;
    flex-direction: column;
    position: relative;
    border: 1px solid rgba(11,11,11,0.1);
  }

  .bean-image-wrap {
    position: relative;
    display: block;
    width: 100%;
    /* Aspect Ratio optimization */
    aspect-ratio: 0.78;
    overflow: hidden;
    background: #ebe7e2;
  }

  .bean-img {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1), filter 0.35s ease;
  }

  .bean-placeholder-svg {
    width: 100%;
    height: 100%;
    background: #eee;
    fill: #ccc;
    object-fit: cover;
  }

  .bean-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    background: {{ section.settings.badge_bg | default: '#5a3e2b' }};
    color: {{ section.settings.badge_text | default: '#ffffff' }};
    padding: 4px 10px;
    font-size: 0.75rem;
    border-radius: 8px;
    z-index: 2;
    font-weight: 600;
  }

  .bean-vibe-badge {
    position: absolute;
    left: 1.2rem;
    bottom: 1.2rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1rem;
    font-family: 'Poppins', sans-serif;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: rgba(245,245,245,0.86);
    color: #0b0b0b;
    backdrop-filter: blur(10px);
    border-radius: 10px;
  }

  .bean-product-info {
    padding: 1.8rem;
    text-align: left;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .bean-product-title {
    font-family: 'Poppins', sans-serif;
    font-size: 1.35rem;
    margin: 0 0 0.5rem 0;
    color: inherit;
    font-weight: 700;
    line-height: 1.3;
  }

  .bean-price {
    margin-bottom: 1rem;
    font-size: 1.35rem;
    color: inherit;
  }

  .bean-old {
    text-decoration: line-through;
    opacity: 0.6;
    margin-right: 8px;
    font-size: 0.9em;
  }

  /* Accessible Link Overlay (Optimization) */
  .bean-card-link-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    z-index: 1;
  }

  .bean-btn {
    display: inline-block;
    width: 100%;
    padding: 10px;
    border-radius: 10px;
    border: 1px solid currentColor;
    background: transparent;
    color: inherit;
    text-decoration: none;
    font-size: 1.15rem;
    font-weight: 900;
    text-transform: uppercase;
    cursor: pointer;
    letter-spacing: 0.12em;
    transition: all 0.28s ease;
    position: relative;
    z-index: 2;
  }

  .bean-btn:hover {
    background: {{ section.settings.text_color | default: '#000000' }};
    color: {{ section.settings.bg_color | default: '#F5F5F5' }};
    border-color: {{ section.settings.text_color | default: '#000000' }};
  }

  @media (hover: hover) {
    .bean-product-card:hover {
      transform: translateY(-5px) scale(1.015);
      box-shadow: 0 24px 60px rgba(0,0,0,0.14);
      border-color: rgba(198,169,105,0.4);
    }
    .bean-product-card:hover .bean-img {
      transform: scale(1.045);
      filter: saturate(1.05) contrast(1.03);
    }
  }

  @media (max-width: 768px) {
    .bean-popular {
      margin: 0 1rem;
      border-radius: 2.8rem 2.8rem 3.6rem 3.4rem / 2rem 2rem 2.8rem 2.6rem;
    }
    .bean-product-card {
      flex: 0 0 240px; /* Mobile Optimization for Carousel */
    }
    .bean-popular-title {
      font-size: 1.8rem;
    }
    .bean-popular-header::after {
      display: none;
    }

    /* Mobile Grid Overrides */
    .bean-layout-grid.bean-mobile-cols-1 .bean-product-card {
      width: 100%;
      flex: none;
    }

    .bean-layout-grid.bean-mobile-cols-2 .bean-product-card {
      width: calc(50% - 0.75rem); /* gap is 1.5rem */
      flex: none;
    }
  }
</style>

<section
  class="bean-popular{% if section.settings.bg_color == '#EDE7E3' or section.settings.bg_color == '#ede7e3' %} texture-grain{% endif %}"
  data-section-id="{{ section.id }}"
>
  <img
    src="{{ 'RedDoodle1.png' | file_url }}"
    alt=""
    aria-hidden="true"
    style="position:absolute; top:2rem; right:-2rem; width:clamp(160px,18vw,260px); height:auto; opacity:0.13; transform:rotate(-6deg); pointer-events:none; z-index:0; mix-blend-mode:multiply;"
    loading="lazy"
  >
  <img
    src="{{ 'RedDoodle2.png' | file_url }}"
    alt=""
    aria-hidden="true"
    style="position:absolute; bottom:-2rem; left:-3rem; width:clamp(140px,16vw,220px); height:auto; opacity:0.10; transform:rotate(14deg) scaleX(-1); pointer-events:none; z-index:0; mix-blend-mode:multiply;"
    loading="lazy"
  >
  <div class="bean-container">
    <header class="bean-popular-header">
      {% if section.settings.title != blank %}
        <h2 class="bean-popular-title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="bean-popular-desc">{{ section.settings.description }}</p>
      {% endif %}
    </header>

    <div class="bean-popular-slider bean-layout-{{ section.settings.layout_mode }} bean-mobile-cols-{{ section.settings.mobile_cols }}">
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}

        {% if product != blank %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          {% assign price = product.price %}
          {% assign compare = product.compare_at_price %}

          {% assign discount = 0 %}
          {% if compare > price %}
            {% assign discount = compare | minus: price | times: 100 | divided_by: compare %}
          {% endif %}

          <div class="bean-product-card" {{ block.shopify_attributes }}>
            <a href="{{ product.url }}" class="bean-image-wrap">
              {% if compare > price %}
                <span class="bean-badge">-{{ discount | round }}%</span>
              {% endif %}

              <span class="bean-vibe-badge">
                {% cycle 'Lowkey Favorite', 'Main Character', 'Quiet Luxury', 'On Repeat' %}
              </span>

              {% if product.featured_image %}
                {{
                  product.featured_image
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    class: 'bean-img',
                    widths: '300, 600',
                    sizes: '(max-width: 768px) 300px, 280px',
                    alt: product.title
                }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'bean-placeholder-svg' }}
              {% endif %}
            </a>

            <div class="bean-product-info">
              <h3 class="bean-product-title">{{ product.title }}</h3>

              <div class="bean-price">
                {% if compare > price %}
                  <span class="bean-old">{{ compare | money }}</span>
                {% endif %}
                <span class="bean-current">{{ price | money }}</span>
              </div>

              <!-- Button link -->
              <a href="{{ product.url }}" class="bean-btn">
                {% if product.available %}View Product{% else %}Sold Out{% endif %}
              </a>
            </div>

            <!-- Accessible Overlay Link covering the whole card (for white space clicks) -->
            <a href="{{ product.url }}" class="bean-card-link-overlay" aria-label="View {{ product.title }}"></a>
          </div>

        {% else %}
          <!-- Placeholder Card -->
          <div class="bean-product-card" {{ block.shopify_attributes }}>
            <div class="bean-image-wrap">
              {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'bean-placeholder-svg' }}
            </div>
            <div class="bean-product-info">
              <h3 class="bean-product-title">Example Product Title</h3>
              <div class="bean-price">
                <span class="bean-current">{{ 1999 | money }}</span>
              </div>
              <span class="bean-btn">View Product</span>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Most Popular Products",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    { "type": "text", "id": "title", "label": "Heading", "default": "Community Has Spoken" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Shop What’s Selling" },
    { "type": "range", "id": "heading_size", "label": "Heading Size", "min": 20, "max": 60, "step": 2, "default": 32 },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Layout",
      "options": [
        { "value": "carousel", "label": "Carousel / Slider" },
        { "value": "grid", "label": "Grid" }
      ],
      "default": "carousel"
    },
    {
      "type": "select",
      "id": "mobile_cols",
      "label": "Mobile Grid Columns",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "2",
      "info": "Only applies when Layout is set to Grid"
    },

    {
      "type": "header",
      "content": "Colors"
    },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F5F5F5" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" },
    { "type": "color", "id": "badge_bg", "label": "Badge Background", "default": "#C6A969" },
    { "type": "color", "id": "badge_text", "label": "Badge Text", "default": "#000000" },

    {
      "type": "header",
      "content": "Spacing"
    },
    { "type": "range", "id": "padding_top", "label": "Padding Top", "min": 0, "max": 100, "step": 4, "default": 60 },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [{ "type": "product", "id": "product", "label": "Select product" }]
    }
  ],
  "presets": [
    {
      "name": "Most Popular Products",
      "blocks": [{ "type": "product" }, { "type": "product" }, { "type": "product" }, { "type": "product" }]
    }
  ]
}
{% endschema %}
