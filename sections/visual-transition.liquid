{% comment %}
  SECTION: VISUAL TRANSITION
  - Acts as a bridge between dark Hero and light content.
  - Features ivory background, paper texture, and subtle floating beans.
{% endcomment %}

<div class="visual-transition" id="Transition-{{ section.id }}">
  <div class="transition-gradient-top"></div>
  <div class="transition-texture"></div>
  <div class="floating-beans">
    <div class="f-bean f-bean-1"></div>
    <div class="f-bean f-bean-2"></div>
    <div class="f-bean f-bean-3"></div>
    <div class="f-bean f-bean-4"></div>
  </div>
</div>

<style>
  .visual-transition {
    position: relative;
    width: 100%;
    height: clamp(72px, 9vw, 126px);
    background-color: #0b0b0b;
    overflow: hidden;
    display: block;
  }

  /* Blends from the hero's dark base */
  .transition-gradient-top {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, #0b0b0b 0%, rgba(11,11,11,0.86) 42%, #121212 100%);
    z-index: 2;
    pointer-events: none;
  }

  /* Paper/Grain Texture */
  .transition-texture {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0.08;
    pointer-events: none;
    z-index: 1;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }

  /* Floating Beans */
  .floating-beans {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 3;
  }

  .f-bean {
    position: absolute;
    width: 32px;
    height: 20px;
    background: #c6a969;
    border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
    opacity: 0.1;
    filter: blur(0.5px);
  }

  /* The "bean" line */
  .f-bean::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 10%;
    width: 80%;
    height: 1px;
    background: rgba(11,11,11,0.28);
    transform: rotate(-5deg);
  }

  .f-bean-1 { top: 30%; left: 10%; transform: rotate(25deg); animation: floatBean 12s infinite ease-in-out; }
  .f-bean-2 { top: 65%; left: 85%; transform: rotate(-15deg); animation: floatBean 15s infinite ease-in-out reverse; }
  .f-bean-3 { top: 15%; left: 60%; transform: rotate(45deg); animation: floatBean 18s infinite ease-in-out 2s; }
  .f-bean-4 { top: 75%; left: 40%; transform: rotate(-35deg); animation: floatBean 14s infinite ease-in-out 1s; }

  @keyframes floatBean {
    0%, 100% { transform: translate(0, 0) rotate(var(--base-rot, 0deg)); }
    50% { transform: translate(15px, -20px) rotate(calc(var(--base-rot, 0deg) + 12deg)); }
  }

  @media (max-width: 767px) {
    .visual-transition {
      height: 72px;
    }
    .f-bean {
      width: 24px;
      height: 15px;
    }
  }
</style>

{% schema %}
{
  "name": "Visual Transition",
  "settings": [
    {
      "type": "paragraph",
      "content": "A minimal section for visual blending. No settings required."
    }
  ],
  "presets": [
    {
      "name": "Visual Transition"
    }
  ]
}
{% endschema %}
