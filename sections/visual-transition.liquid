{% comment %}
  SECTION: VISUAL TRANSITION
  - Acts as a bridge between dark Hero and light content.
  - Features ivory background, paper texture, and subtle floating beans.
{% endcomment %}

<div class="visual-transition" id="Transition-{{ section.id }}">
  <div class="transition-gradient-top"></div>
  <div class="transition-texture"></div>
  <div class="transition-doodles" aria-hidden="true">
    <span class="transition-star transition-star-1"></span>
    <span class="transition-star transition-star-2"></span>
    <span class="transition-line transition-line-1"></span>
    <span class="transition-line transition-line-2"></span>
  </div>
</div>

<style>
  .visual-transition {
    position: relative;
    width: 100%;
    height: clamp(72px, 9vw, 126px);
    background-color: #0b0b0b;
    overflow: hidden;
    display: block;
  }

  /* Blends from the hero's dark base */
  .transition-gradient-top {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, #0b0b0b 0%, rgba(11,11,11,0.86) 42%, #121212 100%);
    z-index: 2;
    pointer-events: none;
  }

  /* Paper/Grain Texture */
  .transition-texture {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0.08;
    pointer-events: none;
    z-index: 1;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }


  .transition-doodles {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    opacity: 0.48;
  }

  .transition-star,
  .transition-line {
    position: absolute;
    display: block;
  }

  .transition-star::before,
  .transition-star::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(245,245,245,0.45);
  }

  .transition-star::before {
    width: 100%;
    height: 1px;
    top: 50%;
    transform: translateY(-50%);
  }

  .transition-star::after {
    width: 1px;
    height: 100%;
    left: 50%;
    transform: translateX(-50%);
  }

  .transition-star-1 {
    width: 1.4rem;
    height: 1.4rem;
    top: 18%;
    right: 24%;
    transform: none;
  }

  .transition-star-2 {
    width: 1rem;
    height: 1rem;
    bottom: 20%;
    left: 31%;
    transform: none;
  }

  .transition-line {
    border-top: 1px solid rgba(245,245,245,0.34);
    border-right: 1px solid rgba(245,245,245,0.34);
    border-radius: 0 100% 0 0;
  }

  .transition-line-1 {
    width: 7rem;
    height: 2.4rem;
    top: 18%;
    left: 42%;
    transform: none;
  }

  .transition-line-2 {
    width: 6rem;
    height: 2rem;
    bottom: 18%;
    right: 10%;
    transform: none;
  }


  @media (max-width: 767px) {
    .visual-transition {
      height: 72px;
    }
    .f-bean {
      width: 28px;
      height: 40px;
    }
    .transition-line-1,
    .transition-line-2 {
      display: none;
    }
  }
</style>

{% schema %}
{
  "name": "Visual Transition",
  "settings": [
    {
      "type": "paragraph",
      "content": "A minimal section for visual blending. No settings required."
    }
  ],
  "presets": [
    {
      "name": "Visual Transition"
    }
  ]
}
{% endschema %}
