{% comment %}
  SECTION: VISUAL TRANSITION
  - Acts as a bridge between dark Hero and light content.
  - Features ivory background, paper texture, and subtle floating beans.
{% endcomment %}

<div class="visual-transition" id="Transition-{{ section.id }}">
  <div class="transition-gradient-top"></div>
  <div class="transition-texture"></div>
  <div class="transition-doodles" aria-hidden="true">
    <span class="transition-star transition-star-1"></span>
    <span class="transition-star transition-star-2"></span>
    <span class="transition-line transition-line-1"></span>
    <span class="transition-line transition-line-2"></span>
  </div>
  <div class="floating-beans">
    <div class="f-bean f-bean-1"></div>
    <div class="f-bean f-bean-2"></div>
    <div class="f-bean f-bean-3"></div>
    <div class="f-bean f-bean-4"></div>
    <div class="f-bean f-bean-5"></div>
    <div class="f-bean f-bean-6"></div>
  </div>
</div>

<style>
  .visual-transition {
    position: relative;
    width: 100%;
    height: clamp(72px, 9vw, 126px);
    background-color: #0b0b0b;
    overflow: hidden;
    display: block;
  }

  /* Blends from the hero's dark base */
  .transition-gradient-top {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, #0b0b0b 0%, rgba(11,11,11,0.86) 42%, #121212 100%);
    z-index: 2;
    pointer-events: none;
  }

  /* Paper/Grain Texture */
  .transition-texture {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0.08;
    pointer-events: none;
    z-index: 1;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }

  /* Floating Beans */
  .floating-beans {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 3;
  }

  .f-bean {
    position: absolute;
    width: 38px;
    height: 54px;
    border-radius: 52% 48% 50% 50% / 40% 42% 58% 60%;
    opacity: 0.22;
    background:
      radial-gradient(circle at 38% 30%, rgba(255,255,255,0.34), transparent 18%),
      linear-gradient(145deg, rgba(198,169,105,0.92), rgba(146,111,67,0.75));
    box-shadow: 0 1rem 2rem rgba(0,0,0,0.18);
  }

  /* The "bean" line */
  .f-bean::after {
    content: '';
    position: absolute;
    top: 16%;
    left: 48%;
    width: 2px;
    height: 68%;
    background: rgba(11,11,11,0.18);
    border-radius: 999px;
    transform: rotate(10deg);
  }

  .f-bean-1 { top: 18%; left: 9%; --base-rot: 24deg; animation: floatBean 12s infinite ease-in-out; }
  .f-bean-2 { top: 60%; left: 84%; --base-rot: -14deg; animation: floatBean 15s infinite ease-in-out reverse; }
  .f-bean-3 { top: 8%; left: 61%; --base-rot: 42deg; animation: floatBean 18s infinite ease-in-out 2s; }
  .f-bean-4 { top: 62%; left: 39%; --base-rot: -30deg; animation: floatBean 14s infinite ease-in-out 1s; }
  .f-bean-5 { top: 34%; left: 72%; --base-rot: 10deg; animation: floatBean 16s infinite ease-in-out 1.5s; }
  .f-bean-6 { top: 48%; left: 20%; --base-rot: -18deg; animation: floatBean 13s infinite ease-in-out 0.5s; }

  .transition-doodles {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    opacity: 0.48;
  }

  .transition-star,
  .transition-line {
    position: absolute;
    display: block;
  }

  .transition-star::before,
  .transition-star::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(245,245,245,0.45);
  }

  .transition-star::before {
    width: 100%;
    height: 1px;
    top: 50%;
    transform: translateY(-50%);
  }

  .transition-star::after {
    width: 1px;
    height: 100%;
    left: 50%;
    transform: translateX(-50%);
  }

  .transition-star-1 {
    width: 1.4rem;
    height: 1.4rem;
    top: 18%;
    right: 24%;
    transform: rotate(12deg);
  }

  .transition-star-2 {
    width: 1rem;
    height: 1rem;
    bottom: 20%;
    left: 31%;
    transform: rotate(-8deg);
  }

  .transition-line {
    border-top: 1px solid rgba(245,245,245,0.34);
    border-right: 1px solid rgba(245,245,245,0.34);
    border-radius: 0 100% 0 0;
  }

  .transition-line-1 {
    width: 7rem;
    height: 2.4rem;
    top: 18%;
    left: 42%;
    transform: rotate(8deg);
  }

  .transition-line-2 {
    width: 6rem;
    height: 2rem;
    bottom: 18%;
    right: 10%;
    transform: rotate(-12deg);
  }

  @keyframes floatBean {
    0%, 100% { transform: translate(0, 0) rotate(var(--base-rot, 0deg)); }
    50% { transform: translate(15px, -20px) rotate(calc(var(--base-rot, 0deg) + 12deg)); }
  }

  @media (max-width: 767px) {
    .visual-transition {
      height: 72px;
    }
    .f-bean {
      width: 28px;
      height: 40px;
    }
    .transition-line-1,
    .transition-line-2 {
      display: none;
    }
  }
</style>

{% schema %}
{
  "name": "Visual Transition",
  "settings": [
    {
      "type": "paragraph",
      "content": "A minimal section for visual blending. No settings required."
    }
  ],
  "presets": [
    {
      "name": "Visual Transition"
    }
  ]
}
{% endschema %}
