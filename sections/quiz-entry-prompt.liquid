{% comment %}
  SECTION: QUIZ ENTRY PROMPT
  - Captures users halfway down the page and directs them to the quiz.
{% endcomment %}

{%- style -%}
  #QuizPrompt-{{ section.id }} {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      linear-gradient(135deg, rgba(198,169,105,0.16), transparent 34%),
      radial-gradient(circle at 82% 22%, rgba(245,245,245,0.08), transparent 28%),
      #121212;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    text-align: left;
    border-top: 1px solid rgba(245, 245, 245, 0.08);
    border-bottom: 0;
    border-radius: 4.2rem 4.2rem 4.8rem 4.8rem / 3rem 3rem 4rem 4rem;
    color: #f5f5f5;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    margin-left: 1.6rem;
    margin-right: 1.6rem;
    box-shadow: 0 2.2rem 4.8rem rgba(0, 0, 0, 0.18);
    z-index: 1;
  }

  .quiz-prompt__bean-gif {
    position: absolute;
    top: -5rem;
    left: -5rem;
    width: clamp(260px, 30vw, 400px);
    height: auto;
    border-radius: 50% 44% 55% 42% / 46% 52% 48% 54%;
    mix-blend-mode: screen;
    opacity: 0.55;
    pointer-events: none;
    z-index: 0;
  }

  @media screen and (max-width: 749px) {
    .quiz-prompt__bean-gif {
      width: clamp(160px, 44vw, 240px);
      top: -3rem;
      left: -3rem;
    }
  }

  #QuizPrompt-{{ section.id }}::before {
    content: "FIND YOUR BEAN";
    position: absolute;
    right: -0.08em;
    bottom: 1rem;
    z-index: -1;
    font-family: var(--font-heading-family);
    font-size: clamp(6rem, 14vw, 16rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0;
    color: rgba(245,245,245,0.035);
    white-space: nowrap;
  }


  .quiz-prompt__wrapper {
    max-width: 118rem;
    margin: 0 auto;
    padding: 1rem 4rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 3rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }


  .quiz-prompt__headline {
    font-family: var(--font-heading-family);
    font-size: clamp(2.2rem, 3.8vw, 3.4rem);
    font-weight: 900;
    color: #f5f5f5;
    margin: 0;
    letter-spacing: 0;
    line-height: 1.1;
    max-width: 28ch;
    text-transform: none;
    word-break: keep-all;
    overflow-wrap: break-word;
    grid-column: 1;
    grid-row: 1;
  }

  .quiz-prompt__subline {
    font-size: clamp(1.4rem, 1.3vw, 1.7rem);
    color: rgba(245,245,245,0.74);
    margin: 0.8rem 0 0;
    line-height: 1.55;
    max-width: 47rem;
    grid-column: 1;
    grid-row: 2;
  }

  .quiz-prompt__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24rem;
    min-height: 5.4rem;
    padding: 0 4rem;
    background-color: #c6a969;
    color: #0b0b0b;
    text-decoration: none;
    font-size: 1.4rem;
    font-weight: 800;
    text-transform: none;
    letter-spacing: 0.08em;
    border: 1px solid #c6a969;
    border-radius: 12px;
    transition: transform 0.28s ease, background 0.28s ease, color 0.28s ease;
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    position: relative;
    overflow: hidden;
  }

  .quiz-prompt__button:hover {
    background: transparent;
    color: #c6a969;
    transform: translateY(-0.25rem) scale(1.02);
  }

  .quiz-prompt__button::after {
    content: "";
    position: absolute;
    left: 2.2rem;
    right: 2.2rem;
    bottom: 1.2rem;
    height: 2px;
    background: currentColor;
    transform: scaleX(0.16);
    transform-origin: left center;
    opacity: 0.28;
    transition: transform 0.28s ease, opacity 0.28s ease;
  }

  .quiz-prompt__button:hover::after {
    transform: scaleX(1);
    opacity: 0.8;
  }


  @media screen and (max-width: 749px) {
    #QuizPrompt-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 }}px;
      text-align: center;
      border-radius: 2.8rem 2.8rem 3.4rem 3.4rem / 2.2rem 2.2rem 2.8rem 2.8rem;
      margin-top: {{ section.settings.margin_top | times: 0.8 }}px;
      margin-bottom: {{ section.settings.margin_bottom | times: 0.8 }}px;
      margin-left: 1rem;
      margin-right: 1rem;
    }
    .quiz-prompt__wrapper {
      display: block;
    }
    .quiz-prompt__subline {
      font-size: 1.6rem;
      margin-left: auto;
      margin-right: auto;
    }
    .quiz-prompt__headline {
      max-width: none;
    }
    .quiz-prompt__headline,
    .quiz-prompt__subline,
    .quiz-prompt__button {
      grid-column: auto;
      grid-row: auto;
    }
    .quiz-prompt__button {
      width: 100%;
      margin-top: 3rem;
    }
  }
{%- endstyle -%}

<div
  id="QuizPrompt-{{ section.id }}"
  class="quiz-prompt-section{% if section.settings.bg_color == '#EDE7E3' or section.settings.bg_color == '#ede7e3' %} texture-grain{% endif %}"
>
  <div class="quiz-prompt__wrapper">
    {%- if section.settings.headline != blank -%}
      <h2 class="quiz-prompt__headline">{{ section.settings.headline }}</h2>
    {%- endif -%}
    {%- if section.settings.subline != blank -%}
      <div class="quiz-prompt__subline">{{ section.settings.subline }}</div>
    {%- endif -%}
    <a href="/pages/which-bean-are-you" class="quiz-prompt__button">
      {{ section.settings.button_label }}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Quiz Entry Prompt",
  "settings": [
    {
      "type": "textarea",
      "id": "headline",
      "label": "Headline",
      "default": "Not sure which bean you are?"
    },
    {
      "type": "textarea",
      "id": "subline",
      "label": "Subline",
      "default": "Meet the archetype that fits your soul and wear your identity with pride."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Find Out"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F5F5F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Background",
      "default": "#C6A969"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button Text",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin Bottom",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Quiz Entry Prompt"
    }
  ]
}
{% endschema %}
