{% comment %}
  SECTION: ADMIN PORTAL SPA
  - Single Page Application admin portal for moderating stories, returns, and sizing.
  - Fully hosted on Shopify, avoiding any front-end server deployments.
{% endcomment %}

{%- style -%}
  /* --- DESIGN SYSTEM & VARIABLES --- */
  #AdminPortal-{{ section.id }} {
    --font-heading: 'Outfit', sans-serif;
    --font-body: 'Poppins', sans-serif;

    --bg-main: #090909;
    --bg-sidebar: #101010;
    --bg-card: #141414;
    --bg-card-alt: #181818;
    --bg-input: #1a1a1a;

    --border-color: rgba(255, 255, 255, 0.08);
    --text-main: #f5f5f5;
    --text-muted: rgba(245, 245, 245, 0.55);

    --accent-gold: #C6A969;
    --accent-gold-rgb: 198, 169, 105;
    --accent-green: #388E3C;
    --accent-red: #D32F2F;

    --active-accent: #A67C52;
    --active-accent-rgb: 166, 124, 82;

    display: block;
    width: 100%;
    min-height: 100vh;
    background-color: var(--bg-main);
    background-image:
      radial-gradient(circle at top left, rgba(var(--accent-gold-rgb), 0.12), transparent 26%),
      radial-gradient(circle at top right, rgba(255, 255, 255, 0.04), transparent 24%),
      linear-gradient(180deg, #080808 0%, #0d0d0d 100%);
    color: var(--text-main);
    font-family: var(--font-body);
    position: relative;
    padding: 3.2rem clamp(1.6rem, 2.8vw, 3.2rem) 5rem;
    overflow: hidden;
  }

  #AdminPortal-{{ section.id }} * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  #AdminPortal-{{ section.id }}::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.02), transparent 38%),
      radial-gradient(circle at 50% 0%, rgba(var(--accent-gold-rgb), 0.06), transparent 42%);
    pointer-events: none;
  }

  /* Custom Scrollbars */
  #AdminPortal-{{ section.id }} ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  #AdminPortal-{{ section.id }} ::-webkit-scrollbar-track {
    background: transparent;
  }
  #AdminPortal-{{ section.id }} ::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 3px;
  }
  #AdminPortal-{{ section.id }} ::-webkit-scrollbar-thumb:hover {
    background: var(--accent-gold);
  }

  /* ==========================================================================
     AUTH GATE GATEKEEPER SCREEN
     ========================================================================== */
  .auth-gate-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 50% 50%, #1c1810 0%, #090909 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99999;
    padding: 2rem;
  }

  .auth-gate-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-top: 4px solid var(--accent-gold);
    border-radius: 2.4rem;
    padding: 4.5rem 4rem;
    width: 100%;
    max-width: 460px;
    box-shadow: 0 4rem 10rem rgba(0, 0, 0, 0.6);
    animation: modalEnter 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  @keyframes modalEnter {
    0% { transform: scale(0.92) translateY(2rem); opacity: 0; }
    100% { transform: scale(1) translateY(0); opacity: 1; }
  }

  .auth-gate-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .auth-brand {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--accent-gold);
    display: block;
    margin-bottom: 1rem;
  }

  .auth-gate-header h2 {
    font-family: var(--font-heading);
    font-size: 2.8rem;
    font-weight: 900;
    letter-spacing: -0.01em;
    margin-bottom: 1.2rem;
  }

  .auth-gate-header p {
    font-size: 1.3rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .form-group label {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: rgba(245, 245, 245, 0.7);
  }

  .form-group input {
    background: var(--bg-input);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1.2rem;
    padding: 1.5rem 1.8rem;
    color: #fff;
    font-family: inherit;
    font-size: 1.5rem;
    letter-spacing: 0.1em;
    transition: all 0.25s ease;
  }

  .form-group input:focus {
    outline: none;
    border-color: var(--accent-gold);
    box-shadow: 0 0 0 3px rgba(var(--accent-gold-rgb), 0.18);
  }

  .auth-error-msg {
    color: var(--accent-red);
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 2rem;
    text-align: center;
    animation: shake 0.35s ease;
  }

  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-6px); }
    75% { transform: translateX(6px); }
  }

  .auth-submit-btn {
    width: 100%;
    padding: 1.6rem;
    border: 1px solid var(--accent-gold);
    background: transparent;
    color: var(--text-main);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.4rem;
    letter-spacing: 0.05em;
    border-radius: 1.2rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .auth-submit-btn:hover {
    background: var(--accent-gold);
    color: #000;
    transform: translateY(-2px);
    box-shadow: 0 1rem 3rem rgba(var(--accent-gold-rgb), 0.2);
  }

  /* ==========================================================================
     MAIN DASHBOARD GRID LAYOUT
     ========================================================================== */
  .admin-dashboard-layout {
    display: flex;
    width: 100%;
    max-width: 1480px;
    min-height: calc(100vh - 8rem);
    margin: 0 auto;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 16%),
      var(--bg-main);
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 3.2rem;
    overflow: hidden;
    box-shadow: 0 3rem 8rem rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(14px);
  }

  /* Left Sidebar Menu Drawer */
  .admin-sidebar {
    width: 290px;
    background:
      linear-gradient(180deg, rgba(var(--accent-gold-rgb), 0.08), transparent 22%),
      var(--bg-sidebar);
    border-right: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    padding: 4rem 2.4rem 3rem;
    flex-shrink: 0;
  }

  .sidebar-brand-wrapper {
    margin-bottom: 4rem;
    padding: 0 0.8rem;
  }

  .sidebar-logo {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    font-weight: 900;
    letter-spacing: -0.01em;
    display: block;
    color: #FFF;
  }

  .sidebar-badge {
    display: inline-block;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--accent-gold);
    text-transform: uppercase;
    margin-top: 0.4rem;
  }

  .sidebar-menu {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex-grow: 1;
  }

  .menu-item {
    width: 100%;
    background: transparent;
    border: none;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem 1.6rem;
    border-radius: 1.6rem;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.25s ease;
    font-family: inherit;
    font-weight: 600;
    font-size: 1.4rem;
    border: 1px solid transparent;
  }

  .menu-icon {
    width: 2.2rem;
    height: 2.2rem;
    fill: currentColor;
  }

  .menu-item:hover {
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-main);
    transform: translateX(3px);
  }

  .menu-item.active {
    background: linear-gradient(90deg, rgba(var(--accent-gold-rgb), 0.16), rgba(var(--accent-gold-rgb), 0.04));
    border: 1px solid rgba(var(--accent-gold-rgb), 0.18);
    color: var(--accent-gold);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .sidebar-footer {
    border-top: 1px solid var(--border-color);
    padding-top: 2.4rem;
    margin-top: 2rem;
  }

  .admin-profile {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-bottom: 2rem;
    padding: 0 1rem;
  }

  .admin-avatar {
    width: 4rem;
    height: 4rem;
    background: var(--accent-gold);
    color: #000;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 1.8rem;
  }

  .admin-meta {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .admin-name {
    font-weight: 600;
    font-size: 1.3rem;
    color: var(--text-main);
  }

  .admin-role {
    font-size: 1.1rem;
    color: var(--text-muted);
  }

  .logout-btn {
    width: 100%;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--text-muted);
    padding: 1.2rem;
    border-radius: 1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.2rem;
    transition: all 0.25s ease;
  }

  .logout-icon {
    width: 1.6rem;
    height: 1.6rem;
    fill: currentColor;
  }

  .logout-btn:hover {
    border-color: var(--accent-red);
    color: var(--accent-red);
    background: rgba(211, 47, 47, 0.05);
  }

  /* ==========================================================================
     MAIN DASHBOARD VIEWS GRID
     ========================================================================== */
  .admin-main-content {
    flex-grow: 1;
    padding: 4rem clamp(2.4rem, 4vw, 5.6rem) 5rem;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .tab-view {
    display: none;
    animation: fadeIn 0.3s ease both;
    width: 100%;
    max-width: 1220px;
    margin: 0 auto;
    padding: 1.2rem 0 0;
  }

  .tab-view.active {
    display: block;
  }

  @keyframes fadeIn {
    0% { opacity: 0; transform: translateY(1rem); }
    100% { opacity: 1; transform: translateY(0); }
  }

  .view-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 4rem;
    margin-bottom: 3.6rem;
    padding: 3.2rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 2.8rem;
    background:
      linear-gradient(135deg, rgba(var(--accent-gold-rgb), 0.08), transparent 38%),
      rgba(255, 255, 255, 0.02);
    box-shadow: 0 1.8rem 4rem rgba(0, 0, 0, 0.24);
  }

  .view-heading-group {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    min-width: 0;
  }

  .view-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    width: fit-content;
    padding: 0.8rem 1.3rem;
    border-radius: 999px;
    border: 1px solid rgba(var(--accent-gold-rgb), 0.18);
    background: rgba(var(--accent-gold-rgb), 0.1);
    color: var(--accent-gold);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .view-header h1 {
    font-family: var(--font-heading);
    font-size: clamp(3rem, 3vw, 4rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #FFF;
    text-align: left;
    line-height: 1.05;
  }

  .view-header p {
    font-size: 1.45rem;
    color: var(--text-muted);
    line-height: 1.75;
    letter-spacing: 0.01em;
    max-width: 720px;
    text-align: left;
  }

  /* Metrics counters */
  .metrics-row {
    display: flex;
    gap: 2rem;
    flex-shrink: 0;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .metric-card {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.02));
    border: 1px solid var(--border-color);
    border-radius: 2rem;
    padding: 2rem 2.4rem;
    min-width: 180px;
    text-align: center;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04), 0 12px 35px rgba(0, 0, 0, 0.2);
  }

  .metric-num {
    font-family: var(--font-heading);
    font-size: 3.8rem;
    font-weight: 900;
    color: var(--accent-gold);
    line-height: 1;
    display: block;
    margin-bottom: 0.6rem;
  }

  .metric-lbl {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Moderation Tabs Navigation Buttons */
  .module-nav-tabs {
    display: flex;
    gap: 1rem;
    margin-bottom: 3.2rem;
    padding: 0.8rem;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 2rem;
    background: rgba(255, 255, 255, 0.02);
    width: fit-content;
    flex-wrap: wrap;
  }

  .sub-tab {
    background: transparent;
    border: 1px solid transparent;
    color: var(--text-muted);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.25rem;
    padding: 1.15rem 1.8rem;
    cursor: pointer;
    position: relative;
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: 1.4rem;
  }

  .sub-tab:hover {
    color: var(--text-main);
    background: rgba(255, 255, 255, 0.03);
  }

  .sub-tab.active {
    color: var(--accent-gold);
    background: rgba(var(--accent-gold-rgb), 0.1);
    border-color: rgba(var(--accent-gold-rgb), 0.18);
  }

  .sub-tab.active::after {
    content: none;
  }

  /* Loading indicators */
  .loading-state, .error-state, .empty-state {
    text-align: center;
    padding: 7rem 3rem;
    font-size: 1.6rem;
    color: var(--text-muted);
    font-weight: 600;
    width: 100%;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 2.8rem;
  }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .empty-icon {
    width: 5.6rem;
    height: 5.6rem;
    fill: rgba(255,255,255,0.15);
  }

  /* Dynamic Cards Grid */
  .cards-grid {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    max-width: 1180px;
    width: 100%;
    padding-bottom: 1.2rem;
  }

  /* ==========================================================================
     MODERATION STORY CARD GRID COMPONENT
     ========================================================================== */
  .admin-story-card {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.035), transparent 24%),
      var(--bg-card);
    border: 1px solid var(--border-color);
    border-top: 4px solid var(--bean-accent, var(--accent-gold));
    border-radius: 3rem;
    padding: 3.4rem;
    box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.32);
    display: flex;
    flex-direction: row;
    gap: 3.6rem;
    position: relative;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease, opacity 0.3s ease;
    align-items: stretch;
  }

  .admin-story-card.no-media {
    flex-direction: column;
    gap: 2.8rem;
  }

  .card-left-section {
    flex: 1.4;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
  }

  .card-right-section {
    flex: 1;
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--border-color);
    padding-left: 3.6rem;
    justify-content: flex-start;
    gap: 2rem;
    min-width: 320px;
  }

  .right-section-label {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: rgba(245, 245, 245, 0.45);
    text-transform: uppercase;
    display: block;
    text-align: left;
    margin-bottom: 0.8rem;
  }

  .admin-story-card:hover {
    transform: translateY(-4px);
    border-color: var(--bean-accent, var(--accent-gold));
    box-shadow: 0 2.6rem 5.5rem rgba(0, 0, 0, 0.38);
  }

  .admin-story-card.fading-out {
    opacity: 0;
    transform: scale(0.92) translateY(-10px);
  }

  .card-header-wrapper {
    display: flex;
    align-items: flex-start;
    gap: 1.8rem;
    margin-bottom: 2.4rem;
  }

  .card-avatar {
    width: 5.6rem;
    height: 5.6rem;
    border-radius: 50%;
    border: 2px solid var(--bean-accent, var(--accent-gold));
    overflow: hidden;
    background: rgba(255,255,255,0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .card-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-avatar svg {
    width: 2.4rem;
    height: 2.4rem;
    fill: var(--bean-accent, var(--accent-gold));
  }

  .card-title-meta {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    text-align: left;
  }

  .card-user-name {
    font-weight: 700;
    font-size: 1.75rem;
    color: var(--text-main);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: -0.01em;
  }

  .card-user-meta {
    font-size: 1.25rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-top: 0.4rem;
  }

  .card-handle-badge {
    color: #fff;
    font-weight: 600;
  }

  .card-bean-badge {
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--bean-accent, var(--accent-gold));
  }

  .card-timestamp {
    font-size: 1.15rem;
    color: rgba(245, 245, 245, 0.55);
    font-weight: 700;
    text-align: right;
    flex-shrink: 0;
    align-self: flex-start;
    margin-top: 0.2rem;
    padding: 0.8rem 1.1rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .card-story-body {
    font-size: 1.55rem;
    line-height: 1.9;
    color: rgba(245, 245, 245, 0.88);
    margin-bottom: 2.8rem;
    font-style: italic;
    flex-grow: 1;
    white-space: pre-wrap;
    text-align: left;
    letter-spacing: 0.01em;
    padding: 2.4rem;
    border-radius: 2.2rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  /* Card Media Galleries */
  .card-media-gallery {
    display: flex;
    flex-direction: column;
    gap: 2.2rem;
    width: 100%;
  }

  .card-image-slider {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    padding-bottom: 0.8rem;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .card-image-slider::-webkit-scrollbar {
    display: none;
  }

  .card-image-slider img {
    width: 9.2rem;
    height: 9.2rem;
    object-fit: cover;
    border-radius: 1.6rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    flex-shrink: 0;
    cursor: pointer;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .card-image-slider img:hover {
    transform: scale(1.04) translateY(-2px);
    border-color: var(--bean-accent);
  }

  .card-video-player {
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 2.2rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: #000;
  }

  .card-video-player video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Action Controls Panel */
  .card-action-bar {
    border-top: 1px solid var(--border-color);
    padding-top: 2.4rem;
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .card-btn {
    flex: 1;
    min-width: 180px;
    padding: 1.5rem 2rem;
    border-radius: 1.4rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    background: transparent;
    transition: all 0.25s ease;
  }

  .card-btn.approve {
    border: 1px solid var(--accent-green);
    color: var(--accent-green);
  }

  .card-btn.approve:hover {
    background: var(--accent-green);
    color: #fff;
    box-shadow: 0 1rem 2rem rgba(56, 142, 60, 0.15);
  }

  .card-btn.reject {
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--text-muted);
  }

  .card-btn.reject:hover {
    border-color: var(--accent-red);
    color: var(--accent-red);
    background: rgba(211, 47, 47, 0.05);
  }

  /* ==========================================================================
     PLACEHOLDER CONSOLE SCREEN
     ========================================================================== */
  .placeholder-module-card {
    background:
      linear-gradient(180deg, rgba(var(--accent-gold-rgb), 0.08), transparent 30%),
      var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 3.2rem;
    padding: 5rem 4.5rem;
    text-align: left;
    max-width: 760px;
    margin: 2rem 0 0;
    box-shadow: 0 25px 60px rgba(0,0,0,0.25);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2.4rem;
    animation: modalEnter 0.4s ease;
  }

  .placeholder-graphic {
    width: 8rem;
    height: 8rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.03);
    border: 2px dashed rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-gold);
  }

  .placeholder-graphic svg {
    width: 3.6rem;
    height: 3.6rem;
    fill: currentColor;
  }

  .placeholder-module-card h3 {
    font-family: var(--font-heading);
    font-size: 2.6rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: #FFF;
    margin-bottom: 0.5rem;
  }

  .placeholder-module-card p {
    font-size: 1.45rem;
    color: var(--text-muted);
    line-height: 1.8;
    max-width: 56rem;
  }

  .placeholder-action-btn {
    margin-top: 1.5rem;
    padding: 1.6rem 3.5rem;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.12);
    color: var(--text-main);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.3rem;
    border-radius: 1.4rem;
    cursor: pointer;
    transition: all 0.25s ease;
    letter-spacing: 0.08em;
  }

  .placeholder-action-btn:hover {
    background: var(--accent-gold);
    color: #000;
    border-color: var(--accent-gold);
  }

  /* ==========================================================================
     RESPONSIVE DESIGN ADAPTATIONS
     ========================================================================== */
  @media screen and (max-width: 1024px) {
    .admin-dashboard-layout {
      min-height: auto;
      border-radius: 2.4rem;
    }
    .admin-sidebar {
      width: 100%;
      height: auto;
      border-right: none;
      border-bottom: 1px solid var(--border-color);
      padding: 2.5rem 2rem;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
    .sidebar-brand-wrapper {
      margin-bottom: 0;
    }
    .sidebar-menu {
      flex-direction: row;
      flex-grow: 0;
      gap: 1rem;
    }
    .sidebar-footer {
      border-top: none;
      padding-top: 0;
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }
    .admin-profile {
      margin-bottom: 0;
    }
    .logout-btn {
      width: auto;
      padding: 1rem 1.6rem;
    }
    .admin-main-content {
      padding: 3rem 2.2rem 3.5rem;
    }
    .tab-view {
      max-width: none;
      padding-top: 0.6rem;
    }
    .view-header {
      padding: 2.6rem;
    }
    .admin-story-card {
      flex-direction: column;
      gap: 2.5rem;
      padding: 2.5rem;
    }
    .card-right-section {
      border-left: none;
      padding-left: 0;
      min-width: 0;
    }
  }

  @media screen and (max-width: 768px) {
    #AdminPortal-{{ section.id }} {
      padding: 2rem 1rem 3rem;
    }
    .sidebar-menu span, .admin-meta, .logout-btn span {
      display: none;
    }
    .menu-item {
      padding: 1rem;
      justify-content: center;
    }
    .logout-btn {
      padding: 1rem;
    }
    .view-header {
      flex-direction: column;
      gap: 2rem;
      padding: 2.2rem;
      margin-bottom: 2.6rem;
    }
    .metrics-row {
      width: 100%;
      justify-content: stretch;
    }
    .metric-card {
      flex: 1;
      min-width: 0;
    }
    .module-nav-tabs {
      width: 100%;
      margin-bottom: 2.6rem;
    }
    .sub-tab {
      flex: 1 1 calc(50% - 1rem);
      text-align: center;
    }
    .card-header-wrapper {
      flex-wrap: wrap;
    }
    .card-timestamp {
      text-align: left;
    }
    .card-story-body {
      padding: 1.8rem;
    }
    .placeholder-module-card {
      padding: 3.2rem 2.4rem;
    }
  }

  /* Google Drive Connection Card Styling */
  .gdrive-connection-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 3rem;
    margin-bottom: 3.2rem;
    padding: 2.4rem 3.2rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 2.4rem;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.03), transparent), rgba(0, 0, 0, 0.2);
    box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.15);
  }

  .gdrive-status-info {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .gdrive-icon {
    width: 4.2rem;
    height: 4.2rem;
    fill: #4285F4;
    flex-shrink: 0;
  }

  .gdrive-text {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-align: left;
  }

  .gdrive-text h4 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.8rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: #FFF;
  }

  .gdrive-status-text {
    margin: 0;
    font-size: 1.35rem;
    color: var(--text-muted);
  }

  .gdrive-status-text.connected {
    color: var(--accent-green);
  }

  .gdrive-status-text.disconnected {
    color: var(--text-muted);
  }

  .gdrive-status-text.error {
    color: var(--accent-red);
  }

  .gdrive-email-highlight {
    font-weight: 700;
    color: #FFF;
  }

  .gdrive-actions {
    display: flex;
    gap: 1rem;
  }

  .gdrive-btn {
    padding: 1.2rem 2.8rem;
    border-radius: 1.2rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .gdrive-btn.connect {
    background: #4285F4;
    border: 1px solid #4285F4;
    color: #FFF;
  }

  .gdrive-btn.connect:hover {
    background: #357ae8;
    border-color: #357ae8;
    box-shadow: 0 0.8rem 2rem rgba(66, 133, 244, 0.25);
  }

  .gdrive-btn.disconnect {
    background: transparent;
    border: 1px solid rgba(211, 47, 47, 0.5);
    color: var(--accent-red);
  }

  .gdrive-btn.disconnect:hover {
    background: var(--accent-red);
    color: #FFF;
    border-color: var(--accent-red);
    box-shadow: 0 0.8rem 2rem rgba(211, 47, 47, 0.25);
  }

  @media screen and (max-width: 768px) {
    .gdrive-connection-card {
      flex-direction: column;
      align-items: stretch;
      gap: 2rem;
      padding: 2.2rem;
    }
    .gdrive-actions {
      justify-content: flex-start;
    }
  }

  /* Publish / Unpublish Actions & Badges */
  .card-live-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.15rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.4rem 1.1rem;
    border-radius: 999px;
    background: rgba(76, 175, 80, 0.1);
    color: var(--accent-green);
    border: 1px solid rgba(76, 175, 80, 0.2);
    margin-top: 0.4rem;
  }

  .card-btn.publish {
    border: 1px solid var(--accent-gold);
    color: var(--accent-gold);
  }

  .card-btn.publish:hover {
    background: var(--accent-gold);
    color: #000;
    box-shadow: 0 1rem 2rem rgba(198, 169, 105, 0.15);
  }

  .card-btn.unpublish {
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--text-muted);
  }

  .card-btn.unpublish:hover {
    border-color: #FFF;
    color: #FFF;
    background: rgba(255, 255, 255, 0.05);
  }
{%- endstyle -%}

