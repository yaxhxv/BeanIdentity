{% comment %}
  SECTION: ADMIN PORTAL SPA
  - Single Page Application admin portal for moderating stories, returns, and sizing.
  - Fully hosted on Shopify, avoiding any front-end server deployments.
{% endcomment %}

{%- style -%}
  /* --- DESIGN SYSTEM & VARIABLES --- */
  #AdminPortal-{{ section.id }} {
    --font-heading: 'Outfit', sans-serif;
    --font-body: 'Poppins', sans-serif;

    --bg-main: #090909;
    --bg-sidebar: #0d0d0d;
    --bg-card: #121212;
    --bg-elevated: #181818;
    --border: rgba(255, 255, 255, 0.07);
    --text-primary: #f0f0f0;
    --text-muted: rgba(240, 240, 240, 0.45);
    --gold: #C6A969;
    --gold-glow: rgba(198, 169, 105, 0.12);
    --green: #388E3C;
    --red: #C62828;
    --blue-accent: #4FC3F7;

    /* Bean type colors */
    --coffee: #A67C52;
    --chilli: #D32F2F;
    --vanilla: #E8D5A3;
    --jelly: #EC407A;
    --green-bean: #43A047;

    display: block;
    width: 100%;
    min-height: 100vh;
    background-color: var(--bg-main);
    color: var(--text-primary);
    font-family: var(--font-body);
    position: relative;
    overflow: hidden;
  }

  #AdminPortal-{{ section.id }} * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  /* Custom Scrollbars */
  #AdminPortal-{{ section.id }} ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  #AdminPortal-{{ section.id }} ::-webkit-scrollbar-track {
    background: transparent;
  }
  #AdminPortal-{{ section.id }} ::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.12);
    border-radius: 3px;
  }
  #AdminPortal-{{ section.id }} ::-webkit-scrollbar-thumb:hover {
    background: var(--gold);
  }

  /* AUTHENTICATION GATE */
  #AdminPortal-{{ section.id }} .auth-gate-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #090909;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99999;
    padding: 24px;
    overflow: hidden;
  }

  #AdminPortal-{{ section.id }} .auth-glow-bg {
    position: absolute;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(198, 169, 105, 0.1) 0%, rgba(198, 169, 105, 0) 70%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 0;
    animation: authGlowPulse-{{ section.id }} 6s infinite alternate ease-in-out;
  }

  @keyframes authGlowPulse-{{ section.id }} {
    0% { transform: translate(-50%, -50%) scale(0.95); opacity: 0.6; }
    100% { transform: translate(-50%, -50%) scale(1.15); opacity: 1; }
  }

  #AdminPortal-{{ section.id }} .auth-gate-card {
    position: relative;
    z-index: 1;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-top: 4px solid var(--gold);
    border-radius: 20px;
    padding: 56px 48px;
    width: 100%;
    max-width: 480px;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.7);
    animation: modalEnter-{{ section.id }} 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes modalEnter-{{ section.id }} {
    0% { transform: scale(0.96) translateY(12px); opacity: 0; }
    100% { transform: scale(1) translateY(0); opacity: 1; }
  }

  #AdminPortal-{{ section.id }} .auth-gate-header {
    text-align: center;
    margin-bottom: 32px;
  }

  #AdminPortal-{{ section.id }} .auth-brand {
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: var(--gold);
    display: block;
    margin-bottom: 8px;
  }

  #AdminPortal-{{ section.id }} .auth-gate-header h2 {
    font-family: var(--font-heading);
    font-size: 28px;
    font-weight: 900;
    letter-spacing: -0.01em;
    margin-bottom: 12px;
    color: var(--text-primary);
  }

  #AdminPortal-{{ section.id }} .auth-gate-header p {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.6;
  }

  #AdminPortal-{{ section.id }} .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 24px;
  }

  #AdminPortal-{{ section.id }} .form-group label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  #AdminPortal-{{ section.id }} .form-group input {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 16px;
    color: var(--text-primary);
    font-family: inherit;
    font-size: 14px;
    letter-spacing: 0.05em;
    transition: all 0.2s ease;
  }

  #AdminPortal-{{ section.id }} .form-group input:focus {
    outline: none;
    border-color: var(--gold);
    box-shadow: 0 0 0 3px var(--gold-glow);
  }

  #AdminPortal-{{ section.id }} .auth-error-msg {
    color: var(--red);
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 20px;
    text-align: center;
    animation: shake-{{ section.id }} 0.3s ease;
  }

  @keyframes shake-{{ section.id }} {
    0%, 100% { transform: translateX(0); }
    20%, 60% { transform: translateX(-4px); }
    40%, 80% { transform: translateX(4px); }
  }

  #AdminPortal-{{ section.id }} .auth-submit-btn {
    width: 100%;
    padding: 16px;
    border: 1px solid var(--gold);
    background: transparent;
    color: var(--text-primary);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.08em;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  #AdminPortal-{{ section.id }} .auth-submit-btn:hover {
    background: var(--gold);
    color: #000;
    box-shadow: 0 8px 24px var(--gold-glow);
  }

  #AdminPortal-{{ section.id }} .auth-submit-btn:focus {
    outline: none;
    box-shadow: 0 0 0 3px var(--gold-glow);
  }

  /* MAIN DASHBOARD LAYOUT */
  #AdminPortal-{{ section.id }} .admin-dashboard-layout {
    display: flex;
    width: 100%;
    height: 100vh;
  }

  /* SIDEBAR styling */
  #AdminPortal-{{ section.id }} .admin-sidebar {
    width: 260px;
    height: 100%;
    background-color: var(--bg-sidebar);
    display: flex;
    flex-direction: column;
    padding: 32px 20px;
    flex-shrink: 0;
    position: relative;
    box-shadow: inset -1px 0 0 rgba(255, 255, 255, 0.05);
  }

  #AdminPortal-{{ section.id }} .sidebar-brand-wrapper {
    margin-bottom: 40px;
    padding-left: 8px;
  }

  #AdminPortal-{{ section.id }} .sidebar-logo {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: var(--gold);
    display: block;
  }

  #AdminPortal-{{ section.id }} .sidebar-badge {
    display: block;
    font-family: var(--font-heading);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    text-transform: uppercase;
    margin-top: 4px;
  }

  #AdminPortal-{{ section.id }} .sidebar-menu {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-grow: 1;
  }

  #AdminPortal-{{ section.id }} .menu-item {
    width: 100%;
    height: 48px;
    background: transparent;
    border: none;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 0 16px;
    border-radius: 12px;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: inherit;
    font-weight: 600;
    font-size: 13px;
    text-align: left;
  }

  #AdminPortal-{{ section.id }} .menu-icon {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  #AdminPortal-{{ section.id }} .menu-item:hover {
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-primary);
  }

  #AdminPortal-{{ section.id }} .menu-item.active {
    background: var(--gold-glow);
    color: var(--gold);
    border-left: 3px solid var(--gold);
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
  }

  #AdminPortal-{{ section.id }} .menu-item:focus {
    outline: none;
    box-shadow: inset 0 0 0 1px var(--gold);
  }

  #AdminPortal-{{ section.id }} .sidebar-footer {
    border-top: 1px solid var(--border);
    padding-top: 24px;
    margin-top: auto;
  }

  #AdminPortal-{{ section.id }} .admin-profile {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    padding: 0 8px;
  }

  #AdminPortal-{{ section.id }} .admin-avatar {
    width: 36px;
    height: 36px;
    background: var(--gold);
    color: #000;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 16px;
  }

  #AdminPortal-{{ section.id }} .admin-meta {
    display: flex;
    flex-direction: column;
  }

  #AdminPortal-{{ section.id }} .admin-name {
    font-weight: 600;
    font-size: 13px;
    color: var(--text-primary);
  }

  #AdminPortal-{{ section.id }} .admin-role {
    font-size: 11px;
    color: var(--text-muted);
  }

  #AdminPortal-{{ section.id }} .logout-btn {
    width: 100%;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-muted);
    padding: 12px;
    border-radius: 10px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 11px;
    transition: all 0.2s ease;
  }

  #AdminPortal-{{ section.id }} .logout-icon {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }

  #AdminPortal-{{ section.id }} .logout-btn:hover {
    border-color: var(--red);
    color: var(--red);
    background: rgba(198, 40, 40, 0.05);
  }

  #AdminPortal-{{ section.id }} .logout-btn:focus {
    outline: none;
    box-shadow: 0 0 0 2px rgba(198, 40, 40, 0.2);
  }

  /* MAIN VIEWPORT */
  #AdminPortal-{{ section.id }} .admin-main-content {
    flex-grow: 1;
    height: 100%;
    overflow-y: auto;
    padding: 56px 64px;
  }

  #AdminPortal-{{ section.id }} .tab-view {
    display: none;
    max-width: 1400px;
    margin: 0 auto;
    animation: viewFadeIn-{{ section.id }} 0.3s ease both;
  }

  #AdminPortal-{{ section.id }} .tab-view.active {
    display: block;
  }

  @keyframes viewFadeIn-{{ section.id }} {
    0% { opacity: 0; transform: translateY(8px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  #AdminPortal-{{ section.id }} .view-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    margin-bottom: 40px;
  }

  #AdminPortal-{{ section.id }} .view-header h1 {
    font-family: var(--font-heading);
    font-size: 36px;
    font-weight: 900;
    letter-spacing: -0.01em;
    margin-bottom: 12px;
    text-transform: uppercase;
    position: relative;
    padding-bottom: 12px;
    color: #fff;
  }

  #AdminPortal-{{ section.id }} .view-header h1::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 40px;
    height: 4px;
    background-color: var(--gold);
  }

  #AdminPortal-{{ section.id }} .view-header p {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 680px;
  }

  /* Metrics Row (Stories / Global) */
  #AdminPortal-{{ section.id }} .metrics-row {
    display: flex;
    gap: 16px;
    flex-shrink: 0;
  }

  #AdminPortal-{{ section.id }} .metric-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 16px 24px;
    width: 160px;
    text-align: center;
    box-shadow: 0 8px 24px rgba(0,0,0,0.2);
  }

  #AdminPortal-{{ section.id }} .metric-num {
    font-family: var(--font-heading);
    font-size: 32px;
    font-weight: 900;
    color: var(--gold);
    line-height: 1.2;
    display: block;
    margin-bottom: 4px;
  }

  #AdminPortal-{{ section.id }} .metric-lbl {
    font-size: 10px;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Google Drive Connection Card */
  #AdminPortal-{{ section.id }} .gdrive-connection-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    margin-bottom: 32px;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--bg-card);
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
  }

  #AdminPortal-{{ section.id }} .gdrive-status-info {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  #AdminPortal-{{ section.id }} .gdrive-icon {
    width: 36px;
    height: 36px;
    fill: #4285F4;
    flex-shrink: 0;
  }

  #AdminPortal-{{ section.id }} .gdrive-text h4 {
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 700;
    color: var(--text-primary);
  }

  #AdminPortal-{{ section.id }} .gdrive-status-text {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 4px;
  }

  #AdminPortal-{{ section.id }} .gdrive-status-text.connected {
    color: var(--green);
  }

  #AdminPortal-{{ section.id }} .gdrive-status-text.disconnected {
    color: var(--text-muted);
  }

  #AdminPortal-{{ section.id }} .gdrive-status-text.error {
    color: var(--red);
  }

  #AdminPortal-{{ section.id }} .gdrive-email-highlight {
    font-weight: 700;
    color: var(--text-primary);
  }

  #AdminPortal-{{ section.id }} .gdrive-btn {
    padding: 10px 24px;
    border-radius: 8px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  #AdminPortal-{{ section.id }} .gdrive-btn.connect {
    background: #4285F4;
    border: 1px solid #4285F4;
    color: #FFF;
  }

  #AdminPortal-{{ section.id }} .gdrive-btn.connect:hover {
    background: #357ae8;
    box-shadow: 0 4px 12px rgba(66, 133, 244, 0.2);
  }

  #AdminPortal-{{ section.id }} .gdrive-btn.disconnect {
    background: transparent;
    border: 1.5px solid var(--border);
    color: var(--red);
  }

  #AdminPortal-{{ section.id }} .gdrive-btn.disconnect:hover {
    background: rgba(198, 40, 40, 0.05);
    border-color: var(--red);
  }

  /* Sub tabs queue selector (Pill container) */
  #AdminPortal-{{ section.id }} .module-nav-tabs {
    display: inline-flex;
    background: var(--bg-elevated);
    padding: 4px;
    border-radius: 8px;
    gap: 4px;
    margin-bottom: 32px;
  }

  #AdminPortal-{{ section.id }} .sub-tab {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 12px;
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s ease;
  }

  #AdminPortal-{{ section.id }} .sub-tab:hover {
    color: var(--text-primary);
  }

  #AdminPortal-{{ section.id }} .sub-tab.active {
    background: var(--gold);
    color: #000000;
  }

  #AdminPortal-{{ section.id }} .sub-tab-badge {
    font-size: 10px;
    padding: 2px 6px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    color: var(--text-muted);
    transition: all 0.2s ease;
  }

  #AdminPortal-{{ section.id }} .sub-tab.active .sub-tab-badge {
    background: rgba(0, 0, 0, 0.12);
    color: #000;
  }

  /* Grid System */
  #AdminPortal-{{ section.id }} .cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  @media screen and (max-width: 1200px) {
    #AdminPortal-{{ section.id }} .cards-grid {
      grid-template-columns: 1fr;
    }
  }

  /* STORY CARDS REDESIGN */
  #AdminPortal-{{ section.id }} .admin-story-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-top: 3px solid var(--bean-accent, var(--gold));
    border-radius: 16px;
    padding: 28px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.25s ease, box-shadow 0.25s ease, opacity 0.25s ease;
  }

  #AdminPortal-{{ section.id }} .admin-story-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.3);
  }

  #AdminPortal-{{ section.id }} .admin-story-card.fading-out {
    opacity: 0;
    transform: scale(0.96) translateY(-10px);
  }

  #AdminPortal-{{ section.id }} .card-header-wrapper {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
  }

  #AdminPortal-{{ section.id }} .card-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 2px solid var(--bean-accent, var(--gold));
    overflow: hidden;
    background: rgba(255, 255, 255, 0.02);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  #AdminPortal-{{ section.id }} .card-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #AdminPortal-{{ section.id }} .card-avatar svg {
    width: 20px;
    height: 20px;
    fill: var(--bean-accent, var(--gold));
  }

  #AdminPortal-{{ section.id }} .card-title-meta {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  #AdminPortal-{{ section.id }} .card-user-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 16px;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  #AdminPortal-{{ section.id }} .card-user-meta {
    font-size: 11px;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 2px;
  }

  #AdminPortal-{{ section.id }} .card-handle-badge {
    color: var(--text-muted);
  }

  #AdminPortal-{{ section.id }} .card-bean-badge {
    text-transform: uppercase;
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.05em;
    color: var(--bean-accent, var(--gold));
    background: rgba(255, 255, 255, 0.03);
    padding: 2px 8px;
    border-radius: 20px;
  }

  #AdminPortal-{{ section.id }} .card-timestamp {
    font-size: 10px;
    color: var(--text-muted);
    font-weight: 500;
    text-align: right;
    flex-shrink: 0;
    align-self: flex-start;
    margin-top: 4px;
  }

  #AdminPortal-{{ section.id }} .card-live-badge {
    display: inline-block;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 2px 8px;
    border-radius: 12px;
    text-transform: uppercase;
    background-color: rgba(56, 142, 60, 0.1);
    color: #81C784;
    border: 1px solid rgba(56, 142, 60, 0.2);
  }

  /* Card Body Text */
  #AdminPortal-{{ section.id }} .card-story-body {
    font-size: 14px;
    line-height: 1.7;
    color: rgba(240, 240, 240, 0.8);
    margin-bottom: 20px;
    font-style: italic;
    flex-grow: 1;
    white-space: pre-wrap;
    max-height: 120px;
    overflow: hidden;
    transition: max-height 0.3s ease;
    position: relative;
    text-align: left;
  }

  #AdminPortal-{{ section.id }} .card-story-body.expanded {
    max-height: none;
  }

  #AdminPortal-{{ section.id }} .read-more-toggle-btn {
    background: transparent;
    border: none;
    color: var(--gold);
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    padding: 0;
    margin-bottom: 20px;
    margin-top: -12px;
    align-self: flex-start;
    transition: color 0.2s ease;
  }

  #AdminPortal-{{ section.id }} .read-more-toggle-btn:hover {
    color: #fff;
    text-decoration: underline;
  }

  /* Media Gallery in Card */
  #AdminPortal-{{ section.id }} .card-media-section {
    margin-top: 8px;
    margin-bottom: 24px;
  }

  #AdminPortal-{{ section.id }} .media-section-label {
    font-family: var(--font-heading);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 12px;
    text-transform: uppercase;
    text-align: left;
  }

  #AdminPortal-{{ section.id }} .card-media-gallery {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  #AdminPortal-{{ section.id }} .card-image-slider {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 6px;
  }

  #AdminPortal-{{ section.id }} .card-image-slider img {
    width: 88px;
