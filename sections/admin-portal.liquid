  #AdminPortal-{{ section.id }} .skeleton-bar:nth-child(2) { width: 85%; }
  #AdminPortal-{{ section.id }} .skeleton-bar:nth-child(3) { width: 55%; }

  @keyframes skeleton-pulse-{{ section.id }} {
    0% { opacity: 0.4; }
    50% { opacity: 0.8; }
    100% { opacity: 0.4; }
