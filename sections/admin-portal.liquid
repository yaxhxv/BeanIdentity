      gap: 32px;
    }

    #AdminPortal-{{ section.id }} .funnel-step-row {
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
    }

    #AdminPortal-{{ section.id }} .funnel-step-label {
      text-align: left;
      width: 100%;
    }

    #AdminPortal-{{ section.id }} .funnel-step-value {
      width: 100%;
      text-align: right;
    }
  }
{%- endstyle -%}

<div id="AdminPortal-{{ section.id }}">
  <!-- AUTH GATE SCREEN -->
  <div id="auth-gate" class="auth-gate-overlay">
    <div class="auth-glow-bg"></div>
    <div class="auth-gate-card">
      <div class="auth-gate-header">
        <span class="auth-brand">BEAN IDENTITY</span>
        <h2>ADMIN PORTAL</h2>
        <p>Please enter your pre-shared Administrator Secret Key to access the moderation systems.</p>
      </div>

      <form id="auth-form">
        <div class="form-group">
          <label for="admin-secret-input">SECRET ACCESS KEY</label>
