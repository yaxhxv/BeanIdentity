    #AdminPortal-{{ section.id }} .sidebar-footer {
      border-top: none;
      padding-top: 0;
      display: flex;
      align-items: center;
      gap: 16px;
    }

    #AdminPortal-{{ section.id }} .admin-profile {
      margin-bottom: 0;
      padding: 0;
    }

    #AdminPortal-{{ section.id }} .admin-meta {
      display: none;
    }

    #AdminPortal-{{ section.id }} .logout-btn {
      width: auto;
      padding: 8px 12px;
    }

    #AdminPortal-{{ section.id }} .logout-btn span {
      display: none;
    }

    #AdminPortal-{{ section.id }} .admin-main-content {
      padding: 40px 24px;
    }

    #AdminPortal-{{ section.id }} .analytics-dashboard-grid {
      grid-template-columns: 1fr;
