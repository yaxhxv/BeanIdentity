  }

  @media screen and (max-width: 768px) {
    #AdminPortal-{{ section.id }} .view-header {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
    }

    #AdminPortal-{{ section.id }} .metrics-row {
