{%- comment -%}
  SECTION: DYNAMIC BEAN HERO (PREMIUM)
  - High-impact cinematic banner using specific store assets.
  - Features dynamic bean selection mapped to file_url PNGs.
  - Premium typography with Ken Burns effects and film grain texture.
{%- endcomment -%}

{%- style -%}
  .bean-hero-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: {{ section.settings.desktop_height }}vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: #0b0b0b;
    color: #f5f5f5;
  }

  .bean-hero-{{ section.id }} .bean-hero-track {
    display: flex;
    width: 100%;
    height: 100%;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bean-hero-{{ section.id }} .bean-hero-slide {
    flex: 0 0 100%;
    width: 100%;
    position: relative;
    min-height: inherit;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    padding: 0 8% 8rem;
  }

  .bean-hero-{{ section.id }} .bean-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transition: transform 12s ease-out;
    z-index: 1;
    transform: scale(1.05); /* Start slightly zoomed for Ken Burns */
  }

  .bean-hero-{{ section.id }} .bean-hero-slide.is-active .bean-hero-bg {
    transform: scale(1.15); /* Slow Ken Burns zoom in */
  }

  /* Cinematic Overlays */
  .bean-hero-{{ section.id }} .bean-hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      to top right,
      rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 | times: 1.8 }}) 0%,
      rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }}) 40%,
      transparent 100%
    );
  }

  /* Film Grain Texture */
  .bean-hero-{{ section.id }} .film-grain {
    position: absolute;
    inset: 0;
    z-index: 3;
    opacity: 0.04;
    pointer-events: none;
    background-image: url('data:image/svg+xml;base64,');
  }

  /* Typography */
  .bean-hero-{{ section.id }} .bean-hero-content {
    position: relative;
    z-index: 4;
    max-width: 900px;
    opacity: 0;
    transform: translateX(-40px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.5s;
  }

  .bean-hero-{{ section.id }} .bean-hero-slide.is-active .bean-hero-content {
    opacity: 1;
    transform: translateX(0);
  }

  .bean-hero-{{ section.id }} .hero-kicker {
    font-family: 'Poppins', sans-serif;
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: #c6a969;
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .bean-hero-{{ section.id }} .hero-kicker::before {
    content: '';
    width: 4rem;
    height: 1px;
    background: currentColor;
  }

  .bean-hero-{{ section.id }} .hero-title {
    font-family: var(--bean-font, var(--font-heading-family));
    font-size: clamp(5rem, 10vw, 12rem);
    font-weight: 900;
    line-height: 0.85;
    margin: 0 0 2.5rem;
    text-transform: uppercase;
    color: var(--bean-accent);
    position: relative;
    display: inline-block;
    z-index: 1;
    text-shadow: 0 10px 40px rgba(0,0,0,0.3);
  }

  .bean-hero-{{ section.id }} .hero-title::before {
    content: '';
    position: absolute;
    inset: -10rem -15rem;
    background: radial-gradient(circle at center, var(--bean-accent) 0%, transparent 70%);
    opacity: 0.15;
    filter: blur(40px);
    z-index: -1;
    pointer-events: none;
  }
  }

  .bean-hero-{{ section.id }} .hero-subtitle {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(1.8rem, 2.2vw, 2.4rem);
    font-weight: 500;
    line-height: 1.5;
    margin-bottom: 4rem;
    color: rgba(245, 245, 245, 0.85);
    max-width: 55ch;
    text-wrap: balance;
  }

  /* CTA Button - High Impact */
  .bean-hero-{{ section.id }} .hero-actions {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .bean-hero-{{ section.id }} .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 2.2rem 5rem;
    background: #fff;
    color: #0b0b0b;
    font-family: 'Poppins', sans-serif;
    font-size: 1.3rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    box-shadow: 0 15px 35px rgba(0,0,0,0.3);
    position: relative;
    overflow: hidden;
  }

  .bean-hero-{{ section.id }} .hero-btn::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #c6a969;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    z-index: -1;
  }

  .bean-hero-{{ section.id }} .hero-btn:hover {
    color: #fff;
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(198, 169, 105, 0.3);
  }

  .bean-hero-{{ section.id }} .hero-btn:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .bean-hero-{{ section.id }} .hero-btn--outline {
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255,255,255,0.4);
  }

  .bean-hero-{{ section.id }} .hero-btn--outline:hover {
    border-color: #fff;
    background: rgba(255,255,255,0.1);
  }

  /* Mobile Adjustments */
  @media screen and (max-width: 749px) {
    .bean-hero-{{ section.id }} {
      min-height: {{ section.settings.mobile_height }}vh;
    }
    .bean-hero-{{ section.id }} .bean-hero-slide {
      padding: 4rem 5%;
      align-items: flex-end;
      text-align: center;
      justify-content: center;
    }
    .bean-hero-{{ section.id }} .bean-hero-content {
      transform: translateY(30px);
      transition-delay: 0.2s;
    }
    .bean-hero-{{ section.id }} .bean-hero-slide.is-active .bean-hero-content {
      transform: translateY(0);
    }
    .bean-hero-{{ section.id }} .hero-kicker {
      justify-content: center;
      font-size: 1.1rem;
    }
    .bean-hero-{{ section.id }} .hero-kicker::before {
      display: none;
    }
    .bean-hero-{{ section.id }} .hero-title {
      font-size: 5.4rem;
    }
    .bean-hero-{{ section.id }} .hero-actions {
      flex-direction: column;
      gap: 1.5rem;
    }
    .bean-hero-{{ section.id }} .hero-btn {
      width: 100%;
      padding: 2rem 3rem;
    }
    .bean-hero-{{ section.id }} .bean-hero-overlay {
      background: linear-gradient(
        to bottom,
        transparent 0%,
        rgba(0, 0, 0, 0.4) 40%,
        rgba(0, 0, 0, 0.9) 100%
      );
    }
  }

  /* Pagination Dots */
  .bean-hero-dots {
    position: absolute;
    bottom: 4rem;
    right: 8%;
    display: flex;
    gap: 1.5rem;
    z-index: 5;
  }

  .bean-hero-dot {
    width: 5rem;
    height: 2px;
    background: rgba(255, 255, 255, 0.2);
    cursor: pointer;
    border: none;
    padding: 0;
    transition: all 0.4s ease;
  }

  .bean-hero-dot.is-active {
    background: #c6a969;
    width: 8rem;
  }

  /* Custom Cursor Hint */
  .scroll-hint {
    position: absolute;
    bottom: 4rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 5;
    opacity: 0.6;
    animation: bounce 2s infinite;
  }

  @keyframes bounce {
    0%, 20%, 50%, 80%, 100% {transform: translateY(0) translateX(-50%);}
    40% {transform: translateY(-10px) translateX(-50%);}
    60% {transform: translateY(-5px) translateX(-50%);}
  }
{%- endstyle -%}

<script>
  console.log('--- BEAN HERO DEBUG ---');
  console.log('Collection Handle:', {{ collection.handle | json }});
  console.log('Section ID:', {{ section.id | json }});
  console.log('Blocks Count:', {{ section.blocks.size | json }});
  {% for block in section.blocks %}
    console.log('Block {{ forloop.index }}:', {
      type: {{ block.settings.bean_type | json }},
      title: {{ block.settings.title | json }}
    });
  {% endfor %}
</script>

<div
  class="bean-hero-{{ section.id }}"
  id="BeanHero-{{ section.id }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.speed }}"
>
  <div class="film-grain"></div>

  <div class="bean-hero-track">
    {%- for block in section.blocks -%}
      {%- liquid
        case block.settings.bean_type
          when 'vanilla'
            assign bean_filename = 'vanilla_bean_hero.png'
            assign bean_font = '"Caprasimo", serif'
          when 'green'
            assign bean_filename = 'green_bean_hero.png'
            assign bean_font = '"Poppins", sans-serif'
          when 'coffee'
            assign bean_filename = 'coffee_bean_hero.png'
            assign bean_font = '"Playfair Display", serif'
          when 'jelly'
            assign bean_filename = 'jelly_bean_hero.png'
            assign bean_font = '"Baloo 2", cursive'
          when 'chilli'
            assign bean_filename = 'ChilliBeanHero2.png'
            assign bean_font = '"Bangers", system-ui'
        endcase

        assign bg_image_url = bean_filename | file_url
      -%}
      <script>
        console.log('Block {{ forloop.index }} Image:', {{ bg_image_url | json }});
      </script>

      <div
        class="bean-hero-slide {% if forloop.first %}is-active{% endif %}"
        {{ block.shopify_attributes }}
        style="--bean-font: {{ bean_font }};"
      >
        <div class="bean-hero-bg" style="background-image: url('{{ bg_image_url }}');"></div>
        <div class="bean-hero-overlay"></div>

        <div class="bean-hero-content">
          {%- if block.settings.kicker != blank -%}
            <span class="hero-kicker">{{ block.settings.kicker }}</span>
          {%- endif -%}

          {%- if block.settings.title != blank -%}
            <h2 class="hero-title">{{ block.settings.title | escape }}</h2>
          {%- endif -%}

          {%- if block.settings.subtitle != blank -%}
            <div class="hero-subtitle">{{ block.settings.subtitle }}</div>
          {%- endif -%}

          <div class="hero-actions">
            {%- if block.settings.button_label != blank -%}
              <a href="{{ block.settings.button_link | default: '#' }}" class="hero-btn">
                {{ block.settings.button_label | escape }}
              </a>
            {%- endif -%}

            {%- if block.settings.secondary_button_label != blank -%}
              <a href="{{ block.settings.secondary_button_link | default: '#' }}" class="hero-btn hero-btn--outline">
                {{ block.settings.secondary_button_label | escape }}
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="bean-hero-dots">
      {%- for block in section.blocks -%}
        <button
          class="bean-hero-dot {% if forloop.first %}is-active{% endif %}"
          data-index="{{ forloop.index0 }}"
          aria-label="Go to slide {{ forloop.index }}"
        ></button>
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="scroll-hint">
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M7 13l5 5 5-5M7 6l5 5 5-5"/>
    </svg>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const section = document.getElementById('BeanHero-{{ section.id }}');
    if (!section) return;

    const track = section.querySelector('.bean-hero-track');
    const slides = section.querySelectorAll('.bean-hero-slide');
    const dots = section.querySelectorAll('.bean-hero-dot');

    if (slides.length <= 1) return;

    let currentIndex = 0;
    const autoplay = section.dataset.autoplay === 'true';
    const speed = parseInt(section.dataset.speed) * 1000;
    let interval;

    function goToSlide(index) {
      currentIndex = index;
      track.style.transform = `translateX(-${currentIndex * 100}%)`;

      slides.forEach((s) => s.classList.remove('is-active'));
      slides[currentIndex].classList.add('is-active');

      dots.forEach((d) => d.classList.remove('is-active'));
      if (dots[currentIndex]) dots[currentIndex].classList.add('is-active');
    }

    function nextSlide() {
      let next = (currentIndex + 1) % slides.length;
      goToSlide(next);
    }

    function startAutoplay() {
      if (autoplay) {
        interval = setInterval(nextSlide, speed);
      }
    }

    function stopAutoplay() {
      clearInterval(interval);
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        stopAutoplay();
        goToSlide(parseInt(dot.dataset.index));
        startAutoplay();
      });
    });

    section.addEventListener('mouseenter', stopAutoplay);
    section.addEventListener('mouseleave', startAutoplay);

    startAutoplay();
  });
</script>

{% schema %}
{
  "name": "Dynamic Bean Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "desktop_height",
      "label": "Desktop Height",
      "options": [
        { "value": "60", "label": "60vh" },
        { "value": "70", "label": "70vh" },
        { "value": "80", "label": "80vh" },
        { "value": "90", "label": "90vh" },
        { "value": "100", "label": "Full Screen (100vh)" }
      ],
      "default": "80"
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "Mobile Height",
      "options": [
        { "value": "50", "label": "50vh" },
        { "value": "60", "label": "60vh" },
        { "value": "70", "label": "70vh" },
        { "value": "80", "label": "80vh" }
      ],
      "default": "70"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content Alignment (Desktop)",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "flex-start"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay Intensity",
      "default": 40
    },
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Slide Duration",
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "hero_slide",
      "name": "Bean Slide",
      "settings": [
        {
          "type": "select",
          "id": "bean_type",
          "label": "Select Bean Identity",
          "options": [
            { "value": "vanilla", "label": "Vanilla Bean" },
            { "value": "green", "label": "Green Bean" },
            { "value": "coffee", "label": "Coffee Bean" },
            { "value": "jelly", "label": "Jelly Bean" },
            { "value": "chilli", "label": "Chilli Bean" }
          ],
          "default": "vanilla"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "Kicker (Small Text Above)",
          "default": "Identity Series"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Vanilla Bean"
        },
        {
          "type": "richtext",
          "id": "subtitle",
          "label": "Subheading",
          "default": "<p>Experience the clean, quiet, and expensive energy of our premium vanilla selection.</p>"
        },
        {
          "type": "header",
          "content": "Primary Call to Action"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Shop the Drop"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "header",
          "content": "Secondary Call to Action"
        },
        {
          "type": "text",
          "id": "secondary_button_label",
          "label": "Secondary Label",
          "default": "Find Your Bean"
        },
        {
          "type": "url",
          "id": "secondary_button_link",
          "label": "Secondary Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dynamic Bean Hero",
      "blocks": [{ "type": "hero_slide", "settings": { "bean_type": "vanilla", "title": "Vanilla Bean" } }]
    }
  ]
}
{% endschema %}
