            <div class="bean-quiz__blend-bar" data-blend-bar></div>
            <div class="bean-quiz__blend-labels" data-blend-labels></div>
          </div>

          <div class="bean-quiz__result-card">
            <div class="bean-quiz__result-copy-wrap">
