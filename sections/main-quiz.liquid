          } else if (beanImg.complete && beanImg.naturalWidth > 0) {
            const beanSize = 420;
            const beanX = 760 - beanSize / 2;
            const beanY = 460 - beanSize / 2;
            
            const glowGrad = ctx.createRadialGradient(
              beanX + beanSize / 2, beanY + beanSize / 2, 10,
