{%- style -%}
  .bean-quiz-page {
    position: relative;
    overflow: hidden;
    background: radial-gradient(circle at 12% 14%, rgba(198, 169, 105, 0.16), transparent 28%),
      radial-gradient(circle at 88% 22%, rgba(255, 255, 255, 0.08), transparent 24%),
      linear-gradient(180deg, #080808 0%, #101010 52%, #141414 100%);
    color: #f5f5f5;
  }

  .bean-quiz-page::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 5.2rem 5.2rem;
    opacity: 0.22;
    pointer-events: none;
  }

  .bean-quiz-page__shell {
    position: relative;
    z-index: 1;
    width: min(120rem, calc(100% - 4rem));
    margin: 0 auto;
    padding: clamp(2rem, 3.5vw, 3.6rem) 0 clamp(4rem, 6vw, 6rem);
  }

  .bean-quiz-page__hero {
    display: grid;
    grid-template-columns: minmax(0, 72rem);
    gap: 0;
    align-items: center;
    min-height: auto;
    padding: clamp(2rem, 4vw, 3.6rem) 0 2rem;
    border-bottom: 1px solid rgba(245, 245, 245, 0.08);
    justify-content: center;
  }

  .bean-quiz-page__copy {
    text-align: center;
  }

  .bean-quiz-page__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 1.6rem;
    font-family: 'Poppins', sans-serif;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #c6a969;
  }

  .bean-quiz-page__eyebrow::before {
    content: '';
    width: 4.8rem;
    height: 1px;
    background: currentColor;
  }

  .bean-quiz-page__title {
    margin: 0;
    max-width: none;
    font-family: var(--font-heading-family);
    font-size: clamp(4.4rem, 8vw, 9.6rem);
    font-weight: 900;
    line-height: 0.84;
    text-transform: uppercase;
    color: #f5f5f5;
    text-wrap: balance;
  }

  .bean-quiz-page__subtitle {
    max-width: 62rem;
    margin: 1.4rem 0 0;
    margin-inline: auto;
    font-family: 'Poppins', sans-serif;
    font-size: clamp(1.6rem, 1.7vw, 1.85rem);
    line-height: 1.5;
    color: rgba(245, 245, 245, 0.7);
  }

  .bean-quiz {
    max-width: 92rem;
    margin: clamp(2.2rem, 4vw, 3.6rem) auto 0;
  }

  .bean-quiz__status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1.2rem;
  }

  .bean-quiz__status-label,
  .bean-quiz__step-count {
    font-family: 'Poppins', sans-serif;
    font-size: 1.02rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.52);
  }

  .bean-quiz__progress {
    width: 100%;
    height: 0.5rem;
    margin-bottom: 1.8rem;
    background: rgba(245, 245, 245, 0.08);
    overflow: hidden;
  }

  .bean-quiz__progress-bar {
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, #8d6b3d 0%, #c6a969 45%, #f5e3b0 100%);
    transition: width 0.4s ease;
  }

  .bean-quiz__panel {
    position: relative;
    min-height: 22rem;
    padding: clamp(1.6rem, 2vw, 2.2rem);
    border: 1px solid rgba(245, 245, 245, 0.1);
    background: rgba(255, 255, 255, 0.04);
    box-shadow: 0 2rem 6rem rgba(0, 0, 0, 0.22);
    backdrop-filter: blur(10px);
    border-radius: 3rem;
  }

  .bean-quiz__screen {
    display: none;
    opacity: 0;
    transform: translateY(1rem);
    transition: opacity 0.32s ease, transform 0.32s ease;
  }

  .bean-quiz__screen.is-active {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }

  .bean-quiz__intro-title,
  .bean-quiz__question-title,
  .bean-quiz__result-title {
    margin: 0;
    font-family: var(--font-heading-family);
    font-weight: 900;
    text-transform: uppercase;
    color: #f5f5f5;
    letter-spacing: 0;
    line-height: 0.92;
  }

  .bean-quiz__intro-title {
    max-width: 100%;
    font-size: clamp(2.8rem, 3.4vw, 3.8rem);
    line-height: 0.9;
  }

  .bean-quiz__question-title {
    max-width: 28ch;
    font-size: clamp(2.2rem, 4vw, 3rem);
    text-transform: none;
    line-height: 1.1;
  }

  .bean-quiz__result-title {
    font-size: clamp(4rem, 7vw, 7rem);
  }

  .bean-quiz__intro-copy,
  .bean-quiz__question-copy,
  .bean-quiz__result-copy {
    max-width: 58rem;
    margin: 1rem 0 0;
    font-family: 'Poppins', sans-serif;
    font-size: 1.42rem;
    line-height: 1.48;
    color: rgba(245, 245, 245, 0.72);
  }

  .bean-quiz__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 5.6rem;
    padding: 0 2.6rem;
    margin-top: 1.2rem;
    border: 1px solid #c6a969;
    background: #c6a969;
    color: #0b0b0b;
    text-decoration: none;
    font-family: 'Poppins', sans-serif;
    font-size: 1.08rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 0.28s ease, background 0.28s ease, border-color 0.28s ease, color 0.28s ease;
    border-radius: 999px;
  }

  .bean-quiz__screen[data-quiz-screen='welcome'].is-active {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.9fr);
    gap: 2rem;
    align-items: center;
  }

  .bean-quiz__welcome-copy {
    display: grid;
    gap: 0;
  }

  .bean-quiz__welcome-side {
    position: relative;
    min-height: 100%;
    padding: 1.6rem;
    border-radius: 2.2rem;
    background: radial-gradient(circle at 80% 24%, rgba(198, 169, 105, 0.16), transparent 22%),
      rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(245, 245, 245, 0.08);
    overflow: hidden;
  }

  .bean-quiz__welcome-pillars {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .bean-quiz__welcome-pill {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0 1rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(245, 245, 245, 0.08);
    color: rgba(245, 245, 245, 0.78);
    font-family: 'Poppins', sans-serif;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .bean-quiz__welcome-art {
    position: absolute;
    right: -1rem;
    bottom: -1rem;
    width: clamp(110px, 13vw, 160px);
    height: auto;
    opacity: 0.22;
    pointer-events: none;
    filter: drop-shadow(0 1.6rem 2.8rem rgba(0, 0, 0, 0.24));
  }

  .bean-quiz__button:hover {
    transform: translateY(-0.2rem);
    background: #f5f5f5;
    border-color: #f5f5f5;
    color: #0b0b0b;
  }

  .bean-quiz__options {
    display: grid;
    gap: 1.2rem;
    margin-top: 2rem;
  }

  .bean-quiz__option {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.6rem;
    align-items: start;
    width: 100%;
    padding: 1.5rem 1.8rem;
    border: 1px solid rgba(245, 245, 245, 0.1);
    background: rgba(255, 255, 255, 0.02);
    color: #f5f5f5;
    text-align: left;
    cursor: pointer;
    transition: transform 0.24s ease, border-color 0.24s ease, background 0.24s ease, box-shadow 0.24s ease;
  }

  .bean-quiz__option:hover,
  .bean-quiz__option.is-selected {
    transform: translateY(-0.2rem);
    border-color: rgba(198, 169, 105, 0.72);
    background: rgba(198, 169, 105, 0.08);
    box-shadow: 0 1.4rem 3.2rem rgba(0, 0, 0, 0.18);
  }

  .bean-quiz__option-index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.2rem;
    height: 3.2rem;
    border: 1px solid rgba(245, 245, 245, 0.18);
    color: rgba(245, 245, 245, 0.76);
    font-family: 'Poppins', sans-serif;
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .bean-quiz__option-text {
    font-family: 'Poppins', sans-serif;
    font-size: 1.5rem;
    line-height: 1.5;
    color: #f5f5f5;
  }

  .bean-quiz__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 1.8rem;
  }

  .bean-quiz__helper {
    margin: 0;
    font-family: 'Poppins', sans-serif;
    font-size: 1.35rem;
    line-height: 1.6;
    color: rgba(245, 245, 245, 0.5);
  }

  .bean-quiz__ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 5.2rem;
    padding: 0 2.4rem;
    border: 1px solid rgba(245, 245, 245, 0.22);
    background: transparent;
    color: #f5f5f5;
    font-family: 'Poppins', sans-serif;
    font-size: 1.08rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 0.24s ease, border-color 0.24s ease, color 0.24s ease;
  }

  .bean-quiz__ghost:hover {
    transform: translateY(-0.2rem);
    border-color: #f5f5f5;
  }

  .bean-quiz__result-card {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(28rem, 0.9fr);
    gap: 2.4rem;
    margin-top: 2.8rem;
  }

  /* Dossier Table Grid Layout */
  .bean-quiz__detailed-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 2.2rem;
    border-top: 1px solid rgba(245, 245, 245, 0.08);
  }

  .bean-quiz__table-row {
    display: grid;
    grid-template-columns: 24rem minmax(0, 1fr);
    border-bottom: 1px solid rgba(245, 245, 245, 0.08);
    transition: background-color 0.24s ease;
  }

  .bean-quiz__table-row:hover {
    background: rgba(255, 255, 255, 0.015);
  }

  .bean-quiz__table-header-cell {
    padding: 2.2rem 2rem 2.2rem 0;
    font-family: 'Poppins', sans-serif;
    font-size: 1.08rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--result-accent, #c6a969);
    align-self: start;
  }

  .bean-quiz__table-body-cell {
    padding: 2.2rem 0;
    font-family: 'Poppins', sans-serif;
    font-size: 1.42rem;
    line-height: 1.6;
    color: var(--result-ink, #f5f5f5);
    opacity: 0.88;
  }

  /* Mobile responsive collapse */
  @media screen and (max-width: 749px) {
    .bean-quiz__table-row {
      grid-template-columns: 1fr;
      padding: 1.8rem 0;
    }

    .bean-quiz__table-header-cell {
      padding: 0 0 0.8rem;
    }

    .bean-quiz__table-body-cell {
      padding: 0;
    }
  }

  .bean-quiz__screen[data-quiz-screen='result'] {
    --result-bg: rgba(255, 255, 255, 0.04);
    --result-bg-strong: rgba(255, 255, 255, 0.08);
    --result-ink: #f5f5f5;
    --result-copy-soft: rgba(245, 245, 245, 0.72);
    --result-border: rgba(245, 245, 245, 0.1);
    --result-glow: rgba(198, 169, 105, 0.18);
    --result-panel: rgba(255, 255, 255, 0.04);
    --result-panel-alt: rgba(255, 255, 255, 0.03);
    position: relative;
    padding: clamp(2rem, 3vw, 3rem);
    border-radius: 2.6rem;
    overflow: hidden;
    background: radial-gradient(circle at top right, var(--result-glow) 0%, transparent 28rem),
      linear-gradient(135deg, var(--result-bg-strong), var(--result-bg));
    border: 1px solid var(--result-border);
  }

  .bean-quiz__screen[data-quiz-screen='result']::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0)),
      radial-gradient(circle at left bottom, rgba(255, 255, 255, 0.08), transparent 22rem);
    pointer-events: none;
  }

  .bean-quiz__result-hero {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3.2rem;
    align-items: start;
  }

  .bean-quiz__result-copy-block {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .bean-quiz__result-kicker {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin: 0;
    color: var(--result-accent, #c6a969);
    font-family: 'Poppins', sans-serif;
    font-size: 1.02rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .bean-quiz__result-kicker::before {
    content: '';
    width: 4rem;
    height: 1px;
    background: currentColor;
    opacity: 0.7;
  }

  .bean-quiz__result-title {
    margin: 0;
    font-family: var(--font-heading-family);
    font-weight: 900;
    text-transform: uppercase;
    color: var(--result-ink);
    letter-spacing: 0;
    line-height: 0.92;
    font-size: clamp(4rem, 7vw, 7rem);
  }

  .bean-quiz__result-copy {
    margin: 0;
    max-width: 52rem;
    font-family: 'Poppins', sans-serif;
    font-size: 1.42rem;
    line-height: 1.48;
    color: var(--result-copy-soft);
  }

  .bean-quiz__result-visual {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
  }

  .bean-quiz__result-visual-shell {
    position: relative;
    display: grid;
    place-items: center;
    width: min(100%, 36rem); /* flush 36rem */
    min-height: 32rem;
    aspect-ratio: 1 / 1;
    border-radius: 3rem;
    border: none;
    background: #ffffff;
    overflow: visible;
    -webkit-mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 38%, transparent 72%);
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 38%, transparent 72%);
  }

  .bean-quiz__result-visual-shell::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(circle at 50% 50%, var(--result-glow, rgba(198, 169, 105, 0.18)), transparent 70%);
    filter: blur(20px);
    z-index: 0;
  }

  .bean-quiz__result-gif {
    position: relative;
    z-index: 1;
    width: min(100%, 32rem);
    height: auto;
    display: block;
  }

  .bean-quiz__traits {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 0.5rem;
  }

  .bean-quiz__trait {
    display: inline-flex;
    align-items: center;
    min-height: 3.4rem;
    padding: 0 1.3rem;
    border: 1px solid rgba(245, 245, 245, 0.12);
    background: rgba(255, 255, 255, 0.08);
    font-family: 'Poppins', sans-serif;
    font-size: 1.02rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--result-ink);
  }

  .bean-quiz__blend-breakdown {
    padding: 1.8rem 2.2rem;
    border: 1px solid var(--result-border);
    background: var(--result-panel);
    border-radius: 2.2rem;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    margin-top: 1.2rem;
    box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.15);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .bean-quiz__blend-breakdown:hover {
    border-color: rgba(245, 245, 245, 0.2);
    box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.22);
  }

  .bean-quiz__result-label {
    display: inline-flex;
    align-items: center;
    gap: 1.2rem;
    margin: 0 0 1.2rem;
    color: var(--result-accent, #c6a969);
    font-family: var(--bean-heading-font);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1;
  }

  .bean-quiz__result-label::before {
    content: '';
    width: 3.2rem;
    height: 1px;
    background: currentColor;
    opacity: 0.5;
  }

  .bean-quiz__blend-classification {
    font-family: var(--bean-heading-font);
    font-size: clamp(2rem, 3.2vw, 2.8rem);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--result-ink, #f5f5f5);
    margin-bottom: 1.4rem;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .bean-quiz__blend-donut-layout {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2.4rem;
    align-items: center;
    margin-top: 1.4rem;
  }

  .bean-quiz__blend-donut-visual {
    position: relative;
    width: 110px;
    height: 110px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bean-quiz__blend-donut-svg {
    transform: rotate(-90deg);
    width: 100%;
    height: 100%;
  }

  .bean-quiz__blend-donut-circle-bg {
    fill: none;
    stroke: rgba(255, 255, 255, 0.05);
    stroke-width: 8;
  }

  .bean-quiz__blend-donut-segment {
    fill: none;
    stroke-width: 8;
    stroke-linecap: round;
    transition: stroke-dashoffset 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94), stroke-width 0.3s ease, opacity 0.3s ease,
      filter 0.3s ease;
    cursor: pointer;
  }

  .bean-quiz__blend-donut-segment.is-hovered {
    stroke-width: 11;
    filter: drop-shadow(0 0 5px currentColor);
    z-index: 10;
  }

  .bean-quiz__blend-donut-segment.is-dimmed {
    opacity: 0.35;
  }

  .bean-quiz__blend-donut-center-label {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    line-height: 1;
    text-align: center;
    pointer-events: none;
  }

  .bean-quiz__blend-donut-center-number {
    font-family: var(--bean-heading-font);
    font-size: 2rem;
    font-weight: 700;
    color: var(--result-ink, #f5f5f5);
    letter-spacing: -0.02em;
    transition: color 0.25s ease, transform 0.25s ease;
  }

  .bean-quiz__blend-donut-center-sub {
    font-family: var(--bean-body-font);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(245, 245, 245, 0.45);
    margin-top: 0.2rem;
    transition: color 0.25s ease;
  }

  .bean-quiz__blend-donut-legend {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .bean-quiz__legend-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--bean-body-font);
    font-size: 1.25rem;
    line-height: 1.2;
    padding: 0.6rem 1rem;
    border-radius: 0.8rem;
    transition: background-color 0.24s ease, opacity 0.24s ease, transform 0.24s ease;
    cursor: pointer;
  }

  .bean-quiz__legend-item.is-hovered {
    background: rgba(255, 255, 255, 0.05);
    transform: translateX(4px);
  }

  .bean-quiz__legend-item.is-dimmed {
    opacity: 0.35;
  }

  .bean-quiz__legend-label {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    font-weight: 600;
    color: var(--result-ink, #f5f5f5);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    font-size: 1.1rem;
  }

  .bean-quiz__legend-dot {
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    display: inline-block;
    transition: transform 0.24s ease;
  }

  .bean-quiz__legend-item:hover .bean-quiz__legend-dot,
  .bean-quiz__legend-item.is-hovered .bean-quiz__legend-dot {
    transform: scale(1.3);
  }

  .bean-quiz__legend-pct {
    font-family: var(--bean-heading-font);
    font-weight: 700;
    color: white;
    font-size: 1.25rem;
  }

  @media screen and (max-width: 749px) {
    .bean-quiz__blend-donut-layout {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 2rem;
    }
    .bean-quiz__blend-donut-legend {
      width: 100%;
      max-width: 32rem;
    }
  }

  /* Expand max-width of quiz container on bigger screens */
  @media screen and (min-width: 1200px) {
    .bean-quiz {
      max-width: 120rem; /* expanded width for bigger screens */
    }
  }

  /* Dossier Card Grid - default 3 columns (tablets) */
  .bean-quiz__detailed-table {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.2rem;
    margin-top: 3rem;
  }

  /* Center the 10th item (last card) in 3-column layout */
  .bean-quiz__detailed-table > :nth-child(10) {
    grid-column: 2;
  }

  /* 4 columns in a row on bigger screens */
  @media screen and (min-width: 1200px) {
    .bean-quiz__detailed-table {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    /* Center the 9th and 10th items (last 2 cards) in 4-column layout */
    .bean-quiz__detailed-table > :nth-child(9) {
      grid-column: 2;
    }
    .bean-quiz__detailed-table > :nth-child(10) {
      grid-column: 3;
    }
  }

  .bean-quiz__table-card {
    padding: 1.8rem;
    border: 1px solid var(--result-border);
    background: var(--result-panel);
    border-radius: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: transform 0.24s ease, background-color 0.24s ease;
  }

  .bean-quiz__table-card:hover {
    transform: translateY(-0.2rem);
    background: rgba(255, 255, 255, 0.06);
  }

  .bean-quiz__table-header-cell {
    font-family: 'Poppins', sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--result-accent, #c6a969);
  }

  .bean-quiz__table-body-cell {
    font-family: 'Poppins', sans-serif;
    font-size: 1.48rem;
    line-height: 1.6;
    color: var(--result-ink, #f5f5f5);
    opacity: 0.88;
  }

  .bean-quiz__result-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-top: 3.2rem;
    justify-content: center;
  }

  .bean-quiz__button--secondary {
    border-color: rgba(245, 245, 245, 0.22);
    background: transparent;
    color: #f5f5f5;
  }

  .bean-quiz__button--secondary:hover {
    background: #f5f5f5;
    border-color: #f5f5f5;
    color: #0b0b0b;
  }

  @media screen and (max-width: 989px) {
    .bean-quiz__result-hero {
      grid-template-columns: 1fr;
      gap: 2.4rem;
      text-align: center;
      justify-items: center;
    }

    .bean-quiz__result-visual-shell {
      width: min(100%, 32rem);
    }
  }

  @media screen and (max-width: 749px) {
    .bean-quiz__detailed-table {
      grid-template-columns: 1fr;
      margin-top: 2.4rem;
    }
    .bean-quiz__detailed-table > :nth-child(9),
    .bean-quiz__detailed-table > :nth-child(10) {
      grid-column: auto;
    }
  }

  /* Sequential play carousel styles */
  .bean-quiz__result-gif-layer {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(100%, 32rem);
    height: auto;
    display: block;
    opacity: 0;
    z-index: 1;
    pointer-events: none;
    transition: opacity 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .bean-quiz__result-gif-layer.is-active {
    opacity: 1;
    z-index: 2;
    pointer-events: auto;
  }

  .bean-quiz__carousel-badge {
    position: absolute;
    bottom: 3rem; /* Floats over the bottom of the shell */
    left: 50%;
    transform: translateX(-50%);
    background: rgba(11, 11, 11, 0.78);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(245, 245, 245, 0.12);
    padding: 0.8rem 1.8rem;
    border-radius: 999px;
    color: #f5f5f5;
    font-family: 'Poppins', sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    z-index: 10;
    white-space: nowrap;
    pointer-events: none;
    box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .bean-quiz__carousel-badge.is-visible {
    opacity: 1;
  }

  .bean-quiz__carousel-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 1.8rem;
    z-index: 3;
    position: relative;
  }

  .bean-quiz__carousel-dot {
    width: 2.4rem;
    height: 0.6rem;
    border-radius: 999px;
    background: rgba(245, 245, 245, 0.22);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.3s ease, width 0.3s ease, transform 0.2s ease;
  }

  .bean-quiz__carousel-dot:hover {
    background: rgba(245, 245, 245, 0.45);
    transform: scaleY(1.2);
  }

  .bean-quiz__carousel-dot.is-active {
    background: var(--result-accent, #c6a969);
    width: 3.8rem;
  }

  .bean-quiz__result-illustration {
    position: absolute;
    right: -0.8rem;
    bottom: -0.8rem;
    width: clamp(8.6rem, 9vw, 12rem);
    height: auto;
    opacity: 0.95;
    filter: drop-shadow(0 1.2rem 2rem rgba(0, 0, 0, 0.18));
  }

  .bean-quiz__button--secondary {
    border-color: rgba(245, 245, 245, 0.22);
    background: transparent;
    color: #f5f5f5;
  }

  .bean-quiz__button--secondary:hover {
    background: #f5f5f5;
    border-color: #f5f5f5;
    color: #0b0b0b;
  }

  @media screen and (max-width: 989px) {
    .bean-quiz-page__hero,
    .bean-quiz__result-card,
    .bean-quiz__result-hero {
      grid-template-columns: 1fr;
    }

    .bean-quiz-page__title {
      max-width: none;
      font-size: clamp(4.2rem, 14vw, 7.4rem);
    }
  }

  @media screen and (max-width: 749px) {
    .bean-quiz-page__shell {
      width: calc(100% - 3rem);
      padding-top: 1.4rem;
      padding-bottom: 3.2rem;
    }

    .bean-quiz-page__hero {
      gap: 1.6rem;
      padding-top: 2rem;
      padding-bottom: 1.6rem;
    }

    .bean-quiz__panel {
      min-height: auto;
      padding: 2rem 1.6rem;
    }

    .bean-quiz__screen[data-quiz-screen='welcome'].is-active {
      grid-template-columns: 1fr;
      gap: 1.4rem;
    }

    .bean-quiz__welcome-side {
      padding: 1.2rem;
      min-height: 11rem;
    }

    .bean-quiz__welcome-art {
      width: 96px;
    }

    .bean-quiz__status {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.8rem;
    }

    .bean-quiz__option {
      padding: 1.5rem;
      gap: 1.2rem;
    }

    .bean-quiz__option-text,
    .bean-quiz__intro-copy,
    .bean-quiz__question-copy,
    .bean-quiz__result-copy {
      font-size: 1.5rem;
    }

    .bean-quiz__footer,
    .bean-quiz__result-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .bean-quiz__button,
    .bean-quiz__ghost,
    .bean-quiz__button--secondary {
      width: 100%;
    }
  }

  /* Social Media Sharing Section CSS */
  .bean-quiz__share-section {
    margin-top: 3.2rem;
    padding: 2.2rem 2.8rem;
    border: 1px solid var(--result-border, rgba(245, 245, 245, 0.08));
    background: var(--result-panel, rgba(255, 255, 255, 0.03));
    border-radius: 2.2rem;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.15);
    text-align: center;
  }

  .bean-quiz__share-title {
    margin: 0 0 1.6rem;
    font-family: 'Poppins', sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--result-accent, #c6a969);
  }

  .bean-quiz__share-buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
  }

  .bean-quiz__share-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    min-height: 4.8rem;
    padding: 0 2rem;
    border-radius: 999px;
    font-family: 'Poppins', sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(245, 245, 245, 0.1);
    color: var(--result-ink, #f5f5f5);
    transition: transform 0.24s cubic-bezier(0.25, 0.46, 0.45, 0.94), background-color 0.24s ease,
      border-color 0.24s ease, box-shadow 0.24s ease;
    position: relative;
  }

  .bean-quiz__share-btn svg {
    flex-shrink: 0;
    transition: transform 0.24s ease;
  }

  .bean-quiz__share-btn:hover {
    transform: translateY(-0.2rem);
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--result-accent, #c6a969);
    box-shadow: 0 0.8rem 2rem rgba(0, 0, 0, 0.18);
  }

  .bean-quiz__share-btn:hover svg {
    transform: scale(1.1);
  }

  /* Specific network brand accents on hover */
  .bean-quiz__share-btn--twitter:hover {
    border-color: #1da1f2;
    color: #1da1f2;
    background: rgba(29, 161, 242, 0.06);
  }
  .bean-quiz__share-btn--facebook:hover {
    border-color: #1877f2;
    color: #1877f2;
    background: rgba(24, 119, 242, 0.06);
  }
  .bean-quiz__share-btn--whatsapp:hover {
    border-color: #25d366;
    color: #25d366;
    background: rgba(37, 211, 102, 0.06);
  }
  .bean-quiz__share-btn--instagram:hover {
    border-color: #e1306c;
    color: #e1306c;
    background: rgba(225, 48, 108, 0.06);
  }

  /* Copy Button Tooltip */
  .bean-quiz__share-btn--copy {
    position: relative;
  }

  .bean-quiz__share-btn--copy .copied-tooltip {
    position: absolute;
    bottom: 120%;
    left: 50%;
    transform: translateX(-50%) translateY(0.4rem);
    background: #000;
    color: #fff;
    padding: 0.6rem 1.2rem;
    border-radius: 0.6rem;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    box-shadow: 0 0.8rem 2rem rgba(0, 0, 0, 0.4);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.24s ease, transform 0.24s ease;
    white-space: nowrap;
    border: 1px solid var(--result-accent, #c6a969);
  }

  .bean-quiz__share-btn--copy.is-copied .copied-tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* Referred Visitor Banner Styles */
  .bean-quiz__referred-banner {
    margin-bottom: 2.2rem;
    border: 1px solid rgba(198, 169, 105, 0.22);
    background: rgba(198, 169, 105, 0.06);
    border-radius: 2rem;
    padding: 2rem 2.4rem;
    box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.15);
    border-left: 4px solid #c6a969;
    text-align: left;
  }

  .bean-quiz__referred-badge {
    display: inline-block;
    padding: 0.4rem 1rem;
    background: #c6a969;
    color: #0b0b0b;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 1rem;
  }

  .bean-quiz__referred-title {
    margin: 0 0 0.6rem;
    font-family: var(--font-heading-family);
    font-size: clamp(2rem, 3.5vw, 2.4rem);
    font-weight: 900;
    line-height: 1.1;
    color: #f5f5f5;
  }

  .bean-quiz__referred-title span {
    color: #c6a969;
    text-transform: uppercase;
  }

  .bean-quiz__referred-desc {
    margin: 0;
    font-family: 'Poppins', sans-serif;
    font-size: 1.35rem;
    line-height: 1.55;
    color: rgba(245, 245, 245, 0.72);
  }

  /* Instagram Modal Dialog CSS */
  .bean-quiz__insta-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 10000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .bean-quiz__insta-modal:not([hidden]) {
    display: flex;
  }

  .bean-quiz__insta-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    transition: opacity 0.3s ease;
  }

  .bean-quiz__insta-content {
    position: relative;
    background: #101010;
    border: 1px solid rgba(245, 245, 245, 0.1);
    border-top: 4px solid var(--result-accent, #c6a969);
    border-radius: 2.8rem;
    width: 100%;
    max-width: 600px;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 4rem 10rem rgba(0, 0, 0, 0.6);
    padding: 3.6rem;
    z-index: 2;
    color: #f5f5f5;
    animation: instaModalFadeUp 0.4s cubic-bezier(0.25, 1, 0.5, 1) both;
  }

  .bean-quiz__insta-close-btn {
    position: absolute;
    top: 2rem;
    right: 2rem;
    background: none;
    border: none;
    font-size: 3rem;
    color: rgba(245, 245, 245, 0.4);
    cursor: pointer;
    line-height: 1;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .bean-quiz__insta-close-btn:hover {
    color: #f5f5f5;
    transform: rotate(90deg);
  }

  .bean-quiz__insta-header {
    text-align: center;
    margin-bottom: 2.8rem;
  }

  .bean-quiz__insta-badge {
    display: inline-block;
    padding: 0.4rem 1.2rem;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--result-accent, #c6a969);
    background: rgba(198, 169, 105, 0.08);
    border: 1px solid rgba(198, 169, 105, 0.15);
    margin-bottom: 1.2rem;
  }

  .bean-quiz__insta-title {
    margin: 0 0 0.8rem;
    font-family: var(--font-heading-family);
    font-size: clamp(2.2rem, 4vw, 2.8rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .bean-quiz__insta-subtitle {
    margin: 0;
    font-family: 'Poppins', sans-serif;
    font-size: 1.35rem;
    line-height: 1.5;
    color: rgba(245, 245, 245, 0.6);
  }

  .bean-quiz__insta-options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 2.8rem;
  }

  .bean-quiz__insta-option-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(245, 245, 245, 0.06);
    border-radius: 2rem;
    padding: 1.8rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.6rem;
  }

  .bean-quiz__insta-preview-placeholder {
    width: 100%;
    background: radial-gradient(circle at center, var(--result-glow, rgba(198, 169, 105, 0.18)), transparent),
      rgba(0, 0, 0, 0.6);
    border: 1px solid rgba(245, 245, 245, 0.1);
    border-radius: 1.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(245, 245, 245, 0.45);
    font-family: 'Poppins', sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    position: relative;
    overflow: hidden;
  }

  .bean-quiz__insta-preview--story {
    aspect-ratio: 9 / 16;
    height: 180px;
  }

  .bean-quiz__insta-preview--feed {
    aspect-ratio: 1 / 1;
    height: 180px;
  }

  .preview-card-ratio {
    position: relative;
    z-index: 1;
  }

  .bean-quiz__insta-preview-placeholder::before {
    content: '★';
    position: absolute;
    font-size: 10rem;
    color: var(--result-accent, #c6a969);
    opacity: 0.08;
    line-height: 1;
  }

  .bean-quiz__insta-download-btn {
    width: 100%;
    margin-top: 0;
    min-height: 4.6rem;
    font-size: 1.02rem;
    padding: 0 1.5rem;
  }

  .bean-quiz__insta-instructions {
    border-top: 1px solid rgba(245, 245, 245, 0.08);
    padding-top: 2rem;
  }

  .bean-quiz__insta-instructions h5 {
    margin: 0 0 1.2rem;
    font-family: 'Poppins', sans-serif;
    font-size: 1.25rem;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--result-accent, #c6a969);
    letter-spacing: 0.05em;
  }

  .bean-quiz__insta-instructions ol {
    margin: 0 0 2rem;
    padding-left: 2rem;
    font-family: 'Poppins', sans-serif;
    font-size: 1.35rem;
    line-height: 1.6;
    color: rgba(245, 245, 245, 0.8);
  }

  .bean-quiz__insta-instructions li {
    margin-bottom: 0.8rem;
  }

  .bean-quiz__insta-instructions li strong {
    color: #ffffff;
  }

  .bean-quiz__insta-link-copy {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(245, 245, 245, 0.1);
    border-radius: 1.2rem;
    padding: 0.6rem 0.6rem 0.6rem 1.6rem;
    align-items: center;
  }

  .bean-quiz__insta-link-input {
    background: none;
    border: none;
    color: rgba(245, 245, 245, 0.6);
    font-family: 'Poppins', sans-serif;
    font-size: 1.25rem;
    outline: none;
    width: 100%;
    cursor: default;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .bean-quiz__insta-copy-btn {
    min-height: 3.8rem;
    padding: 0 1.8rem;
    background: var(--result-accent, #c6a969);
    border: none;
    color: #0b0b0b;
    border-radius: 0.8rem;
    font-family: 'Poppins', sans-serif;
    font-size: 1.1rem;
    font-weight: 800;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.1s ease;
  }

  .bean-quiz__insta-copy-btn:hover {
    background: #ffffff;
  }

  .bean-quiz__insta-copy-btn:active {
    transform: scale(0.96);
  }

  @media screen and (max-width: 749px) {
    .bean-quiz__insta-content {
      padding: 2.8rem 2rem;
      border-radius: 2.2rem;
    }

    .bean-quiz__insta-options {
      grid-template-columns: 1fr;
      gap: 1.6rem;
    }

    .bean-quiz__insta-preview-placeholder {
      height: 120px;
    }
  }

  /* Quiz Entry Form Styles */
  .bean-quiz__screen[data-quiz-screen='entry-gate'].is-active {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.9fr);
    gap: 2rem;
    align-items: center;
  }
  .bean-quiz__form {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
    max-width: 42rem;
    margin-top: 2rem;
  }
  .bean-quiz__form-group {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .bean-quiz__form-label {
    font-family: 'Poppins', sans-serif;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.6);
  }
  .bean-quiz__form-input {
    width: 100%;
    padding: 1.4rem 1.8rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(245, 245, 245, 0.1);
    color: #f5f5f5;
    font-family: 'Poppins', sans-serif;
    font-size: 1.35rem;
    outline: none;
    border-radius: 1.2rem;
    transition: border-color 0.28s ease, background 0.28s ease;
  }
  .bean-quiz__form-input:focus {
    border-color: #c6a969;
    background: rgba(255, 255, 255, 0.06);
  }
  .bean-quiz__form-error {
    font-family: 'Poppins', sans-serif;
    font-size: 1.15rem;
    color: #e63946;
    margin-top: 0.4rem;
    display: none;
  }
  
  @media (max-width: 767px) {
    /* Entry Gate screen (data-quiz-screen='entry-gate') */
    .bean-quiz__screen[data-quiz-screen='entry-gate'].is-active {
      grid-template-columns: 1fr;
      gap: 2.4rem;
    }
    .bean-quiz__screen[data-quiz-screen='entry-gate'] .bean-quiz__form {
      gap: 2.4rem;
    }
    .bean-quiz__screen[data-quiz-screen='entry-gate'] .bean-quiz__welcome-side {
      display: flex;
      flex-wrap: wrap;
      gap: 0.8rem;
      justify-content: flex-start;
      background: none;
      border: none;
      padding: 0;
      min-height: auto;
    }
    .bean-quiz__screen[data-quiz-screen='entry-gate'] .bean-quiz__welcome-pillars {
      display: flex;
      flex-wrap: wrap;
      gap: 0.8rem;
      justify-content: flex-start;
    }
    .bean-quiz__screen[data-quiz-screen='entry-gate'] .bean-quiz__welcome-copy {
      width: 100%;
    }
    .bean-quiz__screen[data-quiz-screen='entry-gate'] .bean-quiz__button {
      width: 100%;
      min-height: 48px;
    }

    /* Result screen (data-quiz-screen='result') */
    .bean-quiz__result-hero {
      gap: 2rem;
    }
    .bean-quiz__result-kicker {
      margin-top: 0;
    }
    .bean-quiz__result-visual {
      margin-bottom: 1.2rem;
      width: 100%;
      max-width: 100%;
    }
  }
{%- endstyle -%}

<section
  id="Quiz-{{ section.id }}"
  class="bean-quiz-page"
  data-section-id="{{ section.id }}"
  data-quiz-root
>
  <div class="bean-quiz-page__shell">
    <div class="bean-quiz-page__hero">
      <div class="bean-quiz-page__copy">
        <p class="bean-quiz-page__eyebrow">Bean Identity Quiz</p>
        <h1 class="bean-quiz-page__title">{{ section.settings.heading }}</h1>
        <p class="bean-quiz-page__subtitle">
          {{ section.settings.subheading }}
        </p>
      </div>
    </div>

    <div class="bean-quiz" data-quiz-app>
      <div class="bean-quiz__status">
        <span class="bean-quiz__status-label">Identity scan</span>
        <span class="bean-quiz__step-count" data-quiz-count>Intro</span>
      </div>

      <div class="bean-quiz__progress">
        <div class="bean-quiz__progress-bar" data-quiz-progress></div>
      </div>

      <div class="bean-quiz__panel">
        <div class="bean-quiz__screen is-active" data-quiz-screen="welcome">
          <div class="bean-quiz__welcome-copy">
            <!-- Referred Welcome Banner (shown dynamically if result query param is present) -->
            <div class="bean-quiz__referred-banner" data-referred-banner hidden>
              <span class="bean-quiz__referred-badge">Shared Match</span>
              <h3 class="bean-quiz__referred-title">
                Your friend matched with the <span data-referred-match-name></span>!
              </h3>
              <p class="bean-quiz__referred-desc" data-referred-match-desc></p>
            </div>

            {% comment %} <h2 class="bean-quiz__intro-title">Find the bean that wears like you.</h2> {% endcomment %}
            <p class="bean-quiz__intro-copy" data-welcome-copy>
              Pick the option that feels most instinctive each time. Do not overthink it. The strongest matches usually
              happen fast.
            </p>
            <button class="bean-quiz__button" type="button" data-quiz-start>Start quiz</button>
          </div>
          <div class="bean-quiz__welcome-side">
            <div class="bean-quiz__welcome-pillars">
              <span class="bean-quiz__welcome-pill">8 questions</span>
              <span class="bean-quiz__welcome-pill">3 min</span>
              <span class="bean-quiz__welcome-pill">Perfect bean match</span>
            </div>
            {% comment %}
              <img
                src="{{ 'bean-green-1.png' | asset_url }}"
                alt=""
                aria-hidden="true"
                class="bean-quiz__welcome-art"
                loading="lazy"
              >
            {% endcomment %}
          </div>
        </div>

        <div class="bean-quiz__screen" data-quiz-screen="entry-gate">
          <div class="bean-quiz__welcome-copy">
            <h2 class="bean-quiz__intro-title">Initialize Scan</h2>
            <p class="bean-quiz__intro-copy">
              Please enter your details to begin the archetype scan. This allows us to save your custom personality
              dossier.
            </p>
            <form id="quiz-entry-form" class="bean-quiz__form" novalidate>
              <div class="bean-quiz__form-group">
                <label class="bean-quiz__form-label" for="quiz-user-name">Your Name</label>
                <input
                  class="bean-quiz__form-input"
                  type="text"
                  id="quiz-user-name"
                  required
                  placeholder="e.g. John Doe"
                >
                <span class="bean-quiz__form-error" id="quiz-name-error">Please enter your name.</span>
              </div>
              <div class="bean-quiz__form-group">
                <label class="bean-quiz__form-label" for="quiz-user-email">Email Address</label>
                <input
                  class="bean-quiz__form-input"
                  type="email"
                  id="quiz-user-email"
                  required
                  placeholder="e.g. john@example.com"
                >
                <span class="bean-quiz__form-error" id="quiz-email-error">Please enter a valid email address.</span>
              </div>
              <button class="bean-quiz__button" type="submit" style="margin-top: 2rem;">Begin Quiz</button>
            </form>
          </div>
          <div class="bean-quiz__welcome-side">
            <div class="bean-quiz__welcome-pillars">
              <span class="bean-quiz__welcome-pill">Details Secure</span>
              <span class="bean-quiz__welcome-pill">No Spam</span>
            </div>
          </div>
        </div>

        <div class="bean-quiz__screen" data-quiz-screen="1" data-step="1">
          <h2 class="bean-quiz__question-title">Your friends plan a last minute night out. You:</h2>
          <p class="bean-quiz__question-copy">Choose the option that feels most natural to you right now.</p>
          <div class="bean-quiz__options">
            <button class="bean-quiz__option" type="button" data-weights="jelly:3,vanilla:1">
              <span class="bean-quiz__option-index">A</span>
              <span class="bean-quiz__option-text">You were already going to suggest this</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="coffee:3,green:1">
              <span class="bean-quiz__option-index">B</span>
              <span class="bean-quiz__option-text">Go only if it's a small group — big crowds drain you</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="green:3,chilli:1">
              <span class="bean-quiz__option-index">C</span>
              <span class="bean-quiz__option-text">Check in with yourself first — are you actually up for it?</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="vanilla:3,jelly:1">
              <span class="bean-quiz__option-index">D</span>
              <span class="bean-quiz__option-text">Get ready in 10 minutes, you were bored anyway</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="chilli:3,coffee:1">
              <span class="bean-quiz__option-index">E</span>
              <span class="bean-quiz__option-text">Go, but only if it's actually worth your time</span>
            </button>
          </div>
        </div>

        <div class="bean-quiz__screen" data-quiz-screen="2" data-step="2">
          <h2 class="bean-quiz__question-title">Getting dressed to head out, you go for:</h2>
          <p class="bean-quiz__question-copy">Choose the option that feels most natural to you right now.</p>
          <div class="bean-quiz__options">
            <button class="bean-quiz__option" type="button" data-weights="chilli:3,vanilla:1">
              <span class="bean-quiz__option-index">A</span>
              <span class="bean-quiz__option-text"
                >The piece you bought knowing not everyone would get it – a bold statement</span
              >
            </button>
            <button class="bean-quiz__option" type="button" data-weights="green:3,jelly:1">
              <span class="bean-quiz__option-index">B</span>
              <span class="bean-quiz__option-text">Something comfortable and sorted</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="jelly:3,chilli:1">
              <span class="bean-quiz__option-index">C</span>
              <span class="bean-quiz__option-text">The outfit you know looks good — no second guessing</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="coffee:3,green:1">
              <span class="bean-quiz__option-index">D</span>
              <span class="bean-quiz__option-text">Something understated with one detail that makes it yours</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="vanilla:3,chilli:1">
              <span class="bean-quiz__option-index">E</span>
              <span class="bean-quiz__option-text">Whatever caught your eye this morning</span>
            </button>
          </div>
        </div>

        <div class="bean-quiz__screen" data-quiz-screen="3" data-step="3">
          <h2 class="bean-quiz__question-title">The group chat is going off. You:</h2>
          <p class="bean-quiz__question-copy">Choose the option that feels most natural to you right now.</p>
          <div class="bean-quiz__options">
            <button class="bean-quiz__option" type="button" data-weights="green:3,jelly:1">
              <span class="bean-quiz__option-index">A</span>
              <span class="bean-quiz__option-text">React with an emoji and check back later</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="chilli:3,jelly:1">
              <span class="bean-quiz__option-index">B</span>
              <span class="bean-quiz__option-text">Say the thing everyone was thinking but nobody typed</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="jelly:3,vanilla:1">
              <span class="bean-quiz__option-index">C</span>
              <span class="bean-quiz__option-text">You're the reason it's going off</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="vanilla:3,chilli:1">
              <span class="bean-quiz__option-index">D</span>
              <span class="bean-quiz__option-text">Send a reel and derail the whole conversation</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="coffee:3,green:1">
              <span class="bean-quiz__option-index">E</span>
              <span class="bean-quiz__option-text"
                >Read everything, reply only when you have something real to add</span
              >
            </button>
          </div>
        </div>

        <div class="bean-quiz__screen" data-quiz-screen="4" data-step="4">
          <h2 class="bean-quiz__question-title">Your order at a café comes out wrong. You:</h2>
          <p class="bean-quiz__question-copy">Choose the option that feels most natural to you right now.</p>
          <div class="bean-quiz__options">
            <button class="bean-quiz__option" type="button" data-weights="vanilla:3,green:1">
              <span class="bean-quiz__option-index">A</span>
              <span class="bean-quiz__option-text">Shrug and try it anyway</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="coffee:3,chilli:1">
              <span class="bean-quiz__option-index">B</span>
              <span class="bean-quiz__option-text">Say nothing, mentally note never to order that again</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="green:3,vanilla:1">
              <span class="bean-quiz__option-index">C</span>
              <span class="bean-quiz__option-text">It's fine — not worth making it a thing</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="chilli:3,coffee:1">
              <span class="bean-quiz__option-index">D</span>
              <span class="bean-quiz__option-text">Politely but clearly ask them to fix it</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="jelly:3,vanilla:1">
              <span class="bean-quiz__option-index">E</span>
              <span class="bean-quiz__option-text">Make it a story you'll tell later</span>
            </button>
          </div>
        </div>

        <div class="bean-quiz__screen" data-quiz-screen="5" data-step="5">
          <h2 class="bean-quiz__question-title">
            Someone in your friend group is clearly off but hasn't said anything. You:
          </h2>
          <p class="bean-quiz__question-copy">Choose the option that feels most natural to you right now.</p>
          <div class="bean-quiz__options">
            <button class="bean-quiz__option" type="button" data-weights="chilli:3,coffee:1">
              <span class="bean-quiz__option-index">A</span>
              <span class="bean-quiz__option-text">Ask them directly, you'd rather just address it</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="coffee:3,chilli:1">
              <span class="bean-quiz__option-index">B</span>
              <span class="bean-quiz__option-text">Notice first but wait for them to bring it up</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="jelly:3,green:1">
              <span class="bean-quiz__option-index">C</span>
              <span class="bean-quiz__option-text">Check in and make sure they know you're around</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="green:3,coffee:1">
              <span class="bean-quiz__option-index">D</span>
              <span class="bean-quiz__option-text">Give them space but quietly keep an eye out</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="vanilla:3,jelly:1">
              <span class="bean-quiz__option-index">E</span>
              <span class="bean-quiz__option-text">Suggest getting out — a change of scene fixes most things</span>
            </button>
          </div>
        </div>

        <div class="bean-quiz__screen" data-quiz-screen="6" data-step="6">
          <h2 class="bean-quiz__question-title">Your ideal Sunday:</h2>
          <p class="bean-quiz__question-copy">Choose the option that feels most natural to you right now.</p>
          <div class="bean-quiz__options">
            <button class="bean-quiz__option" type="button" data-weights="green:3,coffee:1">
              <span class="bean-quiz__option-index">A</span>
              <span class="bean-quiz__option-text">Slow morning, nothing overwhelming</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="jelly:3,vanilla:1">
              <span class="bean-quiz__option-index">B</span>
              <span class="bean-quiz__option-text">Back to back plans, the busier the better</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="coffee:3,green:1">
              <span class="bean-quiz__option-index">C</span>
              <span class="bean-quiz__option-text">Alone time, good playlist, your own pace</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="chilli:3,vanilla:1">
              <span class="bean-quiz__option-index">D</span>
              <span class="bean-quiz__option-text">Doing exactly what you want, no compromises</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="vanilla:3,chilli:1">
              <span class="bean-quiz__option-index">E</span>
              <span class="bean-quiz__option-text">No plan — see where the day goes</span>
            </button>
          </div>
        </div>

        <div class="bean-quiz__screen" data-quiz-screen="7" data-step="7">
          <h2 class="bean-quiz__question-title">Someone new enters your circle. You:</h2>
          <p class="bean-quiz__question-copy">Choose the option that feels most natural to you right now.</p>
          <div class="bean-quiz__options">
            <button class="bean-quiz__option" type="button" data-weights="jelly:3,green:1">
              <span class="bean-quiz__option-index">A</span>
              <span class="bean-quiz__option-text">Make them feel like they've always been part of it</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="chilli:3,coffee:1">
              <span class="bean-quiz__option-index">B</span>
              <span class="bean-quiz__option-text">Wait and see who they actually are first</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="vanilla:3,jelly:1">
              <span class="bean-quiz__option-index">C</span>
              <span class="bean-quiz__option-text">Already thinking about including them in the next plan</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="green:3,jelly:1">
              <span class="bean-quiz__option-index">D</span>
              <span class="bean-quiz__option-text">Make sure they're not feeling out of place</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="coffee:3,vanilla:1">
              <span class="bean-quiz__option-index">E</span>
              <span class="bean-quiz__option-text">Take your time forming an opinion</span>
            </button>
          </div>
        </div>

        <div class="bean-quiz__screen" data-quiz-screen="8" data-step="8">
          <h2 class="bean-quiz__question-title">You just bought a new outfit. You:</h2>
          <p class="bean-quiz__question-copy">Choose the option that feels most natural to you right now.</p>
          <div class="bean-quiz__options">
            <button class="bean-quiz__option" type="button" data-weights="vanilla:3,jelly:1">
              <span class="bean-quiz__option-index">A</span>
              <span class="bean-quiz__option-text">Wear it the next day, you can't wait</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="jelly:3,vanilla:1">
              <span class="bean-quiz__option-index">B</span>
              <span class="bean-quiz__option-text">Already planning which crew sees it first</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="green:3,chilli:1">
              <span class="bean-quiz__option-index">C</span>
              <span class="bean-quiz__option-text">Just glad you found something that feels like you</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="coffee:3,green:1">
              <span class="bean-quiz__option-index">D</span>
              <span class="bean-quiz__option-text">Wait for the right moment — it has to make sense</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="chilli:3,jelly:1">
              <span class="bean-quiz__option-index">E</span>
              <span class="bean-quiz__option-text">Wear it whenever — no occasion needed</span>
            </button>
          </div>
        </div>

        <div class="bean-quiz__screen" data-quiz-screen="result">
          <!-- 1. Result Hero Grid -->
          <div class="bean-quiz__result-hero">
            <!-- Left Column: Copy, Traits & Blend -->
            <div class="bean-quiz__result-copy-block">
              <p class="bean-quiz__result-kicker">Your match</p>
              <h2 class="bean-quiz__result-title" data-result-name></h2>
              <p class="bean-quiz__result-copy" data-result-description></p>

              <!-- Identity trait pills directly below description -->
              <div class="bean-quiz__traits" data-result-traits></div>

              <!-- Blend breakdown inline in the copy block -->
              <div class="bean-quiz__blend-breakdown">
                <p class="bean-quiz__result-label">Your Bean Blend</p>
                <div class="bean-quiz__blend-classification" data-blend-classification></div>
                <div class="bean-quiz__blend-list" data-blend-list></div>
              </div>
            </div>

            <!-- Right Column: GIFs, Badge, Controls -->
            <div class="bean-quiz__result-visual">
              <div class="bean-quiz__result-visual-shell" data-result-gif-container>
                <!-- Layers will be dynamically injected here -->
              </div>
              <div class="bean-quiz__carousel-badge" data-carousel-badge></div>
              <div class="bean-quiz__carousel-controls" data-carousel-controls></div>
            </div>
          </div>

          <!-- Social Media Sharing Block -->
          <div class="bean-quiz__share-section">
            <p class="bean-quiz__share-title">Share Your Identity</p>
            <div class="bean-quiz__share-buttons">
