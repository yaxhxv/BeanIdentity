{%- style -%}
  .quiz-container {
    max-width: 800px;
    margin: 60px auto;
    padding: 40px 20px;
    text-align: center;
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }

  .quiz-progress {
    width: 100%;
    height: 4px;
    background: #EDE7E3;
    margin-bottom: 40px;
    border-radius: 2px;
    overflow: hidden;
  }

  .quiz-progress-bar {
    height: 100%;
    background: #C6A969;
    width: 0%;
    transition: width 0.4s ease;
  }

  .quiz-step {
    display: none;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .quiz-step.active {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }

  .quiz-heading {
    font-size: 3.2rem;
    font-weight: 700;
    margin-bottom: 10px;
  }

  .quiz-subheading {
    font-size: 1.8rem;
    opacity: 0.7;
    margin-bottom: 40px;
  }

  .quiz-question-title {
    font-size: 2.8rem;
    font-weight: 600;
    margin-bottom: 30px;
  }

  .quiz-options {
    display: grid;
    grid-template-columns: 1fr;
    gap: 15px;
    margin-bottom: 40px;
  }

  .quiz-option {
    padding: 20px;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    cursor: pointer;
    font-size: 1.8rem;
    transition: all 0.3s ease;
    background: transparent;
    text-align: left;
  }

  .quiz-option:hover {
    background: #EDE7E3;
    border-color: #C6A969;
  }

  .quiz-button {
    display: inline-block;
    padding: 20px 40px;
    background: #C6A969;
    color: #000000;
    border: none;
    font-size: 1.8rem;
    font-weight: 600;
    text-transform: uppercase;
    cursor: pointer;
    border-radius: 4px;
    transition: opacity 0.3s ease;
  }

  .quiz-button:hover {
    opacity: 0.9;
  }

  /* Results Section */
  .quiz-result-card {
    padding: 40px;
    border: 1px solid #C6A969;
    border-radius: 4px;
  }

  .quiz-result-mascot {
    width: 120px;
    height: 120px;
    margin: 0 auto 20px;
    background: #EDE7E3;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .quiz-result-mascot svg {
    width: 60px;
    height: 60px;
  }

  .quiz-result-name {
    font-size: 4.8rem;
    font-weight: 800;
    margin-bottom: 10px;
    text-transform: uppercase;
  }

  .quiz-result-trait-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    list-style: none;
    padding: 0;
    margin-bottom: 30px;
  }

  .quiz-result-trait {
    padding: 6px 14px;
    background: #EDE7E3;
    border-radius: 20px;
    font-size: 1.4rem;
    font-weight: 600;
  }

  .quiz-result-description {
    font-size: 1.8rem;
    line-height: 1.6;
    margin-bottom: 40px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  @media screen and (max-width: 749px) {
    .quiz-heading { font-size: 2.6rem; }
    .quiz-question-title { font-size: 2.22rem; }
    .quiz-result-name { font-size: 3.2rem; }
  }
{%- endstyle -%}

<div id="Quiz-{{ section.id }}" class="quiz-container" data-section-id="{{ section.id }}">
  <div class="quiz-progress">
    <div class="quiz-progress-bar" id="QuizProgress"></div>
  </div>

  {%- comment -%} WELCOME STEP {%- endcomment -%}
  <div class="quiz-step active" id="Step-Welcome">
    <h1 class="quiz-heading">{{ section.settings.heading }}</h1>
    <p class="quiz-subheading">{{ section.settings.subheading }}</p>
    <button class="quiz-button" data-next="Question-1">Start Quiz</button>
  </div>

  {%- comment -%} QUESTIONS (Template for 5 questions) {%- endcomment -%}
  <div class="quiz-step" id="Step-Question-1" data-step="1">
    <h2 class="quiz-question-title">When starting something new, your instinct is:</h2>
    <div class="quiz-options">
      <button class="quiz-option" data-score="coffee">"Let me understand how this actually works first."</button>
      <button class="quiz-option" data-score="vanilla">"Let’s try it and see what happens."</button>
      <button class="quiz-option" data-score="chilli">"Let’s do it big."</button>
      <button class="quiz-option" data-score="jelly">"Who else is doing this with me?"</button>
      <button class="quiz-option" data-score="green">"Let me think about whether this feels right."</button>
    </div>
  </div>

  <div class="quiz-step" id="Step-Question-2" data-step="2">
    <h2 class="quiz-question-title">When your friend group walks into a party, you’re usually the one who:</h2>
    <div class="quiz-options">
      <button class="quiz-option" data-score="coffee">Finds one interesting person and ends up in a deep conversation about something random.</button>
      <button class="quiz-option" data-score="vanilla">Immediately asks, "Where’s the fun happening?"</button>
      <button class="quiz-option" data-score="chilli">Walks in like you already own the place.</button>
      <button class="quiz-option" data-score="jelly">Somehow knows half the room within 10 minutes.</button>
      <button class="quiz-option" data-score="green">Quietly reads the vibe of the room before doing anything.</button>
    </div>
  </div>

  <div class="quiz-step" id="Step-Question-3" data-step="3">
    <h2 class="quiz-question-title">When facing a tough decision with no obvious right answer, you usually:</h2>
    <div class="quiz-options">
      <button class="quiz-option" data-score="coffee">List the pros and cons and think it through logically.</button>
      <button class="quiz-option" data-score="vanilla">Follow the option that feels like the biggest adventure.</button>
      <button class="quiz-option" data-score="chilli">Choose the path where you can make the boldest impact.</button>
      <button class="quiz-option" data-score="jelly">Talk it out with people until a creative solution appears.</button>  
      <button class="quiz-option" data-score="green">Check in with your emotions and long-term peace of mind.</button>
    </div>
  </div>

  <div class="quiz-step" id="Step-Question-4" data-step="4">
    <h2 class="quiz-question-title">Your friends would probably describe you as the one who:</h2>
    <div class="quiz-options">
      <button class="quiz-option" data-score="coffee">Randomly drops facts or thoughts that make everyone pause and think.</button>
      <button class="quiz-option" data-score="vanilla">Says "Let’s just go" — and somehow everyone follows.</button>
      <button class="quiz-option" data-score="chilli">Says the brutally honest thing everyone else avoided.</button>
      <button class="quiz-option" data-score="jelly">Turns a normal night into a story everyone laughs about later.</button>
      <button class="quiz-option" data-score="green">Calms everyone down when things start getting chaotic.</button>
    </div>
  </div>

  <div class="quiz-step" id="Step-Question-5" data-step="5">
    <h2 class="quiz-question-title">Imagine you unexpectedly get a free day. What are you most likely to do?</h2>
    <div class="quiz-options">
      <button class="quiz-option" data-score="coffee">Dive into a book, podcast, or documentary about something fascinating.</button>
      <button class="quiz-option" data-score="vanilla">Plan a spontaneous trip or try something completely new.</button>
      <button class="quiz-option" data-score="chilli">Start a bold project, pitch a big idea, or take on a tough challenge.</button>
      <button class="quiz-option" data-score="jelly">Call a bunch of friends and plan something fun together.</button>
      <button class="quiz-option" data-score="green">Sleep in, take a peaceful walk, journal, or enjoy a slow day.</button>
    </div>
  </div>

  {%- comment -%} RESULT STEP {%- endcomment -%}
  <div class="quiz-step" id="Step-Results">
    <div class="quiz-result-card" id="QuizResultCard">
      <div class="quiz-result-mascot" id="ResultMascot">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M7 16.3c2.2 0 4-1.83 4-4.05 0-1.16-.57-2.26-1.71-3.19S7 2.99 7 2.99s-2.29 6.08-2.29 6.08C3.57 10 3 11.09 3 12.25c0 2.22 1.8 4.05 4 4.05z"/><path d="M12.56 6.6A10.97 10.97 0 0 0 14 3.02c.5 2.5 2 4.9 4 6.5s3 3.5 3 5.5a6.98 6.98 0 0 1-11.91 4.97"/>
        </svg>
      </div>
      <h2 class="quiz-result-name" id="ResultName">Coffee Bean</h2>
      <ul class="quiz-result-trait-list" id="ResultTraits">
        {%- comment -%} Dynamically filled {%- endcomment -%}
      </ul>
      <p class="quiz-result-description" id="ResultDescription">
        {%- comment -%} Dynamically filled {%- endcomment -%}
      </p>

      <a href="#" id="ResultCTA" class="quiz-button">Shop My Bean</a>
    </div>
  </div>
</div>

<script>
  (function () {
    const quiz = {
      scores: {
        coffee: 0,
        chilli: 0,
        vanilla: 0,
        jelly: 0,
        green: 0,
      },
      archetypes: {
        coffee: {
          name: 'The Coffee Bean',
          traits: ['Curious', 'Analytical', 'Thoughtful'],
          description:
            'You love understanding how things work and observing the world deeply. Even when you’re quiet in a room, your mind is full of ideas and questions.',
          collection: '/collections/coffee-bean',
        },
        chilli: {
          name: 'The Chilli Bean',
          traits: ['Bold', 'Fiery', 'Authentic'],
          description:
            'You say what others hesitate to say and aren’t afraid to challenge the status quo. People may find you intense — but they always know you’re real.',
          collection: '/collections/chilli-bean',
        },
        vanilla: {
          name: 'The Vanilla Bean',
          traits: ['Energetic', 'Adventurous', 'Optimistic'],
          description:
            'You’re always chasing the next experience and inspiring others to do the same. Life feels like something to explore, not overthink.',
          collection: '/collections/vanilla-bean',
        },
        jelly: {
          name: 'The Jelly Bean',
          traits: ['Playful', 'Extroverted', 'Socially Magnetic'],
          description:
            'You bring energy, laughter, and chaos to every group you’re in. With you around, ordinary moments somehow turn into unforgettable stories.',
          collection: '/collections/jelly-bean',
        },
        green: {
          name: 'The Green Bean',
          traits: ['Calm', 'Mindful', 'Grounded'],
          description:
            'You are the quiet balance in the group — the one people turn to when things get overwhelming. Your presence reminds everyone to slow down and breathe.',
          collection: '/collections/green-bean',
        },
      },
      currentStep: 0,
      totalSteps: 5,
      init() {
        const startBtn = document.querySelector('[data-next]');
        if (startBtn) startBtn.addEventListener('click', () => this.goToStep(1));

        document.querySelectorAll('.quiz-option').forEach((opt) => {
          opt.addEventListener('click', (e) => {
            const score = e.target.dataset.score;
            this.scores[score]++;
            const nextStep = parseInt(e.target.closest('.quiz-step').dataset.step) + 1;
            if (nextStep > this.totalSteps) {
              this.showResults();
            } else {
              this.goToStep(nextStep);
            }
          });
        });
      },
      goToStep(step) {
        document.querySelectorAll('.quiz-step').forEach((s) => s.classList.remove('active'));
        const target = document.getElementById(step === 'Results' ? 'Step-Results' : 'Step-Question-' + step);
        if (target) target.classList.add('active');

        // Update Progress
        const percent = step === 'Results' ? 100 : (step / this.totalSteps) * 100;
        document.getElementById('QuizProgress').style.width = percent + '%';
      },
      showResults() {
        // Calculate Winner
        let winner = 'coffee';
        let max = 0;
        for (const bean in this.scores) {
          if (this.scores[bean] > max) {
            max = this.scores[bean];
            winner = bean;
          }
        }

        const data = this.archetypes[winner];
        document.getElementById('ResultName').innerText = data.name;
        document.getElementById('ResultDescription').innerText = data.description;
        document.getElementById('ResultCTA').href = data.collection;

        const traitsContainer = document.getElementById('ResultTraits');
        traitsContainer.innerHTML = '';
        data.traits.forEach((trait) => {
          const li = document.createElement('li');
          li.className = 'quiz-result-trait';
          li.innerText = trait;
          traitsContainer.appendChild(li);
        });

        // Save Result
        localStorage.setItem('bean_identity_result', winner);

        this.goToStep('Results');
      },
    };

    quiz.init();
  })();
</script>

{% schema %}
{
  "name": "Main Quiz",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Which Bean Are You?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Answer 5 questions. Meet your Bean."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F5F5F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    }
  ]
}
{% endschema %}
