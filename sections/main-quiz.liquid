    const state = {
      current: 'welcome',
      totalSteps: 15,
      answers: {},
      scores: {
        coffee: 0,
        chilli: 0,
        vanilla: 0,
        jelly: 0,
        green: 0,
      },
      carouselInterval: null,
      carouselIndex: 0,
      carouselIsPlaying: true,
      carouselManualPaused: false,
      carouselLayers: [],
      carouselDots: [],
    };

    function updateProgress() {
      if (state.current === 'welcome') {
        progressBar.style.width = '0%';
        stepCount.textContent = 'Intro';
        backButton.hidden = true;
        return;
      }

      if (state.current === 'result') {
        progressBar.style.width = '100%';
        stepCount.textContent = 'Result';
        backButton.hidden = false;
        return;
      }

      const step = Number(state.current);
      progressBar.style.width = (step / state.totalSteps) * 100 + '%';
      stepCount.textContent = 'Question ' + step + ' / ' + state.totalSteps;
      backButton.hidden = step === 1;
    }

    function showScreen(name) {
      state.current = name;
      screens.forEach((screen) => {
        screen.classList.toggle('is-active', screen.dataset.quizScreen === String(name));
      });
      updateProgress();
    }

    function calculatePercentages() {
      const rawScores = state.scores;
      const total = Object.values(rawScores).reduce((a, b) => a + b, 0) || 1;
      const percents = {};
      let sum = 0;
      let maxKey = 'coffee';
      let maxVal = -1;

      for (const key in rawScores) {
        const p = Math.round((rawScores[key] / total) * 100);
        percents[key] = p;
        sum += p;
        if (p > maxVal) {
          maxVal = p;
          maxKey = key;
        }
      }

      // Balance to exactly 100%
      const diff = 100 - sum;
      if (diff !== 0) {
        percents[maxKey] += diff;
      }

      // Sort percentages (highest first)
      return Object.entries(percents).sort((a, b) => b[1] - a[1]);
    }

    function getWinningBean() {
      const sorted = calculatePercentages();
      return sorted[0][0];
    }

    function renderResult(beanKey) {
      const data = archetypes[beanKey];
      if (!data) return;

      const sorted = calculatePercentages();
      const primary = sorted[0]; // [key, %]
      const secondary = sorted[1]; // [key, %]

      // Set styles based on winning bean
      root.style.setProperty('--result-accent', data.accent);
      root.style.setProperty('--result-ink', data.ink);
      root.style.setProperty('--result-bg', data.bg);
      root.style.setProperty('--result-bg-strong', data.bgStrong);
      root.style.setProperty('--result-glow', data.glow);
      root.style.setProperty('--result-border', data.border);
      root.style.setProperty('--result-panel', data.panel);
      root.style.setProperty('--result-panel-alt', data.panelAlt);
      // Check Dual Blend trigger (Primary >= 40% and Gap <= 8%)
      const primaryPct = primary[1];
      const secondaryPct = secondary[1];
      const gap = primaryPct - secondaryPct;
      const isDualBlend = primaryPct >= 40 && gap <= 8;

      let classification = '';
      let activeTitle = data.name;
      let activeDesc = data.description;

      // Render new detailed sections
      const coreIdEl = root.querySelector('[data-detail-core-identity]');
      const stressEl = root.querySelector('[data-detail-stress-behaviour]');
      const hiddenEl = root.querySelector('[data-detail-hidden-trait]');
      const misunderstoodEl = root.querySelector('[data-detail-misunderstood]');
      const compatibilityEl = root.querySelector('[data-detail-compatibility]');

      if (isDualBlend) {
        const blendKey = `${primary[0]}_${secondary[0]}`;
        const blendData = dualBlends[blendKey];
        if (blendData) {
          classification = `Dual Blend`;
          activeTitle = blendData.title;
          activeDesc = `You represent a perfect harmony between the characteristics of the ${
            archetypes[primary[0]].name
          } and the ${archetypes[secondary[0]].name}.`;

          if (coreIdEl) coreIdEl.textContent = blendData.coreIdentity;
          if (stressEl) stressEl.textContent = blendData.stressBehaviour;
          if (hiddenEl) hiddenEl.textContent = blendData.hiddenTrait;
          if (misunderstoodEl) misunderstoodEl.textContent = blendData.misunderstood;
          if (compatibilityEl) {
            compatibilityEl.textContent = `As a Dual Blend, you carry a balanced mix of both ${
              archetypes[primary[0]].name
            } and ${
              archetypes[secondary[0]].name
            } characteristics. You pair beautifully with partners who respect both your depth and your fire.`;
          }
        } else {
          // Fallback if blend data is not found
          classification = `Dual Blend: ${archetypes[primary[0]].name} & ${archetypes[secondary[0]].name}`;
          if (coreIdEl) coreIdEl.textContent = data.coreIdentity || '';
          if (stressEl) stressEl.textContent = data.stressBehaviour || '';
          if (hiddenEl) hiddenEl.textContent = data.hiddenTrait || '';
          if (misunderstoodEl) misunderstoodEl.textContent = data.misunderstood || '';
          if (compatibilityEl) compatibilityEl.textContent = data.compatibility || '';
        }
      } else {
        // Standard Single Archetype Logic
        if (primaryPct - secondaryPct <= 5) {
          classification = `True Blend: ${archetypes[primary[0]].name} & ${archetypes[secondary[0]].name}`;
        } else if (primaryPct > 50) {
          classification = `Dominant Archetype: ${archetypes[primary[0]].name}`;
        } else {
          classification = `True Blend: ${archetypes[primary[0]].name} + ${archetypes[secondary[0]].name}`;
        }

        if (coreIdEl) coreIdEl.textContent = data.coreIdentity || '';
        if (stressEl) stressEl.textContent = data.stressBehaviour || '';
        if (hiddenEl) hiddenEl.textContent = data.hiddenTrait || '';
        if (misunderstoodEl) misunderstoodEl.textContent = data.misunderstood || '';
        if (compatibilityEl) compatibilityEl.textContent = data.compatibility || '';
      }

      resultName.textContent = activeTitle;
      resultDescription.textContent = activeDesc;
      resultEnergy.textContent = data.energy;
      resultFit.textContent = data.fit;
      resultLink.href = data.collection;
      resultDirection.textContent = data.direction;
      resultPalette.textContent = data.palette;
      resultCtaCopy.textContent = data.ctaCopy;
      resultTraits.innerHTML = '';

      data.traits.forEach((trait) => {
        const item = document.createElement('span');
        item.className = 'bean-quiz__trait';
        item.textContent = trait;
        resultTraits.appendChild(item);
      });

      // Render classification
      const classificationEl = root.querySelector('[data-blend-classification]');
      if (classificationEl) {
        classificationEl.textContent = classification;
      }

      // Render Blend List & SVG Donut Chart
      const blendList = root.querySelector('[data-blend-list]');
      if (blendList) {
        blendList.innerHTML = '';

        const sortedDisplay = [...sorted];

        // Create the 2-column layout container
        const donutLayout = document.createElement('div');
        donutLayout.className = 'bean-quiz__blend-donut-layout';

        // Left Column: SVG Donut Visual
        const visualCol = document.createElement('div');
        visualCol.className = 'bean-quiz__blend-donut-visual';

        // Create the SVG element
        const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        svg.setAttribute('viewBox', '0 0 100 100');
        svg.setAttribute('class', 'bean-quiz__blend-donut-svg');

        // Circle background track
        const bgCircle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        bgCircle.setAttribute('cx', '50');
        bgCircle.setAttribute('cy', '50');
        bgCircle.setAttribute('r', '40');
        bgCircle.setAttribute('class', 'bean-quiz__blend-donut-circle-bg');
        svg.appendChild(bgCircle);

        // Center label (winning bean percentage + label)
        const centerLabel = document.createElement('div');
        centerLabel.className = 'bean-quiz__blend-donut-center-label';

        const numberSpan = document.createElement('span');
        numberSpan.className = 'bean-quiz__blend-donut-center-number';
        numberSpan.textContent = `${sortedDisplay[0][1]}%`;

        const subSpan = document.createElement('span');
        subSpan.className = 'bean-quiz__blend-donut-center-sub';
        subSpan.textContent = 'Primary';

        centerLabel.appendChild(numberSpan);
        centerLabel.appendChild(subSpan);

        // Right Column: Legend item list
        const legendCol = document.createElement('div');
        legendCol.className = 'bean-quiz__blend-donut-legend';

        let accumulatedPct = 0;
        const circumference = 2 * Math.PI * 40; // ~251.327

        sortedDisplay.forEach(([key, pct]) => {
          if (pct > 0) {
            const pctFraction = pct / 100;
            const segmentLength = circumference * pctFraction;
            const startAngle = (accumulatedPct / 100) * 360;

            // Create SVG segment circle
            const segment = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
            segment.setAttribute('cx', '50');
            segment.setAttribute('cy', '50');
            segment.setAttribute('r', '40');
            segment.setAttribute('class', 'bean-quiz__blend-donut-segment');
            segment.setAttribute('data-bean-key', key);
            segment.style.stroke = archetypes[key].accent;
            segment.style.currentColor = archetypes[key].accent;
            segment.setAttribute('stroke-dasharray', `${segmentLength} ${circumference}`);
            segment.setAttribute('stroke-dashoffset', segmentLength);
            segment.setAttribute('transform', `rotate(${startAngle} 50 50)`);

            svg.appendChild(segment);

            // Create Legend Item
            const legendItem = document.createElement('div');
            legendItem.className = 'bean-quiz__legend-item';
            legendItem.setAttribute('data-bean-key', key);

            const nameSpan = document.createElement('span');
            nameSpan.className = 'bean-quiz__legend-label';

            const dot = document.createElement('span');
            dot.className = 'bean-quiz__legend-dot';
            dot.style.backgroundColor = archetypes[key].accent;
            dot.style.boxShadow = `0 0 8px ${archetypes[key].accent}`;

            nameSpan.appendChild(dot);
            nameSpan.appendChild(document.createTextNode(` ${archetypes[key].name}`));

            const pctSpan = document.createElement('span');
            pctSpan.className = 'bean-quiz__legend-pct';
            pctSpan.textContent = `${pct}%`;

            legendItem.appendChild(nameSpan);
            legendItem.appendChild(pctSpan);
            legendCol.appendChild(legendItem);

            // Set up hover interactive effects
            const handleEnter = () => {
              // Highlight this segment, dim others
              svg.querySelectorAll('.bean-quiz__blend-donut-segment').forEach((s) => {
                if (s.getAttribute('data-bean-key') === key) {
                  s.classList.add('is-hovered');
                } else {
                  s.classList.add('is-dimmed');
                }
              });

              // Highlight legend item, dim others
              legendCol.querySelectorAll('.bean-quiz__legend-item').forEach((li) => {
                if (li.getAttribute('data-bean-key') === key) {
                  li.classList.add('is-hovered');
                } else {
                  li.classList.add('is-dimmed');
                }
              });

              // Update center label text with hovered details
              numberSpan.textContent = `${pct}%`;
              subSpan.textContent = archetypes[key].name.replace(' Bean', '');
              subSpan.style.color = archetypes[key].accent;
            };

            const handleLeave = () => {
              // Remove active styles from all segments
              svg.querySelectorAll('.bean-quiz__blend-donut-segment').forEach((s) => {
                s.classList.remove('is-hovered', 'is-dimmed');
              });

              // Remove active styles from legend items
              legendCol.querySelectorAll('.bean-quiz__legend-item').forEach((li) => {
                li.classList.remove('is-hovered', 'is-dimmed');
              });

              // Revert center label to default (primary match)
              numberSpan.textContent = `${sortedDisplay[0][1]}%`;
              subSpan.textContent = 'Primary';
              subSpan.style.color = '';
            };

            segment.addEventListener('mouseenter', handleEnter);
            segment.addEventListener('mouseleave', handleLeave);
            legendItem.addEventListener('mouseenter', handleEnter);
            legendItem.addEventListener('mouseleave', handleLeave);

            // Animate segment growing
            setTimeout(() => {
              segment.setAttribute('stroke-dashoffset', '0');
            }, 50);

            accumulatedPct += pct;
          }
        });

        visualCol.appendChild(svg);
        visualCol.appendChild(centerLabel);

        donutLayout.appendChild(visualCol);
        donutLayout.appendChild(legendCol);
        blendList.appendChild(donutLayout);
      }

      // --- Carousel Engine Implementation ---
      if (gifContainer && carouselControls && carouselBadge) {
        gifContainer.innerHTML = '';
        carouselControls.innerHTML = '';

        // Clear any existing carousel interval
        if (state.carouselInterval) {
          clearInterval(state.carouselInterval);
          state.carouselInterval = null;
        }

        // Filter out beans with 0% score
        const activeBeans = sorted.filter(([key, pct]) => pct > 0);
        state.carouselIndex = 0;
        state.carouselIsPlaying = true;
        state.carouselManualPaused = false;
        state.carouselLayers = [];
        state.carouselDots = [];

        // Add badge overlay class
        carouselBadge.classList.add('is-visible');

        // Create layered GIF elements & navigation dots
        activeBeans.forEach(([key, pct], index) => {
          const archData = archetypes[key];
          const img = document.createElement('img');
          img.className = 'bean-quiz__result-gif-layer';
          img.src = archData.gif;
          img.alt = archData.name;
          img.loading = 'lazy';
          if (index === 0) img.classList.add('is-active');
          gifContainer.appendChild(img);

          state.carouselLayers.push({
            element: img,
            key: key,
            pct: pct,
            name: archData.name,
          });

          // Create navigation dot
          const dot = document.createElement('button');
          dot.className = 'bean-quiz__carousel-dot';
          dot.type = 'button';
          dot.ariaLabel = `Go to ${archData.name} (${pct}%)`;
          if (index === 0) dot.classList.add('is-active');

          dot.addEventListener('click', () => {
            state.carouselManualPaused = true;
            pauseCarousel();
            goToIndex(index);
          });

          carouselControls.appendChild(dot);
          state.carouselDots.push(dot);
        });

        const updateBadge = (name, pct) => {
          carouselBadge.textContent = `${name} • ${pct}%`;
        };

        const goToIndex = (idx) => {
          state.carouselLayers.forEach((layer, i) => {
            layer.element.classList.toggle('is-active', i === idx);
          });
          state.carouselDots.forEach((dot, i) => {
            dot.classList.toggle('is-active', i === idx);
          });
          const activeLayer = state.carouselLayers[idx];
          if (activeLayer) {
            updateBadge(activeLayer.name, activeLayer.pct);
          }
          state.carouselIndex = idx;
        };

        // Initialize badge with the first active bean
        if (state.carouselLayers[0]) {
          updateBadge(state.carouselLayers[0].name, state.carouselLayers[0].pct);
        }

        const nextSlide = () => {
          if (activeBeans.length <= 1) return;
          const nextIdx = (state.carouselIndex + 1) % activeBeans.length;
          goToIndex(nextIdx);
        };

        const startCarousel = () => {
          if (activeBeans.length <= 1) return;
          state.carouselInterval = setInterval(nextSlide, 3500);
        };

        const pauseCarousel = () => {
          if (state.carouselInterval) {
            clearInterval(state.carouselInterval);
            state.carouselInterval = null;
          }
        };

        // Start autoplay if there's more than one active bean
        startCarousel();

        // Pause on hover, resume on mouse leave (unless manually clicked)
        gifContainer.addEventListener('mouseenter', () => {
          if (!state.carouselManualPaused) {
            pauseCarousel();
          }
        });

        gifContainer.addEventListener('mouseleave', () => {
          if (!state.carouselManualPaused) {
            startCarousel();
          }
        });
      }

      localStorage.setItem('bean_identity_result', beanKey);
    }

    function parseWeights(weightStr) {
      const weights = {};
      if (!weightStr) return weights;
      weightStr.split(',').forEach((item) => {
        const [bean, val] = item.split(':');
        if (bean && val) {
          weights[bean.trim()] = Number(val.trim());
        }
      });
      return weights;
    }

    function goNextFrom(step, optionButton) {
      const weightStr = optionButton.dataset.weights || '';
      const nextStep = step + 1;
      const previousWeightsStr = state.answers[step];

      if (previousWeightsStr) {
        const prevWeights = parseWeights(previousWeightsStr);
        for (const bean in prevWeights) {
          state.scores[bean] = Math.max(0, state.scores[bean] - prevWeights[bean]);
        }
      }

      state.answers[step] = weightStr;
      const currentWeights = parseWeights(weightStr);
      for (const bean in currentWeights) {
        state.scores[bean] = (state.scores[bean] || 0) + currentWeights[bean];
      }

      optionButton
        .closest('[data-quiz-screen]')
        .querySelectorAll('.bean-quiz__option')
        .forEach((option) => {
          option.classList.remove('is-selected');
        });
      optionButton.classList.add('is-selected');

      window.setTimeout(function () {
        if (nextStep > state.totalSteps) {
          const winner = getWinningBean();
          renderResult(winner);
          showScreen('result');
        } else {
          showScreen(String(nextStep));
        }
      }, 180);
    }

    function goBack() {
      if (state.current === 'result') {
        showScreen(String(state.totalSteps));
        return;
      }

      if (state.current === 'welcome') {
        return;
      }

      const step = Number(state.current);
      if (step > 1) {
        showScreen(String(step - 1));
      } else {
        showScreen('welcome');
      }
    }

    function resetQuiz() {
      state.current = 'welcome';
      state.answers = {};
      state.scores = {
        coffee: 0,
        chilli: 0,
        vanilla: 0,
        jelly: 0,
        green: 0,
      };

      // Carousel state cleanup
      if (state.carouselInterval) {
        clearInterval(state.carouselInterval);
        state.carouselInterval = null;
      }
      state.carouselLayers = [];
      state.carouselDots = [];
      state.carouselIndex = 0;
      state.carouselIsPlaying = true;
      state.carouselManualPaused = false;

      // Carousel DOM cleanup
      if (gifContainer) gifContainer.innerHTML = '';
      if (carouselBadge) {
        carouselBadge.innerHTML = '';
        carouselBadge.classList.remove('is-visible');
      }
      if (carouselControls) carouselControls.innerHTML = '';

      root.querySelectorAll('.bean-quiz__option').forEach((option) => {
        option.classList.remove('is-selected');
      });

      showScreen('welcome');
    }

    startButtons.forEach((startButton) => {
      startButton.addEventListener('click', function () {
        showScreen('1');
      });
    });

    if (backButton) {
      backButton.addEventListener('click', goBack);
    }

    if (restartButton) {
      restartButton.addEventListener('click', resetQuiz);
    }

    root.querySelectorAll('.bean-quiz__screen[data-step]').forEach((screen) => {
      const step = Number(screen.dataset.step);
      screen.querySelectorAll('.bean-quiz__option').forEach((button) => {
        button.addEventListener('click', function () {
          goNextFrom(step, button);
        });
      });
    });

    // ==========================================
    // Permutation Tester Debug Utility
    // ==========================================
    if (window.location.search.includes('debug=true') || window.location.search.includes('test=true')) {
      const debugStyle = document.createElement('style');
      debugStyle.textContent = `
        .bean-quiz-debug-trigger {
          position: fixed;
          bottom: 2rem;
          right: 2rem;
          z-index: 99999;
          background: rgba(11, 11, 11, 0.85);
          backdrop-filter: blur(12px);
          -webkit-backdrop-filter: blur(12px);
          border: 1px solid rgba(198, 169, 105, 0.3);
          color: #c6a969;
          padding: 1.2rem 2rem;
          border-radius: 999px;
          font-family: 'Poppins', sans-serif;
          font-size: 1.2rem;
          font-weight: 800;
          letter-spacing: 0.08em;
          text-transform: uppercase;
          cursor: pointer;
          display: flex;
          align-items: center;
          gap: 0.8rem;
          box-shadow: 0 1rem 3rem rgba(0,0,0,0.5);
          transition: all 0.28s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }
        .bean-quiz-debug-trigger:hover {
          transform: translateY(-0.2rem) scale(1.05);
          border-color: #c6a969;
          background: #c6a969;
          color: #0b0b0b;
        }
        .bean-quiz-debug-panel {
          position: fixed;
          bottom: 6.5rem;
          right: 2rem;
          z-index: 99998;
          width: 34rem;
          background: rgba(15, 15, 15, 0.94);
          backdrop-filter: blur(20px);
          -webkit-backdrop-filter: blur(20px);
          border: 1px solid rgba(245, 245, 245, 0.1);
          border-radius: 2.2rem;
          padding: 2.2rem;
          box-shadow: 0 2rem 5rem rgba(0,0,0,0.6);
          font-family: 'Poppins', sans-serif;
          transform: translateY(2rem) scale(0.95);
          opacity: 0;
          pointer-events: none;
          transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }
        .bean-quiz-debug-panel.is-open {
          transform: translateY(0) scale(1);
          opacity: 1;
          pointer-events: auto;
        }
        .bean-quiz-debug-title {
          margin: 0 0 1.6rem;
          font-size: 1.35rem;
          font-weight: 800;
          letter-spacing: 0.1em;
          text-transform: uppercase;
          color: #f5f5f5;
          border-bottom: 1px solid rgba(245, 245, 245, 0.08);
          padding-bottom: 0.8rem;
        }
        .bean-quiz-debug-label {
          display: block;
          margin-bottom: 0.8rem;
          font-size: 1.05rem;
          font-weight: 800;
          text-transform: uppercase;
          letter-spacing: 0.06em;
          color: rgba(245, 245, 245, 0.6);
        }
        .bean-quiz-debug-select {
          width: 100%;
          background: rgba(255, 255, 255, 0.05);
          border: 1px solid rgba(245, 245, 245, 0.15);
          color: #f5f5f5;
          padding: 1.2rem;
          border-radius: 1.2rem;
          font-size: 1.25rem;
          font-family: 'Poppins', sans-serif;
          margin-bottom: 1.8rem;
          cursor: pointer;
          outline: none;
        }
        .bean-quiz-debug-select option {
          background: #111111;
          color: #f5f5f5;
        }
        .bean-quiz-debug-btn {
          width: 100%;
          min-height: 4.8rem;
          background: #c6a969;
          border: 1px solid #c6a969;
          color: #0b0b0b;
          border-radius: 999px;
          font-size: 1.15rem;
          font-weight: 900;
          text-transform: uppercase;
          letter-spacing: 0.08em;
          cursor: pointer;
          transition: all 0.24s ease;
        }
        .bean-quiz-debug-btn:hover {
          background: #f5f5f5;
          border-color: #f5f5f5;
        }
      `;
      document.head.appendChild(debugStyle);

      const trigger = document.createElement('button');
      trigger.className = 'bean-quiz-debug-trigger';
      trigger.type = 'button';
      trigger.innerHTML = '⚙️ Result Tester';
      document.body.appendChild(trigger);

      const panel = document.createElement('div');
      panel.className = 'bean-quiz-debug-panel';
      panel.innerHTML = `
        <h3 class="bean-quiz-debug-title">⚙️ Permutation Tester</h3>
        <label class="bean-quiz-debug-label" for="debug-outcome-select">Select Outcome Profile</label>
        <select id="debug-outcome-select" class="bean-quiz-debug-select">
          <optgroup label="Single Dominant Archetypes">
            <option value="coffee">Coffee Bean</option>
            <option value="chilli">Chilli Bean</option>
            <option value="vanilla">Vanilla Bean</option>
            <option value="jelly">Jelly Bean</option>
            <option value="green">Green Bean</option>
          </optgroup>
          <optgroup label="Dual Blend Permutations (20 Profiles)">
            <option value="coffee_green">Coffee & Green — The Still Water</option>
            <option value="green_coffee">Green & Coffee — Reversed Still Water</option>
            <option value="coffee_chilli">Coffee & Chilli — The Sharp Thinker</option>
            <option value="chilli_coffee">Chilli & Coffee — Reversed Sharp Thinker</option>
            <option value="coffee_jelly">Coffee & Jelly — The Soft Observer</option>
            <option value="jelly_coffee">Jelly & Coffee — Reversed Soft Observer</option>
            <option value="coffee_vanilla">Coffee & Vanilla — The Restless Mind</option>
            <option value="vanilla_coffee">Vanilla & Coffee — Reversed Restless Mind</option>
            <option value="vanilla_jelly">Vanilla & Jelly — The Electric Optimist</option>
            <option value="jelly_vanilla">Jelly & Vanilla — Reversed Electric Optimist</option>
            <option value="vanilla_chilli">Vanilla & Chilli — The Live Wire</option>
            <option value="chilli_vanilla">Chilli & Vanilla — Reversed Live Wire</option>
            <option value="vanilla_green">Vanilla & Green — The Open Road</option>
            <option value="green_vanilla">Green & Vanilla — Reversed Open Road</option>
            <option value="chilli_jelly">Chilli & Jelly — The Charismatic Storm</option>
            <option value="jelly_chilli">Jelly & Chilli — Reversed Charismatic Storm</option>
            <option value="chilli_green">Chilli & Green — The Quiet Revolutionary</option>
            <option value="green_chilli">Green & Chilli — Reversed Quiet Revolutionary</option>
            <option value="jelly_green">Jelly & Green — The Warm Anchor</option>
            <option value="green_jelly">Green & Jelly — Reversed Warm Anchor</option>
          </optgroup>
        </select>
        <button type="button" id="debug-simulate-btn" class="bean-quiz-debug-btn">Simulate Result</button>
      `;
      document.body.appendChild(panel);

      trigger.addEventListener('click', () => {
        panel.classList.toggle('is-open');
      });

      document.getElementById('debug-simulate-btn').addEventListener('click', () => {
        const value = document.getElementById('debug-outcome-select').value;
        panel.classList.remove('is-open');

        // Reset scores
        for (const key in state.scores) {
          state.scores[key] = 0;
        }

        if (value.includes('_')) {
          // Dual Blend
          const [primary, secondary] = value.split('_');
          state.scores[primary] = 45;
          state.scores[secondary] = 38;
          // Set others to small values
          const others = Object.keys(state.scores).filter((k) => k !== primary && k !== secondary);
          others.forEach((key, i) => {
            state.scores[key] = 5 + i;
          });

          renderResult(primary);
        } else {
          // Single Archetype
          state.scores[value] = 70;
          const others = Object.keys(state.scores).filter((k) => k !== value);
          others.forEach((key, i) => {
            state.scores[key] = 7 + i;
          });

          renderResult(value);
        }

        showScreen('result');
      });
    }

    showScreen('welcome');
  })();
</script>

{% schema %}
{
  "name": "Main Quiz",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Which Bean Are You?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Five quick choices. One personality match."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#080808"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#F5F5F5"
    }
  ]
}
{% endschema %}
