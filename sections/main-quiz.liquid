                target="_blank"
                data-share-whatsapp
                aria-label="Share on WhatsApp"
              >
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.057 5.291 5.349 0 11.859 0c3.15 0 6.11 1.229 8.337 3.459a11.785 11.785 0 0 1 3.456 8.349c-.002 6.545-5.3 11.84-11.808 11.84h-.002c-1.996 0-3.957-.507-5.69-1.472L0 24zm6.59-4.846c1.62.962 3.208 1.47 5.269 1.472 5.485 0 9.948-4.468 9.95-9.95.002-2.656-1.03-5.153-2.903-7.027A9.888 9.888 0 0 0 11.857 1.05C6.37 1.05 1.908 5.518 1.906 11c-.001 2.012.525 3.977 1.522 5.711l-.991 3.616 3.71-.973zm12.174-6.864c-.294-.147-1.743-.86-2.012-.958-.268-.098-.463-.147-.658.147-.195.294-.755.958-.926 1.154-.171.195-.341.22-.635.073a9.006 9.006 0 0 1-2.585-1.595 9.902 9.902 0 0 1-1.789-2.227c-.171-.294-.018-.452.129-.597.133-.13.294-.342.44-.514.147-.171.195-.293.293-.489.098-.195.049-.366-.024-.513-.073-.147-.658-1.587-.902-2.173-.238-.573-.48-.494-.658-.503-.171-.008-.366-.01-.561-.01-.195 0-.512.073-.78.366-.268.293-1.024 1.001-1.024 2.441 0 1.439 1.049 2.83 1.195 3.025.147.195 2.064 3.15 5.001 4.417.699.301 1.244.482 1.67.618.702.223 1.34.192 1.845.116.563-.085 1.743-.712 1.987-1.401.244-.689.244-1.28.171-1.401-.073-.122-.268-.195-.561-.342z"/>
