          // 7. Traits
          ctx.fillStyle = profile.accent || '#c6a969';
          ctx.font = '800 16px "Poppins", sans-serif';
          const traitsText = profile.traits.join('  ★  ').toUpperCase();
          const traitsY = titleEndY + 55;
          ctx.fillText(traitsText, 320, traitsY);

          // 8. Description
          ctx.fillStyle = 'rgba(255, 255, 255, 0.72)';
          ctx.font = '500 20px "Poppins", sans-serif';
          ctx.textAlign = 'center';
          const descMaxWidth = 440;
          const descLineHeight = 32;
          wrapText(ctx, profile.desc, 320, traitsY + 55, descMaxWidth, descLineHeight);

          // 9. Draw Bean Image (Right Column)
          if (profile.isBlend && beanImg2.complete && beanImg2.naturalWidth > 0) {
            const beanSize = 320;
            const beanY = 460 - beanSize / 2;
            const bean1X = 510;
            const bean2X = 690;
            
            const glowGrad1 = ctx.createRadialGradient(
              bean1X + beanSize / 2, beanY + beanSize / 2, 10,
              bean1X + beanSize / 2, beanY + beanSize / 2, beanSize / 2 + 50
            );
            const rgbAccent1 = hexToRgb(profile.accent || '#c6a969');
            const rgbaAccentGlow1 = rgbAccent1 ? `rgba(${rgbAccent1.r}, ${rgbAccent1.g}, ${rgbAccent1.b}, 0.18)` : 'rgba(198, 169, 105, 0.18)';
            glowGrad1.addColorStop(0, rgbaAccentGlow1);
            glowGrad1.addColorStop(1, 'rgba(8, 8, 8, 0)');
            ctx.fillStyle = glowGrad1;
            ctx.beginPath();
            ctx.arc(bean1X + beanSize / 2, beanY + beanSize / 2, beanSize / 2 + 30, 0, Math.PI * 2);
            ctx.fill();
            
            const secondaryAccent = archetypes[profile.secondaryKey] ? archetypes[profile.secondaryKey].accent : '#c6a969';
            const glowGrad2 = ctx.createRadialGradient(
              bean2X + beanSize / 2, beanY + beanSize / 2, 10,
              bean2X + beanSize / 2, beanY + beanSize / 2, beanSize / 2 + 50
            );
            const rgbAccent2 = hexToRgb(secondaryAccent);
            const rgbaAccentGlow2 = rgbAccent2 ? `rgba(${rgbAccent2.r}, ${rgbAccent2.g}, ${rgbAccent2.b}, 0.18)` : 'rgba(198, 169, 105, 0.18)';
            glowGrad2.addColorStop(0, rgbaAccentGlow2);
