            glowGrad.addColorStop(0, rgbaAccentGlow);
            glowGrad.addColorStop(1, 'rgba(8, 8, 8, 0)');
            
            ctx.fillStyle = glowGrad;
            ctx.beginPath();
            ctx.arc(beanX + beanSize / 2, beanY + beanSize / 2, beanSize / 2 + 50, 0, Math.PI * 2);
            ctx.fill();
            
            ctx.drawImage(beanImg, beanX, beanY, beanSize, beanSize);
          }

          // 10. Donut Chart (Bottom Left Column)
          const donutCenterX = 320;
          const donutCenterY = 740;
          const donutRadius = 90;
          const donutThickness = 14;
          ctx.lineWidth = donutThickness;
          ctx.lineCap = 'round';

          // Circle track
          ctx.strokeStyle = 'rgba(255, 255, 255, 0.04)';
          ctx.beginPath();
          ctx.arc(donutCenterX, donutCenterY, donutRadius, 0, Math.PI * 2);
          ctx.stroke();

          // Draw Segments based on scores
          const sortedDisplay = calculatePercentages();
          let accumulatedAngle = -Math.PI / 2;
          sortedDisplay.forEach(([key, pct]) => {
            if (pct > 0) {
              const angleRange = (pct / 100) * Math.PI * 2;
              ctx.strokeStyle = archetypes[key].accent;
              ctx.beginPath();
              ctx.arc(donutCenterX, donutCenterY, donutRadius, accumulatedAngle, accumulatedAngle + angleRange);
              ctx.stroke();
              accumulatedAngle += angleRange;
            }
          });

          // Donut Inner Text (Clean percentage centered)
          ctx.fillStyle = '#ffffff';
          ctx.font = '900 32px "Poppins", sans-serif';
          ctx.textAlign = 'center';
