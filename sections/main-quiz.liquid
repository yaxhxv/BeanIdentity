                <span>WhatsApp</span>
              </a>
              <!-- Instagram -->
              <button
                class="bean-quiz__share-btn bean-quiz__share-btn--instagram"
                type="button"
                data-share-instagram
                aria-label="Share on Instagram"
              >
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
