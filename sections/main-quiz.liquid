          ctx.fillRect(0, 0, width, height);

          // 2. Draw Grid Lines
          ctx.strokeStyle = 'rgba(255, 255, 255, 0.02)';
          ctx.lineWidth = 1;
          const gridSize = 80;
          for (let x = 0; x < width; x += gridSize) {
            ctx.beginPath();
            ctx.moveTo(x, 0);
            ctx.lineTo(x, height);
            ctx.stroke();
          }
          for (let y = 0; y < height; y += gridSize) {
            ctx.beginPath();
            ctx.moveTo(0, y);
            ctx.lineTo(width, y);
            ctx.stroke();
          }

          // 3. Draw Outer Border
          ctx.strokeStyle = profile.accent || '#c6a969';
          ctx.lineWidth = 2;
          ctx.globalAlpha = 0.35;
