{%- style -%}
  .bean-quiz-page {
    position: relative;
    overflow: hidden;
    background: radial-gradient(circle at 12% 14%, rgba(198, 169, 105, 0.16), transparent 28%),
      radial-gradient(circle at 88% 22%, rgba(255, 255, 255, 0.08), transparent 24%),
      linear-gradient(180deg, #080808 0%, #101010 52%, #141414 100%);
    color: #f5f5f5;
  }

  .bean-quiz-page::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 5.2rem 5.2rem;
    opacity: 0.22;
    pointer-events: none;
  }

  .bean-quiz-page__shell {
    position: relative;
    z-index: 1;
    width: min(120rem, calc(100% - 4rem));
    margin: 0 auto;
    padding: clamp(2rem, 3.5vw, 3.6rem) 0 clamp(4rem, 6vw, 6rem);
  }

  .bean-quiz-page__hero {
    display: grid;
    grid-template-columns: minmax(0, 72rem);
    gap: 0;
    align-items: center;
    min-height: auto;
    padding: clamp(2rem, 4vw, 3.6rem) 0 2rem;
    border-bottom: 1px solid rgba(245, 245, 245, 0.08);
    justify-content: center;
  }

  .bean-quiz-page__copy {
    text-align: center;
  }

  .bean-quiz-page__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 1.6rem;
    font-family: 'Poppins', sans-serif;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #c6a969;
  }

  .bean-quiz-page__eyebrow::before {
    content: '';
    width: 4.8rem;
    height: 1px;
    background: currentColor;
  }

  .bean-quiz-page__title {
    margin: 0;
    max-width: none;
    font-family: var(--font-heading-family);
    font-size: clamp(4.4rem, 8vw, 9.6rem);
    font-weight: 900;
    line-height: 0.84;
    text-transform: uppercase;
    color: #f5f5f5;
    text-wrap: balance;
  }

  .bean-quiz-page__subtitle {
    max-width: 62rem;
    margin: 1.4rem 0 0;
    margin-inline: auto;
    font-family: 'Poppins', sans-serif;
    font-size: clamp(1.6rem, 1.7vw, 1.85rem);
    line-height: 1.5;
    color: rgba(245, 245, 245, 0.7);
  }

  .bean-quiz {
    max-width: 92rem;
    margin: clamp(2.2rem, 4vw, 3.6rem) auto 0;
  }

  .bean-quiz__status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1.2rem;
  }

  .bean-quiz__status-label,
  .bean-quiz__step-count {
    font-family: 'Poppins', sans-serif;
    font-size: 1.02rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.52);
  }

  .bean-quiz__progress {
    width: 100%;
    height: 0.5rem;
    margin-bottom: 1.8rem;
    background: rgba(245, 245, 245, 0.08);
    overflow: hidden;
  }

  .bean-quiz__progress-bar {
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, #8d6b3d 0%, #c6a969 45%, #f5e3b0 100%);
    transition: width 0.4s ease;
  }

  .bean-quiz__panel {
    position: relative;
    min-height: 22rem;
    padding: clamp(1.6rem, 2vw, 2.2rem);
    border: 1px solid rgba(245, 245, 245, 0.1);
    background: rgba(255, 255, 255, 0.04);
    box-shadow: 0 2rem 6rem rgba(0, 0, 0, 0.22);
    backdrop-filter: blur(10px);
    border-radius: 3rem;
  }

  .bean-quiz__screen {
    display: none;
    opacity: 0;
    transform: translateY(1rem);
    transition: opacity 0.32s ease, transform 0.32s ease;
  }

  .bean-quiz__screen.is-active {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }

  .bean-quiz__intro-title,
  .bean-quiz__question-title,
  .bean-quiz__result-title {
    margin: 0;
    font-family: var(--font-heading-family);
    font-weight: 900;
    text-transform: uppercase;
    color: #f5f5f5;
    letter-spacing: 0;
    line-height: 0.92;
  }

  .bean-quiz__intro-title {
    max-width: 5ch;
    font-size: clamp(2.8rem, 3.4vw, 3.8rem);
    line-height: 0.9;
  }

  .bean-quiz__question-title {
    max-width: 28ch;
    font-size: clamp(2.2rem, 4vw, 3rem);
    text-transform: lowercase;
    line-height: 1.1;
  }

  .bean-quiz__result-title {
    font-size: clamp(4rem, 7vw, 7rem);
  }

  .bean-quiz__intro-copy,
  .bean-quiz__question-copy,
  .bean-quiz__result-copy {
    max-width: 58rem;
    margin: 1rem 0 0;
    font-family: 'Poppins', sans-serif;
    font-size: 1.42rem;
    line-height: 1.48;
    color: rgba(245, 245, 245, 0.72);
  }

  .bean-quiz__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 5.6rem;
    padding: 0 2.6rem;
    margin-top: 1.2rem;
    border: 1px solid #c6a969;
    background: #c6a969;
    color: #0b0b0b;
    text-decoration: none;
    font-family: 'Poppins', sans-serif;
    font-size: 1.08rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 0.28s ease, background 0.28s ease, border-color 0.28s ease, color 0.28s ease;
    border-radius: 999px;
  }

  .bean-quiz__screen[data-quiz-screen='welcome'].is-active {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.9fr);
    gap: 2rem;
    align-items: center;
  }

  .bean-quiz__welcome-copy {
    display: grid;
    gap: 0;
  }

  .bean-quiz__welcome-side {
    position: relative;
    min-height: 100%;
    padding: 1.6rem;
    border-radius: 2.2rem;
    background: radial-gradient(circle at 80% 24%, rgba(198, 169, 105, 0.16), transparent 22%),
      rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(245, 245, 245, 0.08);
    overflow: hidden;
  }

  .bean-quiz__welcome-pillars {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .bean-quiz__welcome-pill {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0 1rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(245, 245, 245, 0.08);
    color: rgba(245, 245, 245, 0.78);
    font-family: 'Poppins', sans-serif;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .bean-quiz__welcome-art {
    position: absolute;
    right: -1rem;
    bottom: -1rem;
    width: clamp(110px, 13vw, 160px);
    height: auto;
    opacity: 0.22;
    pointer-events: none;
    filter: drop-shadow(0 1.6rem 2.8rem rgba(0, 0, 0, 0.24));
  }

  .bean-quiz__button:hover {
    transform: translateY(-0.2rem);
    background: #f5f5f5;
    border-color: #f5f5f5;
    color: #0b0b0b;
  }

  .bean-quiz__options {
    display: grid;
    gap: 1.2rem;
    margin-top: 2rem;
  }

  .bean-quiz__option {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.6rem;
    align-items: start;
    width: 100%;
    padding: 1.5rem 1.8rem;
    border: 1px solid rgba(245, 245, 245, 0.1);
    background: rgba(255, 255, 255, 0.02);
    color: #f5f5f5;
    text-align: left;
    cursor: pointer;
    transition: transform 0.24s ease, border-color 0.24s ease, background 0.24s ease, box-shadow 0.24s ease;
  }

  .bean-quiz__option:hover,
  .bean-quiz__option.is-selected {
    transform: translateY(-0.2rem);
    border-color: rgba(198, 169, 105, 0.72);
    background: rgba(198, 169, 105, 0.08);
    box-shadow: 0 1.4rem 3.2rem rgba(0, 0, 0, 0.18);
  }

  .bean-quiz__option-index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.2rem;
    height: 3.2rem;
    border: 1px solid rgba(245, 245, 245, 0.18);
    color: rgba(245, 245, 245, 0.76);
    font-family: 'Poppins', sans-serif;
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .bean-quiz__option-text {
    font-family: 'Poppins', sans-serif;
    font-size: 1.5rem;
    line-height: 1.5;
    color: #f5f5f5;
  }

  .bean-quiz__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 1.8rem;
  }

  .bean-quiz__helper {
    margin: 0;
    font-family: 'Poppins', sans-serif;
    font-size: 1.35rem;
    line-height: 1.6;
    color: rgba(245, 245, 245, 0.5);
  }

  .bean-quiz__ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 5.2rem;
    padding: 0 2.4rem;
    border: 1px solid rgba(245, 245, 245, 0.22);
    background: transparent;
    color: #f5f5f5;
    font-family: 'Poppins', sans-serif;
    font-size: 1.08rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 0.24s ease, border-color 0.24s ease, color 0.24s ease;
  }

  .bean-quiz__ghost:hover {
    transform: translateY(-0.2rem);
    border-color: #f5f5f5;
  }

  .bean-quiz__result-card {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(28rem, 0.9fr);
    gap: 2.4rem;
    margin-top: 2.8rem;
  }

  .bean-quiz__blend-breakdown {
    margin-top: 2.8rem;
    padding: 2.2rem;
    border: 1px solid var(--result-border);
    background: var(--result-panel);
    border-radius: 2.6rem;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .bean-quiz__blend-classification {
    font-family: var(--font-heading-family);
    font-size: clamp(2rem, 3.5vw, 3.2rem);
    font-weight: 900;
    text-transform: uppercase;
    color: var(--result-accent);
    margin-bottom: 0.8rem;
    letter-spacing: 0.05em;
  }

  .bean-quiz__blend-bar {
    display: flex;
    height: 1.6rem;
    border-radius: 999px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.06);
    margin: 1.6rem 0;
  }

  .bean-quiz__blend-segment {
    height: 100%;
    transition: width 0.6s ease;
  }

  .bean-quiz__blend-labels {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    font-family: 'Poppins', sans-serif;
    font-size: 1.35rem;
    line-height: 1.5;
  }

  .bean-quiz__blend-text {
    color: var(--result-copy-soft);
  }

  .bean-quiz__blend-text strong {
    color: var(--result-ink);
  }

  .bean-quiz__detailed-sections {
    display: grid;
    gap: 2rem;
    margin-top: 2.4rem;
    padding-top: 2.4rem;
    border-top: 1px solid rgba(245, 245, 245, 0.08);
  }

  .bean-quiz__detail-item {
    display: grid;
    gap: 0.6rem;
  }

  .bean-quiz__detail-title {
    font-family: 'Poppins', sans-serif;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.52);
  }

  .bean-quiz__detail-desc {
    margin: 0;
    font-family: 'Poppins', sans-serif;
    font-size: 1.4rem;
    line-height: 1.55;
    color: var(--result-ink);
    opacity: 0.88;
  }

  .bean-quiz__screen[data-quiz-screen='result'] {
    --result-bg: rgba(255, 255, 255, 0.04);
    --result-bg-strong: rgba(255, 255, 255, 0.08);
    --result-ink: #f5f5f5;
    --result-copy-soft: rgba(245, 245, 245, 0.72);
    --result-border: rgba(245, 245, 245, 0.1);
    --result-glow: rgba(198, 169, 105, 0.18);
    --result-panel: rgba(255, 255, 255, 0.04);
    --result-panel-alt: rgba(255, 255, 255, 0.03);
    position: relative;
    padding: clamp(2rem, 3vw, 3rem);
    border-radius: 2.6rem;
    overflow: hidden;
    background: radial-gradient(circle at top right, var(--result-glow) 0%, transparent 28rem),
      linear-gradient(135deg, var(--result-bg-strong), var(--result-bg));
    border: 1px solid var(--result-border);
  }

  .bean-quiz__screen[data-quiz-screen='result']::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0)),
      radial-gradient(circle at left bottom, rgba(255, 255, 255, 0.08), transparent 22rem);
    pointer-events: none;
  }

  .bean-quiz__result-hero {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(24rem, 0.9fr);
    gap: 2.4rem;
    align-items: center;
  }

  .bean-quiz__result-copy-block {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .bean-quiz__result-kicker {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin: 0;
    color: var(--result-accent, #c6a969);
    font-family: 'Poppins', sans-serif;
    font-size: 1.02rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .bean-quiz__result-kicker::before {
    content: '';
    width: 4rem;
    height: 1px;
    background: currentColor;
    opacity: 0.7;
  }

  .bean-quiz__result-title,
  .bean-quiz__result-copy,
  .bean-quiz__result-label,
  .bean-quiz__result-stat span,
  .bean-quiz__trait {
    position: relative;
    z-index: 1;
  }

  .bean-quiz__result-title {
    color: var(--result-ink);
  }

  .bean-quiz__result-copy {
    max-width: 52rem;
    color: var(--result-copy-soft);
  }

  .bean-quiz__result-visual {
    position: relative;
    display: grid;
    place-items: center;
  }

  .bean-quiz__result-visual-shell {
    position: relative;
    display: grid;
    place-items: center;
    width: min(100%, 34rem);
    aspect-ratio: 1 / 1;
    border-radius: 3rem;
    border: none;
    background: #ffffff;
    overflow: visible;
    /* Fade the white shell to transparent at edges */
    -webkit-mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 38%, transparent 72%);
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 38%, transparent 72%);
  }

  .bean-quiz__result-visual-shell::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(circle at 50% 50%, var(--result-glow, rgba(198, 169, 105, 0.18)), transparent 70%);
    filter: blur(20px);
    z-index: 0;
  }

  .bean-quiz__result-gif {
    position: relative;
    z-index: 1;
    width: min(100%, 32rem);
    height: auto;
    display: block;
    /* No mix-blend-mode needed — shell background matches gif's white */
  }

  .bean-quiz__result-illustration {
    position: absolute;
    right: -0.8rem;
    bottom: -0.8rem;
    width: clamp(8.6rem, 9vw, 12rem);
    height: auto;
    opacity: 0.95;
    filter: drop-shadow(0 1.2rem 2rem rgba(0, 0, 0, 0.18));
  }

  .bean-quiz__result-copy-wrap,
  .bean-quiz__result-meta {
    padding: 2.2rem;
    border: 1px solid var(--result-border);
    background: var(--result-panel);
    border-radius: 2.2rem;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .bean-quiz__result-label {
    display: inline-block;
    margin: 0 0 1.2rem;
    font-family: 'Poppins', sans-serif;
    font-size: 1.02rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--result-accent, #c6a969);
  }

  .bean-quiz__traits {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.8rem;
  }

  .bean-quiz__trait {
    display: inline-flex;
    align-items: center;
    min-height: 3.4rem;
    padding: 0 1.3rem;
    border: 1px solid rgba(245, 245, 245, 0.12);
    background: rgba(255, 255, 255, 0.08);
    font-family: 'Poppins', sans-serif;
    font-size: 1.02rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--result-ink);
  }

  .bean-quiz__result-stat + .bean-quiz__result-stat {
    margin-top: 1.8rem;
    padding-top: 1.8rem;
    border-top: 1px solid rgba(245, 245, 245, 0.08);
  }

  .bean-quiz__result-stat strong,
  .bean-quiz__result-stat span {
    display: block;
    font-family: 'Poppins', sans-serif;
  }

  .bean-quiz__result-stat strong {
    margin-bottom: 0.5rem;
    font-size: 1.06rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.52);
  }

  .bean-quiz__result-stat span {
    font-size: 1.55rem;
    line-height: 1.6;
    color: var(--result-ink);
  }

  .bean-quiz__result-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-top: 2.4rem;
  }

  .bean-quiz__result-bridge {
    display: none;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.2rem;
    margin-top: 2rem;
  }

  .bean-quiz__bridge-card {
    padding: 1.6rem 1.5rem;
    border: 1px solid var(--result-border);
    border-radius: 1.8rem;
    background: var(--result-panel-alt);
  }

  @media screen and (max-width: 989px) {
    .bean-quiz__result-card {
      grid-template-columns: 1fr;
    }
    .bean-quiz__result-hero {
      grid-template-columns: 1fr;
      text-align: center;
      justify-items: center;
    }
    .bean-quiz__result-copy {
      margin-inline: auto;
    }
    .bean-quiz__result-bridge {
      grid-template-columns: 1fr;
    }
    .bean-quiz__result-visual-shell {
      width: min(100%, 28rem);
    }
    .bean-quiz__result-actions {
      justify-content: center;
    }
  }

  .bean-quiz__bridge-card strong,
  .bean-quiz__bridge-card span {
    display: block;
    font-family: 'Poppins', sans-serif;
  }

  .bean-quiz__bridge-card strong {
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.5);
  }

  .bean-quiz__bridge-card span {
    font-size: 1.3rem;
    line-height: 1.45;
    color: var(--result-ink);
  }

  .bean-quiz__button--secondary {
    border-color: rgba(245, 245, 245, 0.22);
    background: transparent;
    color: #f5f5f5;
  }

  .bean-quiz__button--secondary:hover {
    background: #f5f5f5;
    border-color: #f5f5f5;
    color: #0b0b0b;
  }

  @media screen and (max-width: 989px) {
    .bean-quiz-page__hero,
    .bean-quiz__result-card,
    .bean-quiz__result-hero,
    .bean-quiz__result-bridge {
      grid-template-columns: 1fr;
    }

    .bean-quiz-page__title {
      max-width: none;
      font-size: clamp(4.2rem, 14vw, 7.4rem);
    }
  }

  @media screen and (max-width: 749px) {
    .bean-quiz-page__shell {
      width: calc(100% - 3rem);
      padding-top: 1.4rem;
      padding-bottom: 3.2rem;
    }

    .bean-quiz-page__hero {
      gap: 1.6rem;
      padding-top: 2rem;
      padding-bottom: 1.6rem;
    }

    .bean-quiz__panel {
      min-height: auto;
      padding: 2rem 1.6rem;
    }

    .bean-quiz__screen[data-quiz-screen='welcome'].is-active {
      grid-template-columns: 1fr;
      gap: 1.4rem;
    }

    .bean-quiz__welcome-side {
      padding: 1.2rem;
      min-height: 11rem;
    }

    .bean-quiz__welcome-art {
      width: 96px;
    }

    .bean-quiz__status {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.8rem;
    }

    .bean-quiz__option {
      padding: 1.5rem;
      gap: 1.2rem;
    }

    .bean-quiz__option-text,
    .bean-quiz__intro-copy,
    .bean-quiz__question-copy,
    .bean-quiz__result-copy {
      font-size: 1.5rem;
    }

    .bean-quiz__footer,
    .bean-quiz__result-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .bean-quiz__button,
    .bean-quiz__ghost,
    .bean-quiz__button--secondary {
      width: 100%;
    }
  }
{%- endstyle -%}

<section
  id="Quiz-{{ section.id }}"
  class="bean-quiz-page"
  data-section-id="{{ section.id }}"
  data-quiz-root
>
  <div class="bean-quiz-page__shell">
    <div class="bean-quiz-page__hero">
      <div class="bean-quiz-page__copy">
        <p class="bean-quiz-page__eyebrow">Bean Identity Quiz</p>
        <h1 class="bean-quiz-page__title">{{ section.settings.heading }}</h1>
        <p class="bean-quiz-page__subtitle">
          {{ section.settings.subheading }}
        </p>
      </div>
    </div>

    <div class="bean-quiz" data-quiz-app>
      <div class="bean-quiz__status">
        <span class="bean-quiz__status-label">Identity scan</span>
        <span class="bean-quiz__step-count" data-quiz-count>Intro</span>
      </div>

      <div class="bean-quiz__progress">
        <div class="bean-quiz__progress-bar" data-quiz-progress></div>
      </div>

      <div class="bean-quiz__panel">
        <div class="bean-quiz__screen is-active" data-quiz-screen="welcome">
          <div class="bean-quiz__welcome-copy">
            {% comment %} <h2 class="bean-quiz__intro-title">Find the bean that wears like you.</h2> {% endcomment %}
            <p class="bean-quiz__intro-copy">
              Pick the option that feels most instinctive each time. Do not overthink it. The strongest matches usually
              happen fast.
            </p>
            <button class="bean-quiz__button" type="button" data-quiz-start>Start quiz</button>
          </div>
          <div class="bean-quiz__welcome-side">
            <div class="bean-quiz__welcome-pillars">
              <span class="bean-quiz__welcome-pill">15 questions</span>
              <span class="bean-quiz__welcome-pill">5 min</span>
              <span class="bean-quiz__welcome-pill">1 bean match</span>
            </div>
            {% comment %}
              <img
                src="{{ 'bean-green-1.png' | asset_url }}"
                alt=""
                aria-hidden="true"
                class="bean-quiz__welcome-art"
                loading="lazy"
              >
            {% endcomment %}
          </div>
        </div>

        <div class="bean-quiz__screen" data-quiz-screen="1" data-step="1">
          <h2 class="bean-quiz__question-title">When you walk into a party you weren’t really planning to attend, your 1st instinct is:</h2>
          <p class="bean-quiz__question-copy">Choose the option that feels most natural to you right now.</p>
          <div class="bean-quiz__options">
            <button class="bean-quiz__option" type="button" data-weights="coffee:3,green:1">
              <span class="bean-quiz__option-index">A</span>
              <span class="bean-quiz__option-text">Find the quietest corner & observe before deciding to whether actually exist there</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="vanilla:2,jelly:2">
              <span class="bean-quiz__option-index">B</span>
              <span class="bean-quiz__option-text">Immediately find whoever seems fun and attach yourself to them</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="jelly:3,chilli:1">
              <span class="bean-quiz__option-index">C</span>
              <span class="bean-quiz__option-text">Go straight to the drinks, start a random conversation, and somehow end up being the life of the party</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="green:3,coffee:1">
              <span class="bean-quiz__option-index">D</span>
              <span class="bean-quiz__option-text">Feel mildly overwhelmed but breathe through it, talk to one or two people intentionally</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="chilli:3,jelly:1">
              <span class="bean-quiz__option-index">E</span>
              <span class="bean-quiz__option-text">Walk in like you own it, say something mildly controversial, and see who laughs</span>
            </button>
          </div>
        </div>

        <div class="bean-quiz__screen" data-quiz-screen="2" data-step="2">
          <h2 class="bean-quiz__question-title">A close friend is going through something. You naturally:</h2>
          <p class="bean-quiz__question-copy">Choose the option that feels most natural to you right now.</p>
          <div class="bean-quiz__options">
            <button class="bean-quiz__option" type="button" data-weights="green:3,coffee:1">
              <span class="bean-quiz__option-index">A</span>
              <span class="bean-quiz__option-text">Sit with them without trying to fix anything–just be there</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="jelly:2,chilli:2">
              <span class="bean-quiz__option-index">B</span>
              <span class="bean-quiz__option-text">Send them a voice note rant about how much you love them & want to fight whatever hurt them</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="coffee:3,green:1">
              <span class="bean-quiz__option-index">C</span>
              <span class="bean-quiz__option-text">Research their problem obsessively & come back with a 5-point plan</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="vanilla:2,jelly:2">
              <span class="bean-quiz__option-index">D</span>
              <span class="bean-quiz__option-text">Distract them–plan something exciting, make them laugh, shift the energy</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="chilli:3,green:1">
              <span class="bean-quiz__option-index">E</span>
              <span class="bean-quiz__option-text">Tell them exactly what you think, even if it’s hard to hear, because that’s real love</span>
            </button>
          </div>
        </div>

        <div class="bean-quiz__screen" data-quiz-screen="3" data-step="3">
          <h2 class="bean-quiz__question-title">Your notes app is probably:</h2>
          <p class="bean-quiz__question-copy">Choose the option that feels most natural to you right now.</p>
          <div class="bean-quiz__options">
            <button class="bean-quiz__option" type="button" data-weights="coffee:3,vanilla:1">
              <span class="bean-quiz__option-index">A</span>
              <span class="bean-quiz__option-text">Full of half-finished thoughts, observations, & ideas you’ll “definitely come back to”</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="vanilla:2,jelly:2">
              <span class="bean-quiz__option-index">B</span>
              <span class="bean-quiz__option-text">Vibes, quotes, random plans & screenshots with zero organisation</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="chilli:2,coffee:2">
              <span class="bean-quiz__option-index">C</span>
              <span class="bean-quiz__option-text">Empty.. You keep things in your head</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="green:3,coffee:1">
              <span class="bean-quiz__option-index">D</span>
              <span class="bean-quiz__option-text">A mix of to-dos, reflections & things you’re trying to process</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="jelly:3,vanilla:1">
              <span class="bean-quiz__option-index">E</span>
              <span class="bean-quiz__option-text">Mostly voice memos of you talking to yourself</span>
            </button>
          </div>
        </div>

        <div class="bean-quiz__screen" data-quiz-screen="4" data-step="4">
          <h2 class="bean-quiz__question-title">When someone gives you unsolicited advice, you:</h2>
          <p class="bean-quiz__question-copy">Choose the option that feels most natural to you right now.</p>
          <div class="bean-quiz__options">
            <button class="bean-quiz__option" type="button" data-weights="coffee:2,green:2">
              <span class="bean-quiz__option-index">A</span>
              <span class="bean-quiz__option-text">Smile, nod, mentally file it under “noted & ignored”</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="coffee:3,vanilla:1">
              <span class="bean-quiz__option-index">B</span>
              <span class="bean-quiz__option-text">Genuinely consider it – even if you don’t agree, input is data</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="chilli:3,coffee:1">
              <span class="bean-quiz__option-index">C</span>
              <span class="bean-quiz__option-text">Tell them immediately why that won't work for you</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="jelly:2,green:2">
              <span class="bean-quiz__option-index">D</span>
              <span class="bean-quiz__option-text">Feel weirdly defensive but try not to show it</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="vanilla:2,jelly:2">
              <span class="bean-quiz__option-index">E</span>
              <span class="bean-quiz__option-text">Laugh it off & redirect the conversation to something more fun</span>
            </button>
          </div>
        </div>

        <div class="bean-quiz__screen" data-quiz-screen="5" data-step="5">
          <h2 class="bean-quiz__question-title">Your ideal Sunday looks like:</h2>
          <p class="bean-quiz__question-copy">Choose the option that feels most natural to you right now.</p>
          <div class="bean-quiz__options">
            <button class="bean-quiz__option" type="button" data-weights="vanilla:3,jelly:1">
              <span class="bean-quiz__option-index">A</span>
              <span class="bean-quiz__option-text">Doing something completely spontaneous – no plan, just vibes</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="coffee:3,green:1">
              <span class="bean-quiz__option-index">B</span>
              <span class="bean-quiz__option-text">A slow morning, a book or podcast, limited social interaction</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="jelly:3,vanilla:1">
              <span class="bean-quiz__option-index">C</span>
              <span class="bean-quiz__option-text">Being with people you love, probably too loud, probably eating something good</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="green:2,coffee:2">
              <span class="bean-quiz__option-index">D</span>
              <span class="bean-quiz__option-text">Finally doing something you’ve been putting off – you’ll feel peaceful after</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="chilli:3,vanilla:1">
              <span class="bean-quiz__option-index">E</span>
              <span class="bean-quiz__option-text">Literally doing whatever you feel like with zero apology</span>
            </button>
          </div>
        </div>

        <div class="bean-quiz__screen" data-quiz-screen="6" data-step="6">
          <h2 class="bean-quiz__question-title">When you’re making a big decision, you tend to:</h2>
          <p class="bean-quiz__question-copy">Choose the option that feels most natural to you right now.</p>
          <div class="bean-quiz__options">
            <button class="bean-quiz__option" type="button" data-weights="coffee:3,green:1">
              <span class="bean-quiz__option-index">A</span>
              <span class="bean-quiz__option-text">Research it until you feel sick & make a spreadsheet no one asked for</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="vanilla:3,chilli:1">
              <span class="bean-quiz__option-index">B</span>
              <span class="bean-quiz__option-text">Go with your gut, immediately, and figure it out as you go</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="jelly:2,green:2">
              <span class="bean-quiz__option-index">C</span>
              <span class="bean-quiz__option-text">Talk it through with at least 3 people before landing anywhere</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="green:3,coffee:1">
              <span class="bean-quiz__option-index">D</span>
              <span class="bean-quiz__option-text">Sit with it quietly until something becomes clear</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="chilli:3,vanilla:1">
              <span class="bean-quiz__option-index">E</span>
              <span class="bean-quiz__option-text">Make the call, own it fully, and don’t second guess</span>
            </button>
          </div>
        </div>

        <div class="bean-quiz__screen" data-quiz-screen="7" data-step="7">
          <h2 class="bean-quiz__question-title">The compliment that actually lands for you:</h2>
          <p class="bean-quiz__question-copy">Choose the option that feels most natural to you right now.</p>
          <div class="bean-quiz__options">
            <button class="bean-quiz__option" type="button" data-weights="green:2,jelly:2">
              <span class="bean-quiz__option-index">A</span>
              <span class="bean-quiz__option-text">“You always know exactly what to say”</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="vanilla:2,jelly:2">
              <span class="bean-quiz__option-index">B</span>
              <span class="bean-quiz__option-text">“You make everything more fun”</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="chilli:3,coffee:1">
              <span class="bean-quiz__option-index">C</span>
              <span class="bean-quiz__option-text">“You’re the most real person I know”</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="coffee:3,green:1">
              <span class="bean-quiz__option-index">D</span>
              <span class="bean-quiz__option-text">“You notice things no one else does”</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="jelly:3,vanilla:1">
              <span class="bean-quiz__option-index">E</span>
              <span class="bean-quiz__option-text">“You light up every room you’re in”</span>
            </button>
          </div>
        </div>

        <div class="bean-quiz__screen" data-quiz-screen="8" data-step="8">
          <h2 class="bean-quiz__question-title">When conflict arises in a group, you’re typically:</h2>
          <p class="bean-quiz__question-copy">Choose the option that feels most natural to you right now.</p>
          <div class="bean-quiz__options">
            <button class="bean-quiz__option" type="button" data-weights="coffee:2,green:2">
              <span class="bean-quiz__option-index">A</span>
              <span class="bean-quiz__option-text">Quietly trying to understand everyone’s position before saying anything</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="chilli:3,vanilla:1">
              <span class="bean-quiz__option-index">B</span>
              <span class="bean-quiz__option-text">Address it directly & immediately – tension makes you itch</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="jelly:3,vanilla:1">
              <span class="bean-quiz__option-index">C</span>
              <span class="bean-quiz__option-text">Try to lighten the mood – sometimes humour is the safest bridge</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="green:3,coffee:1">
              <span class="bean-quiz__option-index">D</span>
              <span class="bean-quiz__option-text">Become the unofficial mediator, emotionally holding the room</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="coffee:3,green:1">
              <span class="bean-quiz__option-index">E</span>
              <span class="bean-quiz__option-text">Go quiet & process it later, probably alone</span>
            </button>
          </div>
        </div>

        <div class="bean-quiz__screen" data-quiz-screen="9" data-step="9">
          <h2 class="bean-quiz__question-title">Which of these sentences could you have written?</h2>
          <p class="bean-quiz__question-copy">Choose the option that feels most natural to you right now.</p>
          <div class="bean-quiz__options">
            <button class="bean-quiz__option" type="button" data-weights="coffee:3,green:1">
              <span class="bean-quiz__option-index">A</span>
              <span class="bean-quiz__option-text">“I don’t hate people. I just find them exhausting in large doses”</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="vanilla:3,jelly:1">
              <span class="bean-quiz__option-index">B</span>
              <span class="bean-quiz__option-text">“I want to do everything. I genuinely cannot choose”</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="chilli:3,coffee:1">
              <span class="bean-quiz__option-index">C</span>
              <span class="bean-quiz__option-text">“I will not apologise for being too much. That’s not my problem”</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="green:3,coffee:1">
              <span class="bean-quiz__option-index">D</span>
              <span class="bean-quiz__option-text">“Everyone is going through something. Be gentler than you think you need to be”</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="jelly:3,vanilla:1">
              <span class="bean-quiz__option-index">E</span>
              <span class="bean-quiz__option-text">“If I like you, you will know. If I love you, the whole world will know”</span>
            </button>
          </div>
        </div>

        <div class="bean-quiz__screen" data-quiz-screen="10" data-step="10">
          <h2 class="bean-quiz__question-title">How do you feel about being perceived?</h2>
          <p class="bean-quiz__question-copy">Choose the option that feels most natural to you right now.</p>
          <div class="bean-quiz__options">
            <button class="bean-quiz__option" type="button" data-weights="coffee:2,chilli:2">
              <span class="bean-quiz__option-index">A</span>
              <span class="bean-quiz__option-text">You care more than you admit, but you’d die before you’d admit it</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="chilli:2,green:2">
              <span class="bean-quiz__option-index">B</span>
              <span class="bean-quiz__option-text">You want to be liked but you won’t pretend to be someone you’re not</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="jelly:3,vanilla:1">
              <span class="bean-quiz__option-index">C</span>
              <span class="bean-quiz__option-text">You genuinely love when people get you–it feels like a little win</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="chilli:3,coffee:1">
              <span class="bean-quiz__option-index">D</span>
              <span class="bean-quiz__option-text">You’re pretty indifferent. People will think what they want to think</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="green:2,coffee:2">
              <span class="bean-quiz__option-index">E</span>
              <span class="bean-quiz__option-text">You care deeply but channel it into just being as authentic as possible</span>
            </button>
          </div>
        </div>

        <div class="bean-quiz__screen" data-quiz-screen="11" data-step="11">
          <h2 class="bean-quiz__question-title">When you’re overwhelmed, you:</h2>
          <p class="bean-quiz__question-copy">Choose the option that feels most natural to you right now.</p>
          <div class="bean-quiz__options">
            <button class="bean-quiz__option" type="button" data-weights="coffee:3,green:1">
              <span class="bean-quiz__option-index">A</span>
              <span class="bean-quiz__option-text">Go silent & disappear into yourself for a while</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="vanilla:3,chilli:1">
              <span class="bean-quiz__option-index">B</span>
              <span class="bean-quiz__option-text">Move – walk, exercise, plan a trip, do something physical</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="jelly:3,green:1">
              <span class="bean-quiz__option-index">C</span>
              <span class="bean-quiz__option-text">Call someone and talk it out until it makes sense</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="chilli:2,vanilla:2">
              <span class="bean-quiz__option-index">D</span>
              <span class="bean-quiz__option-text">Get weirdly productive – chaos becomes fuel</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="green:3,coffee:1">
              <span class="bean-quiz__option-index">E</span>
              <span class="bean-quiz__option-text">Meditate, journal, breathe – regulate before you act</span>
            </button>
          </div>
        </div>

        <div class="bean-quiz__screen" data-quiz-screen="12" data-step="12">
          <h2 class="bean-quiz__question-title">Your relationship with rules is:</h2>
          <p class="bean-quiz__question-copy">Choose the option that feels most natural to you right now.</p>
          <div class="bean-quiz__options">
            <button class="bean-quiz__option" type="button" data-weights="coffee:2,chilli:2">
              <span class="bean-quiz__option-index">A</span>
              <span class="bean-quiz__option-text">You follow them if they make sense. If they don’t, you quietly route around them</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="chilli:3,green:1">
              <span class="bean-quiz__option-index">B</span>
              <span class="bean-quiz__option-text">You find them mildly insulting unless they are genuinely necessary</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="vanilla:2,jelly:2">
              <span class="bean-quiz__option-index">C</span>
              <span class="bean-quiz__option-text">You follow them mostly, but you love creative exceptions</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="green:2,vanilla:2">
              <span class="bean-quiz__option-index">D</span>
              <span class="bean-quiz__option-text">You prefer guidelines. Rigid rules stress you out</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="chilli:3,jelly:1">
              <span class="bean-quiz__option-index">E</span>
              <span class="bean-quiz__option-text">Rules are just “suggestions from people who couldn’t handle your energy”</span>
            </button>
          </div>
        </div>

        <div class="bean-quiz__screen" data-quiz-screen="13" data-step="13">
          <h2 class="bean-quiz__question-title">What kind of energy do you bring to a group project?</h2>
          <p class="bean-quiz__question-copy">Choose the option that feels most natural to you right now.</p>
          <div class="bean-quiz__options">
            <button class="bean-quiz__option" type="button" data-weights="coffee:3,green:1">
              <span class="bean-quiz__option-index">A</span>
              <span class="bean-quiz__option-text">The researcher - you go deep, come back with more than anyone asked for</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="jelly:2,vanilla:2">
              <span class="bean-quiz__option-index">B</span>
              <span class="bean-quiz__option-text">The hype person - morale, energy, keeping it fun even when it’s boring</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="chilli:2,vanilla:2">
              <span class="bean-quiz__option-index">C</span>
              <span class="bean-quiz__option-text">The wildcard - you bring the unexpected idea that somehow works</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="green:3,coffee:1">
              <span class="bean-quiz__option-index">D</span>
              <span class="bean-quiz__option-text">The anchor - you keep things calm, grounded & moving</span>
            </button>
            <button class="bean-quiz__option" type="button" data-weights="jelly:3,vanilla:1">
              <span class="bean-quiz__option-index">E</span>
              <span class="bean-quiz__option-text">The connector - you get everyone talking & make the group feel like a team</span>
            </button>
          </div>
        </div>

        <div class="bean-quiz__screen" data-quiz-screen="14" data-step="14">
          <h2 class="bean-quiz__question-title">Your inner monologue at 2am looks like:</h2>
          <p class="bean-quiz__question-copy">Choose the option that feels most natural to you right now.</p>
          <div class="bean-quiz__options">
            <button class="bean-quiz__option" type="button" data-weights="coffee:3,jelly:1">
              <span class="bean-quiz__option-index">A</span>
