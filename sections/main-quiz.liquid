          ctx.font = '800 14px "Poppins", sans-serif';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText('MY PERSONALITY MATCH', 320, 190);

          // 6. Match Title (Wrapped to fit)
