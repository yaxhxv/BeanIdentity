{%- style -%}
  .bean-quiz-page {
    position: relative;
    overflow: hidden;
    background: radial-gradient(circle at 12% 14%, rgba(198, 169, 105, 0.16), transparent 28%),
      radial-gradient(circle at 88% 22%, rgba(255, 255, 255, 0.08), transparent 24%),
      linear-gradient(180deg, #080808 0%, #101010 52%, #141414 100%);
    color: #f5f5f5;
  }

  .bean-quiz-page::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 5.2rem 5.2rem;
    opacity: 0.22;
    pointer-events: none;
  }

  .bean-quiz-page__shell {
    position: relative;
    z-index: 1;
    width: min(120rem, calc(100% - 4rem));
    margin: 0 auto;
    padding: clamp(2rem, 3.5vw, 3.6rem) 0 clamp(4rem, 6vw, 6rem);
  }

  .bean-quiz-page__hero {
    display: grid;
    grid-template-columns: minmax(0, 72rem);
    gap: 0;
    align-items: center;
    min-height: auto;
    padding: clamp(2rem, 4vw, 3.6rem) 0 2rem;
    border-bottom: 1px solid rgba(245, 245, 245, 0.08);
    justify-content: center;
  }

  .bean-quiz-page__copy {
    text-align: center;
  }

  .bean-quiz-page__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 1.6rem;
    font-family: 'Poppins', sans-serif;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #c6a969;
  }

  .bean-quiz-page__eyebrow::before {
    content: '';
    width: 4.8rem;
    height: 1px;
    background: currentColor;
  }

  .bean-quiz-page__title {
    margin: 0;
    max-width: none;
    font-family: var(--font-heading-family);
    font-size: clamp(4.4rem, 8vw, 9.6rem);
    font-weight: 900;
    line-height: 0.84;
    text-transform: uppercase;
    color: #f5f5f5;
    text-wrap: balance;
  }

  .bean-quiz-page__subtitle {
    max-width: 62rem;
    margin: 1.4rem 0 0;
    margin-inline: auto;
    font-family: 'Poppins', sans-serif;
    font-size: clamp(1.6rem, 1.7vw, 1.85rem);
    line-height: 1.5;
    color: rgba(245, 245, 245, 0.7);
  }

  .bean-quiz {
    max-width: 92rem;
    margin: clamp(2.2rem, 4vw, 3.6rem) auto 0;
  }

  .bean-quiz__status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1.2rem;
  }

  .bean-quiz__status-label,
  .bean-quiz__step-count {
    font-family: 'Poppins', sans-serif;
    font-size: 1.02rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.52);
  }

  .bean-quiz__progress {
    width: 100%;
    height: 0.5rem;
    margin-bottom: 1.8rem;
    background: rgba(245, 245, 245, 0.08);
    overflow: hidden;
  }

  .bean-quiz__progress-bar {
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, #8d6b3d 0%, #c6a969 45%, #f5e3b0 100%);
    transition: width 0.4s ease;
  }

  .bean-quiz__panel {
    position: relative;
    min-height: 22rem;
    padding: clamp(1.6rem, 2vw, 2.2rem);
    border: 1px solid rgba(245, 245, 245, 0.1);
    background: rgba(255, 255, 255, 0.04);
    box-shadow: 0 2rem 6rem rgba(0, 0, 0, 0.22);
    backdrop-filter: blur(10px);
    border-radius: 3rem;
  }

  .bean-quiz__screen {
    display: none;
    opacity: 0;
    transform: translateY(1rem);
    transition: opacity 0.32s ease, transform 0.32s ease;
  }

  .bean-quiz__screen.is-active {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }

  .bean-quiz__intro-title,
  .bean-quiz__question-title,
  .bean-quiz__result-title {
    margin: 0;
    font-family: var(--font-heading-family);
    font-weight: 900;
    text-transform: uppercase;
    color: #f5f5f5;
    letter-spacing: 0;
    line-height: 0.92;
  }

  .bean-quiz__intro-title {
    max-width: 5ch;
    font-size: clamp(2.8rem, 3.4vw, 3.8rem);
    line-height: 0.9;
  }

  .bean-quiz__question-title {
    max-width: 28ch;
    font-size: clamp(2.2rem, 4vw, 3rem);
    text-transform: lowercase;
    line-height: 1.1;
  }

  .bean-quiz__result-title {
    font-size: clamp(4rem, 7vw, 7rem);
  }

  .bean-quiz__intro-copy,
  .bean-quiz__question-copy,
  .bean-quiz__result-copy {
    max-width: 58rem;
    margin: 1rem 0 0;
    font-family: 'Poppins', sans-serif;
    font-size: 1.42rem;
    line-height: 1.48;
    color: rgba(245, 245, 245, 0.72);
  }

  .bean-quiz__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 5.6rem;
    padding: 0 2.6rem;
    margin-top: 1.2rem;
    border: 1px solid #c6a969;
    background: #c6a969;
    color: #0b0b0b;
    text-decoration: none;
    font-family: 'Poppins', sans-serif;
    font-size: 1.08rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 0.28s ease, background 0.28s ease, border-color 0.28s ease, color 0.28s ease;
    border-radius: 999px;
  }

  .bean-quiz__screen[data-quiz-screen='welcome'].is-active {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.9fr);
    gap: 2rem;
    align-items: center;
  }

  .bean-quiz__welcome-copy {
    display: grid;
    gap: 0;
  }

  .bean-quiz__welcome-side {
    position: relative;
    min-height: 100%;
    padding: 1.6rem;
    border-radius: 2.2rem;
    background: radial-gradient(circle at 80% 24%, rgba(198, 169, 105, 0.16), transparent 22%),
      rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(245, 245, 245, 0.08);
    overflow: hidden;
  }

  .bean-quiz__welcome-pillars {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .bean-quiz__welcome-pill {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0 1rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(245, 245, 245, 0.08);
    color: rgba(245, 245, 245, 0.78);
    font-family: 'Poppins', sans-serif;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .bean-quiz__welcome-art {
    position: absolute;
    right: -1rem;
    bottom: -1rem;
    width: clamp(110px, 13vw, 160px);
    height: auto;
    opacity: 0.22;
    pointer-events: none;
    filter: drop-shadow(0 1.6rem 2.8rem rgba(0, 0, 0, 0.24));
  }

  .bean-quiz__button:hover {
    transform: translateY(-0.2rem);
    background: #f5f5f5;
    border-color: #f5f5f5;
    color: #0b0b0b;
  }

  .bean-quiz__options {
    display: grid;
    gap: 1.2rem;
    margin-top: 2rem;
  }

  .bean-quiz__option {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.6rem;
    align-items: start;
    width: 100%;
    padding: 1.5rem 1.8rem;
    border: 1px solid rgba(245, 245, 245, 0.1);
    background: rgba(255, 255, 255, 0.02);
    color: #f5f5f5;
    text-align: left;
    cursor: pointer;
    transition: transform 0.24s ease, border-color 0.24s ease, background 0.24s ease, box-shadow 0.24s ease;
  }

  .bean-quiz__option:hover,
  .bean-quiz__option.is-selected {
    transform: translateY(-0.2rem);
    border-color: rgba(198, 169, 105, 0.72);
    background: rgba(198, 169, 105, 0.08);
    box-shadow: 0 1.4rem 3.2rem rgba(0, 0, 0, 0.18);
  }

  .bean-quiz__option-index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.2rem;
    height: 3.2rem;
    border: 1px solid rgba(245, 245, 245, 0.18);
    color: rgba(245, 245, 245, 0.76);
    font-family: 'Poppins', sans-serif;
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .bean-quiz__option-text {
    font-family: 'Poppins', sans-serif;
    font-size: 1.5rem;
    line-height: 1.5;
    color: #f5f5f5;
  }

  .bean-quiz__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 1.8rem;
  }

  .bean-quiz__helper {
    margin: 0;
    font-family: 'Poppins', sans-serif;
    font-size: 1.35rem;
    line-height: 1.6;
    color: rgba(245, 245, 245, 0.5);
  }

  .bean-quiz__ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 5.2rem;
    padding: 0 2.4rem;
    border: 1px solid rgba(245, 245, 245, 0.22);
    background: transparent;
    color: #f5f5f5;
    font-family: 'Poppins', sans-serif;
    font-size: 1.08rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 0.24s ease, border-color 0.24s ease, color 0.24s ease;
  }

  .bean-quiz__ghost:hover {
    transform: translateY(-0.2rem);
    border-color: #f5f5f5;
  }

  .bean-quiz__result-card {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(28rem, 0.9fr);
    gap: 2.4rem;
    margin-top: 2.8rem;
  }

  .bean-quiz__screen[data-quiz-screen='result'] {
    --result-bg: rgba(255, 255, 255, 0.04);
    --result-bg-strong: rgba(255, 255, 255, 0.08);
    --result-ink: #f5f5f5;
    --result-copy-soft: rgba(245, 245, 245, 0.72);
    --result-border: rgba(245, 245, 245, 0.1);
    --result-glow: rgba(198, 169, 105, 0.18);
    --result-panel: rgba(255, 255, 255, 0.04);
    --result-panel-alt: rgba(255, 255, 255, 0.03);
    position: relative;
    padding: clamp(2rem, 3vw, 3rem);
    border-radius: 2.6rem;
    overflow: hidden;
    background: radial-gradient(circle at top right, var(--result-glow) 0%, transparent 28rem),
      linear-gradient(135deg, var(--result-bg-strong), var(--result-bg));
    border: 1px solid var(--result-border);
  }

  .bean-quiz__screen[data-quiz-screen='result']::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0)),
      radial-gradient(circle at left bottom, rgba(255, 255, 255, 0.08), transparent 22rem);
    pointer-events: none;
  }

  .bean-quiz__result-hero {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(24rem, 0.9fr);
    gap: 2.4rem;
    align-items: center;
  }

  .bean-quiz__result-copy-block {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .bean-quiz__result-kicker {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin: 0;
    color: var(--result-accent, #c6a969);
    font-family: 'Poppins', sans-serif;
    font-size: 1.02rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .bean-quiz__result-kicker::before {
    content: '';
    width: 4rem;
    height: 1px;
    background: currentColor;
    opacity: 0.7;
  }

  .bean-quiz__result-title,
  .bean-quiz__result-copy,
  .bean-quiz__result-label,
  .bean-quiz__result-stat span,
  .bean-quiz__trait {
    position: relative;
    z-index: 1;
  }

  .bean-quiz__result-title {
    color: var(--result-ink);
  }

  .bean-quiz__result-copy {
    max-width: 52rem;
    color: var(--result-copy-soft);
  }

  .bean-quiz__result-visual {
    position: relative;
    display: grid;
    place-items: center;
  }

  .bean-quiz__result-visual-shell {
    position: relative;
    display: grid;
    place-items: center;
    width: min(100%, 34rem);
    aspect-ratio: 1 / 1;
    border-radius: 3rem;
    border: 1px solid var(--result-border);
    background: radial-gradient(
        circle at 50% 45%,
        rgba(255, 255, 255, 0.9) 0%,
        rgba(255, 255, 255, 0.42) 42%,
        transparent 72%
      ),
      linear-gradient(180deg, rgba(255, 255, 255, 0.36), rgba(255, 255, 255, 0.14));
    overflow: hidden;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28);
  }

  .bean-quiz__result-visual-shell::before {
    content: '';
    position: absolute;
    inset: 14%;
    border-radius: 50%;
    background: radial-gradient(circle, var(--result-glow), transparent 72%);
    filter: blur(16px);
  }

  .bean-quiz__result-gif {
    position: relative;
    z-index: 1;
    width: min(100%, 24rem);
    height: auto;
    display: block;
    filter: drop-shadow(0 1.8rem 3rem rgba(0, 0, 0, 0.16));
  }

  .bean-quiz__result-illustration {
    position: absolute;
    right: -0.8rem;
    bottom: -0.8rem;
    width: clamp(8.6rem, 9vw, 12rem);
    height: auto;
    opacity: 0.95;
    filter: drop-shadow(0 1.2rem 2rem rgba(0, 0, 0, 0.18));
  }

  .bean-quiz__result-copy-wrap,
  .bean-quiz__result-meta {
    padding: 2.2rem;
    border: 1px solid var(--result-border);
    background: var(--result-panel);
    border-radius: 2.2rem;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .bean-quiz__result-label {
    display: inline-block;
    margin: 0 0 1.2rem;
    font-family: 'Poppins', sans-serif;
    font-size: 1.02rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--result-accent, #c6a969);
  }

  .bean-quiz__traits {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.8rem;
  }

  .bean-quiz__trait {
    display: inline-flex;
    align-items: center;
    min-height: 3.4rem;
    padding: 0 1.3rem;
    border: 1px solid rgba(245, 245, 245, 0.12);
    background: rgba(255, 255, 255, 0.08);
    font-family: 'Poppins', sans-serif;
    font-size: 1.02rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--result-ink);
  }

  .bean-quiz__result-stat + .bean-quiz__result-stat {
    margin-top: 1.8rem;
    padding-top: 1.8rem;
    border-top: 1px solid rgba(245, 245, 245, 0.08);
  }

  .bean-quiz__result-stat strong,
  .bean-quiz__result-stat span {
    display: block;
    font-family: 'Poppins', sans-serif;
  }

  .bean-quiz__result-stat strong {
    margin-bottom: 0.5rem;
    font-size: 1.06rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.52);
  }

  .bean-quiz__result-stat span {
    font-size: 1.55rem;
    line-height: 1.6;
    color: var(--result-ink);
  }

  .bean-quiz__result-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-top: 2.4rem;
  }

  .bean-quiz__result-bridge {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.2rem;
    margin-top: 2rem;
  }

  .bean-quiz__bridge-card {
    padding: 1.6rem 1.5rem;
    border: 1px solid var(--result-border);
    border-radius: 1.8rem;
    background: var(--result-panel-alt);
  }

  @media screen and (max-width: 989px) {
    .bean-quiz__result-card {
      grid-template-columns: 1fr;
    }
    .bean-quiz__result-hero {
      grid-template-columns: 1fr;
      text-align: center;
      justify-items: center;
    }
    .bean-quiz__result-copy {
      margin-inline: auto;
    }
    .bean-quiz__result-bridge {
      grid-template-columns: 1fr;
    }
    .bean-quiz__result-visual-shell {
      width: min(100%, 28rem);
    }
    .bean-quiz__result-actions {
      justify-content: center;
    }
  }

  .bean-quiz__bridge-card strong,
  .bean-quiz__bridge-card span {
    display: block;
    font-family: 'Poppins', sans-serif;
  }

  .bean-quiz__bridge-card strong {
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.5);
  }

  .bean-quiz__bridge-card span {
    font-size: 1.3rem;
    line-height: 1.45;
    color: var(--result-ink);
  }

  .bean-quiz__button--secondary {
    border-color: rgba(245, 245, 245, 0.22);
    background: transparent;
    color: #f5f5f5;
  }

  .bean-quiz__button--secondary:hover {
    background: #f5f5f5;
    border-color: #f5f5f5;
    color: #0b0b0b;
  }

  @media screen and (max-width: 989px) {
    .bean-quiz-page__hero,
    .bean-quiz__result-card,
    .bean-quiz__result-hero,
    .bean-quiz__result-bridge {
      grid-template-columns: 1fr;
    }

    .bean-quiz-page__title {
      max-width: none;
      font-size: clamp(4.2rem, 14vw, 7.4rem);
    }
  }

  @media screen and (max-width: 749px) {
    .bean-quiz-page__shell {
      width: calc(100% - 3rem);
      padding-top: 1.4rem;
      padding-bottom: 3.2rem;
    }

    .bean-quiz-page__hero {
      gap: 1.6rem;
      padding-top: 2rem;
      padding-bottom: 1.6rem;
    }

    .bean-quiz__panel {
      min-height: auto;
      padding: 2rem 1.6rem;
    }

    .bean-quiz__screen[data-quiz-screen='welcome'].is-active {
      grid-template-columns: 1fr;
      gap: 1.4rem;
    }

    .bean-quiz__welcome-side {
      padding: 1.2rem;
      min-height: 11rem;
    }

    .bean-quiz__welcome-art {
      width: 96px;
    }

    .bean-quiz__status {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.8rem;
    }

    .bean-quiz__option {
      padding: 1.5rem;
      gap: 1.2rem;
    }

    .bean-quiz__option-text,
    .bean-quiz__intro-copy,
    .bean-quiz__question-copy,
    .bean-quiz__result-copy {
      font-size: 1.5rem;
    }

    .bean-quiz__footer,
    .bean-quiz__result-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .bean-quiz__button,
    .bean-quiz__ghost,
    .bean-quiz__button--secondary {
      width: 100%;
    }
  }
{%- endstyle -%}

<section
  id="Quiz-{{ section.id }}"
  class="bean-quiz-page"
  data-section-id="{{ section.id }}"
  data-quiz-root
>
  <div class="bean-quiz-page__shell">
    <div class="bean-quiz-page__hero">
      <div class="bean-quiz-page__copy">
        <p class="bean-quiz-page__eyebrow">Bean Identity Quiz</p>
        <h1 class="bean-quiz-page__title">{{ section.settings.heading }}</h1>
        <p class="bean-quiz-page__subtitle">
          {{ section.settings.subheading }}
        </p>
      </div>
    </div>

    <div class="bean-quiz" data-quiz-app>
      <div class="bean-quiz__status">
        <span class="bean-quiz__status-label">Identity scan</span>
        <span class="bean-quiz__step-count" data-quiz-count>Intro</span>
      </div>

      <div class="bean-quiz__progress">
        <div class="bean-quiz__progress-bar" data-quiz-progress></div>
      </div>

      <div class="bean-quiz__panel">
        <div class="bean-quiz__screen is-active" data-quiz-screen="welcome">
          <div class="bean-quiz__welcome-copy">
            {% comment %} <h2 class="bean-quiz__intro-title">Find the bean that wears like you.</h2> {% endcomment %}
            <p class="bean-quiz__intro-copy">
              Pick the option that feels most instinctive each time. Do not overthink it. The strongest matches usually
              happen fast.
            </p>
            <button class="bean-quiz__button" type="button" data-quiz-start>Start quiz</button>
          </div>
          <div class="bean-quiz__welcome-side">
            <div class="bean-quiz__welcome-pillars">
              <span class="bean-quiz__welcome-pill">5 questions</span>
              <span class="bean-quiz__welcome-pill">2 min</span>
              <span class="bean-quiz__welcome-pill">1 bean match</span>
            </div>
            {% comment %}
              <img
                src="{{ 'bean-green-1.png' | asset_url }}"
                alt=""
                aria-hidden="true"
                class="bean-quiz__welcome-art"
                loading="lazy"
              >
            {% endcomment %}
          </div>
        </div>

        <div class="bean-quiz__screen" data-quiz-screen="1" data-step="1">
          <h2 class="bean-quiz__question-title">When starting something new, your instinct is:</h2>
          <p class="bean-quiz__question-copy">Start where your energy goes first, not where you think it should.</p>
          <div class="bean-quiz__options">
            <button class="bean-quiz__option" type="button" data-score="coffee">
              <span class="bean-quiz__option-index">A</span
              ><span class="bean-quiz__option-text">Let me understand how this actually works first.</span>
            </button>
            <button class="bean-quiz__option" type="button" data-score="vanilla">
              <span class="bean-quiz__option-index">B</span
              ><span class="bean-quiz__option-text">Let us try it and see what happens.</span>
            </button>
            <button class="bean-quiz__option" type="button" data-score="chilli">
              <span class="bean-quiz__option-index">C</span
              ><span class="bean-quiz__option-text">Let us do it big.</span>
            </button>
            <button class="bean-quiz__option" type="button" data-score="jelly">
              <span class="bean-quiz__option-index">D</span
              ><span class="bean-quiz__option-text">Who else is doing this with me?</span>
            </button>
            <button class="bean-quiz__option" type="button" data-score="green">
              <span class="bean-quiz__option-index">E</span
              ><span class="bean-quiz__option-text">Let me think about whether this feels right.</span>
            </button>
          </div>
        </div>

        <div class="bean-quiz__screen" data-quiz-screen="2" data-step="2">
          <h2 class="bean-quiz__question-title">
            When your friend group walks into a party, you are usually the one who:
          </h2>
          <p class="bean-quiz__question-copy">
            This is less about volume and more about your natural posture in the room.
          </p>
          <div class="bean-quiz__options">
            <button class="bean-quiz__option" type="button" data-score="coffee">
              <span class="bean-quiz__option-index">A</span
              ><span class="bean-quiz__option-text"
                >Finds one interesting person and ends up in a deep conversation about something random.</span
              >
            </button>
            <button class="bean-quiz__option" type="button" data-score="vanilla">
              <span class="bean-quiz__option-index">B</span
              ><span class="bean-quiz__option-text">Immediately asks, where is the fun happening?</span>
            </button>
            <button class="bean-quiz__option" type="button" data-score="chilli">
              <span class="bean-quiz__option-index">C</span
              ><span class="bean-quiz__option-text">Walks in like you already own the place.</span>
            </button>
            <button class="bean-quiz__option" type="button" data-score="jelly">
              <span class="bean-quiz__option-index">D</span
              ><span class="bean-quiz__option-text">Somehow knows half the room within ten minutes.</span>
            </button>
            <button class="bean-quiz__option" type="button" data-score="green">
              <span class="bean-quiz__option-index">E</span
              ><span class="bean-quiz__option-text">Quietly reads the vibe of the room before doing anything.</span>
            </button>
          </div>
        </div>

        <div class="bean-quiz__screen" data-quiz-screen="3" data-step="3">
          <h2 class="bean-quiz__question-title">
            When facing a tough decision with no obvious right answer, you usually:
          </h2>
          <p class="bean-quiz__question-copy">
            Choose the option that sounds the most like your default decision mode.
          </p>
          <div class="bean-quiz__options">
            <button class="bean-quiz__option" type="button" data-score="coffee">
              <span class="bean-quiz__option-index">A</span
              ><span class="bean-quiz__option-text">List the pros and cons and think it through logically.</span>
            </button>
            <button class="bean-quiz__option" type="button" data-score="vanilla">
              <span class="bean-quiz__option-index">B</span
              ><span class="bean-quiz__option-text">Follow the option that feels like the biggest adventure.</span>
            </button>
            <button class="bean-quiz__option" type="button" data-score="chilli">
              <span class="bean-quiz__option-index">C</span
              ><span class="bean-quiz__option-text">Choose the path where you can make the boldest impact.</span>
            </button>
            <button class="bean-quiz__option" type="button" data-score="jelly">
              <span class="bean-quiz__option-index">D</span
              ><span class="bean-quiz__option-text">Talk it out with people until a creative solution appears.</span>
            </button>
            <button class="bean-quiz__option" type="button" data-score="green">
              <span class="bean-quiz__option-index">E</span
              ><span class="bean-quiz__option-text">Check in with your emotions and long-term peace of mind.</span>
            </button>
          </div>
        </div>

        <div class="bean-quiz__screen" data-quiz-screen="4" data-step="4">
          <h2 class="bean-quiz__question-title">Your friends would probably describe you as the one who:</h2>
          <p class="bean-quiz__question-copy">Go with what people say when they are being honest, not polite.</p>
          <div class="bean-quiz__options">
            <button class="bean-quiz__option" type="button" data-score="coffee">
              <span class="bean-quiz__option-index">A</span
              ><span class="bean-quiz__option-text"
                >Randomly drops facts or thoughts that make everyone pause and think.</span
              >
            </button>
            <button class="bean-quiz__option" type="button" data-score="vanilla">
              <span class="bean-quiz__option-index">B</span
              ><span class="bean-quiz__option-text">Says let us just go and somehow everyone follows.</span>
            </button>
            <button class="bean-quiz__option" type="button" data-score="chilli">
              <span class="bean-quiz__option-index">C</span
              ><span class="bean-quiz__option-text">Says the brutally honest thing everyone else avoided.</span>
            </button>
            <button class="bean-quiz__option" type="button" data-score="jelly">
              <span class="bean-quiz__option-index">D</span
              ><span class="bean-quiz__option-text"
                >Turns a normal night into a story everyone laughs about later.</span
              >
            </button>
            <button class="bean-quiz__option" type="button" data-score="green">
              <span class="bean-quiz__option-index">E</span
              ><span class="bean-quiz__option-text">Calms everyone down when things start getting chaotic.</span>
            </button>
          </div>
        </div>

        <div class="bean-quiz__screen" data-quiz-screen="5" data-step="5">
          <h2 class="bean-quiz__question-title">
            Imagine you unexpectedly get a free day. What are you most likely to do?
          </h2>
          <p class="bean-quiz__question-copy">The answer that feels easiest is usually the right one.</p>
          <div class="bean-quiz__options">
            <button class="bean-quiz__option" type="button" data-score="coffee">
              <span class="bean-quiz__option-index">A</span
              ><span class="bean-quiz__option-text"
                >Dive into a book, podcast, or documentary about something fascinating.</span
              >
            </button>
            <button class="bean-quiz__option" type="button" data-score="vanilla">
              <span class="bean-quiz__option-index">B</span
              ><span class="bean-quiz__option-text">Plan a spontaneous trip or try something completely new.</span>
            </button>
            <button class="bean-quiz__option" type="button" data-score="chilli">
              <span class="bean-quiz__option-index">C</span
              ><span class="bean-quiz__option-text"
                >Start a bold project, pitch a big idea, or take on a tough challenge.</span
              >
            </button>
            <button class="bean-quiz__option" type="button" data-score="jelly">
              <span class="bean-quiz__option-index">D</span
              ><span class="bean-quiz__option-text">Call a bunch of friends and plan something fun together.</span>
            </button>
            <button class="bean-quiz__option" type="button" data-score="green">
              <span class="bean-quiz__option-index">E</span
              ><span class="bean-quiz__option-text">Sleep in, take a peaceful walk, journal, or enjoy a slow day.</span>
            </button>
          </div>
        </div>

        <div class="bean-quiz__screen" data-quiz-screen="result">
          <div class="bean-quiz__result-hero">
            <div class="bean-quiz__result-copy-block">
              <p class="bean-quiz__result-kicker">Your match</p>
              <h2 class="bean-quiz__result-title" data-result-name></h2>
              <p class="bean-quiz__result-copy" data-result-description></p>
            </div>

            <div class="bean-quiz__result-visual">
              <div class="bean-quiz__result-visual-shell">
                <img
                  class="bean-quiz__result-gif"
                  src=""
                  alt=""
                  loading="lazy"
                  data-result-gif
                >
              </div>
            </div>
          </div>

          <div class="bean-quiz__result-card">
            <div class="bean-quiz__result-copy-wrap">
              <p class="bean-quiz__result-label">Identity traits</p>
              <div class="bean-quiz__traits" data-result-traits></div>
            </div>

            <div class="bean-quiz__result-meta">
              <div class="bean-quiz__result-stat">
                <strong>Energy</strong>
                <span data-result-energy></span>
              </div>
              <div class="bean-quiz__result-stat">
                <strong>Why it fits</strong>
                <span data-result-fit></span>
              </div>
            </div>
          </div>

          <div class="bean-quiz__result-bridge">
            <div class="bean-quiz__bridge-card">
              <strong>Visual direction</strong>
              <span data-result-direction></span>
            </div>
            <div class="bean-quiz__bridge-card">
              <strong>Color mood</strong>
              <span data-result-palette></span>
            </div>
            <div class="bean-quiz__bridge-card">
              <strong>Best next move</strong>
              <span data-result-cta-copy></span>
            </div>
          </div>

          <div class="bean-quiz__result-actions">
            <a class="bean-quiz__button" href="#" data-result-link>Shop your bean</a>
            <button class="bean-quiz__button bean-quiz__button--secondary" type="button" data-quiz-restart>
              Retake quiz
            </button>
          </div>
        </div>

        <div class="bean-quiz__footer">
          <p class="bean-quiz__helper">Best results come from instinct, not strategy.</p>
          <button class="bean-quiz__ghost" type="button" data-quiz-back hidden>Previous</button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    const root = document.querySelector('[data-quiz-root]');
    if (!root) return;

    const screens = Array.from(root.querySelectorAll('[data-quiz-screen]'));
    const progressBar = root.querySelector('[data-quiz-progress]');
    const stepCount = root.querySelector('[data-quiz-count]');
    const backButton = root.querySelector('[data-quiz-back]');
    const startButtons = Array.from(root.querySelectorAll('[data-quiz-start]'));
    const restartButton = root.querySelector('[data-quiz-restart]');
    const resultName = root.querySelector('[data-result-name]');
    const resultDescription = root.querySelector('[data-result-description]');
    const resultTraits = root.querySelector('[data-result-traits]');
    const resultEnergy = root.querySelector('[data-result-energy]');
    const resultFit = root.querySelector('[data-result-fit]');
    const resultLink = root.querySelector('[data-result-link]');
    const resultGif = root.querySelector('[data-result-gif]');

    const resultDirection = root.querySelector('[data-result-direction]');
    const resultPalette = root.querySelector('[data-result-palette]');
    const resultCtaCopy = root.querySelector('[data-result-cta-copy]');

    const archetypes = {
      coffee: {
        name: 'Coffee Bean',
        traits: ['Curious', 'Grounded', 'Precise'],
        description:
          'You move with thought, restraint, and depth. Even when you are quiet, your point of view lands clearly.',
        energy: 'Calm authority',
        fit: 'Best on days that call for sharper thinking and quieter confidence.',
        collection: '/collections/coffee-bean',
        accent: '#8B5E3C',
        ink: '#F7F1EA',
        bg: 'rgba(90, 58, 27, 0.28)',
        bgStrong: 'rgba(139, 94, 60, 0.18)',
        glow: 'rgba(90, 58, 27, 0.24)',
        border: 'rgba(184, 133, 96, 0.22)',
        panel: 'rgba(255, 248, 240, 0.05)',
        panelAlt: 'rgba(255, 248, 240, 0.03)',
        palette: 'Roasted brown, espresso depth, warm mocha neutrals.',
        direction: 'Editorial, grounded, and quietly sharp with deeper contrast.',
        ctaCopy: 'Go straight into the Coffee Bean drop for the clearest fit.',
        gif: "{{ 'coffee_bean_gif.gif' | file_url }}",
      },
      chilli: {
        name: 'Chilli Bean',
        traits: ['Bold', 'Fiery', 'Unfiltered'],
        description: 'You lead with instinct, heat, and impact. People feel your presence before you explain yourself.',
        energy: 'High contrast',
        fit: 'Best when the mood is direct, loud, and impossible to ignore.',
        collection: '/collections/chilli-bean',
        accent: '#E63946',
        ink: '#FFF3F4',
        bg: 'rgba(158, 27, 27, 0.24)',
        bgStrong: 'rgba(230, 57, 70, 0.16)',
        glow: 'rgba(230, 57, 70, 0.22)',
        border: 'rgba(255, 126, 126, 0.22)',
        panel: 'rgba(255, 245, 246, 0.05)',
        panelAlt: 'rgba(255, 245, 246, 0.03)',
        palette: 'Hot red, burnt red, and a flash of lava yellow.',
        direction: 'Charged, bold, and cleanly aggressive without losing clarity.',
        ctaCopy: 'Open the Chilli Bean page when you want the loudest match.',
        gif: "{{ 'chilli_bean_gif.gif' | file_url }}",
      },
      vanilla: {
        name: 'Vanilla Bean',
        traits: ['Smooth', 'Stylish', 'Fluid'],
        description: 'You have range, rhythm, and a polished way of moving that never feels forced.',
        energy: 'Soft magnetism',
        fit: 'Best when you want elegance, ease, and style without stiffness.',
        collection: '/collections/vanilla-bean',
        accent: '#D4A85A',
        ink: '#FFF8F0',
        bg: 'rgba(182, 120, 47, 0.2)',
        bgStrong: 'rgba(229, 211, 179, 0.18)',
        glow: 'rgba(229, 211, 179, 0.26)',
        border: 'rgba(228, 196, 146, 0.24)',
        panel: 'rgba(255, 249, 240, 0.05)',
        panelAlt: 'rgba(255, 249, 240, 0.03)',
        palette: 'Cream silk, soft butter, and warm beige layering.',
        direction: 'Smooth, mellow, and elevated with softer warmth.',
        ctaCopy: 'Step into the Vanilla Bean page for the cleanest soft-luxury lane.',
        gif: "{{ 'vanilla_bean_gif.gif' | file_url }}",
      },
      jelly: {
        name: 'Jelly Bean',
        traits: ['Playful', 'Social', 'Magnetic'],
        description:
          'You are switched on, socially alive, and naturally expressive. Your energy turns moments into signals.',
        energy: 'Fast and social',
        fit: 'Best for playful days, scene energy, and a look that feels current.',
        collection: '/collections/jelly-bean',
        accent: '#2BB3C0',
        ink: '#F2FEFF',
        bg: 'rgba(21, 128, 138, 0.22)',
        bgStrong: 'rgba(43, 179, 192, 0.16)',
        glow: 'rgba(43, 179, 192, 0.22)',
        border: 'rgba(125, 231, 241, 0.24)',
        panel: 'rgba(242, 254, 255, 0.05)',
        panelAlt: 'rgba(242, 254, 255, 0.03)',
        palette: 'Candy cyan, bubble blue, and glossy cool light.',
        direction: 'Bright, digital, and playful with a cleaner cyan atmosphere.',
        ctaCopy: 'Jump to the Jelly Bean page for the most animated version of your match.',
        gif: "{{ 'jelly_bean_gif.gif' | file_url }}",
      },
      green: {
        name: 'Green Bean',
        traits: ['Fresh', 'Grounded', 'Open'],
        description: 'You carry lightness without losing shape. Your best style feels clean, calm, and fully lived in.',
        energy: 'Restorative clarity',
        fit: 'Best when you want a reset, softer movement, and easy confidence.',
        collection: '/collections/green-bean',
        accent: '#5BBF3A',
        ink: '#F4FFF0',
        bg: 'rgba(47, 125, 50, 0.22)',
        bgStrong: 'rgba(91, 191, 58, 0.16)',
        glow: 'rgba(91, 191, 58, 0.22)',
        border: 'rgba(164, 232, 143, 0.24)',
        panel: 'rgba(244, 255, 240, 0.05)',
        panelAlt: 'rgba(244, 255, 240, 0.03)',
        palette: 'Fresh leaf green, soft lime, and airy botanical light.',
        direction: 'Clean, restorative, and bright with a softer natural wash.',
        ctaCopy: 'Open the Green Bean page when you want the calmest version of your result.',
        gif: "{{ 'green_bean_gif.gif' | file_url }}",
      },
    };

    const state = {
      current: 'welcome',
      totalSteps: 5,
      answers: {},
      scores: {
        coffee: 0,
        chilli: 0,
        vanilla: 0,
        jelly: 0,
        green: 0,
      },
    };

    function updateProgress() {
      if (state.current === 'welcome') {
        progressBar.style.width = '0%';
        stepCount.textContent = 'Intro';
        backButton.hidden = true;
        return;
      }

      if (state.current === 'result') {
        progressBar.style.width = '100%';
        stepCount.textContent = 'Result';
        backButton.hidden = false;
        return;
      }

      const step = Number(state.current);
      progressBar.style.width = (step / state.totalSteps) * 100 + '%';
      stepCount.textContent = 'Question ' + step + ' / ' + state.totalSteps;
      backButton.hidden = step === 1;
    }

    function showScreen(name) {
      state.current = name;
      screens.forEach((screen) => {
        screen.classList.toggle('is-active', screen.dataset.quizScreen === String(name));
      });
      updateProgress();
    }

    function getWinningBean() {
      const tieOrder = ['coffee', 'vanilla', 'chilli', 'jelly', 'green'];
      let winner = tieOrder[0];
      let max = -1;

      tieOrder.forEach((bean) => {
        if (state.scores[bean] > max) {
          max = state.scores[bean];
          winner = bean;
        }
      });

      return winner;
    }

    function renderResult(beanKey) {
      const data = archetypes[beanKey];
      if (!data) return;

      root.style.setProperty('--result-accent', data.accent);
      root.style.setProperty('--result-ink', data.ink);
      root.style.setProperty('--result-bg', data.bg);
      root.style.setProperty('--result-bg-strong', data.bgStrong);
      root.style.setProperty('--result-glow', data.glow);
      root.style.setProperty('--result-border', data.border);
      root.style.setProperty('--result-panel', data.panel);
      root.style.setProperty('--result-panel-alt', data.panelAlt);
      resultName.textContent = data.name;
      resultDescription.textContent = data.description;
      resultEnergy.textContent = data.energy;
      resultFit.textContent = data.fit;
      resultLink.href = data.collection;
      resultDirection.textContent = data.direction;
      resultPalette.textContent = data.palette;
      resultCtaCopy.textContent = data.ctaCopy;
      resultGif.src = data.gif;
      resultGif.alt = data.name;
      resultTraits.innerHTML = '';

      data.traits.forEach((trait) => {
        const item = document.createElement('span');
        item.className = 'bean-quiz__trait';
        item.textContent = trait;
        resultTraits.appendChild(item);
      });

      localStorage.setItem('bean_identity_result', beanKey);
    }

    function goNextFrom(step, optionButton) {
      const score = optionButton.dataset.score;
      const nextStep = step + 1;
      const previousScore = state.answers[step];

      if (previousScore) {
        state.scores[previousScore] = Math.max(0, state.scores[previousScore] - 1);
      }

      state.answers[step] = score;
      state.scores[score] += 1;

      optionButton
        .closest('[data-quiz-screen]')
        .querySelectorAll('.bean-quiz__option')
        .forEach((option) => {
          option.classList.remove('is-selected');
        });
      optionButton.classList.add('is-selected');

      window.setTimeout(function () {
        if (nextStep > state.totalSteps) {
          const winner = getWinningBean();
          renderResult(winner);
          showScreen('result');
        } else {
          showScreen(String(nextStep));
        }
      }, 180);
    }

    function goBack() {
      if (state.current === 'result') {
        showScreen(String(state.totalSteps));
        return;
      }

      if (state.current === 'welcome') {
        return;
      }

      const step = Number(state.current);
      if (step > 1) {
        showScreen(String(step - 1));
      } else {
        showScreen('welcome');
      }
    }

    function resetQuiz() {
      state.current = 'welcome';
      state.answers = {};
      state.scores = {
        coffee: 0,
        chilli: 0,
        vanilla: 0,
        jelly: 0,
        green: 0,
      };

      root.querySelectorAll('.bean-quiz__option').forEach((option) => {
        option.classList.remove('is-selected');
      });

      showScreen('welcome');
    }

    startButtons.forEach((startButton) => {
      startButton.addEventListener('click', function () {
        showScreen('1');
      });
    });

    if (backButton) {
      backButton.addEventListener('click', goBack);
    }

    if (restartButton) {
      restartButton.addEventListener('click', resetQuiz);
    }

    root.querySelectorAll('.bean-quiz__screen[data-step]').forEach((screen) => {
      const step = Number(screen.dataset.step);
      screen.querySelectorAll('.bean-quiz__option').forEach((button) => {
        button.addEventListener('click', function () {
          goNextFrom(step, button);
        });
      });
    });

    showScreen('welcome');
  })();
</script>

{% schema %}
{
  "name": "Main Quiz",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Which Bean Are You?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Five quick choices. One personality match."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#080808"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#F5F5F5"
    }
  ]
}
{% endschema %}
