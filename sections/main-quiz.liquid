          // 10. Donut Chart
          const donutCenterY = 1380;
          const donutRadius = 120;
          const donutThickness = 20;
          ctx.lineWidth = donutThickness;
          ctx.lineCap = 'round';

          // Circle track
          ctx.strokeStyle = 'rgba(255, 255, 255, 0.04)';
          ctx.beginPath();
          ctx.arc(width / 2, donutCenterY, donutRadius, 0, Math.PI * 2);
          ctx.stroke();

          // Draw Segments based on scores
          const sortedDisplay = calculatePercentages();
          let accumulatedAngle = -Math.PI / 2;
          sortedDisplay.forEach(([key, pct]) => {
            if (pct > 0) {
              const angleRange = (pct / 100) * Math.PI * 2;
              ctx.strokeStyle = archetypes[key].accent;
