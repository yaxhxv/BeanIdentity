          ctx.fillText(`${sortedDisplay[0][1]}%`, donutCenterX, donutCenterY);

          // Labels below the donut
          ctx.fillStyle = profile.accent || '#c6a969';
          ctx.font = '800 13px "Poppins", sans-serif';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          let belowDonutText = '';
          if (profile.isBlend) {
            const primaryName = archetypes[sortedDisplay[0][0]].name.toUpperCase();
            const primaryPct = sortedDisplay[0][1];
            const secondaryName = archetypes[sortedDisplay[1][0]].name.toUpperCase();
            const secondaryPct = sortedDisplay[1][1];
            belowDonutText = `${primaryName} ${primaryPct}%  ★  ${secondaryName} ${secondaryPct}%`;
          } else {
            belowDonutText = archetypes[sortedDisplay[0][0]].name.toUpperCase();
          }
          ctx.fillText(belowDonutText, donutCenterX, donutCenterY + 125);

          // 11. Footer CTA
          ctx.fillStyle = 'rgba(255, 255, 255, 0.4)';
          ctx.font = '800 14px "Poppins", sans-serif';
          ctx.fillText('FIND YOUR BEAN IDENTITY', width / 2, 955);

          ctx.fillStyle = profile.accent || '#c6a969';
          ctx.font = '800 18px "Poppins", sans-serif';
          ctx.fillText((window.location.host + window.location.pathname).toUpperCase(), width / 2, 995);
        }

        // Trigger callback with data URL
        const dataUrl = canvas.toDataURL('image/png');
        if (callback) callback(dataUrl);
      };

      let imagesToLoad = 1;
      let imagesLoaded = 0;
      
      const checkAndDraw = () => {
        imagesLoaded++;
        if (imagesLoaded >= imagesToLoad) {
          drawCanvasElements();
        }
      };
      
      beanImg.onload = checkAndDraw;
      beanImg.onerror = () => {
        console.error('Failed to load primary bean image');
        checkAndDraw();
      };
      
      beanImg2.onload = checkAndDraw;
      beanImg2.onerror = () => {
        console.error('Failed to load secondary bean image');
        checkAndDraw();
      };
      
      if (profile.isBlend && profile.secondaryStaticImage) {
        imagesToLoad = 2;
        beanImg.src = profile.staticImage;
        beanImg2.src = profile.secondaryStaticImage;
      } else if (profile.staticImage) {
        imagesToLoad = 1;
        beanImg.src = profile.staticImage;
      } else if (profile.gif) {
        imagesToLoad = 1;
        beanImg.src = profile.gif;
      } else {
        imagesToLoad = 0;
        setTimeout(drawCanvasElements, 50);
      }

      // Safety timeout: if image takes too long, draw anyway
      setTimeout(drawCanvasElements, 2500);
    }

    // Modal visibility handlers
    function openInstaModal() {
      if (!instaModal) return;
      
      // Dynamically override modal styling colors based on winning profile
      const profile = state.winningProfile;
      if (profile) {
        instaModal.style.setProperty('--result-accent', profile.accent);
        instaModal.style.setProperty('--result-ink', profile.ink);
      }

      instaModal.removeAttribute('hidden');
      
      if (instaLinkInput) {
        instaLinkInput.value = state.shareUrl;
      }

      // Generate preview canvases and display
      generateShareCard(true, (dataUrl) => {
        const preview = instaModal.querySelector('.bean-quiz__insta-preview--story');
        if (preview) {
          preview.innerHTML = `<img src="${dataUrl}" style="width:100%; height:100%; object-fit:cover; border-radius:inherit;" alt="Story Card Preview">`;
        }
      });

      generateShareCard(false, (dataUrl) => {
        const preview = instaModal.querySelector('.bean-quiz__insta-preview--feed');
        if (preview) {
          preview.innerHTML = `<img src="${dataUrl}" style="width:100%; height:100%; object-fit:cover; border-radius:inherit;" alt="Feed Card Preview">`;
        }
      });
    }

    function closeInstaModal() {
      if (instaModal) {
        instaModal.setAttribute('hidden', '');
      }
    }

    function downloadCard(isStory) {
      generateShareCard(isStory, (dataUrl) => {
        const link = document.createElement('a');
        const fileName = `${state.winningProfile.key}_bean_${isStory ? 'story' : 'post'}.png`;
        link.download = fileName;
        link.href = dataUrl;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      });
    }

    // URL query check on page load
    function checkReferredVisitor() {
      const urlParams = new URLSearchParams(window.location.search);
      const resultParam = urlParams.get('result');
      if (resultParam) {
        let details = null;
        let name = '';
        let desc = '';
        
        if (resultParam.includes('_')) {
          const parts = resultParam.split('_');
          const primaryKey = parts[0];
          const secondaryKey = parts[1];
          const blendKey = `${primaryKey}_${secondaryKey}`;
          const blendData = dualBlends[blendKey];
          if (blendData) {
            name = blendData.title;
            desc = `Your friend matches as a Dual Blend! A perfect harmony of characteristics. Take the quiz to discover your unique Bean Blend.`;
          }
        } else if (archetypes[resultParam]) {
          details = archetypes[resultParam];
          name = details.name;
          desc = `Your friend matches as a ${details.name}! ${details.description}`;
        }

        if (name && desc) {
          if (referredBanner) {
            referredBanner.removeAttribute('hidden');
          }
          if (referredMatchName) {
            referredMatchName.textContent = name;
          }
          if (referredMatchDesc) {
            referredMatchDesc.textContent = desc;
          }
          if (welcomeCopy) {
            welcomeCopy.textContent = "Your friend shared their results with you! Pick the option that feels most instinctive to discover your own matching Bean archetype.";
          }
          
          startButtons.forEach((startBtn) => {
            startBtn.textContent = 'Find Your Bean Identity';
            startBtn.addEventListener('click', () => {
              const cleanUrl = new URL(window.location.href);
              cleanUrl.searchParams.delete('result');
              window.history.replaceState({}, document.title, cleanUrl.toString());
              referredBanner.setAttribute('hidden', '');
            }, { once: true });
          });
        }
      }
    }

    startButtons.forEach((startButton) => {
      startButton.addEventListener('click', async function () {
        if (customer.isLoggedIn) {
          const origText = startButton.textContent;
          startButton.textContent = 'Initializing...';
          startButton.disabled = true;

          await initQuizSession(customer.name, customer.email);

          startButton.textContent = origText;
          startButton.disabled = false;
          showScreen('1');
        } else {
          showScreen('entry-gate');
        }
      });
    });

    if (entryForm) {
      entryForm.addEventListener('submit', async function (e) {
        e.preventDefault();

        const name = nameInput.value.trim();
        const email = emailInput.value.trim();

        let valid = true;

        if (!name) {
          nameError.style.display = 'block';
          valid = false;
        } else {
          nameError.style.display = 'none';
        }

        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!email || !emailRegex.test(email)) {
          emailError.style.display = 'block';
          valid = false;
        } else {
          emailError.style.display = 'none';
        }

        if (!valid) return;

        // Save entered details in local storage so they persist for future sessions
        localStorage.setItem('quiz_user_name', name);
        localStorage.setItem('quiz_user_email', email);

        const submitBtn = entryForm.querySelector('button[type="submit"]');
        const origText = submitBtn.textContent;
        submitBtn.textContent = 'Initializing...';
        submitBtn.disabled = true;

        await initQuizSession(name, email);

        submitBtn.textContent = origText;
        submitBtn.disabled = false;

        showScreen('1');
      });
    }

    if (backButton) {
      backButton.addEventListener('click', goBack);
    }

    if (restartButton) {
      restartButton.addEventListener('click', resetQuiz);
    }

    root.querySelectorAll('.bean-quiz__screen[data-step]').forEach((screen) => {
      const step = Number(screen.dataset.step);
      screen.querySelectorAll('.bean-quiz__option').forEach((button) => {
        button.addEventListener('click', function () {
          goNextFrom(step, button);
        });
      });
    });

    // ==========================================
    // Permutation Tester Debug Utility
    // ==========================================
    if (window.location.search.includes('debug=true') || window.location.search.includes('test=true')) {
      const debugStyle = document.createElement('style');
      debugStyle.textContent = `
        .bean-quiz-debug-trigger {
          position: fixed;
          bottom: 2rem;
          right: 2rem;
          z-index: 99999;
          background: rgba(11, 11, 11, 0.85);
          backdrop-filter: blur(12px);
          -webkit-backdrop-filter: blur(12px);
          border: 1px solid rgba(198, 169, 105, 0.3);
          color: #c6a969;
          padding: 1.2rem 2rem;
          border-radius: 999px;
          font-family: 'Poppins', sans-serif;
          font-size: 1.2rem;
          font-weight: 800;
          letter-spacing: 0.08em;
          text-transform: uppercase;
          cursor: pointer;
          display: flex;
          align-items: center;
          gap: 0.8rem;
          box-shadow: 0 1rem 3rem rgba(0,0,0,0.5);
          transition: all 0.28s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }
        .bean-quiz-debug-trigger:hover {
          transform: translateY(-0.2rem) scale(1.05);
          border-color: #c6a969;
          background: #c6a969;
          color: #0b0b0b;
        }
        .bean-quiz-debug-panel {
          position: fixed;
          bottom: 6.5rem;
          right: 2rem;
          z-index: 99998;
          width: 34rem;
          background: rgba(15, 15, 15, 0.94);
          backdrop-filter: blur(20px);
          -webkit-backdrop-filter: blur(20px);
          border: 1px solid rgba(245, 245, 245, 0.1);
          border-radius: 2.2rem;
          padding: 2.2rem;
          box-shadow: 0 2rem 5rem rgba(0,0,0,0.6);
          font-family: 'Poppins', sans-serif;
          transform: translateY(2rem) scale(0.95);
          opacity: 0;
          pointer-events: none;
          transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }
        .bean-quiz-debug-panel.is-open {
          transform: translateY(0) scale(1);
          opacity: 1;
          pointer-events: auto;
        }
        .bean-quiz-debug-title {
          margin: 0 0 1.6rem;
          font-size: 1.35rem;
          font-weight: 800;
          letter-spacing: 0.1em;
          text-transform: uppercase;
          color: #f5f5f5;
          border-bottom: 1px solid rgba(245, 245, 245, 0.08);
          padding-bottom: 0.8rem;
        }
        .bean-quiz-debug-label {
          display: block;
          margin-bottom: 0.8rem;
          font-size: 1.05rem;
          font-weight: 800;
          text-transform: uppercase;
          letter-spacing: 0.06em;
          color: rgba(245, 245, 245, 0.6);
        }
        .bean-quiz-debug-select {
          width: 100%;
          background: rgba(255, 255, 255, 0.05);
          border: 1px solid rgba(245, 245, 245, 0.15);
          color: #f5f5f5;
          padding: 1.2rem;
          border-radius: 1.2rem;
          font-size: 1.25rem;
          font-family: 'Poppins', sans-serif;
          margin-bottom: 1.8rem;
          cursor: pointer;
          outline: none;
        }
        .bean-quiz-debug-select option {
          background: #111111;
          color: #f5f5f5;
        }
        .bean-quiz-debug-btn {
          width: 100%;
          min-height: 4.8rem;
          background: #c6a969;
          border: 1px solid #c6a969;
          color: #0b0b0b;
          border-radius: 999px;
          font-size: 1.15rem;
          font-weight: 900;
          text-transform: uppercase;
          letter-spacing: 0.08em;
          cursor: pointer;
          transition: all 0.24s ease;
        }
        .bean-quiz-debug-btn:hover {
          background: #f5f5f5;
          border-color: #f5f5f5;
        }
      `;
      document.head.appendChild(debugStyle);

      const trigger = document.createElement('button');
      trigger.className = 'bean-quiz-debug-trigger';
      trigger.type = 'button';
      trigger.innerHTML = '⚙️ Result Tester';
      document.body.appendChild(trigger);

      const panel = document.createElement('div');
      panel.className = 'bean-quiz-debug-panel';
      panel.innerHTML = `
        <h3 class="bean-quiz-debug-title">⚙️ Permutation Tester</h3>
        <label class="bean-quiz-debug-label" for="debug-outcome-select">Select Outcome Profile</label>
        <select id="debug-outcome-select" class="bean-quiz-debug-select">
          <optgroup label="Single Dominant Archetypes">
            <option value="coffee">Coffee Bean</option>
            <option value="chilli">Chilli Bean</option>
            <option value="vanilla">Vanilla Bean</option>
            <option value="jelly">Jelly Bean</option>
            <option value="green">Green Bean</option>
          </optgroup>
          <optgroup label="Dual Blend Permutations (20 Profiles)">
            <option value="coffee_green">Coffee & Green — The Still Water</option>
            <option value="green_coffee">Green & Coffee — Reversed Still Water</option>
            <option value="coffee_chilli">Coffee & Chilli — The Sharp Thinker</option>
            <option value="chilli_coffee">Chilli & Coffee — Reversed Sharp Thinker</option>
            <option value="coffee_jelly">Coffee & Jelly — The Soft Observer</option>
            <option value="jelly_coffee">Jelly & Coffee — Reversed Soft Observer</option>
            <option value="coffee_vanilla">Coffee & Vanilla — The Restless Mind</option>
            <option value="vanilla_coffee">Vanilla & Coffee — Reversed Restless Mind</option>
            <option value="vanilla_jelly">Vanilla & Jelly — The Electric Optimist</option>
            <option value="jelly_vanilla">Jelly & Vanilla — Reversed Electric Optimist</option>
            <option value="vanilla_chilli">Vanilla & Chilli — The Live Wire</option>
            <option value="chilli_vanilla">Chilli & Vanilla — Reversed Live Wire</option>
            <option value="vanilla_green">Vanilla & Green — The Open Road</option>
            <option value="green_vanilla">Green & Vanilla — Reversed Open Road</option>
            <option value="chilli_jelly">Chilli & Jelly — The Charismatic Storm</option>
            <option value="jelly_chilli">Jelly & Chilli — Reversed Charismatic Storm</option>
            <option value="chilli_green">Chilli & Green — The Quiet Revolutionary</option>
            <option value="green_chilli">Green & Chilli — Reversed Quiet Revolutionary</option>
            <option value="jelly_green">Jelly & Green — The Warm Anchor</option>
            <option value="green_jelly">Green & Jelly — Reversed Warm Anchor</option>
          </optgroup>
        </select>
        <div style="margin-bottom: 1.8rem; display: flex; align-items: center; gap: 0.8rem;">
          <input type="checkbox" id="debug-true-blend-chk" style="width: 1.8rem; height: 1.8rem; cursor: pointer; accent-color: #c6a969;">
          <label for="debug-true-blend-chk" style="color: rgba(245, 245, 245, 0.7); font-size: 1.1rem; cursor: pointer; user-select: none; font-weight: 500; font-family: 'Poppins', sans-serif;">Simulate as True Blend (Tie score)</label>
        </div>
        <button type="button" id="debug-simulate-btn" class="bean-quiz-debug-btn">Simulate Result</button>
      `;
      document.body.appendChild(panel);

      trigger.addEventListener('click', () => {
        panel.classList.toggle('is-open');
      });

      document.getElementById('debug-simulate-btn').addEventListener('click', () => {
        const value = document.getElementById('debug-outcome-select').value;
        const simulateTrueBlend = document.getElementById('debug-true-blend-chk') ? document.getElementById('debug-true-blend-chk').checked : false;
        panel.classList.remove('is-open');

        // Reset scores
        for (const key in state.scores) {
          state.scores[key] = 0;
        }

        if (value.includes('_')) {
          // Dual Blend or True Blend
          const [primary, secondary] = value.split('_');
          
          if (simulateTrueBlend) {
            // True Blend (Tie score) - Gap of 0
            state.scores[primary] = 40;
            state.scores[secondary] = 40;
          } else {
            // Dual Blend - Gap of 2 (triggers isDualBlend under the 1-2 gap threshold)
            state.scores[primary] = 40;
            state.scores[secondary] = 38;
          }
          
          // Set others to small values
          const others = Object.keys(state.scores).filter((k) => k !== primary && k !== secondary);
          others.forEach((key, i) => {
            state.scores[key] = 5 + i;
          });

          renderResult(primary);
        } else {
          // Single Archetype
          state.scores[value] = 70;
          const others = Object.keys(state.scores).filter((k) => k !== value);
          others.forEach((key, i) => {
            state.scores[key] = 7 + i;
          });

          renderResult(value);
        }

        showScreen('result');
      });
    }

    // Share buttons event listeners registration
    if (shareCopy) {
      shareCopy.addEventListener('click', () => {
        if (navigator.clipboard) {
          navigator.clipboard.writeText(state.shareUrl).then(() => {
            shareCopy.classList.add('is-copied');
            setTimeout(() => {
              shareCopy.classList.remove('is-copied');
            }, 2000);
          });
        }
      });
    }

    if (shareWhatsApp) {
      shareWhatsApp.addEventListener('click', async (e) => {
        const profile = state.winningProfile;
        if (!profile) return;

        const msgData = shareMessages[profile.key] || {
          title: profile.title,
          desc: profile.desc
        };

        const shareText = `${msgData.title}\n${msgData.desc}\nWhat's your Bean? 👀 Take the quiz to find out:\n${state.shareUrl}`;

        // Check if Web Share API with files is supported
        if (navigator.share && navigator.canShare) {
          e.preventDefault();
          
          const textEl = shareWhatsApp.querySelector('span');
          const origText = textEl ? textEl.textContent : 'WhatsApp';
          if (textEl) textEl.textContent = 'Preparing card...';

          try {
            // Generate the feed card (1:1 aspect ratio) for sharing
            generateShareCard(false, async (dataUrl) => {
              try {
                // Ensure image fetching has CORS safety by prepending https: if protocol relative
                const fetchUrl = dataUrl.startsWith('//') ? `https:${dataUrl}` : dataUrl;
                const response = await fetch(fetchUrl);
                const blob = await response.blob();
                const file = new File([blob], `${profile.key}_card.png`, { type: 'image/png' });

                const shareData = {
                  files: [file],
                  title: msgData.title,
                  text: shareText
                };

                if (navigator.canShare(shareData)) {
                  await navigator.share(shareData);
                } else {
                  // Fallback to redirection
                  window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(shareText)}`, '_blank');
                }
              } catch (err) {
                console.warn('Native share failed inside callback:', err);
                window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(shareText)}`, '_blank');
              } finally {
                if (textEl) textEl.textContent = origText;
              }
            });
            return;
          } catch (err) {
            console.warn('Native share setup failed:', err);
          }

          if (textEl) textEl.textContent = origText;
          // Fallback to URL redirection
          window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(shareText)}`, '_blank');
        }
      });
    }

    if (shareInstagram) {
      shareInstagram.addEventListener('click', openInstaModal);
    }

    instaCloseBtns.forEach(btn => {
      btn.addEventListener('click', closeInstaModal);
    });

    if (downloadStoryBtn) {
      downloadStoryBtn.addEventListener('click', () => downloadCard(true));
    }

    if (downloadFeedBtn) {
      downloadFeedBtn.addEventListener('click', () => downloadCard(false));
    }

    if (instaCopyBtn && instaLinkInput) {
      instaCopyBtn.addEventListener('click', () => {
        if (navigator.clipboard) {
          navigator.clipboard.writeText(instaLinkInput.value).then(() => {
            instaCopyBtn.textContent = 'COPIED!';
            setTimeout(() => {
              instaCopyBtn.textContent = 'COPY LINK';
            }, 2000);
          });
        }
      });
    }

    // Check for shared results query parameter on load
    checkReferredVisitor();

    // Dynamically fetch and sync slider images from homepage on load
    async function loadSliderImages() {
      try {
        const response = await fetch('/');
        if (!response.ok) return;
        const html = await response.text();
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');
        const cards = doc.querySelectorAll('#shopify-section-collection_slider_yzYUYt .cc-card');
        cards.forEach(card => {
          const titleEl = card.querySelector('.cc-card-title');
          const imgEl = card.querySelector('.cc-image');
          if (titleEl && imgEl) {
            const title = titleEl.textContent.trim().toLowerCase();
            const src = imgEl.getAttribute('src') || imgEl.src;
            if (title && src) {
              let key = null;
              if (title.includes('coffee')) key = 'coffee';
              else if (title.includes('chilli')) key = 'chilli';
              else if (title.includes('vanilla')) key = 'vanilla';
              else if (title.includes('jelly')) key = 'jelly';
              else if (title.includes('green')) key = 'green';
              
              if (key && archetypes[key]) {
                let resolvedSrc = src;
                if (resolvedSrc.startsWith('//')) {
                  resolvedSrc = 'https:' + resolvedSrc;
                }
                // Strip Shopify size suffix (e.g. _600x.png) if present to get high-res image
                resolvedSrc = resolvedSrc.replace(/_\d+x(\.(png|jpg|jpeg|webp|gif))/i, '$1');
                archetypes[key].staticImage = resolvedSrc;
              }
            }
          }
        });
      } catch (err) {
        console.error('Error fetching homepage slider images:', err);
      }
    }
    loadSliderImages();

    showScreen('welcome');
  })();
</script>

