        <div class="bean-quiz__footer">
          <p class="bean-quiz__helper">Best results come from instinct, not strategy.</p>
          <button class="bean-quiz__ghost" type="button" data-quiz-back hidden>Previous</button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    const root = document.querySelector('[data-quiz-root]');
    if (!root) return;

    const screens = Array.from(root.querySelectorAll('[data-quiz-screen]'));
    const progressBar = root.querySelector('[data-quiz-progress]');
    const stepCount = root.querySelector('[data-quiz-count]');
    const backButton = root.querySelector('[data-quiz-back]');
    const startButtons = Array.from(root.querySelectorAll('[data-quiz-start]'));
    const restartButton = root.querySelector('[data-quiz-restart]');
    const resultName = root.querySelector('[data-result-name]');
    const resultDescription = root.querySelector('[data-result-description]');
    const resultTraits = root.querySelector('[data-result-traits]');
    const resultEnergy = root.querySelector('[data-result-energy]');
    const resultFit = root.querySelector('[data-result-fit]');
    const resultLink = root.querySelector('[data-result-link]');
    const resultGif = root.querySelector('[data-result-gif]');

    const resultDirection = root.querySelector('[data-result-direction]');
    const resultPalette = root.querySelector('[data-result-palette]');
    const resultCtaCopy = root.querySelector('[data-result-cta-copy]');

    const archetypes = {
      coffee: {
        name: 'Coffee Bean',
        traits: ['Curious', 'Grounded', 'Precise'],
        description:
          'You move with thought, restraint, and depth. Even when you are quiet, your point of view lands clearly.',
        energy: 'Calm authority',
        fit: 'Best on days that call for sharper thinking and quieter confidence.',
        collection: '/collections/coffee-bean',
        accent: '#8B5E3C',
        ink: '#F7F1EA',
        bg: 'rgba(90, 58, 27, 0.28)',
        bgStrong: 'rgba(139, 94, 60, 0.18)',
        glow: 'rgba(90, 58, 27, 0.24)',
        border: 'rgba(184, 133, 96, 0.22)',
        panel: 'rgba(255, 248, 240, 0.05)',
        panelAlt: 'rgba(255, 248, 240, 0.03)',
        palette: 'Roasted brown, espresso depth, warm mocha neutrals.',
        direction: 'Editorial, grounded, and quietly sharp with deeper contrast.',
        ctaCopy: 'Go straight into the Coffee Bean drop for the clearest fit.',
        gif: "{{ 'coffee_bean_gif.gif' | file_url }}",
        coreIdentity: "You live a few steps behind the surface. You see patterns in people’s behaviour before they see them in themselves. Conversations with you feel like finally being understood. You’re not antisocial — you’re selective.",
        stressBehaviour: "Withdrawal, over-analysis, rumination spirals. You replay conversations looking for what you missed. You go quiet when you need help most.",
        hiddenTrait: "You are far funnier than people expect. Your humour is dry, precise, perfectly timed — and devastating.",
        misunderstood: "That you’re cold, or uninterested. You’re neither. You’re just watching. When you finally speak, it means something.",
        compatibility: "You balance beautifully with Jelly Bean energy (they externalize what you internalize) and Green Bean (they hold space for your spirals)."
      },
      chilli: {
        name: 'Chilli Bean',
        traits: ['Bold', 'Fiery', 'Unfiltered'],
        description: 'You lead with instinct, heat, and impact. People feel your presence before you explain yourself.',
        energy: 'High contrast',
        fit: 'Best when the mood is direct, loud, and impossible to ignore.',
        collection: '/collections/chilli-bean',
        accent: '#E63946',
        ink: '#FFF3F4',
        bg: 'rgba(158, 27, 27, 0.24)',
        bgStrong: 'rgba(230, 57, 70, 0.16)',
        glow: 'rgba(230, 57, 70, 0.22)',
        border: 'rgba(255, 126, 126, 0.22)',
        panel: 'rgba(255, 245, 246, 0.05)',
        panelAlt: 'rgba(255, 245, 246, 0.03)',
        palette: 'Hot red, burnt red, and a flash of lava yellow.',
        direction: 'Charged, bold, and cleanly aggressive without losing clarity.',
        ctaCopy: 'Open the Chilli Bean page when you want the loudest match.',
        gif: "{{ 'chilli_bean_gif.gif' | file_url }}",
        coreIdentity: "You don't filter, and you don't perform. You lead with instinct, heat, and impact. If someone needs a reality check or a wild adventure, they come to you. You choose honest conflict over fake comfort.",
        stressBehaviour: "Hot-headedness, impatience, and overload. You get loud or completely route around rules when they feel restrictive.",
        hiddenTrait: "You have a surprisingly soft heart. You protect the people you love with a fierce, uncompromising loyalty.",
        misunderstood: "That you're angry or intentionally combative. You're not. You're just completely, unapologetically real.",
        compatibility: "You pair beautifully with Green Bean's calm energy (they ground your fire) and Coffee Bean (who values your absolute honesty)."
      },
      vanilla: {
        name: 'Vanilla Bean',
        traits: ['Smooth', 'Stylish', 'Fluid'],
        description: 'You have range, rhythm, and a polished way of moving that never feels forced.',
        energy: 'Soft magnetism',
        fit: 'Best when you want elegance, ease, and style without stiffness.',
        collection: '/collections/vanilla-bean',
        accent: '#D4A85A',
        ink: '#FFF8F0',
        bg: 'rgba(182, 120, 47, 0.2)',
        bgStrong: 'rgba(229, 211, 179, 0.18)',
        glow: 'rgba(229, 211, 179, 0.26)',
        border: 'rgba(228, 196, 146, 0.24)',
        panel: 'rgba(255, 249, 240, 0.05)',
        panelAlt: 'rgba(255, 249, 240, 0.03)',
        palette: 'Cream silk, soft butter, and warm beige layering.',
        direction: 'Smooth, mellow, and elevated with softer warmth.',
        ctaCopy: 'Step into the Vanilla Bean page for the cleanest soft-luxury lane.',
        gif: "{{ 'vanilla_bean_gif.gif' | file_url }}",
        coreIdentity: "You are not shallow — you are expansive. You collect experiences the way others collect things. Boredom feels like a small death. You make ordinary moments feel like something worth remembering.",
        stressBehaviour: "Escape mode. You plan trips, start new projects, move your furniture — anything to feel like forward motion. Sitting with discomfort is your hardest skill.",
        hiddenTrait: "You carry anxiety that no one sees. The optimism is real, but it also works overtime to outrun a fear of things being still.",
        misunderstood: "That you’re not serious, or that your enthusiasm is performative. It isn’t. You are exactly this alive.",
        compatibility: "You need Coffee Bean’s depth to slow you down, and Green Bean’s stillness to help you land."
      },
      jelly: {
        name: 'Jelly Bean',
        traits: ['Playful', 'Social', 'Magnetic'],
        description:
          'You are switched on, socially alive, and naturally expressive. Your energy turns moments into signals.',
        energy: 'Fast and social',
        fit: 'Best for playful days, scene energy, and a look that feels current.',
        collection: '/collections/jelly-bean',
        accent: '#2BB3C0',
        ink: '#F2FEFF',
        bg: 'rgba(21, 128, 138, 0.22)',
        bgStrong: 'rgba(43, 179, 192, 0.16)',
        glow: 'rgba(43, 179, 192, 0.22)',
        border: 'rgba(125, 231, 241, 0.24)',
        panel: 'rgba(242, 254, 255, 0.05)',
        panelAlt: 'rgba(242, 254, 255, 0.03)',
        palette: 'Candy cyan, bubble blue, and glossy cool light.',
        direction: 'Bright, digital, and playful with a cleaner cyan atmosphere.',
        ctaCopy: 'Jump to the Jelly Bean page for the most animated version of your match.',
        gif: "{{ 'jelly_bean_gif.gif' | file_url }}",
        coreIdentity: "You are a natural connector. You remember birthdays, inside jokes, and the name of someone’s dog. Relationships are your primary language. You don’t just want to be liked — you genuinely love people, loudly and without apology.",
        stressBehaviour: "Over-extension. You take on everyone’s emotional labour until you’ve got nothing left. You perform okayness long after you stopped being okay.",
        hiddenTrait: "You crave depth. Beneath the social ease is someone who wants to be truly, completely known — and worries they’re only loved for being fun.",
        misunderstood: "That you’re all surface. You are not. The expressiveness is real, but so is the person underneath it who thinks about everything.",
        compatibility: "You ground beautifully with Coffee Bean (who sees past the performance) and Green Bean (who holds you without needing you to be 'on')."
      },
      green: {
        name: 'Green Bean',
        traits: ['Fresh', 'Grounded', 'Open'],
        description: 'You carry lightness without losing shape. Your best style feels clean, calm, and fully lived in.',
        energy: 'Restorative clarity',
        fit: 'Best when you want a reset, softer movement, and easy confidence.',
        collection: '/collections/green-bean',
        accent: '#5BBF3A',
        ink: '#F4FFF0',
        bg: 'rgba(47, 125, 50, 0.22)',
        bgStrong: 'rgba(91, 191, 58, 0.16)',
        glow: 'rgba(91, 191, 58, 0.22)',
        border: 'rgba(164, 232, 143, 0.24)',
        panel: 'rgba(244, 255, 240, 0.05)',
        panelAlt: 'rgba(244, 255, 240, 0.03)',
        palette: 'Fresh leaf green, soft lime, and airy botanical light.',
        direction: 'Clean, restorative, and bright with a softer natural wash.',
        ctaCopy: 'Open the Green Bean page when you want the calmest version of your result.',
        gif: "{{ 'green_bean_gif.gif' | file_url }}",
        coreIdentity: "You are the anchor. You carry peace, emotional intelligence, and clean, grounding energy. People feel lighter just by being in your presence. You choose mindful presence over noisy action.",
        stressBehaviour: "Over-absorption. You take on the weight of everyone else's emotions and problems until you are completely drained.",
        hiddenTrait: "You have incredibly sharp instincts. You read a room or a person instantly, even if you keep your observations to yourself.",
        misunderstood: "That you're passive or have no opinion. You do — you just don't feel the need to shout to be heard.",
        compatibility: "You pair beautifully with Chilli Bean (you ground their chaos) and Vanilla Bean (they drag you into spontaneous experiences)."
      },
    };

    const state = {
      current: 'welcome',
      totalSteps: 15,
      answers: {},
      scores: {
        coffee: 0,
        chilli: 0,
        vanilla: 0,
        jelly: 0,
        green: 0,
      },
    };

    function updateProgress() {
      if (state.current === 'welcome') {
        progressBar.style.width = '0%';
        stepCount.textContent = 'Intro';
        backButton.hidden = true;
        return;
      }

      if (state.current === 'result') {
        progressBar.style.width = '100%';
        stepCount.textContent = 'Result';
        backButton.hidden = false;
        return;
      }

      const step = Number(state.current);
      progressBar.style.width = (step / state.totalSteps) * 100 + '%';
      stepCount.textContent = 'Question ' + step + ' / ' + state.totalSteps;
      backButton.hidden = step === 1;
    }

    function showScreen(name) {
      state.current = name;
      screens.forEach((screen) => {
        screen.classList.toggle('is-active', screen.dataset.quizScreen === String(name));
      });
      updateProgress();
    }

    function getWinningBean() {
      const tieOrder = ['coffee', 'vanilla', 'chilli', 'jelly', 'green'];
      let winner = tieOrder[0];
      let max = -1;

      tieOrder.forEach((bean) => {
        if (state.scores[bean] > max) {
          max = state.scores[bean];
          winner = bean;
        }
      });

      return winner;
    }

    function renderResult(beanKey) {
      const data = archetypes[beanKey];
      if (!data) return;

      root.style.setProperty('--result-accent', data.accent);
      root.style.setProperty('--result-ink', data.ink);
      root.style.setProperty('--result-bg', data.bg);
      root.style.setProperty('--result-bg-strong', data.bgStrong);
      root.style.setProperty('--result-glow', data.glow);
      root.style.setProperty('--result-border', data.border);
      root.style.setProperty('--result-panel', data.panel);
      root.style.setProperty('--result-panel-alt', data.panelAlt);
      resultName.textContent = data.name;
      resultDescription.textContent = data.description;
      resultEnergy.textContent = data.energy;
      resultFit.textContent = data.fit;
      resultLink.href = data.collection;
      resultDirection.textContent = data.direction;
      resultPalette.textContent = data.palette;
      resultCtaCopy.textContent = data.ctaCopy;
      resultGif.src = data.gif;
      resultGif.alt = data.name;
      resultTraits.innerHTML = '';

      data.traits.forEach((trait) => {
        const item = document.createElement('span');
        item.className = 'bean-quiz__trait';
        item.textContent = trait;
        resultTraits.appendChild(item);
      });

      // Render new detailed sections
      const coreIdEl = root.querySelector('[data-detail-core-identity]');
      const stressEl = root.querySelector('[data-detail-stress-behaviour]');
      const hiddenEl = root.querySelector('[data-detail-hidden-trait]');
      const misunderstoodEl = root.querySelector('[data-detail-misunderstood]');
      const compatibilityEl = root.querySelector('[data-detail-compatibility]');

      if (coreIdEl) coreIdEl.textContent = data.coreIdentity || '';
      if (stressEl) stressEl.textContent = data.stressBehaviour || '';
      if (hiddenEl) hiddenEl.textContent = data.hiddenTrait || '';
      if (misunderstoodEl) misunderstoodEl.textContent = data.misunderstood || '';
      if (compatibilityEl) compatibilityEl.textContent = data.compatibility || '';

      // 1. Calculate raw scores
      const rawScores = state.scores;
      const total = Object.values(rawScores).reduce((a, b) => a + b, 0) || 1;

      // 2. Round percentages
      const percents = {};
      let sum = 0;
      let maxKey = 'coffee';
      let maxVal = -1;

      for (const key in rawScores) {
        const p = Math.round((rawScores[key] / total) * 100);
        percents[key] = p;
        sum += p;
        if (p > maxVal) {
          maxVal = p;
          maxKey = key;
        }
      }

      // 3. Balance to exactly 100%
      const diff = 100 - sum;
      if (diff !== 0) {
        percents[maxKey] += diff;
      }

      // 4. Sort percentages
      const sorted = Object.entries(percents).sort((a, b) => b[1] - a[1]);
      const primary = sorted[0]; // [key, %]
      const secondary = sorted[1]; // [key, %]

      // 5. Determine Classification
      let classification = '';
      if (primary[1] - secondary[1] <= 5) {
        classification = `True Blend: ${archetypes[primary[0]].name} & ${archetypes[secondary[0]].name}`;
      } else if (primary[1] > 50) {
        classification = `Dominant Archetype: ${archetypes[primary[0]].name}`;
      } else {
        classification = `Dual Blend: ${archetypes[primary[0]].name} + ${archetypes[secondary[0]].name}`;
      }

      // Render classification
      const classificationEl = root.querySelector('[data-blend-classification]');
      if (classificationEl) {
        classificationEl.textContent = classification;
      }

      // Render Blend Bar & Labels
      const blendBar = root.querySelector('[data-blend-bar]');
      const blendLabels = root.querySelector('[data-blend-labels]');
      if (blendBar && blendLabels) {
        blendBar.innerHTML = '';
        blendLabels.innerHTML = '';

        // Display labels as- “You are 60% Chilli Bean, 25% Coffee Bean...”
        const sortedDisplay = [...sorted];
        const labelText = sortedDisplay.map(([key, pct]) => `${pct}% ${archetypes[key].name}`).join(', ');
        
        const textWrapper = document.createElement('div');
        textWrapper.className = 'bean-quiz__blend-text';
        textWrapper.innerHTML = `You are: <strong>${labelText}</strong>`;
        blendLabels.appendChild(textWrapper);

        sortedDisplay.forEach(([key, pct]) => {
          if (pct > 0) {
            const segment = document.createElement('div');
            segment.className = 'bean-quiz__blend-segment';
            segment.style.width = pct + '%';
            segment.style.backgroundColor = archetypes[key].accent;
            blendBar.appendChild(segment);
          }
        });
      }

      localStorage.setItem('bean_identity_result', beanKey);
    }

    function parseWeights(weightStr) {
      const weights = {};
      if (!weightStr) return weights;
      weightStr.split(',').forEach((item) => {
        const [bean, val] = item.split(':');
        if (bean && val) {
          weights[bean.trim()] = Number(val.trim());
        }
      });
      return weights;
    }

    function goNextFrom(step, optionButton) {
      const weightStr = optionButton.dataset.weights || '';
      const nextStep = step + 1;
      const previousWeightsStr = state.answers[step];

      if (previousWeightsStr) {
        const prevWeights = parseWeights(previousWeightsStr);
        for (const bean in prevWeights) {
          state.scores[bean] = Math.max(0, state.scores[bean] - prevWeights[bean]);
        }
      }

      state.answers[step] = weightStr;
      const currentWeights = parseWeights(weightStr);
      for (const bean in currentWeights) {
        state.scores[bean] = (state.scores[bean] || 0) + currentWeights[bean];
      }

      optionButton
        .closest('[data-quiz-screen]')
        .querySelectorAll('.bean-quiz__option')
        .forEach((option) => {
          option.classList.remove('is-selected');
        });
      optionButton.classList.add('is-selected');

      window.setTimeout(function () {
        if (nextStep > state.totalSteps) {
          const winner = getWinningBean();
          renderResult(winner);
          showScreen('result');
        } else {
          showScreen(String(nextStep));
        }
      }, 180);
    }

    function goBack() {
      if (state.current === 'result') {
        showScreen(String(state.totalSteps));
        return;
      }

      if (state.current === 'welcome') {
        return;
      }

      const step = Number(state.current);
      if (step > 1) {
        showScreen(String(step - 1));
      } else {
        showScreen('welcome');
      }
    }

    function resetQuiz() {
      state.current = 'welcome';
      state.answers = {};
      state.scores = {
        coffee: 0,
        chilli: 0,
        vanilla: 0,
        jelly: 0,
        green: 0,
      };

      root.querySelectorAll('.bean-quiz__option').forEach((option) => {
        option.classList.remove('is-selected');
      });

      showScreen('welcome');
    }

    startButtons.forEach((startButton) => {
      startButton.addEventListener('click', function () {
        showScreen('1');
      });
    });

    if (backButton) {
      backButton.addEventListener('click', goBack);
    }

    if (restartButton) {
      restartButton.addEventListener('click', resetQuiz);
    }

    root.querySelectorAll('.bean-quiz__screen[data-step]').forEach((screen) => {
      const step = Number(screen.dataset.step);
      screen.querySelectorAll('.bean-quiz__option').forEach((button) => {
        button.addEventListener('click', function () {
          goNextFrom(step, button);
        });
      });
    });

    showScreen('welcome');
  })();
</script>

