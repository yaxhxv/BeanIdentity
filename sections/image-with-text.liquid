{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
.section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
{% if section.settings.bg_color != blank %}
  background: linear-gradient(180deg, #f5f5f5 0%, #ede7e3 100%);
{% endif %}
  border-radius: 4.2rem 4.2rem 5rem 5.4rem / 3rem 3rem 3.8rem 4rem;
  box-shadow: 0 2.4rem 5rem rgba(43,43,43,0.08);
  margin: 0 1.6rem;
  position: relative;
  overflow: hidden;
}

{% if section.settings.bg_color != blank %}
  .section-{{ section.id }}-padding, .section-{{ section.id }}-padding .content-container { background: transparent
  !important; background-color: transparent !important; }
  {% if section.settings.text_color != blank %}
    .section-{{ section.id }}-padding .image-with-text__heading, .section-{{ section.id }}-padding
    .image-with-text__text { color: {{ section.settings.text_color }}; }
  {% endif %}
{% endif %}

@media screen and (min-width: 750px) { .section-{{ section.id }}-padding { padding-top:
{{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; } }

.section-{{ section.id }}-padding .image-with-text {
  border: 1px solid rgba(11,11,11,0.08);
  border-radius: 3.6rem 2.8rem 3.8rem 3.2rem;
  overflow: hidden;
  opacity: 1 !important;
  transform: none !important;
  background: rgba(255,255,255,0.36);
  box-shadow: 0 1.8rem 4rem rgba(43,43,43,0.06);
}

.section-{{ section.id }}-padding .scroll-trigger,
.section-{{ section.id }}-padding .animate--slide-in {
  opacity: 1 !important;
  transform: none !important;
}

.section-{{ section.id }}-padding .image-with-text__media {
  border-radius: 2.6rem;
  border: 1px solid rgba(11,11,11,0.08);
  overflow: hidden;
  opacity: 1 !important;
  --video-padding: {{ section.settings.video_padding }}px;
  position: relative;
  
  /* Premium Margin and Spacing additions for video cards */
  {% if section.settings.video != blank or section.settings.video_filename != blank or section.settings.video_url != blank %}
    background: rgba(255, 255, 255, 0.22) !important;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.35) !important;
    align-self: center; /* Prevents card from stretching */
  {% endif %}
}

{% if section.settings.video != blank or section.settings.video_filename != blank or section.settings.video_url != blank %}
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding .image-with-text__media {
      margin: 2.4rem;
      width: calc(100% - 4.8rem) !important;
    }
    .section-{{ section.id }}-padding .image-with-text__media-item {
      align-self: center; /* Prevents grid column from stretching vertically */
    }
  }
  @media screen and (max-width: 749px) {
    .section-{{ section.id }}-padding .image-with-text__media {
      margin: 1.6rem;
      width: calc(100% - 3.2rem) !important;
    }
  }
{% endif %}

.section-{{ section.id }}-padding .image-with-text__video {
  position: absolute;
  top: var(--video-padding);
  left: var(--video-padding);
  width: calc(100% - (var(--video-padding) * 2));
  height: calc(100% - (var(--video-padding) * 2));
  object-fit: cover;
  border-radius: max(0px, calc(2.6rem - var(--video-padding)));
  transition: transform 0.4s ease;
}

.section-{{ section.id }}-padding .image-with-text__content {
  padding: clamp(4rem, 6vw, 8rem);
  opacity: 1 !important;
}

.section-{{ section.id }}-padding .image-with-text__heading {
  font-family: var(--font-heading-family);
  font-weight: 900;
  line-height: 0.92;
  letter-spacing: 0;
  text-transform: none;
  color: #0b0b0b !important;
}

.section-{{ section.id }}-padding .image-with-text__text {
  font-family: 'Poppins', sans-serif;
  color: rgba(11,11,11,0.68) !important;
  line-height: 1.6;
}

.section-{{ section.id }}-padding .button {
  border-radius: 999px;
  min-height: 5.2rem;
  padding: 0 3rem;
  font-family: 'Poppins', sans-serif;
  font-size: 1.2rem;
  font-weight: 900;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

@media screen and (max-width: 749px) {
  .section-{{ section.id }}-padding {
    margin: 0 1rem;
    border-radius: 2.6rem 2.6rem 3.4rem 3.6rem / 2rem 2rem 2.6rem 2.8rem;
  }

  .section-{{ section.id }}-padding .image-with-text {
    border-radius: 2.4rem;
  }

  .section-{{ section.id }}-padding .iwt-vanilla-doodle,
  .section-{{ section.id }}-padding .iwt-jelly-doodle {
    display: none !important;
  }
}
{%- endstyle -%}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
  if section.settings.color_scheme == section.settings.section_color_scheme and section.settings.content_layout == 'no-overlap'
    assign remove_color_classes = true
  endif
-%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.section_color_scheme }}{% if section.settings.bg_color == '#EDE7E3' or section.settings.bg_color == '#ede7e3' %} texture-grain{% endif %}">
  {%- if section.settings.show_doodles -%}
    <img
      src="{{ 'JellyDoodle2.png' | file_url }}"
      alt=""
      aria-hidden="true"
      loading="lazy"
      class="iwt-jelly-doodle"
      style="position:absolute; top: -3rem; right: -4rem; width: clamp(160px, 20vw, 280px); height: auto; opacity: 0.78; transform: rotate(15deg); pointer-events: none; z-index: 0; mix-blend-mode: multiply; border-radius: 52% 48% 50% 50% / 40% 42% 58% 60%;"
    >
    <img
      src="{{ 'VanillaDoodle2.png' | file_url }}"
      alt=""
      aria-hidden="true"
      loading="lazy"
      class="iwt-vanilla-doodle"
      style="position:absolute; bottom: -2rem; left: -3rem; width: clamp(180px, 24vw, 320px); height: auto; opacity: 0.75; transform: rotate(-12deg); pointer-events: none; z-index: 0; mix-blend-mode: multiply; border-radius: 46% 54% 52% 48% / 54% 46% 54% 46%;"
    >
  {%- endif -%}
  <div class="page-width">
    <div class="image-with-text image-with-text--{{ section.settings.content_layout }} isolate{% if settings.text_boxes_border_thickness > 0 and settings.text_boxes_border_opacity > 0 and settings.media_border_thickness > 0 and settings.media_border_opacity > 0 %} collapse-borders{% endif %}{% unless section.settings.color_scheme == section.settings.section_color_scheme and settings.media_border_thickness > 0 and settings.text_boxes_shadow_opacity == 0 and settings.text_boxes_border_thickness == 0 or settings.text_boxes_border_opacity == 0 %} collapse-corners{% endunless %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <div class="image-with-text__grid grid grid--gapless grid--1-col grid--{% if section.settings.desktop_image_width == 'medium' %}2-col-tablet{% else %}3-col-tablet{% endif %}{% if section.settings.layout == 'text_first' %} image-with-text__grid--reverse{% endif %}">
        <div class="image-with-text__media-item image-with-text__media-item--{{ section.settings.desktop_image_width }} image-with-text__media-item--{{ section.settings.desktop_content_position }} grid__item">
          <div
            class="image-with-text__media image-with-text__media--{{ section.settings.height }} global-media-settings{% unless remove_color_classes %} gradient color-{{ section.settings.color_scheme }}{% else %} background-transparent{% endunless %}{% if section.settings.image != blank or section.settings.video != blank or section.settings.video_filename != blank or section.settings.video_url != blank %} media{% else %} image-with-text__media--placeholder placeholder{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}"
            {% if section.settings.height == 'adapt' %}
              {% if section.settings.video != blank %}
                style="padding-bottom: {{ 1 | divided_by: section.settings.video.aspect_ratio | times: 100 }}%;"
              {% elsif section.settings.image != blank %}
                style="padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;"
              {% else %}
                style="padding-bottom: 56.25%;"
              {% endif %}
            {% endif %}
          >
            {%- liquid
              assign video_src = ''
              if section.settings.video != blank
                for source in section.settings.video.sources
                  if source.format == 'mp4'
                    assign video_src = source.url
                    break
                  endif
                endfor
                if video_src == blank
                  assign video_src = section.settings.video.sources[0].url
                endif
              elsif section.settings.video_url != blank
                assign video_src = section.settings.video_url
              elsif section.settings.video_filename != blank
                if section.settings.video_filename contains '.'
                  assign video_src = section.settings.video_filename | file_url
                else
                  assign video_src = section.settings.video_filename | append: '.mp4' | file_url
                endif
              endif
            -%}

            {%- if video_src != blank -%}
              <video
                id="Video-{{ section.id }}"
                autoplay
                loop
                muted
                playsinline
                class="image-with-text__video"
                aria-label="{{ section.settings.image.alt | default: 'Bean Identity brand movie' | escape }}"
              >
                <source src="{{ video_src }}" type="video/mp4">
                Your browser does not support the video tag.
              </video>

              {%- if section.settings.show_controls -%}
                <div class="iwt-video-controls-container">
                  <div class="iwt-video-controls-bar">
                    <button id="PlayBtn-{{ section.id }}" class="iwt-ctrl-btn" aria-label="Pause Video" type="button">
                      <svg id="PauseIcon-{{ section.id }}" class="icon-pause" viewBox="0 0 24 24"><path fill="currentColor" d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
                      <svg id="PlayIcon-{{ section.id }}" class="icon-play" viewBox="0 0 24 24" style="display: none; transform: translateX(1px);"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
                    </button>
                    
                    <span id="TimeDisplay-{{ section.id }}" class="iwt-time-display">0:00 / 0:00</span>
                    
                    <div class="iwt-seek-bar-container">
                      <input id="SeekBar-{{ section.id }}" class="iwt-seek-bar" type="range" min="0" max="100" value="0" step="0.1" aria-label="Seek video">
                    </div>
                    
                    <button id="MuteBtn-{{ section.id }}" class="iwt-ctrl-btn" aria-label="Unmute Video" type="button">
                      <svg id="MutedIcon-{{ section.id }}" class="icon-muted" viewBox="0 0 24 24"><path fill="currentColor" d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.03c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73 4.27 3zM12 4L9.91 6.09 12 8.18V4z"/></svg>
                      <svg id="UnmutedIcon-{{ section.id }}" class="icon-unmuted" viewBox="0 0 24 24" style="display: none;"><path fill="currentColor" d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>
                    </button>
                    
                    <button id="FullscreenBtn-{{ section.id }}" class="iwt-ctrl-btn" aria-label="Toggle Fullscreen" type="button">
                      <svg class="icon-fullscreen" viewBox="0 0 24 24"><path fill="currentColor" d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>
                    </button>
                  </div>
                </div>
              {%- endif -%}
            {%- elsif section.settings.image != blank -%}
              {%- if section.settings.image_behavior == 'ambient' or section.settings.image_behavior == 'zoom-in' -%}
                {%- assign widths = '198, 432, 642, 900, 1284, 1800' -%}
                {%- capture sizes -%}
                  (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 1.6667 }}px,
                  (min-width: 750px) calc((100vw - 130px) / 1.667), calc((100vw - 50px) / 1.667)
                {%- endcapture -%}
              {%- else -%}
                {%- assign widths = '165, 360, 535, 750, 1070, 1500' -%}
                {%- capture sizes -%}
                  (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px,
                  (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)
                {%- endcapture -%}
              {%- endif -%}
              {{
                section.settings.image
                | image_url: width: 1500
                | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
              }}
            {%- else -%}
              {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        </div>
        <div class="image-with-text__text-item grid__item">
          <div
            id="ImageWithText--{{ section.id }}"
            class="image-with-text__content image-with-text__content--{{ section.settings.desktop_content_position }} image-with-text__content--desktop-{{ section.settings.desktop_content_alignment }} image-with-text__content--mobile-{{ section.settings.mobile_content_alignment }} image-with-text__content--{{ section.settings.height }} content-container{% unless remove_color_classes %} gradient color-{{ section.settings.color_scheme }}{% else %} background-transparent{% endunless %}"
          >
            {%- for block in section.blocks -%}
              {% case block.type %}
                {%- when 'heading' -%}
                  <h2
                    class="image-with-text__heading inline-richtext {{ block.settings.heading_size }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.heading }}
                  </h2>
                {%- when 'caption' -%}
                  <p
                    class="image-with-text__text image-with-text__text--caption {{ block.settings.text_style }} {{ block.settings.text_style }}--{{ block.settings.text_size }} {{ block.settings.text_style }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.caption | escape }}
                  </p>
                {%- when 'text' -%}
                  <div class="image-with-text__text rte {{ block.settings.text_style }}" {{ block.shopify_attributes }}>
                    {{ block.settings.text }}
                  </div>
                {%- when 'button' -%}
                  {%- if block.settings.button_label != blank -%}
                    <a
                      {% if block.settings.button_link == blank %}
                        role="link" aria-disabled="true"
                      {% else %}
                        href="{{ block.settings.button_link }}"
                      {% endif %}
                      class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.button_label | escape }}
                    </a>
                  {%- endif -%}
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{%- if section.settings.show_controls and video_src != blank -%}
  <style>
    .iwt-video-controls-container {
      position: absolute;
      bottom: var(--video-padding);
      left: var(--video-padding);
      width: calc(100% - (var(--video-padding) * 2));
      z-index: 5;
      padding: 1.2rem;
      box-sizing: border-box;
      pointer-events: none;
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                  transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    .image-with-text__media:hover .iwt-video-controls-container,
    .image-with-text__media.show-controls .iwt-video-controls-container {
      opacity: 1;
      transform: translateY(0);
    }

    .iwt-video-controls-bar {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.8rem 1.2rem;
      border-radius: 1.2rem;
      background: rgba(18, 18, 18, 0.65);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.15);
      pointer-events: auto;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    }

    .iwt-ctrl-btn {
      width: 3.6rem !important;
      height: 3.6rem !important;
      padding: 0.8rem !important;
      border-radius: 50%;
      border: 1px solid rgba(255, 255, 255, 0.1) !important;
      background: rgba(255, 255, 255, 0.1) !important;
      color: #ffffff !important;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      flex-shrink: 0;
      box-shadow: none !important;
    }

    .iwt-ctrl-btn svg {
      width: 1.8rem !important;
      height: 1.8rem !important;
      display: block;
    }

    .iwt-ctrl-btn:hover {
      background: #ffffff !important;
      color: #000000 !important;
      border-color: #ffffff !important;
      transform: scale(1.08);
    }

    .iwt-time-display {
      font-family: 'Poppins', sans-serif;
      font-size: 1.1rem;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.9);
      min-width: 7.5rem;
      text-align: center;
      user-select: none;
      flex-shrink: 0;
      letter-spacing: 0.05em;
    }

    .iwt-seek-bar-container {
      flex-grow: 1;
      display: flex;
      align-items: center;
      position: relative;
    }

    .iwt-seek-bar {
      -webkit-appearance: none;
      appearance: none;
      width: 100%;
      height: 4px;
      border-radius: 2px;
      background: rgba(255, 255, 255, 0.25);
      cursor: pointer;
      outline: none;
      margin: 0;
      transition: height 0.2s ease;
      background-image: linear-gradient(to right, #c6a969 0%, rgba(255, 255, 255, 0.25) 0%);
      background-repeat: no-repeat;
    }

    .iwt-seek-bar-container:hover .iwt-seek-bar {
      height: 6px;
    }

    .iwt-seek-bar::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      height: 12px;
      width: 12px;
      border-radius: 50%;
      background: #ffffff;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
      transition: transform 0.15s ease, background-color 0.15s ease;
    }

    .iwt-seek-bar-container:hover .iwt-seek-bar::-webkit-slider-thumb {
      transform: scale(1.25);
      background: #c6a969;
    }

    .iwt-seek-bar::-moz-range-thumb {
      height: 12px;
      width: 12px;
      border: none;
      border-radius: 50%;
      background: #ffffff;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
      transition: transform 0.15s ease, background-color 0.15s ease;
    }

    .iwt-seek-bar-container:hover .iwt-seek-bar::-moz-range-thumb {
      transform: scale(1.25);
      background: #c6a969;
    }

    /* Fullscreen styling overrides for container and layout */
    .image-with-text__media:fullscreen {
      width: 100vw !important;
      height: 100vh !important;
      max-width: none !important;
      max-height: none !important;
      padding-bottom: 0 !important;
      margin: 0 !important;
      border-radius: 0 !important;
      border: none !important;
      background: #000000 !important;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .image-with-text__media:fullscreen .image-with-text__video {
      position: relative;
      top: 0;
      left: 0;
      width: 100% !important;
      height: 100% !important;
      max-width: 100% !important;
      max-height: 100% !important;
      object-fit: contain !important;
      border-radius: 0 !important;
    }

    .image-with-text__media:fullscreen .iwt-video-controls-container {
      bottom: 2rem !important;
      left: 2rem !important;
      width: calc(100% - 4rem) !important;
    }

    /* Safari Fullscreen fallback styling */
    .image-with-text__media:-webkit-full-screen {
      width: 100vw !important;
      height: 100vh !important;
      max-width: none !important;
      max-height: none !important;
      padding-bottom: 0 !important;
      margin: 0 !important;
      border-radius: 0 !important;
      border: none !important;
      background: #000000 !important;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .image-with-text__media:-webkit-full-screen .image-with-text__video {
      position: relative;
      top: 0;
      left: 0;
      width: 100% !important;
      height: 100% !important;
      max-width: 100% !important;
      max-height: 100% !important;
      object-fit: contain !important;
      border-radius: 0 !important;
    }

    .image-with-text__media:-webkit-full-screen .iwt-video-controls-container {
      bottom: 2rem !important;
      left: 2rem !important;
      width: calc(100% - 4rem) !important;
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const sectionId = "{{ section.id }}";
      const video = document.getElementById(`Video-${sectionId}`);
      const playBtn = document.getElementById(`PlayBtn-${sectionId}`);
      const muteBtn = document.getElementById(`MuteBtn-${sectionId}`);
      const seekBar = document.getElementById(`SeekBar-${sectionId}`);
      const timeDisplay = document.getElementById(`TimeDisplay-${sectionId}`);
      const fullscreenBtn = document.getElementById(`FullscreenBtn-${sectionId}`);
      
      const pauseIcon = document.getElementById(`PauseIcon-${sectionId}`);
      const playIcon = document.getElementById(`PlayIcon-${sectionId}`);
      const mutedIcon = document.getElementById(`MutedIcon-${sectionId}`);
      const unmutedIcon = document.getElementById(`UnmutedIcon-${sectionId}`);

      if (!video) return;

      const mediaContainer = video.parentElement;
      let hideTimeout = null;
      let isSeeking = false;

      function updatePlayUI(isPaused) {
        if (!playBtn) return;
        if (isPaused) {
          pauseIcon.style.display = 'none';
          playIcon.style.display = 'block';
        } else {
          pauseIcon.style.display = 'block';
          playIcon.style.display = 'none';
        }
      }

      function updateMuteUI(isMuted) {
        if (!muteBtn) return;
        if (isMuted) {
          mutedIcon.style.display = 'block';
          unmutedIcon.style.display = 'none';
        } else {
          mutedIcon.style.display = 'none';
          unmutedIcon.style.display = 'block';
        }
      }

      function formatTime(seconds) {
        if (isNaN(seconds) || !isFinite(seconds)) return '0:00';
        const mins = Math.floor(seconds / 60);
        const secs = Math.floor(seconds % 60);
        return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
      }

      function updateSeekBar() {
        if (!video.duration || isSeeking) return;
        const percentage = (video.currentTime / video.duration) * 100;
        if (seekBar) {
          seekBar.value = percentage;
          seekBar.style.backgroundImage = `linear-gradient(to right, #c6a969 ${percentage}%, rgba(255, 255, 255, 0.25) ${percentage}%)`;
        }
        if (timeDisplay) {
          timeDisplay.textContent = `${formatTime(video.currentTime)} / ${formatTime(video.duration)}`;
        }
      }

      function showControls() {
        mediaContainer.classList.add('show-controls');
        mediaContainer.style.cursor = 'default';
        
        if (hideTimeout) clearTimeout(hideTimeout);
        
        if (!video.paused) {
          hideTimeout = setTimeout(() => {
            mediaContainer.classList.remove('show-controls');
            if (document.fullscreenElement || document.webkitFullscreenElement) {
              mediaContainer.style.cursor = 'none';
            }
          }, 3000);
        }
      }

      // Initialize UI
      updateMuteUI(video.muted);
      if (video.duration) {
        updateSeekBar();
      }

      // Hover / show-hide behavior
      mediaContainer.addEventListener('mousemove', showControls);
      mediaContainer.addEventListener('mouseenter', showControls);
      
      mediaContainer.addEventListener('click', function(e) {
        if (!e.target.closest('.iwt-video-controls-container')) {
          if (mediaContainer.classList.contains('show-controls')) {
            mediaContainer.classList.remove('show-controls');
            if (hideTimeout) clearTimeout(hideTimeout);
          } else {
            showControls();
          }
        }
      });

      // Desktop direct click play/pause
      video.addEventListener('click', function(e) {
        if (window.matchMedia("(pointer: coarse)").matches) {
          return; // Let container click show/hide controls on mobile
        }
        e.stopPropagation();
        if (video.paused) {
          video.play().catch(err => console.log(err));
        } else {
          video.pause();
        }
      });

      if (playBtn) {
        playBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          if (video.paused) {
            video.play().then(() => updatePlayUI(false)).catch(err => console.log(err));
          } else {
            video.pause();
            updatePlayUI(true);
          }
        });
      }

      if (muteBtn) {
        muteBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          video.muted = !video.muted;
          updateMuteUI(video.muted);
        });
      }

      if (seekBar) {
        seekBar.addEventListener('input', function() {
          isSeeking = true;
          const time = (seekBar.value / 100) * video.duration;
          if (timeDisplay) {
            timeDisplay.textContent = `${formatTime(time)} / ${formatTime(video.duration)}`;
          }
          seekBar.style.backgroundImage = `linear-gradient(to right, #c6a969 ${seekBar.value}%, rgba(255, 255, 255, 0.25) ${seekBar.value}%)`;
        });

        seekBar.addEventListener('change', function() {
          video.currentTime = (seekBar.value / 100) * video.duration;
          isSeeking = false;
        });
      }

      if (fullscreenBtn) {
        fullscreenBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          if (!document.fullscreenElement && !document.webkitFullscreenElement) {
            if (mediaContainer.requestFullscreen) {
              mediaContainer.requestFullscreen();
            } else if (mediaContainer.webkitRequestFullscreen) {
              mediaContainer.webkitRequestFullscreen();
            }
          } else {
            if (document.exitFullscreen) {
              document.exitFullscreen();
            } else if (document.webkitExitFullscreen) {
              document.webkitExitFullscreen();
            }
          }
        });
      }

      video.addEventListener('loadedmetadata', updateSeekBar);
      video.addEventListener('timeupdate', updateSeekBar);
      video.addEventListener('play', () => {
        updatePlayUI(false);
        showControls();
      });
      video.addEventListener('pause', () => {
        updatePlayUI(true);
        showControls();
      });
      video.addEventListener('volumechange', () => updateMuteUI(video.muted));
    });
  </script>
{%- endif -%}

