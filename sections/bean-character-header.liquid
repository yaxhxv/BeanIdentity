{% comment %}
  Dynamic Bean Character Header
  Renders distinct styles and layouts based on the current collection handle.
{% endcomment %}

{%- liquid
  assign current_handle = collection.handle
  
  assign bean_bg_color = '#FFFFFF'
  assign bean_text_color = '#000000'
  assign bean_card_bg_color = '#F5F5F5'

  assign bean_nickname = 'The Bean'
  assign bean_archetype = 'The Unknown'
  assign bean_personality = 'Describe the bean here'
  assign bean_traits = 'Trait 1 • Trait 2 • Trait 3 • Trait 4'
  assign bean_voice = 'Voice'
  assign bean_audience = 'Audience'
  assign bean_font_family = 'inherit'

  case current_handle
    when 'coffee-bean'
      assign bean_bg_color = '#5A3A1B'
      assign bean_text_color = '#F5F5F5'
      assign bean_card_bg_color = '#3B2A1E'
      assign bean_nickname = 'Coffee Bean'
      assign bean_archetype = 'The Intellectual'
      assign bean_personality = 'A calm and collected presence that thrives on depth and knowledge.'
      assign bean_traits = 'Smart • Intellectual • Calm • Mature'
      assign bean_voice = 'Vintage academic feel, thoughtful and grounded.'
      assign bean_audience = 'Thinkers, readers, and those who appreciate quiet confidence.'
      assign bean_font_family = 'Georgia, serif'

    when 'green-bean'
      assign bean_bg_color = '#5BBF3A'
      assign bean_text_color = '#000000'
      assign bean_card_bg_color = '#FFFFFF'
      assign bean_nickname = 'Green Bean'
      assign bean_archetype = 'The Nature Lover'
      assign bean_personality = 'An organic, fresh spirit that keeps things happy and grounded in nature.'
      assign bean_traits = 'Fresh • Happy • Nature-loving • Organic'
      assign bean_voice = 'Bright, sunny, and highly positive.'
      assign bean_audience = 'Outdoor enthusiasts, optimists, and eco-conscious friends.'
      assign bean_font_family = 'Poppins, sans-serif'

    when 'vanilla-bean'
      assign bean_bg_color = '#F3E4C8'
      assign bean_text_color = '#000000'
      assign bean_card_bg_color = '#FFFFFF'
      assign bean_nickname = 'Vanilla Bean'
      assign bean_archetype = 'The Smooth Stylist'
      assign bean_personality = 'A refined, jazzy character who approaches life with effortless cool.'
      assign bean_traits = 'Smooth • Cool • Musical • Stylish'
      assign bean_voice = 'Laid-back, rhythmic, and subtly elegant.'
      assign bean_audience = 'Creatives, music lovers, and trendsetters.'
      assign bean_font_family = '"Caprasimo", serif'

    when 'chilli-bean'
      assign bean_bg_color = '#E63946'
      assign bean_text_color = '#FFFFFF'
      assign bean_card_bg_color = '#9E1B1B'
      assign bean_nickname = 'Chilli Bean'
      assign bean_archetype = 'The Firecracker'
      assign bean_personality = 'Loud, chaotic, and relentlessly spicy. Brings the heat to every situation.'
      assign bean_traits = 'Spicy • Chaotic • Loud • Funny'
      assign bean_voice = 'Exaggerated, high-energy, and completely unfiltered.'
      assign bean_audience = 'Rule-breakers, class clowns, and bold personalities.'
      assign bean_font_family = '"Bangers", cursive'

    when 'jelly-bean'
      assign bean_bg_color = '#2BB3C0'
      assign bean_text_color = '#000000'
      assign bean_card_bg_color = '#FFFFFF'
      assign bean_nickname = 'Jelly Bean'
      assign bean_archetype = 'The Digital Native'
      assign bean_personality = 'A tech-savvy spirit living on the internet. Chill vibes only.'
      assign bean_traits = 'Digital • Chill • Gen Z • Techy'
      assign bean_voice = 'Internet-fluent, glossy, and meme-forward.'
      assign bean_audience = 'Gamers, digital creators, and early adopters.'
      assign bean_font_family = '"Baloo 2", sans-serif'
      
    else
      assign bean_nickname = collection.title
  endcase
-%}

<style>
  .bean-character-wrap {
    background-color: {{ bean_bg_color }};
    color: {{ bean_text_color }};
    padding-bottom: 60px;
    font-family: var(--font-body-family), sans-serif;
  }
  
  .bean-banner-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 80px 20px 40px;
    min-height: 40vh;
  }

  .bean-banner-illustration {
    width: 100%;
    max-width: 300px;
    height: 300px;
    background-color: rgba(255,255,255,0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 30px;
    border: 2px dashed {{ bean_text_color }};
    overflow: hidden;
  }

  .bean-banner-illustration img {
    max-width: 100%;
    object-fit: contain;
  }

  .placeholder-img-text {
    font-size: 1.2rem;
    opacity: 0.7;
  }

  .bean-banner-title {
    font-family: {{ bean_font_family }};
    font-size: clamp(4rem, 8vw, 8rem);
    line-height: 1.1;
    margin: 0;
    text-transform: uppercase;
    font-weight: 800;
  }

  .bean-banner-archetype {
    font-size: 1.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-top: 10px;
    opacity: 0.9;
  }

  /* Introduction Block */
  .bean-intro-block {
    max-width: 800px;
    margin: 0 auto;
    background-color: {{ bean_card_bg_color }};
    color: {% if bean_card_bg_color == '#FFFFFF' %}#000000{% else %}#FFFFFF{% endif %};
    border-radius: 20px;
    padding: 40px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
  }

  @media screen and (min-width: 768px) {
    .bean-intro-block {
      grid-template-columns: 1fr 1fr;
      padding: 60px;
    }
  }

  .bean-intro-section h3 {
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.7;
    margin: 0 0 10px 0;
    color: inherit;
  }

  .bean-intro-section p {
    font-size: 1.6rem;
    line-height: 1.5;
    margin: 0;
    color: inherit;
  }

  .bean-intro-section.full-width {
    grid-column: 1 / -1;
  }
</style>

<div class="bean-character-wrap">
  <!-- Hero Banner -->
  <div class="bean-banner-hero">
    <div class="bean-banner-illustration">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 600 | image_tag: alt: bean_nickname, loading: 'eager' }}
      {%- else -%}
        <span class="placeholder-img-text">Illustration Pending</span>
      {%- endif -%}
    </div>
    <h1 class="bean-banner-title">{{ bean_nickname }}</h1>
    <div class="bean-banner-archetype">{{ bean_archetype }}</div>
  </div>

  <!-- Introduction Block -->
  <div class="page-width">
    <div class="bean-intro-block">
      <div class="bean-intro-section full-width">
        <h3>Personality</h3>
        <p>{{ bean_personality }}</p>
      </div>

      <div class="bean-intro-section">
        <h3>Key Traits</h3>
        <p>{{ bean_traits }}</p>
      </div>

      <div class="bean-intro-section">
        <h3>Voice & Tone</h3>
        <p>{{ bean_voice }}</p>
      </div>

      <div class="bean-intro-section full-width">
        <h3>Audience Match</h3>
        <p>{{ bean_audience }}</p>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bean Character Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Character Illustration",
      "info": "Upload the transparent PNG character illustration here (it will override the placeholder)."
    }
  ],
  "presets": [
    {
      "name": "Bean Character Header"
    }
  ]
}
{% endschema %}
