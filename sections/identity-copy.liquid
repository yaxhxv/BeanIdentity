{% comment %}
  SECTION: IDENTITY COPY (High Impact)
  - Bold, centered typography for brand messaging.
  - Scroll-reveal animation for dynamic feel.
{% endcomment %}

{%- style -%}
  #IdentityCopy-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(180deg, #ede7e3 0%, #f5f5f5 100%);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    text-align: {{ section.settings.alignment }};
    border-radius: 4.2rem 4.2rem 5.6rem 5rem / 2.8rem 2.8rem 4rem 3.6rem;
    box-shadow: 0 2.4rem 5rem rgba(43, 43, 43, 0.08);
    margin: 0 1.6rem;
  }

  .identity-copy__bean-gif {
    position: absolute;
    bottom: -6rem;
    right: -4rem;
    width: clamp(280px, 34vw, 460px);
    height: auto;
    border-radius: 40% 60% 55% 45% / 50% 45% 55% 50%;
    mix-blend-mode: multiply;
    opacity: 0.82;
    pointer-events: none;
    z-index: 0;
  }

  @media screen and (max-width: 749px) {
    .identity-copy__bean-gif {
      width: clamp(180px, 52vw, 280px);
      bottom: -3rem;
      right: -2rem;
    }
  }

  #IdentityCopy-{{ section.id }}::before {
    content: "";
    position: absolute;
    top: 2.4rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: 'Poppins', sans-serif;
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.28em;
    color: #c6a969;
    white-space: nowrap;
  }

  .identity-copy__headline .headline-line {
    display: block;
    line-height: 0.95;
    margin-bottom: 0.2rem;
  }
  .identity-copy__headline .headline-line:last-child {
    margin-bottom: 0;
  }
  .identity-copy__text {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(1.8rem, 2.4vw, 2.4rem);
    line-height: 1.4;
    color: rgba(0,0,0,0.88);
    margin: 0;
    text-wrap: balance;
  }

  #IdentityCopy-{{ section.id }}::after {
    content: "";
    position: absolute;
    top: 4rem;
    left: clamp(1.6rem, 5vw, 5rem);
    width: clamp(8rem, 16vw, 14rem);
    height: clamp(8rem, 16vw, 14rem);
    border-radius: 58% 42% 52% 48% / 42% 56% 44% 58%;
    background: radial-gradient(circle at 30% 30%, rgba(198,169,105,0.22), rgba(198,169,105,0.02) 70%);
    filter: blur(1px);
    opacity: 0.9;
  }


  .identity-copy__wrapper {
    max-width: min({{ section.settings.content_width }}px, calc(100vw - 4rem));
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 1;
  }


  .identity-copy__headline {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: {{ section.settings.headline_size_desktop }}rem;
    font-weight: 900;
    line-height: 0.9;
    color: #0b0b0b;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    position: relative;
    transform: translateY(0);
    word-break: keep-all;
    overflow-wrap: break-word;

    /* Reveal Animation States */
    opacity: 1;
    transition: opacity 0.8s ease-out, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .identity-copy__subline {
    margin: 3rem 0 0 0;
    font-family: 'Poppins', sans-serif;
    font-size: {{ section.settings.subline_size_desktop }}rem;
    color: #2b2b2b;
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.8s ease-out 0.2s, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s;
    line-height: 1.6;
    max-width: 70rem;
    display: inline-block;
  }

  .identity-copy__subline::after {
    content: "";
    display: block;
    width: 12rem;
    max-width: 100%;
    height: 2px;
    margin: 1.6rem auto 0;
    background: linear-gradient(90deg, rgba(198,169,105,0.18), rgba(198,169,105,0.85), rgba(198,169,105,0.18));
    transform: none;
  }

  /* Active/Visible state when scrolled into view */
  #IdentityCopy-{{ section.id }}.is-visible .identity-copy__subline {
    opacity: 1;
    transform: translateY(0);
  }

  #IdentityCopy-{{ section.id }}.is-visible .identity-copy__headline {
    opacity: 1;
    transform: translateY(0);
  }


  @media screen and (max-width: 749px) {
    #IdentityCopy-{{ section.id }} {
      margin: 0 1rem;
      border-radius: 2.6rem 2.6rem 3.6rem 3.2rem / 2rem 2rem 2.8rem 2.4rem;
    }
    .identity-copy__wrapper {
      max-width: min(100%, 34rem);
      padding: 0 2.2rem;
    }
    .identity-copy__headline {
      font-size: {{ section.settings.headline_size_mobile }}rem;
      line-height: 1.1;
      max-width: 24rem;
      margin-inline: auto;
      position: relative;
      z-index: 2;
    }
    .identity-copy__subline {
      font-size: {{ section.settings.subline_size_mobile }}rem;
      max-width: 27rem;
      margin: 2rem auto 0;
      position: relative;
      z-index: 2;
    }
    #IdentityCopy-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | divided_by: 1.5 }}px;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 1.5 }}px;
    }
    .identity-copy__bean-gif--top {
      top: 1.8rem !important;
      left: -8rem !important;
      width: clamp(88px, 24vw, 124px) !important;
      opacity: 0.14 !important;
    }
    .identity-copy__bean-gif:not(.identity-copy__bean-gif--top) {
      right: -4.8rem !important;
      bottom: -3.6rem !important;
      width: clamp(150px, 40vw, 210px) !important;
      opacity: 0.34 !important;
    }
  }
{%- endstyle -%}

<div
  id="IdentityCopy-{{ section.id }}"
  class="identity-copy-section scroll-trigger{% if section.settings.bg_color == '#EDE7E3' or section.settings.bg_color == '#ede7e3' %} texture-grain{% endif %}"
>
  <img
    src="{{ 'VanillaDoodle1.png' | file_url }}"
    alt=""
    aria-hidden="true"
    class="identity-copy__bean-gif identity-copy__bean-gif--top"
    loading="lazy"
    style="top: 2rem; left: -2rem; right: auto; bottom: auto; transform: rotate(-15deg) scale(0.9); opacity: 0.75; mix-blend-mode: multiply; width: clamp(180px, 22vw, 300px); border-radius: 48% 52% 44% 56% / 52% 44% 56% 48%;"
  >
  <div class="identity-copy__wrapper">
    {%- if section.settings.headline != blank -%}
      <h2 class="identity-copy__headline">
        {{ section.settings.headline | escape | newline_to_br }}
      </h2>
    {%- endif -%}
    {%- if section.settings.subline != blank -%}
      <p class="identity-copy__subline">{{ section.settings.subline }}</p>
    {%- endif -%}
  </div>
  <img
    src="{{ 'GreenDoodle1.png' | file_url }}"
    alt=""
    aria-hidden="true"
    class="identity-copy__bean-gif"
    loading="lazy"
    style="bottom: -5rem; right: -3rem; width: clamp(200px, 26vw, 380px); opacity: 0.75; mix-blend-mode: multiply; transform: rotate(8deg); border-radius: 58% 42% 46% 54% / 54% 48% 52% 46%;"
  >
</div>

<script>
  (function () {
    const sectionId = 'IdentityCopy-{{ section.id }}';
    const section = document.getElementById(sectionId);

    if (!section) return;

    const observerOptions = {
      root: null,
      threshold: 0.2, // Trigger when 20% of section is visible
      rootMargin: '0px',
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          section.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    observer.observe(section);
  })();
</script>

{% schema %}
{
  "name": "Identity Copy Section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Headline",
      "default": "Express Every Bean of Your Personality."
    },
    {
      "type": "textarea",
      "id": "subline",
      "label": "Subline",
      "default": "India's first personality-driven apparel brand. Find the archetype that speaks your language and wear your identity with pride."
    },
    {
      "type": "header",
      "content": "Aesthetics"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F5F5F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 600,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "label": "Content Max Width",
      "default": 1000
    },
    {
      "type": "header",
      "content": "Typography Settings"
    },
    {
      "type": "range",
      "id": "headline_size_desktop",
      "min": 2,
      "max": 10,
      "step": 0.5,
      "unit": "rem",
      "label": "Headline Size (Desktop)",
      "default": 6
    },
    {
      "type": "range",
      "id": "headline_size_mobile",
      "min": 2,
      "max": 6,
      "step": 0.5,
      "unit": "rem",
      "label": "Headline Size (Mobile)",
      "default": 3.5
    },
    {
      "type": "range",
      "id": "subline_size_desktop",
      "min": 1,
      "max": 3,
      "step": 0.1,
      "unit": "rem",
      "label": "Subline Size (Desktop)",
      "default": 1.8
    },
    {
      "type": "range",
      "id": "subline_size_mobile",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "unit": "rem",
      "label": "Subline Size (Mobile)",
      "default": 1.6
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 40,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 40,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 120
    }
  ],
  "presets": [
    {
      "name": "Identity Copy Section"
    }
  ]
}
{% endschema %}
