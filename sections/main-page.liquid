{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign video_src = ''
  if section.settings.video != blank
    for source in section.settings.video.sources
      if source.format == 'mp4'
        assign video_src = source.url
        break
      endif
    endfor
    if video_src == blank
      assign video_src = section.settings.video.sources[0].url
    endif
  elsif section.settings.video_url != blank
    assign video_src = section.settings.video_url
  elsif section.settings.video_filename != blank
    if section.settings.video_filename contains '.'
      assign video_src = section.settings.video_filename | file_url
    else
      assign video_src = section.settings.video_filename | append: '.mp4' | file_url
    endif
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Grid and Column Layouts */
  .our-story-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
    max-width: 120rem;
    margin: 0 auto;
  }

  @media screen and (min-width: 990px) {
    .our-story-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 6rem;
    }
  }

  .our-story-video-col {
    width: 100%;
    position: relative;
    border-radius: 3.2rem;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.35);
    padding: 1.6rem;
    box-shadow: 0 2rem 5rem rgba(43,43,43,0.08);
    --video-padding: 1.6rem;
  }

  .our-story-video-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
    overflow: hidden;
    border-radius: 2rem;
    border: 1px solid rgba(11,11,11,0.08);
    background: #000;
  }

  .our-story-video-element {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .our-story-content-col {
    width: 100%;
  }

  .our-story-content {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(1.5rem, 1.6vw, 1.7rem);
    line-height: 1.75;
    color: rgba(var(--color-foreground), 0.75);
    max-width: 100% !important;
    margin: 0 !important;
    text-align: left;
  }

  .our-story-content p {
    margin-bottom: 2.2rem;
    opacity: 0;
    transform: translateY(2rem);
    animation: storyFadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .our-story-content p:nth-child(1) { animation-delay: 0.1s; }
  .our-story-content p:nth-child(2) { animation-delay: 0.3s; }
  .our-story-content p:nth-child(3) { animation-delay: 0.5s; }
  .our-story-content p:nth-child(4) { animation-delay: 0.7s; }
  .our-story-content .story-signoff { animation-delay: 0.9s; }

  @keyframes storyFadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .our-story-content .story-highlight {
    font-size: clamp(1.7rem, 1.9vw, 1.95rem);
    font-weight: 700;
    color: #c6a969;
    margin-top: 3.6rem;
    letter-spacing: 0.02em;
  }

  .our-story-content .story-signoff {
    margin-top: 4rem;
    border-top: 1px solid rgba(var(--color-foreground), 0.08);
    padding-top: 2rem;
    font-family: var(--font-heading-family);
    opacity: 0;
    transform: translateY(2rem);
    animation: storyFadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .our-story-content .story-signoff strong {
    font-size: 1.8rem;
    color: rgb(var(--color-foreground));
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .our-story-content .story-signoff span {
    font-size: 1.4rem;
    color: #c6a969;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* Player Controls Styling */
  .iwt-video-controls-container {
    position: absolute;
    bottom: var(--video-padding);
    left: var(--video-padding);
    width: calc(100% - (var(--video-padding) * 2));
    z-index: 5;
    padding: 1.2rem;
    box-sizing: border-box;
    pointer-events: none;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .our-story-video-col:hover .iwt-video-controls-container,
  .our-story-video-col.show-controls .iwt-video-controls-container {
    opacity: 1;
    transform: translateY(0);
  }

  .iwt-video-controls-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.8rem 1.2rem;
    border-radius: 1.2rem;
    background: rgba(18, 18, 18, 0.65);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    pointer-events: auto;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .iwt-ctrl-btn {
    width: 3.6rem !important;
    height: 3.6rem !important;
    padding: 0.8rem !important;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    background: rgba(255, 255, 255, 0.1) !important;
    color: #ffffff !important;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    flex-shrink: 0;
    box-shadow: none !important;
  }

  .iwt-ctrl-btn svg {
    width: 1.8rem !important;
    height: 1.8rem !important;
    display: block;
  }

  .iwt-ctrl-btn:hover {
    background: #ffffff !important;
    color: #000000 !important;
    border-color: #ffffff !important;
    transform: scale(1.08);
  }

  .iwt-time-display {
    font-family: 'Poppins', sans-serif;
    font-size: 1.1rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
    min-width: 7.5rem;
    text-align: center;
    user-select: none;
    flex-shrink: 0;
    letter-spacing: 0.05em;
  }

  .iwt-seek-bar-container {
    flex-grow: 1;
    display: flex;
    align-items: center;
    position: relative;
  }

  .iwt-seek-bar {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 4px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.25);
    cursor: pointer;
    outline: none;
    margin: 0;
    transition: height 0.2s ease;
    background-image: linear-gradient(to right, #c6a969 0%, rgba(255, 255, 255, 0.25) 0%);
    background-repeat: no-repeat;
  }

  .iwt-seek-bar-container:hover .iwt-seek-bar {
    height: 6px;
  }

  .iwt-seek-bar::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    height: 12px;
    width: 12px;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
    transition: transform 0.15s ease, background-color 0.15s ease;
  }

  .iwt-seek-bar-container:hover .iwt-seek-bar::-webkit-slider-thumb {
    transform: scale(1.25);
    background: #c6a969;
  }

  .iwt-seek-bar::-moz-range-thumb {
    height: 12px;
    width: 12px;
    border: none;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
    transition: transform 0.15s ease, background-color 0.15s ease;
  }

  .iwt-seek-bar-container:hover .iwt-seek-bar::-moz-range-thumb {
    transform: scale(1.25);
    background: #c6a969;
  }

  /* Fullscreen styling overrides for container and layout */
  .our-story-video-col:fullscreen {
    width: 100vw !important;
    height: 100vh !important;
    max-width: none !important;
    max-height: none !important;
    padding: 0 !important;
    margin: 0 !important;
    border-radius: 0 !important;
    border: none !important;
    background: #000000 !important;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .our-story-video-col:fullscreen .our-story-video-wrapper {
    width: 100% !important;
    height: 100% !important;
    padding-bottom: 0 !important;
    border-radius: 0 !important;
    border: none !important;
  }

  .our-story-video-col:fullscreen .iwt-video-controls-container {
    bottom: 2rem !important;
    left: 2rem !important;
    width: calc(100% - 4rem) !important;
  }

  /* Safari Fullscreen fallback styling */
  .our-story-video-col:-webkit-full-screen {
    width: 100vw !important;
    height: 100vh !important;
    max-width: none !important;
    max-height: none !important;
    padding: 0 !important;
    margin: 0 !important;
    border-radius: 0 !important;
    border: none !important;
    background: #000000 !important;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .our-story-video-col:-webkit-full-screen .our-story-video-wrapper {
    width: 100% !important;
    height: 100% !important;
    padding-bottom: 0 !important;
    border-radius: 0 !important;
    border: none !important;
  }

  .our-story-video-col:-webkit-full-screen .iwt-video-controls-container {
    bottom: 2rem !important;
    left: 2rem !important;
    width: calc(100% - 4rem) !important;
  }
{%- endstyle -%}

<div class="page-width {% unless page.handle == 'contact' or page.handle == 'about-us' %}page-width--narrow{% endunless %} section-{{ section.id }}-padding">
  <h1 class="main-page-title page-title h0{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}" style="{% if page.handle == 'contact' or page.handle == 'about-us' %}text-align: center; margin-bottom: 4rem; font-weight: 900; text-transform: uppercase;{% endif %}">
    {%- if page.handle == 'contact' or page.handle == 'about-us' -%}
      Our Story
    {%- else -%}
      {{ page.title | escape }}
    {%- endif -%}
  </h1>
  <div class="rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    {%- if page.handle == 'contact' or page.handle == 'about-us' -%}
      <div class="our-story-grid">
        <div class="our-story-video-col">
          <div class="our-story-video-wrapper">
            {%- if video_src != blank -%}
              <video
                id="Video-{{ section.id }}"
                autoplay
                loop
                muted
                playsinline
                class="our-story-video-element"
                aria-label="Bean Identity Brand Video"
              >
                <source src="{{ video_src }}" type="video/mp4">
                Your browser does not support the video tag.
              </video>
              
              {%- if section.settings.show_controls -%}
                <div class="iwt-video-controls-container">
                  <div class="iwt-video-controls-bar">
                    <button id="PlayBtn-{{ section.id }}" class="iwt-ctrl-btn" aria-label="Pause Video" type="button">
                      <svg id="PauseIcon-{{ section.id }}" class="icon-pause" viewBox="0 0 24 24"><path fill="currentColor" d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
                      <svg id="PlayIcon-{{ section.id }}" class="icon-play" viewBox="0 0 24 24" style="display: none; transform: translateX(1px);"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
                    </button>
                    
                    <span id="TimeDisplay-{{ section.id }}" class="iwt-time-display">0:00 / 0:00</span>
                    
                    <div class="iwt-seek-bar-container">
                      <input id="SeekBar-{{ section.id }}" class="iwt-seek-bar" type="range" min="0" max="100" value="0" step="0.1" aria-label="Seek video">
                    </div>
                    
                    <button id="MuteBtn-{{ section.id }}" class="iwt-ctrl-btn" aria-label="Unmute Video" type="button">
                      <svg id="MutedIcon-{{ section.id }}" class="icon-muted" viewBox="0 0 24 24"><path fill="currentColor" d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.03c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73 4.27 3zM12 4L9.91 6.09 12 8.18V4z"/></svg>
                      <svg id="UnmutedIcon-{{ section.id }}" class="icon-unmuted" viewBox="0 0 24 24" style="display: none;"><path fill="currentColor" d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>
                    </button>
                    
                    <button id="FullscreenBtn-{{ section.id }}" class="iwt-ctrl-btn" aria-label="Toggle Fullscreen" type="button">
                      <svg class="icon-fullscreen" viewBox="0 0 24 24"><path fill="currentColor" d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>
                    </button>
                  </div>
                </div>
              {%- endif -%}
            {%- endif -%}
          </div>
        </div>
        
        <div class="our-story-content-col">
          <div class="our-story-content">
            <p>
              Bean Identity was built on the belief that identity is deeply personal, but belonging should feel natural. In
              a world that constantly asks people to fit in or explain themselves, we wanted to create a space that feels
              more honest - a space where individuality is celebrated, connection feels effortless, and people can simply
              exist as they are.
            </p>
            <p>
              For us, this brand has always been about more than clothing. It’s about recognition. The quiet comfort of
              finding people who understand your energy, your choices, and your way of moving through the world, even
              without words.
            </p>
            <p>
              Every piece, every bean, and every story is rooted in self-expression, authenticity, and community. Whether
              you’re confidently owning who you are or still discovering parts of yourself along the way, Bean Identity is a
              reminder that there’s no one right way to belong.
            </p>
            <p class="story-highlight">And we’re glad you’re here.</p>
            <div class="story-signoff">
              <strong>Founders</strong><br>
              <span>Bean Identity</span>
            </div>
          </div>
        </div>
      </div>
      
      {%- if section.settings.show_controls and video_src != blank -%}
        <script>
          document.addEventListener('DOMContentLoaded', function() {
            const sectionId = "{{ section.id }}";
            const video = document.getElementById(`Video-${sectionId}`);
            const playBtn = document.getElementById(`PlayBtn-${sectionId}`);
            const muteBtn = document.getElementById(`MuteBtn-${sectionId}`);
            const seekBar = document.getElementById(`SeekBar-${sectionId}`);
            const timeDisplay = document.getElementById(`TimeDisplay-${sectionId}`);
            const fullscreenBtn = document.getElementById(`FullscreenBtn-${sectionId}`);
            
            const pauseIcon = document.getElementById(`PauseIcon-${sectionId}`);
            const playIcon = document.getElementById(`PlayIcon-${sectionId}`);
            const mutedIcon = document.getElementById(`MutedIcon-${sectionId}`);
            const unmutedIcon = document.getElementById(`UnmutedIcon-${sectionId}`);

            if (!video) return;

            const mediaContainer = video.parentElement.parentElement; // our-story-video-col
            let hideTimeout = null;
            let isSeeking = false;

            function updatePlayUI(isPaused) {
              if (!playBtn) return;
              if (isPaused) {
                pauseIcon.style.display = 'none';
                playIcon.style.display = 'block';
              } else {
                pauseIcon.style.display = 'block';
                playIcon.style.display = 'none';
              }
            }

            function updateMuteUI(isMuted) {
              if (!muteBtn) return;
              if (isMuted) {
                mutedIcon.style.display = 'block';
                unmutedIcon.style.display = 'none';
              } else {
                mutedIcon.style.display = 'none';
                unmutedIcon.style.display = 'block';
              }
            }

            function formatTime(seconds) {
              if (isNaN(seconds) || !isFinite(seconds)) return '0:00';
              const mins = Math.floor(seconds / 60);
              const secs = Math.floor(seconds % 60);
              return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
            }

            function updateSeekBar() {
              if (!video.duration || isSeeking) return;
              const percentage = (video.currentTime / video.duration) * 100;
              if (seekBar) {
                seekBar.value = percentage;
                seekBar.style.backgroundImage = `linear-gradient(to right, #c6a969 ${percentage}%, rgba(255, 255, 255, 0.25) ${percentage}%)`;
              }
              if (timeDisplay) {
                timeDisplay.textContent = `${formatTime(video.currentTime)} / ${formatTime(video.duration)}`;
              }
            }

            function showControls() {
              mediaContainer.classList.add('show-controls');
              mediaContainer.style.cursor = 'default';
              
              if (hideTimeout) clearTimeout(hideTimeout);
              
              if (!video.paused) {
                hideTimeout = setTimeout(() => {
                  mediaContainer.classList.remove('show-controls');
                  if (document.fullscreenElement || document.webkitFullscreenElement) {
                    mediaContainer.style.cursor = 'none';
                  }
                }, 3000);
              }
            }

            // Initialize UI
            updateMuteUI(video.muted);
            if (video.duration) {
              updateSeekBar();
            }

            // Hover / show-hide behavior
            mediaContainer.addEventListener('mousemove', showControls);
            mediaContainer.addEventListener('mouseenter', showControls);
            
            mediaContainer.addEventListener('click', function(e) {
              if (!e.target.closest('.iwt-video-controls-container')) {
                if (mediaContainer.classList.contains('show-controls')) {
                  mediaContainer.classList.remove('show-controls');
                  if (hideTimeout) clearTimeout(hideTimeout);
                } else {
                  showControls();
                }
              }
            });

            // Desktop direct click play/pause
            video.addEventListener('click', function(e) {
              if (window.matchMedia("(pointer: coarse)").matches) {
                return; // Let container click show/hide controls on mobile
              }
              e.stopPropagation();
              if (video.paused) {
                video.play().catch(err => console.log(err));
              } else {
                video.pause();
              }
            });

            if (playBtn) {
              playBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                if (video.paused) {
                  video.play().then(() => updatePlayUI(false)).catch(err => console.log(err));
                } else {
                  video.pause();
                  updatePlayUI(true);
                }
              });
            }

            if (muteBtn) {
              muteBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                video.muted = !video.muted;
                updateMuteUI(video.muted);
              });
            }

            if (seekBar) {
              seekBar.addEventListener('input', function() {
                isSeeking = true;
                const time = (seekBar.value / 100) * video.duration;
                if (timeDisplay) {
                  timeDisplay.textContent = `${formatTime(time)} / ${formatTime(video.duration)}`;
                }
                seekBar.style.backgroundImage = `linear-gradient(to right, #c6a969 ${seekBar.value}%, rgba(255, 255, 255, 0.25) ${seekBar.value}%)`;
              });

              seekBar.addEventListener('change', function() {
                video.currentTime = (seekBar.value / 100) * video.duration;
                isSeeking = false;
              });
            }

            if (fullscreenBtn) {
              fullscreenBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                if (!document.fullscreenElement && !document.webkitFullscreenElement) {
                  if (mediaContainer.requestFullscreen) {
                    mediaContainer.requestFullscreen();
                  } else if (mediaContainer.webkitRequestFullscreen) {
                    mediaContainer.webkitRequestFullscreen();
                  }
                } else {
                  if (document.exitFullscreen) {
                    document.exitFullscreen();
                  } else if (document.webkitExitFullscreen) {
                    document.webkitExitFullscreen();
                  }
                }
              });
            }

            video.addEventListener('loadedmetadata', updateSeekBar);
            video.addEventListener('timeupdate', updateSeekBar);
            video.addEventListener('play', () => {
              updatePlayUI(false);
              showControls();
            });
            video.addEventListener('pause', () => {
              updatePlayUI(true);
              showControls();
            });
            video.addEventListener('volumechange', () => updateMuteUI(video.muted));
          });
        </script>
      {%- endif -%}
    {%- else -%}
      {{ page.content }}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "header",
      "content": "Our Story Video Settings"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Our Story Video (Alternative to file)"
    },
    {
      "type": "text",
      "id": "video_filename",
      "label": "Video Filename (Alternative, e.g. BeanIdentityMovie)",
      "default": "BeanIdentityMovie"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Direct Video URL"
    },
    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "Show Video Controls",
      "default": true
    }
  ]
}
{% endschema %}
