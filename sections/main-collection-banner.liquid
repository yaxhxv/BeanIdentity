{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  @media screen and (max-width: 749px) {
    .collection-hero--with-image .collection-hero__inner {
      padding-bottom: calc({{settings.media_shadow_vertical_offset | at_least: 0}}px + 2rem);
    }
  }
{%- endstyle -%}

{%- if collection.handle contains 'bean' -%}
  {%- liquid
    assign active_block = null
    for block in section.blocks
      if block.type == 'hero_slide'
        assign target_handle = block.settings.bean_type | append: '-bean'
        if target_handle == collection.handle
          assign active_block = block
          break
        endif
      endif
    endfor
  -%}

  {%- if active_block != null -%}
    {%- liquid
      assign bean_filename = ''
      assign bean_gif = ''
      assign bean_surface = '#F4ECE4'
      assign bean_surface_alt = '#E7D8CB'
      assign bean_accent_soft = '#8B5E3C'
      assign bean_accent_deep = '#5A3A1B'
      assign bean_copy = '#3B2A1E'
      assign bean_glow = 'rgba(90, 58, 27, 0.18)'
      assign bean_border = 'rgba(90, 58, 27, 0.14)'
      case active_block.settings.bean_type
        when 'vanilla'
          assign bean_filename = 'vanilla_bean_hero.png'
          assign bean_gif = 'vanilla_bean_gif.gif'
          assign bean_surface = '#FBF5EA'
          assign bean_surface_alt = '#F3E4C8'
          assign bean_accent = '#E5D3B3'
          assign bean_accent_soft = '#C89E56'
          assign bean_accent_deep = '#B6782F'
          assign bean_copy = '#7A5325'
          assign bean_glow = 'rgba(229, 211, 179, 0.42)'
          assign bean_border = 'rgba(182, 120, 47, 0.14)'
          assign bean_font = '"Caprasimo", serif'
        when 'green'
          assign bean_filename = 'green_bean_hero.png'
          assign bean_gif = 'green_bean_gif.gif'
          assign bean_surface = '#EEF7E8'
          assign bean_surface_alt = '#DDF0D3'
          assign bean_accent = '#5BBF3A'
          assign bean_accent_soft = '#71CF52'
          assign bean_accent_deep = '#2F7D32'
          assign bean_copy = '#244F28'
          assign bean_glow = 'rgba(91, 191, 58, 0.16)'
          assign bean_border = 'rgba(47, 125, 50, 0.14)'
          assign bean_font = '"Poppins", sans-serif'
        when 'coffee'
          assign bean_filename = 'coffee_bean_hero.png'
          assign bean_gif = 'coffee_bean_gif.gif'
          assign bean_surface = '#F4ECE4'
          assign bean_surface_alt = '#E7D8CB'
          assign bean_accent = '#8B5E3C'
          assign bean_accent_soft = '#A67C52'
          assign bean_accent_deep = '#5A3A1B'
          assign bean_copy = '#3B2A1E'
          assign bean_glow = 'rgba(90, 58, 27, 0.18)'
          assign bean_border = 'rgba(90, 58, 27, 0.14)'
          assign bean_font = '"Playfair Display", serif'
        when 'jelly'
          assign bean_filename = 'jelly_bean_hero.png'
          assign bean_gif = 'jelly_bean_gif.gif'
          assign bean_surface = '#EAF8FA'
          assign bean_surface_alt = '#D4F0F4'
          assign bean_accent = '#2BB3C0'
          assign bean_accent_soft = '#47C8D4'
          assign bean_accent_deep = '#15808A'
          assign bean_copy = '#1B5660'
          assign bean_glow = 'rgba(43, 179, 192, 0.16)'
          assign bean_border = 'rgba(21, 128, 138, 0.14)'
          assign bean_font = '"Baloo 2", cursive'
        when 'chilli'
          assign bean_filename = 'ChilliBeanHero2.png'
          assign bean_gif = 'chilli_bean_gif.gif'
          assign bean_surface = '#FDECEF'
          assign bean_surface_alt = '#F8D7DC'
          assign bean_accent = '#E63946'
          assign bean_accent_soft = '#F15C66'
          assign bean_accent_deep = '#9E1B1B'
          assign bean_copy = '#761A1E'
          assign bean_glow = 'rgba(230, 57, 70, 0.16)'
          assign bean_border = 'rgba(158, 27, 27, 0.14)'
          assign bean_font = '"Bangers", system-ui'
          assign bean_letter_spacing = '0.2em'
      endcase

      assign bg_image_url = bean_filename | file_url
      assign bean_gif_url = bean_gif | file_url
    -%}
    {%- style -%}
      #shopify-section-{{ section.id }} {
        --bean-page-bg: {{ bean_surface }};
        --bean-page-bg-alt: {{ bean_surface_alt }};
        --bean-accent: {{ bean_accent }};
        --bean-accent-soft: {{ bean_accent_soft }};
        --bean-accent-deep: {{ bean_accent_deep }};
        --bean-copy: {{ bean_copy }};
        --bean-glow: {{ bean_glow }};
        --bean-border: {{ bean_border }};
      }
      #shopify-section-{{ section.id }},
      #shopify-section-{{ section.id }} ~ .shopify-section {
        position: relative;
        background:
          radial-gradient(circle at top right, var(--bean-glow) 0, transparent 28rem),
          linear-gradient(180deg, var(--bean-page-bg-alt) 0%, var(--bean-page-bg) 42%, var(--bean-page-bg) 100%);
      }
      #shopify-section-{{ section.id }} ~ .shopify-section .gradient {
        background: transparent;
      }
      .bean-collection-hero-{{ section.id }} {
        position: relative;
        width: min(148rem, calc(100vw - 3.2rem));
        min-height: min(82rem, calc(100vh - 8rem));
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        gap: clamp(2rem, 3vw, 4rem);
        overflow: hidden;
        margin: 1.6rem auto 0;
        padding: clamp(2rem, 4vw, 4.6rem);
        border: 1px solid var(--bean-border);
        border-radius: 3.2rem;
        background:
          linear-gradient(135deg, rgba(255,255,255,0.88), rgba(255,255,255,0.54)),
          linear-gradient(180deg, var(--bean-page-bg-alt), var(--bean-page-bg));
        color: var(--bean-copy);
        box-shadow: 0 2.2rem 6rem rgba(20,20,20,0.08);
        isolation: isolate;
      }
      @media screen and (min-width: 1200px) {
        .bean-collection-hero-{{ section.id }} {
           grid-template-columns: minmax(0, 1.1fr) minmax(30rem, 0.9fr);
           padding: clamp(2.4rem, 4vw, 5.6rem);
           gap: clamp(2.4rem, 4vw, 6rem);
        }
      }
      .bean-collection-hero-{{ section.id }}::before,
      .bean-collection-hero-{{ section.id }}::after {
        content: '';
        position: absolute;
        border-radius: 999px;
        pointer-events: none;
        z-index: 0;
      }
      .bean-collection-hero-{{ section.id }}::before {
        width: 34rem;
        height: 34rem;
        top: -10rem;
        right: -8rem;
        background: radial-gradient(circle, var(--bean-glow) 0%, transparent 72%);
      }
      .bean-collection-hero-{{ section.id }}::after {
        width: 24rem;
        height: 24rem;
        left: -4rem;
        bottom: -8rem;
        background: radial-gradient(circle, rgba(255,255,255,0.58) 0%, transparent 72%);
      }
      .bean-collection-hero-{{ section.id }} .hero-bg-container,
      .bean-collection-hero-{{ section.id }} .hero-content,
      .bean-collection-hero-{{ section.id }} .hero-visual {
        position: relative;
        z-index: 1;
      }
      .bean-collection-hero-{{ section.id }} .hero-bg-container {
        overflow: hidden;
        border-radius: 2.8rem;
        border: 1px solid var(--bean-border);
        background: rgba(255,255,255,0.38);
        min-height: 48rem;
      }
      .bean-collection-hero-{{ section.id }} .hero-bg-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
        filter: none;
      }
      .bean-collection-hero-{{ section.id }} .hero-content {
        position: relative;
        z-index: 2;
        width: min(68rem, 100%);
        padding: 0;
        text-align: left;
        display: grid;
        gap: 1.8rem;
      }
      .bean-collection-hero-{{ section.id }} .hero-visual {
        position: relative;
        z-index: 2;
        display: grid;
        place-items: center;
      }
      .bean-collection-hero-{{ section.id }} .hero-visual-shell {
        position: relative;
        display: grid;
        place-items: center;
        width: min(100%, 44rem);
        aspect-ratio: 1 / 1;
        border-radius: 3rem;
        overflow: hidden;
        border: 1px solid var(--bean-border);
        background:
          radial-gradient(circle at 50% 45%, rgba(255,255,255,0.82) 0%, rgba(255,255,255,0.32) 42%, transparent 72%),
          linear-gradient(180deg, rgba(255,255,255,0.42), rgba(255,255,255,0.14));
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.45);
      }
      .bean-collection-hero-{{ section.id }} .hero-visual-shell::before {
        content: '';
        position: absolute;
        inset: 12% 14%;
        border-radius: 50%;
        background: radial-gradient(circle, var(--bean-glow) 0%, transparent 72%);
        filter: blur(14px);
      }
      .bean-collection-hero-{{ section.id }} .hero-gif {
        position: relative;
        z-index: 1;
        width: min(100%, 33rem);
        height: auto;
        display: block;
        filter: drop-shadow(0 2rem 3rem rgba(0,0,0,0.12));
      }
      .bean-collection-hero-{{ section.id }} .hero-kicker {
        font-family: 'Poppins', sans-serif;
        font-size: 1.2rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--bean-accent-deep);
        margin: 0;
        display: inline-flex;
        align-items: center;
        gap: 1.2rem;
      }
      .bean-collection-hero-{{ section.id }} .hero-kicker::before {
        content: '';
        width: 4rem;
        height: 1px;
        background: currentColor;
        opacity: 0.7;
      }
      .bean-collection-hero-{{ section.id }} .hero-title {
        font-family: {{ bean_font | default: 'var(--font-heading-family)' }};
        font-size: clamp(4.8rem, 10vw, 10.4rem);
        font-weight: 800;
        line-height: 0.9;
        letter-spacing: {{ bean_letter_spacing | default: '-0.06em' }};
        margin: 0;
        text-transform: uppercase;
        color: var(--bean-accent-deep);
        position: relative;
        display: inline-block;
        z-index: 1;
        text-wrap: balance;
      }
      .bean-collection-hero-{{ section.id }} .hero-title::before {
        content: '';
        position: absolute;
        inset: -10rem -15rem;
        background: radial-gradient(circle at center, var(--bean-glow) 0%, transparent 70%);
        filter: blur(26px);
        z-index: -1;
        pointer-events: none;
      }
      .bean-collection-hero-{{ section.id }} .hero-subtitle {
        font-family: 'Poppins', sans-serif;
        font-size: clamp(1.75rem, 2.1vw, 2.3rem);
        line-height: 1.5;
        margin: 0;
        color: var(--bean-copy);
        max-width: 52rem;
      }
      .bean-collection-hero-{{ section.id }} .hero-subtitle p {
        margin: 0;
      }
      .bean-collection-hero-{{ section.id }} .hero-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 5rem;
        width: fit-content;
        padding: 1.4rem 2.6rem;
        border-radius: 999px;
        background: var(--bean-accent-deep);
        color: #ffffff;
        font-family: 'Poppins', sans-serif;
        font-size: 1.2rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        text-decoration: none;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        box-shadow: 0 1.2rem 3rem var(--bean-glow);
      }
      .bean-collection-hero-{{ section.id }} .hero-btn:hover {
        color: #ffffff;
        transform: translateY(-0.2rem);
      }
      @media screen and (max-width: 749px) {
        .bean-collection-hero-{{ section.id }} {
          width: calc(100vw - 2.4rem);
          min-height: auto;
          grid-template-columns: 1fr;
          gap: 2rem;
          margin-top: 1.2rem;
          padding: 2.2rem 1.8rem 2.4rem;
          border-radius: 2.4rem;
        }
        .bean-collection-hero-{{ section.id }} .hero-content {
          text-align: center;
          justify-items: center;
        }
        .bean-collection-hero-{{ section.id }} .hero-kicker::before {
          display: none;
        }
        .bean-collection-hero-{{ section.id }} .hero-title {
          font-size: clamp(4rem, 15vw, 6rem);
        }
        .bean-collection-hero-{{ section.id }} .hero-bg-container {
          min-height: 26rem;
          order: 3;
        }
        .bean-collection-hero-{{ section.id }} .hero-visual-shell {
          width: min(100%, 30rem);
          border-radius: 2.4rem;
        }
        .bean-collection-hero-{{ section.id }} .hero-gif {
          width: min(100%, 22rem);
        }
      }
    {%- endstyle -%}

    <div class="bean-collection-hero-{{ section.id }}">
      <div class="hero-content">
        {%- if active_block.settings.kicker != blank -%}
          <span class="hero-kicker">{{ active_block.settings.kicker }}</span>
        {%- endif -%}
        <h1 class="hero-title">{{ active_block.settings.title | default: collection.title }}</h1>
        {%- if active_block.settings.subtitle != blank -%}
          <div class="hero-subtitle">{{ active_block.settings.subtitle }}</div>
        {%- endif -%}
        {%- if active_block.settings.button_label != blank -%}
          <a href="{{ active_block.settings.button_link | default: '#product-grid' }}" class="hero-btn">
            {{ active_block.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
      <div class="hero-visual">
        <div class="hero-visual-shell">
          <img src="{{ bean_gif_url }}" alt="{{ active_block.settings.title }}" class="hero-gif" loading="eager">
        </div>
      </div>
      <div class="hero-bg-container">
        <img src="{{ bg_image_url }}" alt="{{ active_block.settings.title }}" class="hero-bg-img" loading="eager">
      </div>
    </div>
  {%- else -%}
    {% comment %} Fallback to legacy snippet if no block is configured for this bean {% endcomment %}
    {% render 'bean-header-content',
      bean_image: section.settings.bean_image,
      image_alignment: section.settings.bean_image_alignment
    %}
  {%- endif -%}
{%- else -%}
  <div class="collection-hero{% if section.settings.show_collection_image and collection.image %} collection-hero--with-image{% endif %} color-{{ section.settings.color_scheme }} gradient">
    <div class="collection-hero__inner page-width {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      <div class="collection-hero__text-wrapper">
        <h1 class="collection-hero__title">
          <span class="visually-hidden">{{ 'sections.collection_template.title' | t }}: </span>
          {{- collection.title | escape -}}
        </h1>

        {%- if section.settings.show_collection_description -%}
          <div class="collection-hero__description rte">{{ collection.description }}</div>
        {%- endif -%}
      </div>

      {%- if section.settings.show_collection_image and collection.image -%}
        <div class="collection-hero__image-container media gradient">
          <img
            srcset="
              {%- if collection.image.width >= 165 -%}{{ collection.image | image_url: width: 165 }} 165w,{%- endif -%}
              {%- if collection.image.width >= 360 -%}{{ collection.image | image_url: width: 360 }} 360w,{%- endif -%}
              {%- if collection.image.width >= 535 -%}{{ collection.image | image_url: width: 535 }} 535w,{%- endif -%}
              {%- if collection.image.width >= 750 -%}{{ collection.image | image_url: width: 750 }} 750w,{%- endif -%}
              {%- if collection.image.width >= 1070 -%}{{ collection.image | image_url: width: 1070 }} 1070w,{%- endif -%}
              {%- if collection.image.width >= 1500 -%}{{ collection.image | image_url: width: 1500 }} 1500w,{%- endif -%}
              {{ collection.image | image_url }} {{ collection.image.width }}w
            "
            src="{{ collection.image | image_url: width: 750 }}"
            sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc(50vw - 130px), calc(50vw - 55px)"
            alt="{{ collection.image.alt | escape }}"
            width="{{ collection.image.width }}"
            height="{{ collection.image.height }}"
          >
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": false,
      "label": "t:sections.main-collection-banner.settings.show_collection_image.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Bean Specific Layout (Fallback)"
    },
    {
      "type": "image_picker",
      "id": "bean_image",
      "label": "Bean Illustration / Image"
    },
    {
      "type": "select",
      "id": "bean_image_alignment",
      "label": "Image Alignment (Desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    }
  ],
  "blocks": [
    {
      "type": "hero_slide",
      "name": "Cinematic Bean Hero",
      "settings": [
        {
          "type": "select",
          "id": "bean_type",
          "label": "Bean Identity",
          "options": [
            { "value": "vanilla", "label": "Vanilla Bean" },
            { "value": "green", "label": "Green Bean" },
            { "value": "coffee", "label": "Coffee Bean" },
            { "value": "jelly", "label": "Jelly Bean" },
            { "value": "chilli", "label": "Chilli Bean" }
          ],
          "default": "vanilla"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "Kicker (Eyebrow)",
          "default": "Character Profile"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading Override",
          "info": "Leave blank to use Collection Title."
        },
        {
          "type": "richtext",
          "id": "subtitle",
          "label": "Subheading",
          "default": "<p>Experience the identity that moves with your rhythm.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Shop the Collection"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ]
}
{% endschema %}
