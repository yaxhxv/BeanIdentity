{% comment %}
  SECTION: FINAL CTA LOOP
  - Positioned before the footer.
  - Loops users back into the core funnel (Quiz or Shop).
{% endcomment %}

{%- style -%}
  #FinalCTA-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 0%, rgba(198,169,105,0.16), transparent 28%),
      #0b0b0b;
    padding: clamp(9rem, 12vw, 16rem) 0;
    text-align: center;
    border-top: 1px solid rgba(245,245,245,0.08);
  }


  #FinalCTA-{{ section.id }}::before {
    content: "BEAN IDENTITY";
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-heading-family);
    font-size: clamp(8rem, 18vw, 24rem);
    font-weight: 900;
    line-height: 0.8;
    color: rgba(245,245,245,0.035);
    white-space: nowrap;
  }

  .final-cta__wrapper {
    max-width: 90rem;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 1;
    isolation: isolate;
  }

  .final-cta__headline {
    font-family: var(--font-heading-family);
    font-size: clamp(4.4rem, 9vw, 10rem);
    font-weight: 900;
    line-height: 0.86;
    color: #f5f5f5;
    margin: 0 0 2rem 0;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .final-cta__headline span {
    position: relative;
    display: inline-block;
  }

  .final-cta__subline {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(1.55rem, 1.5vw, 2rem);
    color: rgba(245,245,245,0.72);
    margin: 0 0 5rem 0;
    line-height: 1.6;
  }

  .final-cta__buttons {
    display: flex;
    gap: 2rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .final-cta__button {
    display: inline-block;
    min-width: 22rem;
    padding: 2rem 5rem;
    font-size: 1.25rem;
    font-weight: 900;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-radius: 0;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .final-cta__button--primary {
    background: #c6a969;
    color: #0b0b0b;
    border: 1px solid #c6a969;
  }

  .final-cta__button--secondary {
    background: transparent;
    color: #f5f5f5;
    border: 1px solid rgba(245,245,245,0.72);
  }

  .final-cta__button:hover {
    transform: translateY(-0.3rem) scale(1.02);
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
  }

  .final-cta__button::after {
    content: "";
    position: absolute;
    left: 2.2rem;
    right: 2.2rem;
    bottom: 1.2rem;
    height: 2px;
    background: currentColor;
    transform: scaleX(0.14);
    transform-origin: left center;
    opacity: 0.35;
    transition: transform 0.28s ease, opacity 0.28s ease;
  }

  .final-cta__button:hover::after {
    transform: scaleX(1);
    opacity: 0.8;
  }


  @media screen and (max-width: 749px) {
    #FinalCTA-{{ section.id }} {
      padding: 8rem 0;
    }
    .final-cta__button {
      width: 100%;
    }
  }

  .final-cta__bean-gif {
    position: absolute;
    right: -3rem;
    top: 50%;
    transform: translateY(-50%);
    width: clamp(240px, 26vw, 360px);
    height: auto;
    border-radius: 46% 54% 52% 48% / 54% 46% 54% 46%;
    mix-blend-mode: screen;
    opacity: 0.4;
    pointer-events: none;
    z-index: 0;
  }

  @media screen and (max-width: 749px) {
    .final-cta__bean-gif {
      width: clamp(120px, 36vw, 180px);
      right: -1.5rem;
      opacity: 0.3;
    }
  }
{%- endstyle -%}

<div id="FinalCTA-{{ section.id }}" class="final-cta-section">
  <img
    src="{{ 'chilli_bean_gif.gif' | file_url }}"
    alt=""
    aria-hidden="true"
    class="final-cta__bean-gif"
    loading="lazy"
  >
  <div class="final-cta__wrapper">
    {%- if section.settings.headline != blank -%}
      <h2 class="final-cta__headline">{{ section.settings.headline }}</h2>
    {%- endif -%}
    {%- if section.settings.subline != blank -%}
      <p class="final-cta__subline">{{ section.settings.subline }}</p>
    {%- endif -%}

    <div class="final-cta__buttons">
      <a href="/pages/which-bean-are-you" class="final-cta__button final-cta__button--primary"> Find Your Bean </a>
      <a href="/collections/all" class="final-cta__button final-cta__button--secondary"> Explore Beans </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Final CTA Loop",
  "settings": [
    {
      "type": "textarea",
      "id": "headline",
      "label": "Headline",
      "default": "Still haven't found your soul-bean?"
    },
    {
      "type": "textarea",
      "id": "subline",
      "label": "Subline",
      "default": "Take the identity quiz again or browse the universe of all five beans."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#2B2B2B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#F5F5F5"
    },
    {
      "type": "color",
      "id": "primary_btn_bg",
      "label": "Primary Button Background",
      "default": "#C6A969"
    },
    {
      "type": "color",
      "id": "primary_btn_text",
      "label": "Primary Button Text",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Final CTA Loop"
    }
  ]
}
{% endschema %}
