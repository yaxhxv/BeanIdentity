      "settings": {
        "custom_liquid": "<style>\n  /* Container Styling */\n  .custom-lifestyle-banner {\n    position: relative;\n    width: 100%;\n    overflow: hidden;\n    /* We remove min-height so the image dictates the exact size */\n  }\n\n  /* Background Image (Now dictates the section height) */\n  .custom-lifestyle-banner img {\n    display: block;\n    width: 100%;\n    height: auto; /* Adapts to image aspect ratio perfectly */\n    z-index: 1;\n  }\n\n  /* Dark Overlay */\n  .custom-lifestyle-banner .overlay {\n    position: absolute;\n    inset: 0; /* Shorthand for top:0, right:0, bottom:0, left:0 */\n    background-color: rgba(0, 0, 0, 0.4);\n    z-index: 2;\n  }\n\n  /* Content Wrapper (Centered over the image) */\n  .custom-lifestyle-content {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n    z-index: 3;\n    text-align: center;\n    width: 100%;\n    padding: 20px;\n  }\n\n  /* Heading Styling */\n  .custom-lifestyle-heading {\n    color: #ffffff;\n    font-size: 28px; /* Slightly smaller for mobile to fit inside the image */\n    font-weight: 400; \n    margin: 0 0 16px 0;\n    line-height: 1.2;\n    font-family: inherit;\n  }\n\n  /* Button Styling */\n  .custom-lifestyle-btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    height: 44px;\n    padding: 0 24px;\n    font-size: 14px;\n    letter-spacing: 0.025em;\n    color: #ffffff;\n    background-color: transparent;\n    border: 1px solid #ffffff;\n    text-decoration: none;\n    transition: background-color 0.3s ease, color 0.3s ease;\n    cursor: pointer;\n  }\n\n  /* Button Hover State */\n  .custom-lifestyle-btn:hover {\n    background-color: #ffffff;\n    color: #000000;\n  }\n\n  /* Responsive Typography for Desktop */\n  @media (min-width: 768px) {\n    .custom-lifestyle-heading {\n      font-size: 48px;\n      margin-bottom: 24px;\n    }\n    .custom-lifestyle-btn {\n      height: 56px;\n      padding: 0 40px;\n      font-size: 16px;\n    }\n  }\n\n  @media (min-width: 1024px) {\n    .custom-lifestyle-heading {\n      font-size: 60px;\n    }\n  }\n</style>\n\n<div class=\"custom-lifestyle-banner\">\n  <img \n    src=\"https://cdn.shopify.com/s/files/1/0960/2691/9283/files/download_1.webp?v=1771297337\" \n    alt=\"Friends in Bean Identity tees during golden hour\" \n    loading=\"lazy\"\n  >\n  \n  <div class=\"overlay\"></div>\n  \n  <div class=\"custom-lifestyle-content\">\n    <h2 class=\"custom-lifestyle-heading\">Wear what feels real.</h2>\n    \n    <a href=\"/collections/all\" class=\"custom-lifestyle-btn\">\n      Explore More Beans\n    </a>\n  </div>\n</div>",
