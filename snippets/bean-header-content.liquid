{%- liquid
  if collection
    assign current_handle = collection.handle
    assign current_title = collection.title
  elsif product
    assign current_handle = product.collections.first.handle
    assign current_title = product.collections.first.title
  endif

  assign bean_font = '"Space Grotesk", sans-serif'
  assign bean_accent = '#A67C52'
  assign bean_accent_deep = '#5A3A1B'
  assign bean_surface = '#F4ECE4'
  assign bean_surface_alt = '#E7D8CB'
  assign bean_glow = 'rgba(90, 58, 27, 0.16)'
  assign bean_border = 'rgba(90, 58, 27, 0.14)'
  assign bean_text = '#3B2A1E'
  assign bean_title_fill = '#6F4722'
  assign bean_kicker = 'Bean Identity'
  assign bean_tagline = 'A personality in motion.'
  assign bean_pov = 'An easy, considered mood with enough personality to feel unmistakably yours.'
  assign bean_gif_asset = 'coffee_bean_gif.gif'

  case current_handle
    when 'coffee-bean'
      assign bean_font = '"Playfair Display", serif'
      assign bean_accent = '#8B5E3C'
      assign bean_accent_deep = '#5A3A1B'
      assign bean_surface = '#F4ECE4'
      assign bean_surface_alt = '#E7D8CB'
      assign bean_glow = 'rgba(90, 58, 27, 0.18)'
      assign bean_border = 'rgba(90, 58, 27, 0.14)'
      assign bean_text = '#3B2A1E'
      assign bean_title_fill = '#6F4722'
      assign bean_tagline = 'The intellectual. Quietly sharp.'
      assign bean_pov = 'Warm roasted neutrals, thoughtful contrast, and a softer editorial atmosphere.'
      assign bean_gif_asset = 'coffee_bean_gif.gif'
    when 'green-bean'
      assign bean_font = '"Poppins", sans-serif'
      assign bean_accent = '#5BBF3A'
      assign bean_accent_deep = '#2F7D32'
      assign bean_surface = '#EEF7E8'
      assign bean_surface_alt = '#DDF0D3'
      assign bean_glow = 'rgba(91, 191, 58, 0.16)'
      assign bean_border = 'rgba(47, 125, 50, 0.14)'
      assign bean_text = '#244F28'
      assign bean_title_fill = '#4AA531'
      assign bean_tagline = 'The nature lover. Fresh without trying.'
      assign bean_pov = 'Crisp leaf greens and airy neutrals that keep the page bright and calm.'
      assign bean_gif_asset = 'green_bean_gif.gif'
    when 'vanilla-bean'
      assign bean_font = '"Caprasimo", serif'
      assign bean_accent = '#E5D3B3'
      assign bean_accent_deep = '#B6782F'
      assign bean_surface = '#FBF5EA'
      assign bean_surface_alt = '#F3E4C8'
      assign bean_glow = 'rgba(229, 211, 179, 0.42)'
      assign bean_border = 'rgba(182, 120, 47, 0.14)'
      assign bean_text = '#7A5325'
      assign bean_title_fill = '#B6782F'
      assign bean_tagline = 'The smooth stylist. Softly magnetic.'
      assign bean_pov = 'Cream silk tones and warm beige layering for a mellow, polished feel.'
      assign bean_gif_asset = 'vanilla_bean_gif.gif'
    when 'chilli-bean'
      assign bean_font = '"Bangers", system-ui'
      assign bean_accent = '#E63946'
      assign bean_accent_deep = '#9E1B1B'
      assign bean_surface = '#FDECEF'
      assign bean_surface_alt = '#F8D7DC'
      assign bean_glow = 'rgba(230, 57, 70, 0.16)'
      assign bean_border = 'rgba(158, 27, 27, 0.14)'
      assign bean_text = '#761A1E'
      assign bean_title_fill = '#E63946'
      assign bean_tagline = 'The firecracker. Bold on contact.'
      assign bean_letter_spacing = '0.2em'
      assign bean_pov = 'Soft reds and a touch of warmth keep the energy present without making the page harsh.'
      assign bean_gif_asset = 'chilli_bean_gif.gif'
    when 'jelly-bean'
      assign bean_font = '"Baloo 2", cursive'
      assign bean_accent = '#2BB3C0'
      assign bean_accent_deep = '#15808A'
      assign bean_surface = '#EAF8FA'
      assign bean_surface_alt = '#D4F0F4'
      assign bean_glow = 'rgba(43, 179, 192, 0.16)'
      assign bean_border = 'rgba(21, 128, 138, 0.14)'
      assign bean_text = '#1B5660'
      assign bean_title_fill = '#1F9FAD'
      assign bean_tagline = 'The digital native. Playful with edge.'
      assign bean_pov = 'Candy cyan softened with cloudy pastels so the page feels lively, not loud.'
      assign bean_gif_asset = 'jelly_bean_gif.gif'
  endcase

  assign bean_gif_url = bean_gif_asset | file_url
  assign button_label = 'Explore the bean'
  if product
    assign button_label = 'View the details'
  endif
-%}

<style>
  #shopify-section-{{ section.id }} {
    --bean-page-bg: {{ bean_surface }};
    --bean-page-bg-alt: {{ bean_surface_alt }};
    --bean-accent: {{ bean_accent }};
    --bean-accent-deep: {{ bean_accent_deep }};
    --bean-copy: {{ bean_text }};
    --bean-border: {{ bean_border }};
    --bean-glow: {{ bean_glow }};
    --bean-heading-font-local: {{ bean_font }};
    --bean-letter-spacing: {{ bean_letter_spacing | default: 'normal' }};
  }

  #shopify-section-{{ section.id }},
  #shopify-section-{{ section.id }} ~ .shopify-section {
    position: relative;
    background:
      radial-gradient(circle at top right, var(--bean-glow) 0, transparent 28rem),
      linear-gradient(180deg, var(--bean-page-bg-alt) 0%, var(--bean-page-bg) 46%, var(--bean-page-bg) 100%);
  }

  #shopify-section-{{ section.id }} ~ .shopify-section .gradient {
    background: transparent;
  }

  #shopify-section-{{ section.id }} ~ .shopify-section::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0)),
      radial-gradient(circle at left top, rgba(255, 255, 255, 0.26), transparent 30rem);
    opacity: 0.85;
  }

  .bean-landing {
    position: relative;
    overflow: hidden;
    padding: clamp(2rem, 3vw, 3rem);
    color: var(--bean-copy);
  }

  .bean-landing__shell {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(28rem, 0.9fr);
    align-items: center;
    gap: clamp(2.4rem, 4vw, 6rem);
    min-height: min(84rem, calc(100vh - 6rem));
    padding: clamp(3rem, 5vw, 6rem);
    border: 1px solid var(--bean-border);
    border-radius: 3.2rem;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.88), rgba(255, 255, 255, 0.56)),
      linear-gradient(180deg, var(--bean-page-bg-alt), var(--bean-page-bg));
    box-shadow: 0 2.4rem 6rem rgba(20, 20, 20, 0.08);
    isolation: isolate;
  }

  .bean-landing__shell::before,
  .bean-landing__shell::after {
    content: '';
    position: absolute;
    border-radius: 999px;
    pointer-events: none;
    z-index: 0;
  }

  .bean-landing__shell::before {
    width: 32rem;
    height: 32rem;
    top: -10rem;
    right: -7rem;
    background: radial-gradient(circle, var(--bean-glow) 0%, transparent 72%);
  }

  .bean-landing__shell::after {
    width: 22rem;
    height: 22rem;
    bottom: -8rem;
    left: -5rem;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.58) 0%, transparent 72%);
  }

  .bean-landing__content,
  .bean-landing__visual {
    position: relative;
    z-index: 1;
  }

  .bean-landing__content {
    display: grid;
    gap: 1.8rem;
    align-content: center;
    max-width: 64rem;
  }

  .bean-landing__kicker {
    display: inline-flex;
    align-items: center;
    gap: 1.2rem;
    margin: 0;
    color: var(--bean-accent-deep);
    font-family: 'Poppins', sans-serif;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .bean-landing__kicker::before {
    content: '';
    width: 4rem;
    height: 1px;
    background: currentColor;
    opacity: 0.7;
  }

  .bean-landing__title {
    margin: 0;
    color: var(--bean-title-fill, var(--bean-accent-deep));
    font-family: var(--bean-heading-font-local);
    letter-spacing: var(--bean-letter-spacing, -0.06em);
    font-size: clamp(4.8rem, 10vw, 10.8rem);
    font-weight: 800;
    line-height: 0.9;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .bean-landing__tagline {
    margin: 0;
    color: var(--bean-copy);
    font-family: 'Poppins', sans-serif;
    font-size: clamp(1.9rem, 2.3vw, 2.8rem);
    font-weight: 600;
    line-height: 1.3;
  }

  .bean-landing__copy {
    margin: 0;
    max-width: 52rem;
    color: rgba(0, 0, 0, 0.66);
    font-size: 1.55rem;
    line-height: 1.7;
  }

  .bean-landing__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .bean-landing__pill {
    display: inline-flex;
    align-items: center;
    min-height: 3.8rem;
    padding: 0.9rem 1.5rem;
    border: 1px solid var(--bean-border);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.55);
    color: var(--bean-accent-deep);
    font-family: 'Poppins', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .bean-landing__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-top: 0.8rem;
  }

  .bean-landing__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 5rem;
    padding: 1.4rem 2.6rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: var(--bean-accent-deep);
    color: #ffffff;
    font-family: 'Poppins', sans-serif;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
    transition: transform 0.3s ease, box-shadow 0.3s ease, background-color 0.3s ease, color 0.3s ease;
  }

  .bean-landing__button:hover,
  .bean-landing__button:focus-visible {
    transform: translateY(-0.2rem);
    box-shadow: 0 1.2rem 3rem var(--bean-glow);
  }

  .bean-landing__button--ghost {
    border-color: var(--bean-border);
    background: rgba(255, 255, 255, 0.45);
    color: var(--bean-accent-deep);
  }

  .bean-landing__visual {
    display: grid;
    place-items: center;
  }

  .bean-landing__visual-shell {
    position: relative;
    display: grid;
    place-items: center;
    width: min(100%, 44rem);
    aspect-ratio: 1 / 1;
    border-radius: 3rem;
    background:
      radial-gradient(circle at 50% 45%, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.42) 40%, transparent 72%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.58), rgba(255, 255, 255, 0.18));
    border: 1px solid var(--bean-border);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.45);
    overflow: hidden;
  }

  .bean-landing__visual-shell::before {
    content: '';
    position: absolute;
    inset: 12% 14%;
    border-radius: 50%;
    background: radial-gradient(circle, var(--bean-glow) 0%, transparent 72%);
    filter: blur(10px);
  }

  .bean-landing__gif {
    position: relative;
    z-index: 1;
    width: min(100%, 34rem);
    height: auto;
    display: block;
    filter: drop-shadow(0 2rem 3rem rgba(0, 0, 0, 0.12));
  }

  #bean-page-flow {
    position: absolute;
    bottom: 0;
    left: 0;
  }

  {% if product %}
    #shopify-section-{{ section.id }} ~ .shopify-section product-info {
      display: block;
      background: transparent;
      color: var(--bean-copy);
    }

    #shopify-section-{{ section.id }} ~ .shopify-section product-info .page-width,
    #shopify-section-{{ section.id }} ~ .shopify-section .related-products .page-width {
      position: relative;
      z-index: 1;
    }

    #shopify-section-{{ section.id }} ~ .shopify-section .product__info-container {
      padding: clamp(2.2rem, 3vw, 3rem);
      border: 1px solid var(--bean-border);
      border-radius: 2.8rem;
      background: rgba(255, 255, 255, 0.62);
      box-shadow: 0 1.4rem 4rem rgba(20, 20, 20, 0.06);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }

    #shopify-section-{{ section.id }} ~ .shopify-section .product__media-wrapper .global-media-settings,
    #shopify-section-{{ section.id }} ~ .shopify-section .thumbnail,
    #shopify-section-{{ section.id }} ~ .shopify-section .card-wrapper {
      background: rgba(255, 255, 255, 0.52);
      border-radius: 2.4rem;
    }

    #shopify-section-{{ section.id }} ~ .shopify-section .product__title h2,
    #shopify-section-{{ section.id }} ~ .shopify-section .related-products__heading,
    #shopify-section-{{ section.id }} ~ .shopify-section .accordion__title {
      color: var(--bean-accent-deep);
    }

    #shopify-section-{{ section.id }} ~ .shopify-section .price,
    #shopify-section-{{ section.id }} ~ .shopify-section .product__text,
    #shopify-section-{{ section.id }} ~ .shopify-section .product__tax,
    #shopify-section-{{ section.id }} ~ .shopify-section .accordion__content,
    #shopify-section-{{ section.id }} ~ .shopify-section .card-information {
      color: var(--bean-copy);
    }

    #shopify-section-{{ section.id }} ~ .shopify-section .product-form__submit,
    #shopify-section-{{ section.id }} ~ .shopify-section .shopify-payment-button__button--unbranded,
    #shopify-section-{{ section.id }} ~ .shopify-section .button {
      background: var(--bean-accent-deep);
      color: #ffffff;
    }

    #shopify-section-{{ section.id }} ~ .shopify-section .quantity,
    #shopify-section-{{ section.id }} ~ .shopify-section .select__select,
    #shopify-section-{{ section.id }} ~ .shopify-section .product-form__input input {
      background: rgba(255, 255, 255, 0.72);
    }
  {% endif %}

  @media screen and (max-width: 989px) {
    .bean-landing__shell {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .bean-landing__content {
      margin-inline: auto;
      justify-items: center;
    }

    .bean-landing__kicker::before {
      display: none;
    }

    .bean-landing__pills,
    .bean-landing__actions {
      justify-content: center;
    }
  }

  @media screen and (max-width: 749px) {
    .bean-landing {
      padding: 1.2rem;
    }

    .bean-landing__shell {
      min-height: auto;
      padding: 2.4rem 2rem 2.8rem;
      border-radius: 2.4rem;
    }

    .bean-landing__title {
      font-size: clamp(4.2rem, 16vw, 6.4rem);
    }

    .bean-landing__copy {
      font-size: 1.45rem;
    }

    .bean-landing__visual-shell {
      width: min(100%, 32rem);
      border-radius: 2.4rem;
    }

    .bean-landing__gif {
      width: min(100%, 24rem);
    }

    {% if product %}
      #shopify-section-{{ section.id }} ~ .shopify-section .product__info-container {
        padding: 2rem 1.8rem;
        border-radius: 2.2rem;
      }
    {% endif %}
  }
</style>

<section class="bean-landing">
  <div class="bean-landing__shell">
    <div class="bean-landing__content">
      <p class="bean-landing__kicker">{{ bean_kicker }}</p>
      <h1 class="bean-landing__title" style="--bean-title-fill: {{ bean_title_fill }};">{{ current_title }}</h1>
      <p class="bean-landing__tagline">{{ bean_tagline }}</p>
      <p class="bean-landing__copy">{{ bean_pov }}</p>

      <div class="bean-landing__pills" aria-label="Bean palette notes">
        <span class="bean-landing__pill">{{ bean_accent_deep }}</span>
        <span class="bean-landing__pill">{{ bean_accent }}</span>
        <span class="bean-landing__pill">{{ bean_surface_alt }}</span>
      </div>

      <div class="bean-landing__actions">
        <a href="#bean-page-flow" class="bean-landing__button">{{ button_label }}</a>
        <a href="/pages/which-bean-are-you" class="bean-landing__button bean-landing__button--ghost">Find your bean</a>
      </div>
    </div>

    <div class="bean-landing__visual">
      <div class="bean-landing__visual-shell">
        <img
          src="{{ bean_gif_url }}"
          alt="{{ current_title | escape }}"
          class="bean-landing__gif"
          loading="eager"
        >
      </div>
    </div>
  </div>

  <span id="bean-page-flow" aria-hidden="true"></span>
</section>
