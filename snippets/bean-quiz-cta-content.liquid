{%- liquid
  if collection
    assign current_handle = collection.handle
  elsif product
    assign current_handle = product.collections.first.handle
  endif

  assign show_quiz = false
  if current_handle contains 'bean'
    assign show_quiz = true
  endif

  assign bean_accent = '#000000'
  case current_handle
    when 'coffee-bean'
      assign bean_accent = '#4E342E'
    when 'green-bean'
      assign bean_accent = '#388E3C'
    when 'vanilla-bean'
      assign bean_accent = '#D4AF37'
    when 'chilli-bean'
      assign bean_accent = '#D32F2F'
    when 'jelly-bean'
      assign bean_accent = '#00BCD4'
  endcase
-%}

{%- if show_quiz -%}
  <style>
    .bean-quiz-cta {
      background-color: #EDE7E3;
      color: #2B2B2B;
      padding: 120px 20px;
      text-align: center;
      font-family: 'Poppins', sans-serif;
      border-top: 1px solid #E0E0E0;
    }
    .bean-quiz-cta__content {
      max-width: 900px;
      margin: 0 auto;
    }
    .bean-quiz-cta__title {
      font-size: clamp(3.2rem, 6vw, 5.6rem);
      font-weight: 800;
      text-transform: uppercase;
      line-height: 1.1;
      margin-bottom: 25px;
      color: #000000;
      letter-spacing: -0.02em;
    }
    .bean-quiz-cta__text {
      font-size: 1.8rem;
      line-height: 1.6;
      color: #555555;
      margin-bottom: 45px;
    }
    .bean-quiz-cta__button {
      display: inline-block;
      background-color: #000000;
      color: #FFFFFF;
      padding: 20px 50px;
      text-decoration: none;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      transition: all 0.3s ease;
      font-size: 1.4rem;
    }
    .bean-quiz-cta__button:hover {
      background-color: {{ bean_accent }};
      transform: translateY(-2px);
      box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }
  </style>

  <div class="bean-quiz-cta">
    <div class="bean-quiz-cta__content">
      <h2 class="bean-quiz-cta__title">Not sure if this<br>is your Bean?</h2>
      <p class="bean-quiz-cta__text">Take our 2-minute identity quiz and find the bean that matches your personality perfectly.</p>
      <a href="/pages/quiz" class="bean-quiz-cta__button">Take the Quiz</a>
    </div>
  </div>
{%- endif -%}
