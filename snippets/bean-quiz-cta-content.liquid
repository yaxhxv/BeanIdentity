{%- liquid
  if collection
    assign current_handle = collection.handle
  elsif product
    assign current_handle = product.collections.first.handle
  endif

  assign show_quiz = false
  if current_handle contains 'bean'
    assign show_quiz = true
  endif

  assign bean_accent = '#c6a969'
  assign bean_title = 'Your next identity shift starts here.'
  assign bean_text = 'Not every drop belongs to every mood. Take the quiz and land on the bean that actually fits your energy.'

  case current_handle
    when 'coffee-bean'
      assign bean_accent = '#4E342E'
      assign bean_title = 'Still comparing your moods?'
      assign bean_text = 'Coffee Bean might fit today, but the full identity system will tell you where your sharpest match lives.'
    when 'green-bean'
      assign bean_accent = '#388E3C'
      assign bean_title = 'Need something lighter?'
      assign bean_text = 'Take the quiz if you want the bean that matches your pace, mindset, and the version of you showing up today.'
    when 'vanilla-bean'
      assign bean_accent = '#D4AF37'
      assign bean_title = 'Want the full read on your style?'
      assign bean_text = 'The quiz maps you to the bean that feels most natural, polished, and true to your energy.'
    when 'chilli-bean'
      assign bean_accent = '#D32F2F'
      assign bean_title = 'Too much heat or not enough?'
      assign bean_text = 'Run the identity quiz and find out whether Chilli Bean is really your lane or just today''s mood.'
    when 'jelly-bean'
      assign bean_accent = '#00BCD4'
      assign bean_title = 'Still deciding what fits your signal?'
      assign bean_text = 'Take the quiz and match with the bean that tracks your tone, tempo, and personality best.'
  endcase
-%}

{%- if show_quiz -%}
  <style>
    .bean-quiz-cta {
      position: relative;
      overflow: hidden;
      background:
        radial-gradient(circle at 14% 22%, color-mix(in srgb, {{ bean_accent }} 26%, transparent), transparent 34%),
        linear-gradient(180deg, #111111 0%, #080808 100%);
      color: #f5f5f5;
      padding: clamp(7rem, 10vw, 11rem) 2rem;
      border-top: 1px solid rgba(245,245,245,0.08);
    }

    .bean-quiz-cta__content {
      position: relative;
      z-index: 1;
      width: min(104rem, calc(100% - 8rem));
      margin: 0 auto;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 3rem;
      align-items: end;
    }

    .bean-quiz-cta__copy {
      max-width: 72rem;
    }

    .bean-quiz-cta__eyebrow {
      margin: 0 0 1.6rem;
      font-family: 'Poppins', sans-serif;
      font-size: 1.05rem;
      font-weight: 800;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: {{ bean_accent }};
    }

    .bean-quiz-cta__title {
      margin: 0 0 1.6rem;
      font-family: var(--font-heading-family);
      font-size: clamp(4.4rem, 7vw, 8rem);
      font-weight: 900;
      text-transform: uppercase;
      line-height: 0.92;
      color: #f5f5f5;
      letter-spacing: 0;
      text-wrap: balance;
    }

    .bean-quiz-cta__text {
      margin: 0;
      max-width: 58rem;
      font-family: 'Poppins', sans-serif;
      font-size: 1.75rem;
      line-height: 1.6;
      color: rgba(245,245,245,0.72);
    }

    .bean-quiz-cta__button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 5.6rem;
      padding: 0 3rem;
      border: 1px solid {{ bean_accent }};
      background: {{ bean_accent }};
      color: #0b0b0b;
      text-decoration: none;
      font-family: 'Poppins', sans-serif;
      font-size: 1.15rem;
      font-weight: 900;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      transition: transform 0.28s ease, background 0.28s ease, border-color 0.28s ease, color 0.28s ease;
    }

    .bean-quiz-cta__button:hover {
      background: #f5f5f5;
      border-color: #f5f5f5;
      color: #0b0b0b;
      transform: translateY(-0.2rem);
    }

    @media screen and (max-width: 989px) {
      .bean-quiz-cta__content {
        width: min(104rem, calc(100% - 6rem));
        grid-template-columns: 1fr;
        align-items: start;
      }
    }

    @media screen and (max-width: 749px) {
      .bean-quiz-cta {
        padding-top: 5.6rem;
        padding-bottom: 5.6rem;
        padding-inline: 0;
      }

      .bean-quiz-cta__content {
        width: calc(100% - 3.2rem);
      }

      .bean-quiz-cta__title {
        font-size: clamp(3.8rem, 15vw, 5.6rem);
      }

      .bean-quiz-cta__text {
        font-size: 1.55rem;
      }

      .bean-quiz-cta__button {
        width: 100%;
      }
    }

    @media screen and (max-width: 479px) {
      .bean-quiz-cta__content {
        width: calc(100% - 2.4rem);
      }
    }
  </style>

  <div class="bean-quiz-cta">
    <div class="bean-quiz-cta__content">
      <div class="bean-quiz-cta__copy">
        <p class="bean-quiz-cta__eyebrow">Find your bean</p>
        <h2 class="bean-quiz-cta__title">{{ bean_title }}</h2>
        <p class="bean-quiz-cta__text">{{ bean_text }}</p>
      </div>
      <a href="/pages/which-bean-are-you" class="bean-quiz-cta__button">Take the quiz</a>
    </div>
  </div>
{%- endif -%}
