{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name
  assign og_image_url = blank

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  if canonical_url contains 'result='
    assign shared_result = canonical_url | split: 'result=' | last | split: '&' | first | strip
    case shared_result
      when 'green'
        assign og_title = "Turns out I'm a Green Bean"
        assign og_description = 'The calm in the chaos, and always at peace'
        assign og_image_name = 'bean-green-1.png'
      when 'coffee'
        assign og_title = "Turns out I'm a Coffee Bean"
        assign og_description = 'Thoughtful. Intentional. Always looking deeper'
        assign og_image_name = 'bean-chilli-2.png'
      when 'chilli'
        assign og_title = "Turns out I'm a Chilli Bean"
        assign og_description = 'Bold. Independent. Unafraid to stand out.'
        assign og_image_name = 'bean-coffee-2.png'
      when 'vanilla'
        assign og_title = "Turns out I'm a Vanilla Bean"
        assign og_description = 'Curious. Free-spirited. Open to new adventures'
        assign og_image_name = 'bean-vanilla-1.png'
      when 'jelly'
        assign og_title = "Turns out, I'm a Jelly Bean"
        assign og_description = 'Expressive. Vibrant. Impossible to ignore'
        assign og_image_name = 'bean-jelly-2.png'
      when 'green_coffee'
        assign og_title = "Turns out, I'm a Green + Coffee Blend"
        assign og_description = 'Calm on the outside. Thoughtful on the inside.'
        assign og_image_name = 'bean-green-1.png'
      when 'green_vanilla'
        assign og_title = "Turns out, I'm a Green + Vanilla Blend"
        assign og_description = 'Grounded enough to stay centred. Curious enough to keep exploring.'
        assign og_image_name = 'bean-green-1.png'
      when 'green_jelly'
        assign og_title = "Turns out, I'm a Green + Jelly Blend"
        assign og_description = 'Warm-hearted, easy-going, and full of life.'
        assign og_image_name = 'bean-green-1.png'
      when 'green_chilli'
        assign og_title = "Turns out, I'm a Green + Chilli Blend"
        assign og_description = 'Calm by choice. Strong by nature'
        assign og_image_name = 'bean-green-1.png'
      when 'coffee_vanilla'
        assign og_title = "Turns out, I'm a Coffee + Vanilla Blend"
        assign og_description = 'Thoughtful, curious, and always evolving.'
        assign og_image_name = 'bean-chilli-2.png'
      when 'coffee_jelly'
        assign og_title = "Turns out, I'm a Coffee + Jelly Blend"
        assign og_description = 'Deep thinker. Bright spirit.'
        assign og_image_name = 'bean-chilli-2.png'
      when 'coffee_chilli'
        assign og_title = "Turns out, I'm a Coffee + Chilli Blend"
        assign og_description = 'Reflective. Direct. Unapologetically myself.'
        assign og_image_name = 'bean-chilli-2.png'
      when 'vanilla_jelly'
        assign og_title = "Turns out, I'm a Vanilla + Jelly Blend"
        assign og_description = 'Spontaneous, expressive, and hard to put in a box.'
        assign og_image_name = 'bean-vanilla-1.png'
      when 'vanilla_chilli'
        assign og_title = "Turns out, I'm a Vanilla + Chilli Blend"
        assign og_description = 'Bold enough to explore. Free enough to be myself'
        assign og_image_name = 'bean-vanilla-1.png'
      when 'jelly_chilli'
        assign og_title = "Turns out, I'm a Jelly + Chilli Blend"
        assign og_description = 'Confidence. Passionate. Full of personality.'
        assign og_image_name = 'bean-jelly-2.png'
      when 'coffee_green'
        assign og_title = "Turns out, I'm a Coffee + Green Blend"
        assign og_description = 'Thoughtful by nature. Grounded in every situation.'
        assign og_image_name = 'bean-chilli-2.png'
      when 'vanilla_green'
        assign og_title = "Turns out, I'm a Vanilla + Green Blend"
        assign og_description = 'Curious enough to explore. Calm enough to enjoy the journey'
        assign og_image_name = 'bean-vanilla-1.png'
      when 'jelly_green'
        assign og_title = "Turns out, I'm a Jelly + Green Blend"
        assign og_description = 'Full of life, with a calming presence'
        assign og_image_name = 'bean-jelly-2.png'
      when 'chilli_green'
        assign og_title = "Turns out, I'm a Chilli + Green Blend"
        assign og_description = 'Bold on the outside. Balanced at the core.'
        assign og_image_name = 'bean-coffee-2.png'
      when 'vanilla_coffee'
        assign og_title = "Turns out, I'm a Coffee + Vanilla Blend"
        assign og_description = "Thoughtful, curious, and always questioning what's next."
        assign og_image_name = 'bean-vanilla-1.png'
      when 'jelly_vanilla'
        assign og_title = "Turns out, I'm a Jelly + Vanilla Blend"
        assign og_description = 'Expressive, adventurous, and always up for something new.'
        assign og_image_name = 'bean-jelly-2.png'
      when 'chilli_vanilla'
        assign og_title = "Turns out, I'm a Chilli + Vanilla Blend"
        assign og_description = 'Bold enough to take risks. Curious enough to chase them.'
        assign og_image_name = 'bean-coffee-2.png'
      when 'jelly_coffee'
        assign og_title = "Turns out, I'm a Jelly + Coffee Blend"
        assign og_description = 'Vibrant on the surface. Thoughtful underneath.'
        assign og_image_name = 'bean-jelly-2.png'
      when 'chilli_coffee'
        assign og_title = "Turns out, I'm a Chilli + Coffee Blend"
        assign og_description = 'Direct in my approach. Intentional in my actions.'
        assign og_image_name = 'bean-coffee-2.png'
      when 'chilli_jelly'
        assign og_title = "Turns out, I'm a Chilli + Jelly Blend"
        assign og_description = 'Confident, expressive, and impossible to overlook.'
        assign og_image_name = 'bean-coffee-2.png'
    endcase
    if og_image_name != blank
      case og_image_name
        when 'bean-green-1.png'
          assign og_image_name = '0C5C916D-3FDA-4D91-B677-FAE7FF78D727.png'
          assign og_image_url = og_image_name | file_url
        when 'bean-chilli-2.png'
          assign og_image_name = '69C0C504-64E5-4346-96A8-2D7D234015A2.webp'
          assign og_image_url = og_image_name | file_url
        when 'bean-coffee-2.png'
          assign og_image_name = '878F49BF-A84F-4DB0-AFD7-873B3FA95B96.png'
          assign og_image_url = og_image_name | file_url
        when 'bean-vanilla-1.png'
          assign og_image_name = 'C3A37D2D-2BFC-4EBC-8413-75F36868BE05.png'
          assign og_image_url = og_image_name | file_url
        when 'bean-jelly-2.png'
          assign og_image_name = 'D5C7EF8A-B9B6-4FEC-B725-44D38D1BC3E3.png'
          assign og_image_url = og_image_name | file_url
        else
          if og_image_name contains '.gif'
            assign og_image_url = og_image_name | file_url
          else
            assign og_image_url = og_image_name | asset_url
          endif
      endcase
    endif
  endif
%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if og_image_url != blank -%}
  <meta property="og:image" content="http:{{ og_image_url }}">
  <meta property="og:image:secure_url" content="https:{{ og_image_url }}">
{%- elsif page_image -%}
  <meta property="og:image" content="http:{{ page_image | image_url }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url }}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
