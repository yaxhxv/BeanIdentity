{% doc %}
  @prompt
    Create a promotional announcement banner that displays "Get ₹100 cashback on every purchase! Store credit will be emailed to you after your order." The banner should be eye-catching with a warm, brand-friendly color (like a rich coffee brown or golden tone to match a bean/coffee brand), bold text, and display prominently at the top of the storefront.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-promo-banner-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .ai-promo-banner-content-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .ai-promo-banner-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    margin: 0;
    line-height: 1.4;
  }

  .ai-promo-banner-highlight-{{ ai_gen_id }} {
    color: {{ block.settings.highlight_color }};
    font-weight: 700;
  }

  .ai-promo-banner-close-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    right: {{ block.settings.padding_horizontal }}px;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    color: {{ block.settings.text_color }};
    cursor: pointer;
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .ai-promo-banner-close-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-promo-banner-close-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-promo-banner-{{ ai_gen_id }}.hidden {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .ai-promo-banner-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.85 }}px;
    }

    .ai-promo-banner-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical | times: 0.75 }}px {{ block.settings.padding_horizontal | times: 0.75 }}px;
    }

    .ai-promo-banner-close-{{ ai_gen_id }} {
      right: {{ block.settings.padding_horizontal | times: 0.75 }}px;
    }
  }
{% endstyle %}

<promo-banner-{{ ai_gen_id }}
  class="ai-promo-banner-{{ ai_gen_id }}"
  data-banner-id="{{ block.id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-promo-banner-content-{{ ai_gen_id }}">
    <p class="ai-promo-banner-text-{{ ai_gen_id }}">
      {{ block.settings.banner_text_before }}
      <span class="ai-promo-banner-highlight-{{ ai_gen_id }}">{{ block.settings.banner_text_highlight }}</span>
      {{ block.settings.banner_text_after }}
    </p>
  </div>

  {% if block.settings.show_close_button %}
    <button
      class="ai-promo-banner-close-{{ ai_gen_id }}"
      aria-label="Close announcement"
      type="button"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  {% endif %}
</promo-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class PromoBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.bannerId = this.dataset.bannerId;
        this.storageKey = `promo-banner-closed-${this.bannerId}`;
      }

      connectedCallback() {
        if (this.isBannerClosed()) {
          this.classList.add('hidden');
          return;
        }

        const closeButton = this.querySelector('.ai-promo-banner-close-{{ ai_gen_id }}');
        if (closeButton) {
          closeButton.addEventListener('click', () => this.closeBanner());
        }
      }

      isBannerClosed() {
        try {
          return localStorage.getItem(this.storageKey) === 'true';
        } catch (e) {
          return false;
        }
      }

      closeBanner() {
        this.classList.add('hidden');
        try {
          localStorage.setItem(this.storageKey, 'true');
        } catch (e) {
          console.warn('Unable to save banner state');
        }
      }
    }

    customElements.define('promo-banner-{{ ai_gen_id }}', PromoBanner{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Cashback announcement",
  "settings": [
    {
      "type": "header",
      "content": "Banner text"
    },
    {
      "type": "inline_richtext",
      "id": "banner_text_before",
      "label": "Text before highlight",
      "default": "Get"
    },
    {
      "type": "inline_richtext",
      "id": "banner_text_highlight",
      "label": "Highlighted text",
      "default": "₹100 cashback"
    },
    {
      "type": "inline_richtext",
      "id": "banner_text_after",
      "label": "Text after highlight",
      "default": "on every purchase! Store credit will be emailed to you after your order."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#6B4423"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight color",
      "default": "#FFD700"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 16
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "label": "Maximum content width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Vertical padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 20
    },
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "checkbox",
      "id": "show_close_button",
      "label": "Show close button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Cashback announcement"
    }
  ]
}
{% endschema %}
