{% doc %}
  @prompt
    Create a combined promotional banner block with two parts: 1) A cashback announcement strip that displays "Get ₹100 cashback on every purchase! Store credit will be emailed to you after your order." in a warm coffee brown or golden tone with bold text. 2) Below it, a "Shop with Confidence" section with trust signals (e.g., secure payments, easy returns, genuine products). Both parts should be visually cohesive, matching the Bean Identity brand with warm earthy tones, and display prominently on the storefront.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-promo-banner-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-promo-banner__cashback-{{ ai_gen_id }} {
    background: {{ block.settings.cashback_bg_color }};
    padding: {{ block.settings.cashback_padding }}px 20px;
    text-align: center;
    border-radius: {{ block.settings.border_radius }}px {{ block.settings.border_radius }}px 0 0;
  }

  .ai-promo-banner__cashback-text-{{ ai_gen_id }} {
    color: {{ block.settings.cashback_text_color }};
    font-size: {{ block.settings.cashback_font_size }}px;
    font-weight: {{ block.settings.cashback_font_weight }};
    margin: 0;
    line-height: 1.4;
  }

  .ai-promo-banner__trust-{{ ai_gen_id }} {
    background: {{ block.settings.trust_bg_color }};
    padding: {{ block.settings.trust_padding }}px 20px;
    border-radius: 0 0 {{ block.settings.border_radius }}px {{ block.settings.border_radius }}px;
  }

  .ai-promo-banner__trust-heading-{{ ai_gen_id }} {
    color: {{ block.settings.trust_heading_color }};
    font-size: {{ block.settings.trust_heading_size }}px;
    font-weight: 600;
    text-align: center;
    margin: 0 0 {{ block.settings.trust_item_spacing }}px;
  }

  .ai-promo-banner__trust-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: {{ block.settings.trust_item_spacing }}px;
    max-width: 1000px;
    margin: 0 auto;
  }

  .ai-promo-banner__trust-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
  }

  .ai-promo-banner__trust-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    color: {{ block.settings.icon_color }};
    flex-shrink: 0;
  }

  .ai-promo-banner__trust-label-{{ ai_gen_id }} {
    color: {{ block.settings.trust_text_color }};
    font-size: {{ block.settings.trust_text_size }}px;
    font-weight: 500;
    margin: 0;
  }

  .ai-promo-banner__trust-desc-{{ ai_gen_id }} {
    color: {{ block.settings.trust_desc_color }};
    font-size: {{ block.settings.trust_desc_size }}px;
    margin: 0;
    line-height: 1.3;
  }

  @media screen and (max-width: 749px) {
    .ai-promo-banner__cashback-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.cashback_font_size | times: 0.85 }}px;
    }

    .ai-promo-banner__trust-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.trust_heading_size | times: 0.9 }}px;
    }

    .ai-promo-banner__trust-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.trust_item_spacing | times: 1.5 }}px;
    }
  }
{% endstyle %}

<promo-banner-{{ ai_gen_id }} class="ai-promo-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-promo-banner__cashback-{{ ai_gen_id }}">
    <p class="ai-promo-banner__cashback-text-{{ ai_gen_id }}">
      {{ block.settings.cashback_text }}
    </p>
  </div>

  <div class="ai-promo-banner__trust-{{ ai_gen_id }}">
    {% if block.settings.trust_heading != blank %}
      <h2 class="ai-promo-banner__trust-heading-{{ ai_gen_id }}">
        {{ block.settings.trust_heading }}
      </h2>
    {% endif %}

    <div class="ai-promo-banner__trust-grid-{{ ai_gen_id }}">
      {% if block.settings.show_secure_payments %}
        <div class="ai-promo-banner__trust-item-{{ ai_gen_id }}">
          <svg class="ai-promo-banner__trust-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          <p class="ai-promo-banner__trust-label-{{ ai_gen_id }}">{{ block.settings.secure_payments_label }}</p>
          {% if block.settings.secure_payments_desc != blank %}
            <p class="ai-promo-banner__trust-desc-{{ ai_gen_id }}">{{ block.settings.secure_payments_desc }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.show_easy_returns %}
        <div class="ai-promo-banner__trust-item-{{ ai_gen_id }}">
          <svg class="ai-promo-banner__trust-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 15v-1a4 4 0 00-4-4H8m0 0l3 3m-3-3l3-3m9 14V5a2 2 0 00-2-2H6a2 2 0 00-2 2v16l4-2 4 2 4-2 4 2z" />
          </svg>
          <p class="ai-promo-banner__trust-label-{{ ai_gen_id }}">{{ block.settings.easy_returns_label }}</p>
          {% if block.settings.easy_returns_desc != blank %}
            <p class="ai-promo-banner__trust-desc-{{ ai_gen_id }}">{{ block.settings.easy_returns_desc }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.show_genuine_products %}
        <div class="ai-promo-banner__trust-item-{{ ai_gen_id }}">
          <svg class="ai-promo-banner__trust-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <p class="ai-promo-banner__trust-label-{{ ai_gen_id }}">{{ block.settings.genuine_products_label }}</p>
          {% if block.settings.genuine_products_desc != blank %}
            <p class="ai-promo-banner__trust-desc-{{ ai_gen_id }}">{{ block.settings.genuine_products_desc }}</p>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</promo-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class PromoBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }
    customElements.define('promo-banner-{{ ai_gen_id }}', PromoBanner{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Cashback trust banner",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Cashback announcement"
    },
    {
      "type": "inline_richtext",
      "id": "cashback_text",
      "label": "Cashback message",
      "default": "Get ₹100 cashback on every purchase! Store credit will be emailed to you after your order."
    },
    {
      "type": "range",
      "id": "cashback_font_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "cashback_font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "700"
    },
    {
      "type": "range",
      "id": "cashback_padding",
      "label": "Padding",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "cashback_bg_color",
      "label": "Background color",
      "default": "#c6a969"
    },
    {
      "type": "color",
      "id": "cashback_text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Trust signals"
    },
    {
      "type": "inline_richtext",
      "id": "trust_heading",
      "label": "Heading",
      "default": "Shop with Confidence"
    },
    {
      "type": "range",
      "id": "trust_heading_size",
      "label": "Heading size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "trust_heading_color",
      "label": "Heading color",
      "default": "#2b2b2b"
    },
    {
      "type": "range",
      "id": "trust_padding",
      "label": "Padding",
      "min": 20,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "trust_item_spacing",
      "label": "Item spacing",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "trust_bg_color",
      "label": "Background color",
      "default": "#f5f3ee"
    },
    {
      "type": "header",
      "content": "Secure payments"
    },
    {
      "type": "checkbox",
      "id": "show_secure_payments",
      "label": "Show secure payments",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "secure_payments_label",
      "label": "Label",
      "default": "Secure Payments"
    },
    {
      "type": "inline_richtext",
      "id": "secure_payments_desc",
      "label": "Description",
      "default": "100% safe & secure checkout"
    },
    {
      "type": "header",
      "content": "Easy returns"
    },
    {
      "type": "checkbox",
      "id": "show_easy_returns",
      "label": "Show easy returns",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "easy_returns_label",
      "label": "Label",
      "default": "Easy Returns"
    },
    {
      "type": "inline_richtext",
      "id": "easy_returns_desc",
      "label": "Description",
      "default": "Hassle-free 30-day returns"
    },
    {
      "type": "header",
      "content": "Genuine products"
    },
    {
      "type": "checkbox",
      "id": "show_genuine_products",
      "label": "Show genuine products",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "genuine_products_label",
      "label": "Label",
      "default": "Genuine Products"
    },
    {
      "type": "inline_richtext",
      "id": "genuine_products_desc",
      "label": "Description",
      "default": "100% authentic & verified"
    },
    {
      "type": "header",
      "content": "Icon style"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 24,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#c6a969"
    },
    {
      "type": "header",
      "content": "Text style"
    },
    {
      "type": "range",
      "id": "trust_text_size",
      "label": "Label size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "trust_text_color",
      "label": "Label color",
      "default": "#2b2b2b"
    },
    {
      "type": "range",
      "id": "trust_desc_size",
      "label": "Description size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "color",
      "id": "trust_desc_color",
      "label": "Description color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Cashback trust banner"
    }
  ]
}
{% endschema %}
